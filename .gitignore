# Dependencies
node_modules/
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example
!server/.env.example

# Production credentials
server/config/apiclient_*.pem
private.upload.key

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Build artifacts
dist/
build/
coverage/

# Python bytecode (deploy 脚本运行产物，会触发小程序保留目录报错)
__pycache__/
*.pyc

# Temporary files
*.tmp
*.temp
.workbuddy/
.mimosa/

# Crawler captures and local test artifacts
jw-crawler/.logs/
jw-crawler/captcha.png
jw-crawler/captcha-samples/
jw-crawler/schedule.json
jw-crawler/schedule_raw/
jw-crawler/login_debug/

# 数据库备份：含用户手机号 / openid / 真实姓名等个人信息，禁止提交到仓库
# （备份统一落在 db-backup/；不要在这里用 `*.sql` 通配，
#   否则会误伤 server/sql/init.sql 这类必须版本化的建表脚本）
db-backup/
db-backup-*.sql
*.sql.bak-*
