.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
  padding: 48rpx 32rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
  padding-top: 40rpx;
}

.school-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--card-bg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.school-name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.school-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.form-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 8rpx 32rpx;
  box-shadow: var(--shadow-sm);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.login-btn {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  border: none;
  transition: var(--transition-fast);
}

.login-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.login-btn::after {
  border: none;
}

.captcha-card {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.captcha-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.captcha-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.captcha-refresh {
  font-size: 26rpx;
  color: var(--primary);
}

.captcha-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.captcha-image {
  width: 220rpx;
  height: 88rpx;
  border-radius: 8rpx;
  background: #f5f7fa;
  border: 1rpx solid var(--divider);
  flex-shrink: 0;
}

.captcha-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #f5f7fa;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.captcha-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

.tips {
  margin-top: 48rpx;
  padding: 32rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.tips-text {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.8;
}

/* ===== 已绑定状态 ===== */
.bound-card {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.bound-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bound-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bound-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.bound-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.bound-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 28rpx;
  background: var(--primary);
  border-radius: var(--radius-pill);
  transition: var(--transition-fast);
}

.refresh-btn:active {
  opacity: 0.85;
  transform: scale(0.96);
}

.refresh-btn.refreshing {
  opacity: 0.6;
}

.refresh-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.refresh-btn.refreshing .refresh-icon {
  animation: refresh-spin 1s linear infinite;
}

@keyframes refresh-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.refresh-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

.quick-entries {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quick-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--radius);
  transition: var(--transition-fast);
}

.quick-entry:active {
  opacity: 0.85;
}

.quick-entry.exam {
  background: linear-gradient(135deg, #fff3e6 0%, #fff7ec 100%);
}

.quick-entry.grade {
  background: linear-gradient(135deg, #eafbe4 0%, #f2fdf0 100%);
}

.quick-icon {
  width: 40rpx;
  height: 40rpx;
}

.quick-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.quick-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.captcha-submit {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}
