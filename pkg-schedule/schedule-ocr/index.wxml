<view class="page">
  <view class="tips card">
    <text class="tips-title">识别提示</text>
    <text class="tips-text">建议上传教务系统完整课表截图，保持横平竖直、无遮挡。识别后会自动按课程类型配色，并支持逐项校正再导入。</text>
  </view>

  <view class="example card">
    <view class="example-title">错误示例</view>
    <view class="example-img-wrap bad">
      <text class="example-label">模糊、倾斜、不完整</text>
    </view>
  </view>

  <view class="example card">
    <view class="example-title">正确示例</view>
    <view class="example-img-wrap good">
      <text class="example-label">完整、清晰、正向</text>
    </view>
  </view>

  <view class="preview card" wx:if="{{imageUrl}}">
    <image src="{{imageUrl}}" mode="widthFix" class="preview-img" />
    <view class="quality-list" wx:if="{{qualityTips.length}}">
      <view class="quality-tip" wx:for="{{qualityTips}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <button hover-class="press-spring" class="upload-btn btn-primary spring-btn" bindtap="onUpload" loading="{{recognizing}}" hover-stay-time="120">上传识别</button>

  <!-- 识别结果列表 -->
  <view class="result-section" wx:if="{{showResult}}">
    <view class="result-header">
      <text class="result-title">识别结果（{{recognizedCourses.length}} 门）</text>
      <text class="result-tip">已自动排序，可编辑后导入</text>
    </view>

    <view class="course-edit-item" wx:for="{{recognizedCourses}}" wx:key="id">
      <view class="course-edit-header">
        <view class="course-color-dot" style="background: {{item.color}};"></view>
        <text class="course-edit-label">课程 {{index + 1}}</text>
        <text class="course-theme-tag">{{item.themeLabel}}</text>
        <text class="course-confidence" wx:if="{{item.confidence}}">{{item.confidence}}%</text>
        <text class="course-remove" catchtap="onRemoveCourse" data-index="{{index}}">删除</text>
      </view>
      <view class="course-edit-body">
        <view class="edit-row">
          <text class="edit-label">课程名</text>
          <input class="edit-input" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">地点</text>
          <input class="edit-input" value="{{item.location}}" data-index="{{index}}" data-field="location" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">教师</text>
          <input class="edit-input" value="{{item.teacher}}" data-index="{{index}}" data-field="teacher" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">星期</text>
          <input class="edit-input" type="number" value="{{item.weekDay}}" data-index="{{index}}" data-field="weekDay" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">开始时间</text>
          <input class="edit-input" value="{{item.startTime}}" data-index="{{index}}" data-field="startTime" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">结束时间</text>
          <input class="edit-input" value="{{item.endTime}}" data-index="{{index}}" data-field="endTime" bindinput="onCourseInput" />
        </view>
      </view>
    </view>

    <view class="result-actions">
      <button hover-class="press-spring" class="retry-btn spring-btn" bindtap="onRetry" hover-stay-time="120">重新识别</button>
      <button hover-class="press-spring" class="confirm-btn btn-primary spring-btn" bindtap="onConfirmImport" hover-stay-time="120">确认导入</button>
    </view>
  </view>
</view>
