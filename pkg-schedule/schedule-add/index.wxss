.page {
  padding: 24rpx;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
}

.hero-card {
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 18%, rgba(255,255,255,0.28) 0, rgba(255,255,255,0) 150rpx),
    linear-gradient(135deg, #315cff 0%, #12b8a6 100%);
  box-shadow: 0 14rpx 34rpx rgba(49, 92, 255, 0.18);
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.86);
}

.form {
  padding: 0 24rpx;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F7FA;
}

.label {
  font-size: 28rpx;
  color: #323233;
  display: block;
  margin-bottom: 16rpx;
}

.input {
  font-size: 28rpx;
  color: #323233;
  min-height: 56rpx;
  padding: 10rpx 0;
}

.picker-val {
  font-size: 28rpx;
  color: #4A7AFF;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.preset-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #5f6678;
  font-size: 24rpx;
  transition: var(--transition-fast);
}

.preset-chip.active {
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 700;
}

.sep {
  color: #969799;
  font-size: 26rpx;
}

.color-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.color-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  transition: all 0.3s ease-out;
}

.color-dot.active {
  transform: scale(1.2);
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 8rpx currentColor;
}

.save-btn {
  margin-top: 48rpx;
  width: 90%;
}
