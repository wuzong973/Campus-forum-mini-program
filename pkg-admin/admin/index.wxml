          </view>
        </view>
        <view class="form-item">
          <view class="form-label">群介绍 <text class="form-req">*</text>（展示在用户端群聊列表，一句话说清这个群是干什么的）<text class="form-counter">{{form.intro.length || 0}}/300</text></view>
