          <view class="upload-row upload-row--qr" bindtap="chooseFormImage" data-key="qrcodeUrl">
            <image class="upload-thumb upload-thumb--qr" wx:if="{{form.meta.qrcodeUrl}}" src="{{form.meta.qrcodeUrl}}" mode="aspectFill"></image>
            <view wx:else class="upload-add upload-add--qr">＋ 上传群二维码</view>
