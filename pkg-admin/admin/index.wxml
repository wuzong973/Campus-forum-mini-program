          <view class="form-label">审核意见{{form.action === 'reject' ? '（驳回必填，用户端可见）' : '（选填）'}}</view>
          <textarea data-key="reviewNote" value="{{form.reviewNote}}" maxlength="200" placeholder="例如：群二维码已过期，请补充有效二维码后再提交" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'clubReview'}}">
        <view class="form-guide">申请社团：{{form.applyName}}（审核通过后出现在用户端「社团&组织」的对应分类中）</view>
        <view class="form-item">
          <view class="form-label">审核意见{{form.action === 'reject' ? '（驳回必填，用户端可见）' : '（选填）'}}</view>
          <textarea data-key="reviewNote" value="{{form.reviewNote}}" maxlength="200" placeholder="例如：社团介绍过于简略，请补充社团定位与招新说明后再提交" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'activityAudit'}}">
