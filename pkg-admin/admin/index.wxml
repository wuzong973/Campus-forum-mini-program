<view wx:if="{{ready}}" class="page">
  <view class="hero">
    <text class="hero-title">管理后台</text>
    <text class="hero-subtitle">{{role === 'super_admin' ? '超级管理员' : role}}</text>
  </view>

  <scroll-view class="tabs" scroll-x="true" show-scrollbar="false">
    <view class="tabs-inner">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{activeTab === 'overview' && stats}}">
    <view class="stats-meta">
      <text>每 15 秒自动刷新{{statsUpdatedAt ? ' · 更新于 ' + statsUpdatedAt : ''}}</text>
      <text class="stats-refresh" bindtap="refreshStatsTap">手动刷新</text>
    </view>
    <view class="metric-grid">
      <view class="metric"><text>{{stats.users.total}}</text><label>注册用户</label></view>
      <view class="metric"><text>{{stats.users.active7d}}</text><label>7日活跃</label></view>
      <view class="metric"><text>{{stats.posts.published}}</text><label>已发布帖子</label></view>
      <view class="metric"><text>{{stats.posts.pending}}</text><label>待审核帖子</label></view>
      <view class="metric"><text>{{stats.items.sales}}</text><label>虚拟物品销量</label></view>
      <view class="metric"><text>{{stats.errands.finished}}</text><label>完成跑腿单</label></view>
    </view>
    <view class="section-title">最近管理操作</view>
    <view class="list-card"><view wx:for="{{stats.recentActions}}" wx:key="index" class="audit-row logs-row"><view class="logs-main"><text class="logs-action">{{item.actionText}}</text><text class="logs-sub">{{item.adminName || '管理员'}} · {{item.targetText}} · {{item.timeText}}</text></view></view><view wx:if="{{!stats.recentActions.length}}" class="empty">暂无操作记录</view></view>
  </view>

  <view wx:if="{{activeTab === 'reports'}}">
    <view wx:for="{{reports}}" wx:key="id" class="list-card compact-row report-row">
      <view>
        <text class="row-title">帖子 #{{item.targetId}} · 举报 #{{item.id}}</text>
        <text class="row-sub">举报人：{{item.reporterName || '用户'}} #{{item.reporterId}} · {{item.createdAt}}</text>
        <text class="report-reason">{{item.reason}}</text>
        <text class="row-sub">状态：{{item.status === 'pending' ? '待处理' : item.status === 'processing' ? '处理中' : item.status === 'resolved' ? '已解决' : '已驳回'}}</text>
      </view>
      <view class="row-actions" wx:if="{{item.status === 'pending' || item.status === 'processing'}}">
        <text wx:if="{{item.status === 'pending'}}" data-id="{{item.id}}" data-status="processing" bindtap="updateReport">受理</text>
        <text data-id="{{item.id}}" data-status="resolved" bindtap="updateReport">解决</text>
        <text class="danger" data-id="{{item.id}}" data-status="rejected" bindtap="updateReport">驳回</text>
      </view>
    </view>
    <view wx:if="{{!reports.length}}" class="empty">暂无举报记录</view>
  </view>

  <view wx:if="{{activeTab === 'posts'}}">
    <view class="toolbar"><input placeholder="搜索标题、正文或用户" value="{{postKeyword}}" bindinput="onPostKeyword" confirm-type="search" bindconfirm="searchPosts"/><text bindtap="searchPosts">搜索</text></view>
    <scroll-view class="filters" scroll-x="true"><view class="filters-inner"><view class="filter {{postStatus === '' ? 'selected' : ''}}" data-status="" bindtap="choosePostStatus">全部</view><view class="filter {{postStatus === 2 ? 'selected' : ''}}" data-status="2" bindtap="choosePostStatus">待审核</view><view class="filter {{postStatus === 1 ? 'selected' : ''}}" data-status="1" bindtap="choosePostStatus">已发布</view><view class="filter {{postStatus === 3 ? 'selected' : ''}}" data-status="3" bindtap="choosePostStatus">已隐藏</view><view class="filter {{postStatus === 0 ? 'selected' : ''}}" data-status="0" bindtap="choosePostStatus">已删除</view></view></scroll-view>
    <view class="batch-bar"><text>已选 {{selectedPostIds.length}} 项</text><button size="mini" class="plain-btn" bindtap="batchPostAction">批量操作</button></view>
    <checkbox-group bindchange="selectPosts"><view wx:for="{{posts}}" wx:key="id" class="list-card post-row"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#315CFF"/><view class="post-main"><view class="post-user-row"><image wx:if="{{item.avatarUrl}}" class="post-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="post-avatar post-avatar-fallback">{{item.nickName ? item.nickName[0] : '同'}}</view><text class="post-nick">{{item.nickName || '未知用户'}}</text><text class="status s{{item.status}}">{{item.status === 1 ? '已发布' : item.status === 2 ? '待审核' : item.status === 3 ? '已隐藏' : '已删除'}}</text></view><text class="post-content">{{item.content}}</text><text class="meta">{{item.category || '未选择主题'}} · 赞 {{item.likeCount || 0}} · 评论 {{item.commentCount || 0}}</text><view class="actions"><text wx:if="{{item.status !== 1}}" data-id="{{item.id}}" data-action="approve" bindtap="doPostAction">通过</text><text wx:if="{{item.status !== 3}}" data-id="{{item.id}}" data-action="hide" bindtap="doPostAction">隐藏</text><text data-id="{{item.id}}" bindtap="beginPostEdit">编辑</text><text data-id="{{item.id}}" data-action="{{item.pinned ? 'unpin' : 'pin'}}" bindtap="doPostAction">{{item.pinned ? '取消置顶' : '置顶'}}</text><text class="danger" data-id="{{item.id}}" data-action="delete" bindtap="doPostAction">删除</text></view></view></view></checkbox-group>
    <view wx:if="{{!posts.length}}" class="empty">没有符合条件的帖子</view>
  </view>

  <view wx:if="{{activeTab === 'content'}}">
    <view class="section-head"><view class="mini-tabs"><text class="{{contentType === 'notice' ? 'on' : ''}}" data-type="notice" bindtap="chooseContentType">公告</text><text class="{{contentType === 'tag' ? 'on' : ''}}" data-type="tag" bindtap="chooseContentType">标签</text><text class="{{contentType === 'banner' ? 'on' : ''}}" data-type="banner" bindtap="chooseContentType">轮播</text><text class="{{contentType === 'publish_banner' ? 'on' : ''}}" data-type="publish_banner" bindtap="chooseContentType">发布横幅</text></view><button size="mini" class="primary-mini" bindtap="beginContentCreate">新增</button></view>
    <view class="config-hint" wx:if="{{contentType === 'banner'}}">首页轮播图：启用中的轮播按排序展示在首页顶部；未配置时显示默认轮播。</view>
    <view class="config-hint" wx:elif="{{contentType === 'notice'}}">首页公告：取排序最前的启用条目；「链接图片」在用户点击右侧链接文字后弹出。</view>
    <view class="config-hint" wx:elif="{{contentType === 'tag'}}">帖子标签：启用后的标签会展示在发帖页的标签选项中，供发帖时选择；未配置时发帖页不展示标签栏。</view>
    <view class="config-hint" wx:elif="{{contentType === 'publish_banner'}}">发布页横幅：展示在「发布帖子」「发布跑腿」页顶部，自动左右轮播；「标题」为横幅文字，可配颜色与小图标，未配置时显示默认横幅。</view>
    <view wx:for="{{contentList}}" wx:key="id" class="list-card compact-row"><view><view wx:if="{{contentType === 'tag'}}" class="tag-chip" style="background: {{item.tagBg || '#eef4ff'}}; color: {{item.tagFg || '#4a6b9c'}};">{{item.title}}</view><text wx:else class="row-title">{{item.title}}</text><text class="row-sub">{{item.status ? '启用' : '已停用'}} · 排序 {{item.sortOrder}}</text></view><view class="row-actions"><text data-id="{{item.id}}" bindtap="beginContentEdit">编辑</text><text class="danger" data-id="{{item.id}}" bindtap="deleteContent">删除</text></view></view>
    <view class="section-head feature-head"><text class="section-title-inline">页面横幅</text></view>
    <view class="config-hint">两条横幅相互独立、分别配置：①「我的」页消息通知卡片顶部横幅；②帖子详情页「每日热榜」上方横幅。支持文字、图片、跳转链接，保存后全端实时生效。</view>
    <view class="banner-entry-row">
      <button size="mini" class="plain-btn" bindtap="goBannerEditor" data-scope="message">消息通知横幅</button>
      <button size="mini" class="plain-btn" bindtap="goBannerEditor" data-scope="post">热榜上方横幅</button>
    </view>
  </view>

  <view wx:if="{{activeTab === 'items'}}"><view class="section-head"><text class="section-title-inline">虚拟物品</text><button size="mini" class="primary-mini" bindtap="beginItemCreate">新增物品</button></view><view wx:for="{{items}}" wx:key="id" class="list-card compact-row"><view><text class="row-title">{{item.name}}</text><text class="row-sub">￥{{item.price}} · 库存 {{item.stock}} · 销量 {{item.salesCount}} · {{item.status ? '上架' : '下架'}}</text></view><view class="row-actions"><text data-id="{{item.id}}" bindtap="beginItemEdit">编辑</text><text data-id="{{item.id}}" bindtap="toggleItem">{{item.status ? '下架' : '上架'}}</text></view></view><view wx:if="{{!items.length}}" class="empty">暂无虚拟物品</view></view>

  <view wx:if="{{activeTab === 'clubGroup' && subTabs.clubGroup.length > 1}}" class="sub-tabs">
    <view wx:for="{{subTabs.clubGroup}}" wx:key="key" class="sub-tab {{activeSubTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchSubTab">{{item.name}}</view>
  </view>

  <view wx:if="{{activeTab === 'clubGroup' && activeSubTab === 'groupChat'}}">
    <view class="section-head"><text class="section-title-inline">建群申请审核</text></view>
    <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
      <view class="filter {{groupChatApplyStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseGcApplyStatus">全部</view>
      <view class="filter {{groupChatApplyStatus === 'pending' ? 'selected' : ''}}" data-status="pending" bindtap="chooseGcApplyStatus">待审核</view>
      <view class="filter {{groupChatApplyStatus === 'approved' ? 'selected' : ''}}" data-status="approved" bindtap="chooseGcApplyStatus">已通过</view>
      <view class="filter {{groupChatApplyStatus === 'rejected' ? 'selected' : ''}}" data-status="rejected" bindtap="chooseGcApplyStatus">已驳回</view>
    </view></scroll-view>
    <view wx:for="{{groupChatApplies}}" wx:key="id" class="list-card compact-row chat-apply-row">
      <view class="chat-apply-info">
        <text class="row-title">{{item.name}}<text class="chat-apply-status cs-{{item.status}}">{{item.statusText}}</text></text>
        <text class="row-sub">申请人：{{item.nickName || '用户'}} #{{item.userId}} · {{item.category}} · {{item.createdAtText}}</text>
        <text class="row-sub chat-apply-intro">介绍：{{item.intro}}</text>
        <view class="rider-verify-images" wx:if="{{item.avatarUrl || item.qrcodeUrl || item.adminQrcodeUrl || item.gzhQrcodeUrl}}">
          <image wx:if="{{item.avatarUrl}}" class="verify-img" src="{{item.avatarUrl}}" mode="aspectFill" data-src="{{item.avatarUrl}}" bindtap="previewVerifyImg"/>
          <image wx:if="{{item.qrcodeUrl}}" class="verify-img" src="{{item.qrcodeUrl}}" mode="aspectFill" data-src="{{item.qrcodeUrl}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
          <image wx:if="{{item.adminQrcodeUrl}}" class="verify-img" src="{{item.adminQrcodeUrl}}" mode="aspectFill" data-src="{{item.adminQrcodeUrl}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
          <image wx:if="{{item.gzhQrcodeUrl}}" class="verify-img" src="{{item.gzhQrcodeUrl}}" mode="aspectFill" data-src="{{item.gzhQrcodeUrl}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
        </view>
        <text class="row-sub" wx:if="{{item.reviewNote}}">审核意见：{{item.reviewNote}}</text>
      </view>
      <view class="row-actions" wx:if="{{item.status === 'pending'}}">
        <text data-id="{{item.id}}" data-action="approve" bindtap="openChatReview">通过</text>
        <text class="danger" data-id="{{item.id}}" data-action="reject" bindtap="openChatReview">驳回</text>
      </view>
    </view>
    <view wx:if="{{!groupChatApplies.length}}" class="empty">暂无申请记录</view>

    <view class="section-head"><text class="section-title-inline">群聊列表（{{groupChatGroups.length}}）</text><button size="mini" class="primary-mini" bindtap="beginChatGroupCreate">手动添加</button></view>
    <view class="config-hint">审核通过的申请会自动上架到用户端「广轻群聊」；此处也可手动添加群聊、调整排序或上下架。下架后用户端立即不可见。</view>
    <view wx:for="{{groupChatGroups}}" wx:key="id" class="list-card compact-row">
      <view>
        <text class="row-title">{{item.name}}<text wx:if="{{item.isOfficial}}" class="official-tag">官方</text><text wx:if="{{item.customTag}}" class="custom-tag">{{item.customTag}}</text></text>
        <text class="row-sub">{{item.category || '未分类'}} · {{item.campus || '全部校区'}} · 排序 {{item.sortOrder}} · {{item.status ? '上架中' : '已下架'}}</text>
      </view>
      <view class="row-actions">
        <text data-id="{{item.id}}" bindtap="beginChatGroupEdit">编辑</text>
        <text data-id="{{item.id}}" bindtap="toggleChatGroup">{{item.status ? '下架' : '上架'}}</text>
        <text class="danger" data-id="{{item.id}}" bindtap="deleteChatGroup">删除</text>
      </view>
    </view>
    <view wx:if="{{!groupChatGroups.length}}" class="empty">暂无群聊</view>
  </view>

  <view wx:if="{{activeTab === 'clubGroup' && activeSubTab === 'clubs'}}">
    <view class="section-head"><text class="section-title-inline">社团分类管理</text><button size="mini" class="primary-mini" bindtap="beginClubCategoryCreate">新增分类</button></view>
    <view class="config-hint">分类与社团保存后，用户端「社团&组织」页实时生效（下拉刷新即可看到）。删除分类会将其中社团一并隐藏。</view>
    <view wx:for="{{clubCategories}}" wx:key="id" class="list-card club-admin-card">
      <view class="club-admin-head" data-id="{{item.id}}" bindtap="toggleExpandClubCategory">
        <view class="club-admin-char" style="background: {{item.color}};">{{item.iconChar}}</view>
        <view class="club-admin-main">
          <text class="row-title">{{item.name}}<text wx:if="{{!item.status}}" class="chat-apply-status cs-rejected">已停用</text></text>
          <text class="row-sub">社团 {{item.clubTotal}} 个（启用 {{item.clubEnabled}}） · 排序 {{item.sortOrder}}</text>
        </view>
        <text class="club-admin-arrow">{{expandedClubCategory === item.id ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{expandedClubCategory === item.id}}" class="club-admin-body">
        <text class="row-sub club-admin-slogan">{{item.slogan}}</text>
        <view class="row-actions club-admin-actions">
          <text data-id="{{item.id}}" bindtap="beginClubCategoryEdit">编辑分类</text>
          <text data-id="{{item.id}}" data-name="{{item.name}}" bindtap="beginClubCreate">+ 添加社团</text>
          <text class="danger" data-id="{{item.id}}" bindtap="deleteClubCategory">删除分类</text>
        </view>
        <view wx:for="{{item.clubs}}" wx:for-item="club" wx:key="id" class="club-admin-club">
          <view class="club-admin-club-main">
            <text class="club-admin-club-name">{{club.name}}<text wx:if="{{!club.status}}" class="club-admin-off">（已下架）</text></text>
            <text class="row-sub">{{club.campus || '全部校区'}}<text wx:if="{{club.tags}}"> · {{club.tags}}</text></text>
          </view>
          <view class="row-actions">
            <text data-id="{{club.id}}" bindtap="beginClubEdit">编辑</text>
            <text data-id="{{club.id}}" bindtap="toggleClub">{{club.status ? '下架' : '上架'}}</text>
            <text class="danger" data-id="{{club.id}}" bindtap="deleteClub">删除</text>
          </view>
        </view>
        <view wx:if="{{!item.clubs.length}}" class="empty">该分类下暂无社团</view>
      </view>
    </view>
    <view wx:if="{{!clubCategories.length}}" class="empty">暂无社团分类</view>
  </view>

  <view wx:if="{{activeTab === 'activities'}}">
    <view class="toolbar"><input placeholder="搜索活动标题、位置或发起人" value="{{activityKeyword}}" bindinput="onActivityKeywordInput" confirm-type="search" bindconfirm="searchActivities"/><text bindtap="searchActivities">搜索</text></view>
    <view class="config-hint">用户在小程序「校园活动」页发布的活动在此统一管理；下架后用户端立即不可见，删除为软删除（数据保留）。</view>
    <view wx:for="{{activities}}" wx:key="id" class="list-card act-admin-row">
      <image wx:if="{{item.coverUrl}}" class="act-admin-cover" src="{{item.coverUrl}}" mode="aspectFill"/>
      <view wx:else class="act-admin-cover act-admin-cover--fallback"><text>活动</text></view>
      <view class="act-admin-main">
        <text class="row-title">{{item.title}}<text wx:if="{{item.badgeText}}" class="chat-apply-status cs-{{item.badge === 'signing' ? 'approved' : item.badge === 'notStarted' ? 'pending' : 'rejected'}}">{{item.badgeText}}</text><text wx:if="{{!item.status}}" class="chat-apply-status cs-rejected">已下架</text></text>
        <text class="row-sub">校区：{{item.campus || '全部校区'}} · 已报名 {{item.signupCount}} 人{{item.capacity > 0 ? ' · 名额 ' + item.capacity : ' · 名额不限'}}</text>
        <text class="row-sub">活动时间：{{item.activityStart || '未设置'}}</text>
        <view class="act-initiator">
          <image wx:if="{{item.initiator.avatarUrl}}" class="act-initiator-avatar" src="{{item.initiator.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{item.initiator.nickName ? item.initiator.nickName[0] : '友'}}</view>
          <view class="act-initiator-info">
            <text class="act-initiator-name">{{item.initiator.nickName || '未命名用户'}} #{{item.initiator.userId}}</text>
            <text class="row-sub">{{item.initiator.phone || '未绑定手机号'}}</text>
          </view>
        </view>
        <text class="row-sub">发布于 {{item.createdAtText}}</text>
      </view>
      <view class="row-actions act-admin-actions">
        <text data-id="{{item.id}}" bindtap="beginActivityEdit">编辑</text>
        <text data-id="{{item.id}}" bindtap="toggleActivity">{{item.status ? '下架' : '上架'}}</text>
        <text class="danger" data-id="{{item.id}}" bindtap="deleteActivity">删除</text>
      </view>
    </view>
    <view wx:if="{{!activities.length}}" class="empty">暂无活动</view>
  </view>

  <view wx:if="{{activeTab === 'userAdmin' && subTabs.userAdmin.length > 1}}" class="sub-tabs">
    <view wx:for="{{subTabs.userAdmin}}" wx:key="key" class="sub-tab {{activeSubTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchSubTab">{{item.name}}</view>
  </view>

  <view wx:if="{{activeTab === 'userAdmin' && activeSubTab === 'users'}}"><view class="toolbar"><input placeholder="搜索昵称、手机号或学号" value="{{userKeyword}}" bindinput="onUserKeyword" confirm-type="search" bindconfirm="searchUsers"/><text bindtap="searchUsers">搜索</text></view><view wx:for="{{users}}" wx:key="id" class="list-card compact-row"><view><text class="row-title">{{item.nickName || '未命名用户'}} #{{item.id}}</text><text class="row-sub">{{item.phone || '未绑定手机号'}} · {{item.role}} · {{item.status ? '正常' : '已禁用'}}</text><text class="cert-label-display" wx:if="{{item.certLabel}}">{{item.certLabel}}</text></view><view class="row-actions"><text data-id="{{item.id}}" bindtap="toggleUser">{{item.status ? '禁用' : '启用'}}</text><text data-id="{{item.id}}" bindtap="changeRole">角色</text><text data-id="{{item.id}}" data-certlabel="{{item.certLabel || ''}}" bindtap="editCertLabel">认证</text></view></view></view>

  <view wx:if="{{activeTab === 'userAdmin' && activeSubTab === 'admins'}}">
    <view class="section-head">
      <view class="section-title-inline">管理员账号（{{admins.length}}）</view>
      <button size="mini" class="primary-mini" bindtap="openAdminModal">新增管理员</button>
    </view>
    <view class="config-hint">管理员由已注册用户提升而来。调整角色、停用账号都会写入操作日志；系统始终保留至少一个启用的超级管理员，且不能停用或降级自己。</view>
    <view wx:for="{{admins}}" wx:key="id" class="list-card compact-row">
      <view class="admin-main">
        <text class="row-title">{{item.nickName || '未命名用户'}} #{{item.id}}<text wx:if="{{item.isSelf}}" class="self-tag">我</text></text>
        <text class="row-sub">{{roleLabels[item.role] || item.role}} · {{item.status ? '启用中' : '已停用'}} · {{item.phone || '未绑定手机号'}}</text>
        <text class="row-sub">权限：{{rolePermissionText[item.role] || '—'}}</text>
      </view>
      <view class="row-actions" wx:if="{{!item.isSelf}}">
        <text data-id="{{item.id}}" bindtap="changeAdminRole">调整角色</text>
        <text class="danger" data-id="{{item.id}}" bindtap="toggleAdmin">{{item.status ? '停用' : '启用'}}</text>
      </view>
      <view class="row-actions" wx:else><text class="row-sub">当前登录账号</text></view>
    </view>
    <view wx:if="{{!admins.length}}" class="empty">暂无管理员账号</view>
  </view>

  <view wx:if="{{activeTab === 'logs'}}">
    <view class="toolbar"><input placeholder="搜索标题、订单号或用户昵称" value="{{errandKeyword}}" bindinput="onErrandKeywordInput" confirm-type="search" bindconfirm="searchErrandOrders"/><text bindtap="searchErrandOrders">搜索</text></view>
    <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
      <view class="filter {{errandStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseErrandStatus">全部</view>
      <view class="filter {{errandStatus === 'pending' ? 'selected' : ''}}" data-status="pending" bindtap="chooseErrandStatus">待接单</view>
      <view class="filter {{errandStatus === 'accepted' ? 'selected' : ''}}" data-status="accepted" bindtap="chooseErrandStatus">进行中</view>
      <view class="filter {{errandStatus === 'finished' ? 'selected' : ''}}" data-status="finished" bindtap="chooseErrandStatus">已完成</view>
      <view class="filter {{errandStatus === 'cancelled' ? 'selected' : ''}}" data-status="cancelled" bindtap="chooseErrandStatus">已取消</view>
    </view></scroll-view>
    <view wx:for="{{errandOrders}}" wx:key="id" class="list-card errand-log-card" hover-class="errand-card-hover" data-id="{{item.id}}" bindtap="openErrandDetail">
      <view class="errand-log-head">
        <text class="row-title">#{{item.id}} {{item.title}}</text>
        <text class="errand-status st-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="errand-flow">{{item.flowText}}</text>
      <text class="row-sub">¥{{item.rewardText}} · {{item.paymentText || '未知支付状态'}}</text>
      <text class="row-sub" wx:if="{{item.lastDetailText}}">{{item.lastDetailText}} · {{item.lastAtText}}</text>
    </view>
    <view wx:if="{{!errandOrders.length}}" class="empty">暂无订单流程记录</view>
    <view class="logs-more" wx:if="{{errandHasMore}}"><button size="mini" class="plain-btn" loading="{{errandLoading}}" bindtap="loadMoreErrandOrders">加载更多</button></view>
    <view class="logs-more" wx:elif="{{errandOrders.length}}"><text class="row-sub">已加载全部 {{errandOrders.length}} 条记录</text></view>
  </view>

  <!-- 订单流程详情弹窗：双方用户信息 + 各节点时间 + 流程时间线 -->
  <view wx:if="{{errandDetail}}" class="form-mask" bindtap="closeErrandDetail">
    <view class="form-card" catchtap="noop">
      <view class="form-title">#{{errandDetail.id}} {{errandDetail.title}}</view>
      <view class="errand-detail-users">
        <view class="errand-user-col">
          <image wx:if="{{errandDetail.publisherAvatar}}" class="post-avatar" src="{{errandDetail.publisherAvatar}}" mode="aspectFill"/>
          <view wx:else class="post-avatar post-avatar-fallback">{{errandDetail.publisherName[0]}}</view>
          <text class="errand-user-name">发单：{{errandDetail.publisherName}}</text>
          <text class="errand-user-sub">{{errandDetail.publisherPhone}}</text>
        </view>
        <view class="errand-user-col">
          <image wx:if="{{errandDetail.acceptorAvatar}}" class="post-avatar" src="{{errandDetail.acceptorAvatar}}" mode="aspectFill"/>
          <view wx:elif="{{errandDetail.acceptorName}}" class="post-avatar post-avatar-fallback">{{errandDetail.acceptorName[0]}}</view>
          <view wx:else class="post-avatar post-avatar-fallback">?</view>
          <text class="errand-user-name">接单：{{errandDetail.acceptorName || '暂无人接单'}}</text>
          <text class="errand-user-sub" wx:if="{{errandDetail.acceptorName}}">{{errandDetail.acceptorPhone}}</text>
          <text class="errand-user-sub" wx:else>--</text>
        </view>
      </view>
      <view class="errand-detail-info">
        <text class="errand-info-row">状态：{{errandDetail.statusText}}<text wx:if="{{errandDetail.paymentText}}"> · {{errandDetail.paymentText}}</text> · 悬赏 ¥{{errandDetail.rewardText}}</text>
        <text class="errand-info-row">下单时间：{{errandDetail.createdAtText}}</text>
        <text class="errand-info-row">接单时间：{{errandDetail.acceptedAtText}}</text>
        <text class="errand-info-row">完成时间：{{errandDetail.finishedAtText}}</text>
        <text class="errand-info-row">取消时间：{{errandDetail.cancelledAtText}}</text>
      </view>
      <view class="errand-timeline">
        <view class="errand-timeline-title">订单流程</view>
        <view wx:for="{{errandDetail.logs}}" wx:key="id" class="errand-timeline-item">
          <view class="errand-timeline-dot"></view>
          <view class="errand-timeline-body">
            <text class="errand-timeline-text">{{item.text}}</text>
            <text class="errand-timeline-sub" wx:if="{{item.detail && item.detail !== item.text}}">{{item.detail}}</text>
            <text class="errand-timeline-time">{{item.timeText}}</text>
          </view>
        </view>
        <view wx:if="{{!errandDetail.logs.length}}" class="empty">暂无流程记录</view>
      </view>
      <view class="form-buttons"><button class="cancel-btn" bindtap="closeErrandDetail">关闭</button></view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'review' && subTabs.review.length > 1}}" class="sub-tabs">
    <view wx:for="{{subTabs.review}}" wx:key="key" class="sub-tab {{activeSubTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchSubTab">{{item.name}}</view>
  </view>

  <view wx:if="{{activeTab === 'review' && activeSubTab === 'withdrawals'}}"><view wx:for="{{withdrawals}}" wx:key="id" class="list-card compact-row"><view><text class="row-title">{{item.nickName || '用户'}} #{{item.userId}}</text><text class="row-sub">申请 ¥{{item.amount}} · 手机：{{item.phone || '未绑定'}} · {{item.createdAt}}</text></view><view class="row-actions"><text data-id="{{item.id}}" data-action="approve" bindtap="reviewWithdrawal">通过</text><text class="danger" data-id="{{item.id}}" data-action="reject" bindtap="reviewWithdrawal">驳回</text></view></view><view wx:if="{{!withdrawals.length}}" class="empty">暂无待审核提现</view></view>

  <view wx:if="{{activeTab === 'review' && activeSubTab === 'riderVerifications'}}">
    <view wx:for="{{riderVerifications}}" wx:key="id" class="list-card compact-row rider-verify-row">
      <view class="rider-verify-info">
        <text class="row-title">{{item.nickName || '用户'}} #{{item.userId}}</text>
        <text class="row-sub">姓名：{{item.realName}} · 学号：{{item.studentId}}</text>
        <text class="row-sub">身份证：{{item.identityNumber}} · 手机：{{item.phone || '未绑定'}}</text>
        <text class="row-sub">提交时间：{{item.createdAt}}</text>
        <view class="rider-verify-images" wx:if="{{item.campusCredential || item.identityCredential}}">
          <image wx:if="{{item.campusCredential}}" class="verify-img" src="{{item.campusCredential}}" mode="aspectFill" data-src="{{item.campusCredential}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"></image>
          <image wx:if="{{item.identityCredential}}" class="verify-img" src="{{item.identityCredential}}" mode="aspectFill" data-src="{{item.identityCredential}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"></image>
        </view>
        <text class="verify-status status-{{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已通过' : '已驳回'}}</text>
        <text class="row-sub" wx:if="{{item.reviewNote}}">审核备注：{{item.reviewNote}}</text>
      </view>
      <view class="row-actions" wx:if="{{item.status === 'pending'}}">
        <text data-id="{{item.id}}" data-action="approve" bindtap="reviewRiderVerification">通过</text>
        <text class="danger" data-id="{{item.id}}" data-action="reject" bindtap="reviewRiderVerification">驳回</text>
      </view>
    </view>
    <view wx:if="{{!riderVerifications.length}}" class="empty">暂无认证申请</view>
  </view>

  <view wx:if="{{form}}" class="form-mask">
    <view class="form-card">
      <view class="form-title">{{form.kind === 'post' ? '编辑帖子' : form.kind === 'content' ? (form.id ? '编辑' : '新增') + contentFormTitle : form.kind === 'chatReview' ? (form.action === 'approve' ? '通过建群申请' : '驳回建群申请') : form.kind === 'clubCategory' ? (form.id ? '编辑社团分类' : '新增社团分类') : form.kind === 'club' ? (form.id ? '编辑社团' : '添加社团') : form.kind === 'chatGroup' ? (form.id ? '编辑群聊' : '添加群聊') : form.kind === 'activity' ? '编辑活动' : '虚拟物品'}}</view>

      <block wx:if="{{form.kind === 'content'}}">
        <view class="form-guide">{{contentFormGuide}}</view>
        <block wx:if="{{form.type === 'notice'}}">
          <view class="form-item">
            <view class="form-label">公告文字 <text class="form-req">*</text>（展示在首页顶部公告栏）</view>
            <input data-key="title" value="{{form.title}}" maxlength="60" placeholder="例如：如果你在使用中遇到问题，请联系我们" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">右侧链接文字（显示在公告最右侧，默认"点此查看"）</view>
            <input data-key="meta.linkText" value="{{form.meta.linkText}}" maxlength="12" placeholder="例如：点此查看" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">跳转页面路径（用户点击右侧链接后跳转到该页面；留空则弹出管理员微信二维码）</view>
            <input data-key="meta.linkUrl" value="{{form.meta.linkUrl}}" maxlength="100" placeholder="例如：/pages/service-all/index" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">链接图片（可选；作为公告链接及各页面"添加管理员微信"弹窗展示的图片，建议上传方形二维码图）</view>
            <view class="upload-row" bindtap="chooseFormImage" data-key="tailImage">
              <image class="upload-thumb" wx:if="{{form.meta.tailImage}}" src="{{form.meta.tailImage}}" mode="aspectFill"></image>
              <view wx:else class="upload-add">＋ 上传链接图片</view>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">背景颜色（可选；点击弹出颜色选择器，自定义首页公告栏背景）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
              <view class="color-swatch" style="background: {{form.meta.bgColor || '#fffade'}};"></view>
              <text class="color-value">{{form.meta.bgColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">文字颜色（可选；公告文字与右侧链接将使用该颜色）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
              <view class="color-swatch" style="background: {{form.meta.textColor || '#646566'}};"></view>
              <text class="color-value">{{form.meta.textColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">实时预览（保存后首页公告栏按此效果展示）</view>
            <view class="notice-preview" style="background: {{form.meta.bgColor || '#fffade'}}; color: {{form.meta.textColor || '#646566'}};">
              <text class="notice-preview-text">{{form.title || '公告文字预览效果'}}</text>
              <text class="notice-preview-link">{{form.meta.linkText || '点此查看'}}</text>
              <text class="notice-preview-tail" wx:if="{{form.meta.tailText}}">{{form.meta.tailText}}</text>
            </view>
          </view>
        </block>
        <block wx:elif="{{form.type === 'tag'}}">
          <view class="form-item">
            <view class="form-label">标签名称 <text class="form-req">*</text>（启用后展示在发帖页标签选项中）</view>
            <input data-key="title" value="{{form.title}}" maxlength="20" placeholder="例如：二手好物" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">描述正文（可选，可留空）</view>
            <textarea data-key="body" value="{{form.body}}" placeholder="标签的补充说明，可留空" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">背景颜色（可选；点击弹出颜色选择器，配置列表将按此颜色展示标签）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
              <view class="color-swatch" style="background: {{form.meta.bgColor || '#eef4ff'}};"></view>
              <text class="color-value">{{form.meta.bgColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">文字颜色（可选；点击弹出颜色选择器）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
              <view class="color-swatch" style="background: {{form.meta.textColor || '#4a6b9c'}};"></view>
              <text class="color-value">{{form.meta.textColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">实时预览（保存后配置列表中的标签按此效果展示）</view>
            <view class="tag-chip-preview" style="background: {{form.meta.bgColor || '#eef4ff'}}; color: {{form.meta.textColor || '#4a6b9c'}};">{{form.title || '标签预览'}}</view>
          </view>
        </block>
        <block wx:elif="{{form.type === 'banner'}}">
          <view class="form-item">
            <view class="form-label">主标题 <text class="form-req">*</text>（展示在首页轮播图上）</view>
            <input data-key="title" value="{{form.title}}" maxlength="30" placeholder="例如：AI 课表助手" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">轮播图片 <text class="form-req">*</text>（建议宽高比 16:9，点击图片可更换）</view>
            <view class="upload-row" bindtap="chooseFormImage" data-key="image">
              <image class="upload-thumb" wx:if="{{form.meta.image}}" src="{{form.meta.image}}" mode="aspectFill"></image>
              <view wx:else class="upload-add">＋ 上传轮播图片</view>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">内容描述（可选）</view>
            <input data-key="meta.subtitle" value="{{form.meta.subtitle}}" maxlength="40" placeholder="例如：上传课表截图，自动拆解课程" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">角标（可选，展示在轮播图角落）</view>
            <input data-key="meta.tag" value="{{form.meta.tag}}" maxlength="10" placeholder="例如：课表助手" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">点击跳转路径（可选；小程序内部页面填 /pages/... 路径）</view>
            <input data-key="meta.link" value="{{form.meta.link}}" placeholder="例如：/pages/schedule/index" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">主题色（可选；点击弹出颜色选择器，展示在轮播图左上角色条）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="accent">
              <view class="color-swatch" style="background: {{form.meta.accent || '#4A7AFF'}};"></view>
              <text class="color-value">{{form.meta.accent || '使用默认主题色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">实时预览（保存后首页轮播按此主题色展示）</view>
            <view class="banner-accent-preview">
              <view class="banner-accent-strip" style="background: {{form.meta.accent || '#4A7AFF'}};"></view>
              <view class="banner-accent-main">
                <text class="banner-accent-tag" wx:if="{{form.meta.tag}}">{{form.meta.tag}}</text>
                <text class="banner-accent-title">{{form.title || '主标题预览'}}</text>
                <text class="banner-accent-sub" wx:if="{{form.meta.subtitle}}">{{form.meta.subtitle}}</text>
              </view>
            </view>
          </view>
        </block>
        <block wx:elif="{{form.type === 'publish_banner'}}">
          <view class="form-item">
            <view class="form-label">横幅文字 <text class="form-req">*</text>（展示在「发布帖子」「发布跑腿」页顶部）</view>
            <input data-key="title" value="{{form.title}}" maxlength="40" placeholder="例如：禁止引导私下交易，违规封禁！" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">预设配色（未设置自定义颜色时生效）</view>
            <picker mode="selector" range="{{styleNames}}" value="{{form.meta.styleIndex}}" bindchange="onFormStyleChange">
              <view class="picker-row"><text>颜色</text><text class="picker-value">{{styleNames[form.meta.styleIndex]}} ›</text></view>
            </picker>
          </view>
          <view class="form-item">
            <view class="form-label">背景颜色（可选；点击弹出颜色选择器，设置后优先于预设配色）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
              <view class="color-swatch" style="background: {{form.meta.bgColor || '#f0f2f5'}};"></view>
              <text class="color-value">{{form.meta.bgColor || '跟随预设配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">文字颜色（可选；点击弹出颜色选择器）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
              <view class="color-swatch" style="background: {{form.meta.textColor || '#f0f2f5'}};"></view>
              <text class="color-value">{{form.meta.textColor || '跟随预设配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">实时预览（保存后在发布页顶部按此效果展示）</view>
            <view class="banner-preview" style="background: {{form.meta.bgColor || styleBg[form.meta.style]}}; color: {{form.meta.textColor || styleFg[form.meta.style]}};">
              <text class="banner-preview-icon" wx:if="{{form.meta.icon}}">{{form.meta.icon}}</text>
              <text class="banner-preview-text">{{form.title || '横幅文字预览效果'}}</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">小图标（emoji，可选，展示在横幅文字前）</view>
            <input data-key="meta.icon" value="{{form.meta.icon}}" maxlength="4" placeholder="例如：🚫 或 ⚠️" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">跳转链接（可选；用户点击横幅后跳转，填 /pages/... 页面路径或 https 网页；留空则跳转横幅详情页）</view>
            <input data-key="meta.link" value="{{form.meta.link}}" maxlength="200" placeholder="例如：/pages/service-all/index" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">链接文字（可选；详情页底部相关链接的显示文字）</view>
            <input data-key="meta.linkText" value="{{form.meta.linkText}}" maxlength="20" placeholder="例如：查看详情" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">详情标题（可选；横幅详情页大标题）</view>
            <input data-key="meta.detailTitle" value="{{form.meta.detailTitle}}" maxlength="60" placeholder="例如：规范发帖公告" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">详情内容（可选；横幅详情页正文，换行分段）</view>
            <textarea data-key="meta.detailContent" value="{{form.meta.detailContent}}" maxlength="2000" placeholder="向用户详细说明横幅内容…" bindinput="formInput"/>
          </view>
        </block>
        <view class="form-item">
          <view class="form-label">排序（数字越小越靠前）</view>
          <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'chatReview'}}">
        <view class="form-guide">申请群名：{{form.applyName}}（仅支持微信群）</view>
        <view class="form-item">
          <view class="form-label">审核意见{{form.action === 'reject' ? '（驳回必填，用户端可见）' : '（选填）'}}</view>
          <textarea data-key="reviewNote" value="{{form.reviewNote}}" maxlength="200" placeholder="例如：群二维码已过期，请补充有效二维码后再提交" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'clubCategory'}}">
        <view class="form-item">
          <view class="form-label">分类名称 <text class="form-req">*</text>（展示在社团&组织页卡片）</view>
          <input data-key="name" value="{{form.name}}" maxlength="20" placeholder="例如：艺术类" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">图标字符（单字，展示在分类卡片的彩色图标上）</view>
          <input data-key="iconChar" value="{{form.iconChar}}" maxlength="2" placeholder="例如：艺" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">副标语（卡片第二行文字）</view>
          <input data-key="slogan" value="{{form.slogan}}" maxlength="30" placeholder="例如：捕捉灵感，创造无限之美" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">主题色（前端按此颜色自动生成渐变、浅色底与阴影）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="color">
            <view class="color-swatch" style="background: {{form.meta.color || '#2E6BFF'}};"></view>
            <text class="color-value">{{form.meta.color || '选择主题色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">分类定位介绍（详情页第一板块）</view>
          <textarea data-key="position" value="{{form.position}}" maxlength="1000" placeholder="介绍该分类的定位与整体情况…" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">涵盖范围介绍</view>
          <input data-key="scopeIntro" value="{{form.scopeIntro}}" maxlength="200" placeholder="对涵盖范围的整体说明" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">涵盖范围（用顿号或逗号分隔）</view>
          <textarea data-key="scopeText" value="{{form.scopeText}}" maxlength="500" placeholder="例如：街舞社、民乐团、吉他社、合唱团" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">特色说明（每行一条，格式：标题|描述）</view>
          <textarea data-key="featuresText" value="{{form.featuresText}}" maxlength="2000" placeholder="例如：舞台实践|每年承办迎新晚会、校园十佳歌手大赛等大型演出" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">加入咨询文案（详情页底部展示，可复制）</view>
          <input data-key="contact" value="{{form.contact}}" maxlength="100" placeholder="例如：艺术类招新咨询：大学生社团联合会" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">排序（数字越小越靠前）</view>
          <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'club'}}">
        <view class="form-item">
          <view class="form-label">所属分类</view>
          <picker mode="selector" range="{{clubCategoryNames}}" value="{{form.categoryIndex}}" bindchange="onClubCategoryChange">
            <view class="picker-row"><text>分类</text><text class="picker-value">{{clubCategoryNames[form.categoryIndex] || '请选择'}} ›</text></view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">所属校区（用户端按校区筛选展示；「全部校区」在所有校区可见）</view>
          <view class="campus-grid">
            <view wx:for="{{campusOptions}}" wx:key="value" class="campus-option {{form.campus === item.value ? 'campus-option--active' : ''}}" data-value="{{item.value}}" bindtap="onFormCampus">{{item.label}}</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">社团名称 <text class="form-req">*</text></view>
          <input data-key="name" value="{{form.name}}" maxlength="30" placeholder="例如：街舞社" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">标签（用 · 分隔）</view>
          <input data-key="tags" value="{{form.tags}}" maxlength="60" placeholder="例如：舞蹈 · 演出 · 斗舞赛" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">社团简介</view>
          <textarea data-key="intro" value="{{form.intro}}" maxlength="500" placeholder="社团详细介绍…" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">招新说明</view>
          <input data-key="recruit" value="{{form.recruit}}" maxlength="120" placeholder="例如：每年 9 月招新，零基础可加入训练营" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">排序（数字越小越靠前）</view>
          <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'chatGroup'}}">
        <view class="form-item">
          <view class="form-label">群聊名称 <text class="form-req">*</text></view>
          <input data-key="name" value="{{form.name}}" maxlength="30" placeholder="例如：2026 级新生交流群" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">群类别</view>
          <picker mode="selector" range="{{chatCategoryNames}}" value="{{form.categoryIndex}}" bindchange="onChatCategoryChange">
            <view class="picker-row"><text>类别</text><text class="picker-value">{{chatCategoryNames[form.categoryIndex]}} ›</text></view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">所属校区（用户端按校区筛选展示；「全部校区」在所有校区可见）</view>
          <view class="campus-grid">
            <view wx:for="{{campusOptions}}" wx:key="value" class="campus-option {{form.campus === item.value ? 'campus-option--active' : ''}}" data-value="{{item.value}}" bindtap="onFormCampus">{{item.label}}</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">群介绍（展示在用户端群聊列表）</view>
          <textarea data-key="intro" value="{{form.intro}}" maxlength="300" placeholder="群简介…" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">群头像</view>
          <view class="upload-row" bindtap="chooseFormImage" data-key="avatarUrl">
            <image class="upload-thumb" wx:if="{{form.meta.avatarUrl}}" src="{{form.meta.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="upload-add">＋ 上传群头像</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">群二维码（用户端点击群聊卡片后弹出展示）</view>
          <view class="upload-row" bindtap="chooseFormImage" data-key="qrcodeUrl">
            <image class="upload-thumb" wx:if="{{form.meta.qrcodeUrl}}" src="{{form.meta.qrcodeUrl}}" mode="aspectFill"></image>
            <view wx:else class="upload-add">＋ 上传群二维码</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">公众号二维码（用户端群详情「群管理」卡展示，选填）</view>
          <view class="upload-row" bindtap="chooseFormImage" data-key="gzhQrcodeUrl">
            <image class="upload-thumb" wx:if="{{form.meta.gzhQrcodeUrl}}" src="{{form.meta.gzhQrcodeUrl}}" mode="aspectFill"></image>
            <view wx:else class="upload-add">＋ 上传公众号二维码</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">排序（数字越小越靠前）</view>
          <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
        </view>
        <label class="switch-row"><text>官方群标记（用户端群名右侧展示黑色「官方」徽标）</text><switch checked="{{form.isOfficial}}" color="#315CFF" bindchange="formOfficial"/></label>
        <view class="form-item">
          <view class="form-label">自定义标签（除「官方」外可手动输入并添加，展示在群名右侧，如：合作、福利）</view>
          <view class="tag-input-row">
            <input class="tag-input" data-key="customTag" value="{{form.customTag}}" maxlength="8" placeholder="输入自定义标签，可留空" bindinput="formInput"/>
            <view wx:if="{{form.customTag}}" class="custom-tag">{{form.customTag}}</view>
          </view>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'activity'}}">
        <view class="form-item">
          <view class="form-label">活动标题 <text class="form-req">*</text></view>
          <input data-key="title" value="{{form.title}}" maxlength="40" placeholder="活动标题" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">报名时间（格式 YYYY-MM-DD HH:mm，留空为不限制）</view>
          <input data-key="signupStart" value="{{form.signupStart}}" placeholder="报名开始，例如 2026-09-12 09:00" bindinput="formInput"/>
          <input data-key="signupEnd" value="{{form.signupEnd}}" placeholder="报名截止，例如 2026-09-20 18:00" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">活动时间（格式同上）</view>
          <input data-key="activityStart" value="{{form.activityStart}}" placeholder="活动开始" bindinput="formInput"/>
          <input data-key="activityEnd" value="{{form.activityEnd}}" placeholder="活动结束" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">活动位置</view>
          <input data-key="location" value="{{form.location}}" maxlength="30" placeholder="例如：体育馆" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">详细地址</view>
          <input data-key="address" value="{{form.address}}" maxlength="60" placeholder="详细地址（选填）" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">所属校区（全部校区 = 所有校区可见）</view>
          <view class="campus-grid">
            <view wx:for="{{campusOptions}}" wx:key="value" class="campus-option {{form.campus === item.value ? 'campus-option--active' : ''}}" data-value="{{item.value}}" bindtap="onFormCampus">{{item.label}}</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">报名名额（0 或留空为不限）</view>
          <input data-key="capacity" value="{{form.capacity}}" type="number" placeholder="0" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">封面图片</view>
          <view class="upload-row" bindtap="chooseFormImage" data-key="coverUrl">
            <image class="upload-thumb" wx:if="{{form.meta.coverUrl}}" src="{{form.meta.coverUrl}}" mode="aspectFill"></image>
            <view wx:else class="upload-add">＋ 上传封面图片</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">介绍标题</view>
          <input data-key="detailTitle" value="{{form.detailTitle}}" maxlength="30" placeholder="详细介绍标题（选填）" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">介绍内容</view>
          <textarea data-key="detailContent" value="{{form.detailContent}}" maxlength="2000" placeholder="活动流程、注意事项等…" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">报名按钮标题</view>
          <input data-key="signupTitle" value="{{form.signupTitle}}" maxlength="8" placeholder="默认「立即报名」" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">报名提示内容</view>
          <textarea data-key="signupContent" value="{{form.signupContent}}" maxlength="200" placeholder="报名成功后向参与者展示的提示（选填）" bindinput="formInput"/>
        </view>
      </block>

      <block wx:elif="{{form.kind === 'post'}}">
        <view class="form-item">
          <view class="form-label">帖子标题</view>
          <input data-key="title" value="{{form.title}}" placeholder="标题" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">分类</view>
          <input data-key="category" value="{{form.category}}" placeholder="分类" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">正文</view>
          <textarea data-key="content" value="{{form.content}}" placeholder="正文" bindinput="formInput"/>
        </view>
      </block>

      <block wx:else>
        <view class="form-item">
          <view class="form-label">物品名称</view>
          <input data-key="name" value="{{form.name}}" placeholder="物品名称" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">价格（元）</view>
          <input data-key="price" value="{{form.price}}" type="digit" placeholder="价格" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">库存</view>
          <input data-key="stock" value="{{form.stock}}" type="number" placeholder="库存" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">封面地址（可选）</view>
          <input data-key="coverUrl" value="{{form.coverUrl}}" placeholder="封面地址（可选）" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">物品说明</view>
          <textarea data-key="description" value="{{form.description}}" placeholder="物品说明" bindinput="formInput"/>
        </view>
      </block>

      <label class="switch-row" wx:if="{{form.kind !== 'chatReview'}}"><text>启用状态（关闭即对用户下线）</text><switch checked="{{form.status}}" color="#315CFF" bindchange="formStatus"/></label>
      <view class="form-buttons" wx:if="{{form.kind !== 'chatReview'}}"><button class="cancel-btn" bindtap="closeForm">取消</button><button class="save-btn" loading="{{saving}}" bindtap="saveForm">保存并发布</button></view>
      <view class="form-buttons" wx:else><button class="cancel-btn" bindtap="closeForm">取消</button><button class="save-btn" loading="{{saving}}" bindtap="saveForm">{{form.action === 'approve' ? '确认通过' : '确认驳回'}}</button></view>
    </view>
  </view>

  <color-picker show="{{colorPickerShow}}" value="{{colorPickerValue}}" title="{{colorPickerTitle}}" bind:close="onColorPickerClose" bind:confirm="onColorPickerConfirm" />

  <view wx:if="{{showCertModal}}" class="form-mask" bindtap="closeCertModal"><view class="form-card" catchtap="noop"><view class="form-title">编辑认证信息</view><input value="{{certDraft}}" placeholder="输入认证标签，留空则清除" maxlength="32" bindinput="onCertInput"/><view class="form-buttons"><button class="cancel-btn" bindtap="closeCertModal">取消</button><button class="save-btn" loading="{{savingCert}}" bindtap="saveCertLabel">保存</button></view></view></view>

  <view wx:if="{{showAdminModal}}" class="form-mask" bindtap="closeAdminModal"><view class="form-card" catchtap="noop"><view class="form-title">新增管理员</view><text class="form-hint">输入已有用户的 ID / 手机号 / 学号，将其提升为管理员。若匹配到多个用户，请改用用户 ID。</text><input value="{{adminQuery}}" placeholder="用户 ID / 手机号 / 学号" bindinput="onAdminQueryInput"/><picker mode="selector" range="{{adminRoleNames}}" value="{{adminRoleIndex}}" bindchange="onAdminRoleChange"><view class="picker-row"><text>角色</text><text class="picker-value">{{adminRoleNames[adminRoleIndex]}} ›</text></view></picker><view class="form-buttons"><button class="cancel-btn" bindtap="closeAdminModal">取消</button><button class="save-btn" loading="{{adminSaving}}" bindtap="submitAdminCreate">确认添加</button></view></view></view>
</view>
