        <view class="club-admin-main">
          <text class="row-title">{{item.name}}<text wx:if="{{!item.status}}" class="chat-apply-status cs-rejected">已停用</text></text>
          <text class="row-sub">社团 {{item.clubTotal}} 个（启用 {{item.clubEnabled}}） · 排序 {{item.sortOrder}}</text>
        </view>
        <text class="club-admin-arrow">{{expandedClubCategory === item.id ? '收起 ▲' : '展开 ▼'}}</text>
      </view>
      <view wx:if="{{expandedClubCategory === item.id}}" class="club-admin-body">
        <text class="row-sub club-admin-slogan">{{item.slogan}}</text>
        <view class="row-actions club-admin-actions">
          <text data-id="{{item.id}}" bindtap="beginClubCategoryEdit">编辑分类</text>
          <text data-id="{{item.id}}" data-name="{{item.name}}" bindtap="beginClubCreate">+ 添加社团</text>
          <text class="danger" data-id="{{item.id}}" bindtap="deleteClubCategory">删除分类</text>
        </view>
        <view wx:for="{{item.clubs}}" wx:for-item="club" wx:key="id" class="club-admin-club anim-stagger" style="--i: {{index < 6 ? index : 0}};">
          <view class="club-admin-club-main">
            <text class="club-admin-club-name">{{club.name}}<text wx:if="{{!club.status}}" class="club-admin-off">（已下架）</text></text>
            <text class="row-sub">{{club.campus || '全部校区'}}<text wx:if="{{club.tags}}"> · {{club.tags}}</text></text>
          </view>
          <view class="row-actions">
            <text data-id="{{club.id}}" bindtap="beginClubEdit">编辑</text>
            <text data-id="{{club.id}}" bindtap="toggleClub">{{club.status ? '下架' : '上架'}}</text>
            <text class="danger" data-id="{{club.id}}" bindtap="deleteClub">删除</text>
          </view>
        </view>
        <view wx:if="{{!item.clubs.length}}" class="empty">该分类下暂无社团</view>
      </view>
    </view>
    <view wx:if="{{!clubCategories.length}}" class="empty">暂无社团分类</view>
    </block>
    </block>

    <!-- ===== 社团审核：用户端「申请创建社团」提交的申请 ===== -->
    <block wx:else>
      <view class="section-head"><text class="section-title-inline">社团审核（{{clubApplies.length}}）</text></view>
      <view class="config-hint">用户在小程序「社团&组织」页提交的社团申请在此审核；通过后该社团立即出现在用户端所选分类下（下拉刷新即可看到），驳回时用户可在「我的社团申请」看到审核意见。审核操作均写入后台日志。</view>
      <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
        <view class="filter {{clubApplyStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseClubApplyStatus">全部</view>
        <view class="filter {{clubApplyStatus === 'pending' ? 'selected' : ''}}" data-status="pending" bindtap="chooseClubApplyStatus">待审核</view>
        <view class="filter {{clubApplyStatus === 'approved' ? 'selected' : ''}}" data-status="approved" bindtap="chooseClubApplyStatus">已通过</view>
        <view class="filter {{clubApplyStatus === 'rejected' ? 'selected' : ''}}" data-status="rejected" bindtap="chooseClubApplyStatus">已驳回</view>
      </view></scroll-view>
      <view wx:for="{{clubApplies}}" wx:key="id" class="list-card compact-row club-audit-row anim-stagger" style="--i: {{index < 6 ? index : 0}};">
        <view class="club-audit-main">
          <text class="row-title">{{item.name}}<text class="chat-apply-status cs-{{item.status}}">{{item.statusText}}</text></text>
          <text class="row-sub">分类：{{item.categoryName || '未分类'}} · 校区：{{item.campus || '全部校区'}} · {{item.clubType || '学生社团'}}</text>
          <view class="act-initiator">
            <image wx:if="{{item.creatorAvatar}}" class="act-initiator-avatar" src="{{item.creatorAvatar}}" mode="aspectFill"/>
            <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{item.creatorChar}}</view>
            <view class="act-initiator-info">
              <text class="act-initiator-name">{{item.nickName || '未知用户'}} #{{item.userId}}</text>
              <text class="row-sub">{{item.creatorPhone || '未绑定手机号'}}</text>
            </view>
          </view>
          <text class="row-sub">申请于 {{item.createdAtText}}<text wx:if="{{item.reviewedAtText}}"> · 审核于 {{item.reviewedAtText}}</text></text>
          <text class="row-sub" wx:if="{{item.reviewNote}}">审核意见：{{item.reviewNote}}</text>
        </view>
        <view class="row-actions act-admin-actions">
          <text data-id="{{item.id}}" bindtap="viewClubApply">详情</text>
          <text wx:if="{{item.status !== 'approved'}}" data-id="{{item.id}}" data-action="approve" bindtap="openClubReview">通过</text>
          <text wx:if="{{item.status !== 'rejected'}}" class="danger" data-id="{{item.id}}" data-action="reject" bindtap="openClubReview">驳回</text>
        </view>
      </view>
      <view wx:if="{{!clubApplies.length}}" class="empty">暂无社团申请</view>
    </block>

    <!-- 社团审核详情弹窗：申请人头像、昵称、手机号等个人信息 + 全部申请材料 -->
    <view wx:if="{{clubAuditDetail}}" class="form-mask" bindtap="closeClubApplyDetail">
      <view class="form-card" catchtap="noop">
        <view class="form-title">社团申请详情<text class="chat-apply-status cs-{{clubAuditDetail.status}}">{{clubAuditDetail.statusText}}</text></view>
        <view class="form-item">
          <view class="form-label">{{clubAuditDetail.name}}（{{clubAuditDetail.clubType || '学生社团'}}）</view>
          <text class="audit-detail-line">所属分类：{{clubAuditDetail.categoryName || '未分类'}} · 校区：{{clubAuditDetail.campus || '全部校区'}}</text>
          <text class="audit-detail-line">申请时间：{{clubAuditDetail.createdAtText}}</text>
          <text class="audit-detail-line" wx:if="{{clubAuditDetail.reviewedAtText}}">审核时间：{{clubAuditDetail.reviewedAtText}}</text>
        </view>
        <view class="form-item">
          <view class="form-label">申请人</view>
          <view class="act-initiator">
            <image wx:if="{{clubAuditDetail.creatorAvatar}}" class="act-initiator-avatar" src="{{clubAuditDetail.creatorAvatar}}" mode="aspectFill"/>
            <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{clubAuditDetail.creatorChar}}</view>
            <view class="act-initiator-info">
              <text class="act-initiator-name">{{clubAuditDetail.nickName || '未知用户'}} #{{clubAuditDetail.userId}}</text>
              <text class="row-sub">{{clubAuditDetail.creatorPhone || '未绑定手机号'}}<text> · 点击手机号可复制</text></text>
            </view>
            <text wx:if="{{clubAuditDetail.creatorPhone}}" class="act-detail-btn" data-phone="{{clubAuditDetail.creatorPhone}}" bindtap="copySignupPhone">复制手机号</text>
          </view>
        </view>
        <view class="form-item" wx:if="{{clubAuditDetail.intro}}">
          <view class="form-label">社团介绍</view>
          <!-- 用户申请页填的是纯文本，但审核时可能已是后台用标记语法写过的内容（同一字段被两条写入链共用），
               统一走 richtext-content 渲染：纯文本原样显示，带标记的按格式显示，不把 ** / ## 漏给审核人 -->
          <richtext-content class="audit-detail-rich" content="{{clubAuditDetail.intro}}" selectable></richtext-content>
        </view>
        <view class="form-item" wx:if="{{clubAuditDetail.avatarUrl || clubAuditDetail.qrcodeUrl || clubAuditDetail.adminQrcodeUrl || clubAuditDetail.gzhQrcodeUrl}}">
          <view class="form-label">社团头像 / 社团二维码 / 负责人微信 / 公众号</view>
          <view class="rider-verify-images">
            <image wx:if="{{clubAuditDetail.avatarUrl}}" class="verify-img" src="{{clubAuditDetail.avatarUrl}}" mode="aspectFill" data-url="{{clubAuditDetail.avatarUrl}}" bindtap="previewClubApplyImg"/>
            <image wx:if="{{clubAuditDetail.qrcodeUrl}}" class="verify-img" src="{{clubAuditDetail.qrcodeUrl}}" mode="aspectFill" data-url="{{clubAuditDetail.qrcodeUrl}}" bindtap="previewClubApplyImg" bindlongpress="onImageQrScan" data-src="{{clubAuditDetail.qrcodeUrl}}"/>
            <image wx:if="{{clubAuditDetail.adminQrcodeUrl}}" class="verify-img" src="{{clubAuditDetail.adminQrcodeUrl}}" mode="aspectFill" data-url="{{clubAuditDetail.adminQrcodeUrl}}" bindtap="previewClubApplyImg" bindlongpress="onImageQrScan" data-src="{{clubAuditDetail.adminQrcodeUrl}}"/>
            <image wx:if="{{clubAuditDetail.gzhQrcodeUrl}}" class="verify-img" src="{{clubAuditDetail.gzhQrcodeUrl}}" mode="aspectFill" data-url="{{clubAuditDetail.gzhQrcodeUrl}}" bindtap="previewClubApplyImg" bindlongpress="onImageQrScan" data-src="{{clubAuditDetail.gzhQrcodeUrl}}"/>
          </view>
        </view>
        <view class="form-item" wx:if="{{clubAuditDetail.images.length}}">
          <view class="form-label">图片介绍</view>
          <view class="rider-verify-images">
            <image wx:for="{{clubAuditDetail.images}}" wx:key="index" class="verify-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewClubApplyImg"/>
          </view>
        </view>
        <view class="form-item" wx:if="{{clubAuditDetail.reviewNote}}">
          <view class="form-label">审核意见</view>
          <text class="audit-detail-line">{{clubAuditDetail.reviewNote}}</text>
        </view>
        <view class="form-actions">
          <button hover-class="press-spring" size="mini" class="plain-btn spring-btn" bindtap="closeClubApplyDetail" hover-stay-time="120">关闭</button>
          <button hover-class="press-spring" wx:if="{{clubAuditDetail.status !== 'approved'}}" size="mini" class="primary-mini spring-btn" data-id="{{clubAuditDetail.id}}" data-action="approve" bindtap="openClubReview" hover-stay-time="120">通过</button>
          <button hover-class="press-spring" wx:if="{{clubAuditDetail.status !== 'rejected'}}" size="mini" class="danger-mini spring-btn" data-id="{{clubAuditDetail.id}}" data-action="reject" bindtap="openClubReview" hover-stay-time="120">驳回</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'activities'}}">
    <view class="toolbar"><input placeholder="搜索活动标题、位置或发起人" value="{{activityKeyword}}" bindinput="onActivityKeywordInput" confirm-type="search" bindconfirm="searchActivities"/><text bindtap="searchActivities">搜索</text></view>
    <view class="config-hint">用户在小程序「校园活动」页发布的活动在此统一管理；下架后用户端立即不可见，删除为软删除（数据保留）。</view>
    <view wx:for="{{activities}}" wx:key="id" class="list-card act-admin-row anim-stagger" style="--i: {{index < 6 ? index : 0}};">
      <image wx:if="{{item.coverUrl}}" class="act-admin-cover" src="{{item.coverUrl}}" mode="aspectFill"/>
      <view wx:else class="act-admin-cover act-admin-cover--fallback"><text>活动</text></view>
      <view class="act-admin-main">
        <text class="row-title">{{item.title}}<text wx:if="{{item.badgeText}}" class="chat-apply-status cs-{{item.badge === 'signing' ? 'approved' : item.badge === 'notStarted' ? 'pending' : 'rejected'}}">{{item.badgeText}}</text><text wx:if="{{!item.status}}" class="chat-apply-status cs-rejected">已下架</text></text>
        <text class="row-sub">校区：{{item.campus || '全部校区'}} · 已报名 {{item.signupCount}} 人{{item.capacity > 0 ? ' · 名额 ' + item.capacity : ' · 名额不限'}}</text>
        <text class="row-sub">活动时间：{{item.activityStart || '未设置'}}</text>
        <view class="act-initiator">
          <image wx:if="{{item.initiator.avatarUrl}}" class="act-initiator-avatar" src="{{item.initiator.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{item.initiator.nickName ? item.initiator.nickName[0] : '友'}}</view>
          <view class="act-initiator-info">
            <text class="act-initiator-name">{{item.initiator.nickName || '未命名用户'}} #{{item.initiator.userId}}</text>
            <text class="row-sub">{{item.initiator.phone || '未绑定手机号'}}</text>
          </view>
        </view>
        <text class="row-sub">发布于 {{item.createdAtText}}</text>
      </view>
      <view class="row-actions act-admin-actions">
        <text class="act-detail-btn" data-id="{{item.id}}" bindtap="openActivitySignups">活动详情</text>
        <text data-id="{{item.id}}" bindtap="beginActivityEdit">编辑</text>
        <text data-id="{{item.id}}" bindtap="toggleActivity">{{item.status ? '下架' : '上架'}}</text>
        <text class="danger" data-id="{{item.id}}" bindtap="deleteActivity">删除</text>
      </view>
    </view>
    <view wx:if="{{!activities.length}}" class="empty">暂无活动</view>
  </view>

  <view wx:if="{{activeTab === 'userAdmin' && subTabs.userAdmin.length > 1}}" class="sub-tabs">
    <view wx:for="{{subTabs.userAdmin}}" wx:key="key" class="sub-tab {{activeSubTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchSubTab">{{item.name}}</view>
  </view>

  <view wx:if="{{activeTab === 'userAdmin' && activeSubTab === 'users'}}"><view class="toolbar"><input placeholder="搜索昵称、手机号或学号" value="{{userKeyword}}" bindinput="onUserKeyword" confirm-type="search" bindconfirm="searchUsers"/><text bindtap="searchUsers">搜索</text></view><view wx:for="{{users}}" wx:key="id" class="list-card compact-row anim-stagger" style="--i: {{index < 6 ? index : 0}};"><view><text class="row-title">{{item.nickName || '未命名用户'}} #{{item.id}}</text><text class="row-sub">{{item.phone || '未绑定手机号'}} · {{item.role}} · {{item.status ? '正常' : '已禁用'}}</text><text class="cert-label-display" wx:if="{{item.certLabel}}">{{item.certLabel}}</text></view><view class="row-actions"><text data-id="{{item.id}}" bindtap="toggleUser">{{item.status ? '禁用' : '启用'}}</text><text data-id="{{item.id}}" bindtap="changeRole">角色</text><text data-id="{{item.id}}" data-certlabel="{{item.certLabel || ''}}" bindtap="editCertLabel">认证</text></view></view></view>

  <view wx:if="{{activeTab === 'userAdmin' && activeSubTab === 'admins'}}">
    <view class="section-head">
      <view class="section-title-inline">管理员账号（{{admins.length}}）</view>
      <view class="section-head-side"><button hover-class="press-spring" size="mini" class="primary-mini spring-btn" bindtap="openAdminModal" hover-stay-time="120">新增管理员</button><text class="section-toggle" data-key="admins" bindtap="toggleSection">{{sectionCollapsed.admins ? '展开 ▼' : '收起 ▲'}}</text></view>
    </view>
    <block wx:if="{{!sectionCollapsed.admins}}">
    <view class="config-hint">管理员由已注册用户提升而来。调整角色、停用账号都会写入操作日志；系统始终保留至少一个启用的超级管理员，且不能停用或降级自己。</view>
    <view wx:for="{{admins}}" wx:key="id" class="list-card compact-row anim-stagger" style="--i: {{index < 6 ? index : 0}};">
      <view class="admin-main">
        <text class="row-title">{{item.nickName || '未命名用户'}} #{{item.id}}<text wx:if="{{item.isSelf}}" class="self-tag">我</text></text>
        <text class="row-sub">{{roleLabels[item.role] || item.role}} · {{item.status ? '启用中' : '已停用'}} · {{item.phone || '未绑定手机号'}}</text>
        <text class="row-sub">权限：{{rolePermissionText[item.role] || '—'}}</text>
      </view>
      <view class="row-actions" wx:if="{{!item.isSelf}}">
        <text data-id="{{item.id}}" bindtap="changeAdminRole">调整角色</text>
        <text class="danger" data-id="{{item.id}}" bindtap="toggleAdmin">{{item.status ? '停用' : '启用'}}</text>
      </view>
      <view class="row-actions" wx:else><text class="row-sub">当前登录账号</text></view>
    </view>
    <view wx:if="{{!admins.length}}" class="empty">暂无管理员账号</view>
    </block>
  </view>

  <view wx:if="{{activeTab === 'logs'}}">
    <!-- 日志内部分段：跑腿订单流程 / 订阅消息发送流水 / 维修信息 -->
    <view class="scope-tabs">
      <view class="scope-tab {{logScope === 'errand' ? 'selected' : ''}}" data-scope="errand" bindtap="chooseLogScope">跑腿订单流程</view>
      <view class="scope-tab {{logScope === 'subscribe' ? 'selected' : ''}}" data-scope="subscribe" bindtap="chooseLogScope">订阅消息</view>
      <view class="scope-tab {{logScope === 'repair' ? 'selected' : ''}}" data-scope="repair" bindtap="chooseLogScope">维修信息</view>
    </view>

    <block wx:if="{{logScope === 'errand'}}">
      <view class="toolbar"><input placeholder="搜索标题、订单号或用户昵称" value="{{errandKeyword}}" bindinput="onErrandKeywordInput" confirm-type="search" bindconfirm="searchErrandOrders"/><text bindtap="searchErrandOrders">搜索</text></view>
      <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
        <view class="filter {{errandStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseErrandStatus">全部</view>
        <view class="filter {{errandStatus === 'pending' ? 'selected' : ''}}" data-status="pending" bindtap="chooseErrandStatus">待接单</view>
        <view class="filter {{errandStatus === 'accepted' ? 'selected' : ''}}" data-status="accepted" bindtap="chooseErrandStatus">进行中</view>
        <view class="filter {{errandStatus === 'finished' ? 'selected' : ''}}" data-status="finished" bindtap="chooseErrandStatus">已完成</view>
        <view class="filter {{errandStatus === 'cancelled' ? 'selected' : ''}}" data-status="cancelled" bindtap="chooseErrandStatus">已取消</view>
        <view class="filter {{errandStatus === 'disputed' ? 'selected' : ''}}" data-status="disputed" bindtap="chooseErrandStatus">有异议</view>
      </view></scroll-view>
      <view wx:for="{{errandOrders}}" wx:key="id" class="list-card errand-log-card anim-stagger spring-btn" style="--i: {{index < 6 ? index : 0}};" hover-stay-time="80" hover-class="errand-card-hover press-spring" data-id="{{item.id}}" bindtap="openErrandDetail">
        <view class="errand-log-head">
          <text class="row-title">#{{item.id}} {{item.title}}</text>
          <text class="errand-status st-{{item.status}}">{{item.statusText}}</text>
        </view>
        <text class="errand-flow">{{item.flowText}}</text>
        <text class="row-sub">¥{{item.rewardText}} · {{item.paymentText || '未知支付状态'}}</text>
        <text class="row-sub" wx:if="{{item.lastDetailText}}">{{item.lastDetailText}} · {{item.lastAtText}}</text>
      </view>
      <view wx:if="{{!errandOrders.length}}" class="empty">暂无订单流程记录</view>
      <view class="logs-more" wx:if="{{errandHasMore}}"><button hover-class="press-spring" size="mini" class="plain-btn spring-btn" loading="{{errandLoading}}" bindtap="loadMoreErrandOrders" hover-stay-time="120">加载更多</button></view>
      <view class="logs-more" wx:elif="{{errandOrders.length}}"><text class="row-sub">已加载全部 {{errandOrders.length}} 条记录</text></view>
    </block>

    <block wx:if="{{logScope === 'subscribe'}}">
      <!-- 排查提示：状态语义一眼可读，客服无需连库 -->
      <view class="sub-hint">
        <text class="row-sub">先分清两个状态：「额度不足」= 用户没授权或授权次数已用尽，压根没调用微信；「发送失败」= 调用了微信但被拒，与额度无关，看错误码。</text>
        <text class="row-sub">已发送 = 已交给微信（到达时间由微信决定）· 已合并 = 被合并去重（现会补发）· 命中节流 = 该触发组当天弹窗已达 3 次上限，未调用微信</text>
        <text class="row-sub" wx:if="{{subscribePendingTotal}}">当前有 {{subscribePendingTotal}} 条待补发（等窗口过期或额度恢复）</text>
      </view>
      <view class="toolbar"><input placeholder="搜索用户昵称、摘要或用户 ID" value="{{subscribeLogKeyword}}" bindinput="onSubscribeLogKeywordInput" confirm-type="search" bindconfirm="searchSubscribeLogs"/><text bindtap="searchSubscribeLogs">搜索</text></view>
      <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
        <view class="filter {{subscribeLogStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseSubscribeLogStatus">全部</view>
        <view class="filter {{subscribeLogStatus === 'sent' ? 'selected' : ''}}" data-status="sent" bindtap="chooseSubscribeLogStatus">已发送</view>
        <view class="filter {{subscribeLogStatus === 'merged' ? 'selected' : ''}}" data-status="merged" bindtap="chooseSubscribeLogStatus">已合并</view>
        <view class="filter {{subscribeLogStatus === 'skipped' ? 'selected' : ''}}" data-status="skipped" bindtap="chooseSubscribeLogStatus">额度不足</view>
        <view class="filter {{subscribeLogStatus === 'failed' ? 'selected' : ''}}" data-status="failed" bindtap="chooseSubscribeLogStatus">发送失败</view>
        <view class="filter {{subscribeLogStatus === 'throttled' ? 'selected' : ''}}" data-status="throttled" bindtap="chooseSubscribeLogStatus">命中节流</view>
      </view></scroll-view>
      <view wx:if="{{subscribeQuota.length}}" class="sub-quota">
        <text class="row-sub">额度按「用户」独立计算：「有额度」是真正还能收的人数，「剩余」是全体总量。总量还有却仍显示额度不足，说明是那几个用户自己用光了。</text>
        <view class="sub-quota-row" wx:for="{{subscribeQuota}}" wx:key="tplType">
          <view class="sub-quota-head">
            <text class="sub-quota-name">{{item.label}}</text>
            <text class="sub-quota-key">{{item.tplType}}</text>
          </view>
          <text class="sub-quota-stat">{{item.quotaText}}</text>
        </view>
      </view>
      <view wx:for="{{subscribeLogs}}" wx:key="id" class="list-card anim-stagger" style="--i: {{index < 6 ? index : 0}};">
        <view class="errand-log-head">
          <view class="log-title-wrap">
            <text class="row-title">#{{item.id}} {{item.tplLabel}}</text>
            <text class="sub-quota-key">{{item.tplType}}</text>
          </view>
          <text class="errand-status st-{{item.status === 'sent' ? 'finished' : (item.status === 'failed' ? 'disputed' : (item.status === 'throttled' ? 'throttled' : 'cancelled'))}}">{{item.statusText}}</text>
        </view>
        <text class="row-sub">{{item.timeText}} · 用户 {{item.userName || ('#' + item.userId)}}({{item.userId}})</text>
        <text class="row-sub" wx:if="{{item.summary}}">{{item.summary}}</text>
        <text class="row-sub" wx:if="{{item.errmsg}}">{{item.statusHint}}：{{item.errmsg}}</text>
        <text class="row-sub" wx:elif="{{item.errcode}}">错误码 {{item.errcode}}</text>
        <text class="row-sub err-hint" wx:if="{{item.errcodeHint}}">{{item.errcodeHint}}</text>
      </view>
      <view wx:if="{{!subscribeLogs.length}}" class="empty">暂无订阅消息记录</view>
      <view class="logs-more" wx:if="{{subscribeLogHasMore}}"><button hover-class="press-spring" size="mini" class="plain-btn spring-btn" loading="{{subscribeLogLoading}}" bindtap="loadMoreSubscribeLogs" hover-stay-time="120">加载更多</button></view>
      <view class="logs-more" wx:elif="{{subscribeLogs.length}}"><text class="row-sub">已加载全部 {{subscribeLogs.length}} 条记录</text></view>
    </block>

    <block wx:if="{{logScope === 'repair'}}">
      <!-- 用户提交的预约维修：管理员按此核对联系人/上门地址并派单 -->
      <view class="sub-hint">
        <text class="row-sub">这里是用户端「预约维修」提交的全部记录，含提交人的头像、昵称与联系方式。点卡片可看完整资料与故障照片。</text>
      </view>
      <view class="toolbar"><input placeholder="搜索昵称、联系人、手机号或地址" value="{{repairKeyword}}" bindinput="onRepairKeywordInput" confirm-type="search" bindconfirm="searchRepairOrders"/><text bindtap="searchRepairOrders">搜索</text></view>
      <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
        <view class="filter {{repairStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseRepairStatus">全部</view>
        <view class="filter {{repairStatus === 'unpaid' ? 'selected' : ''}}" data-status="unpaid" bindtap="chooseRepairStatus">待支付</view>
        <view class="filter {{repairStatus === 'paid' ? 'selected' : ''}}" data-status="paid" bindtap="chooseRepairStatus">已支付</view>
        <view class="filter {{repairStatus === 'cancelled' ? 'selected' : ''}}" data-status="cancelled" bindtap="chooseRepairStatus">已取消</view>
      </view></scroll-view>
      <view wx:for="{{repairOrders}}" wx:key="id" class="list-card errand-log-card anim-stagger spring-btn" style="--i: {{index < 6 ? index : 0}};" hover-stay-time="80" hover-class="errand-card-hover press-spring" data-id="{{item.id}}" bindtap="openRepairDetail">
        <view class="errand-log-head">
          <view class="repair-user">
            <image wx:if="{{item.avatarUrl}}" class="post-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
            <view wx:else class="post-avatar post-avatar-fallback">{{item.nickName[0]}}</view>
            <view class="repair-user-copy">
              <text class="row-title">{{item.nickName}}</text>
              <text class="row-sub">用户 #{{item.userId}} · {{item.userPhone || '未绑定手机号'}}</text>
            </view>
          </view>
          <text class="errand-status st-{{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="row-sub">联系人：{{item.contactName}} · {{item.contactPhone}}<text wx:if="{{item.wechatId}}"> · 微信 {{item.wechatId}}</text></text>
        <text class="row-sub">上门地址：{{item.serviceAddress}}</text>
        <text class="repair-service">服务内容：{{item.serviceText}}</text>
        <text class="row-sub">预约上门：{{item.expectedTime || '未填写'}} · 提交于 {{item.createdText}}</text>
        <view class="repair-foot">
          <text class="row-sub">{{item.orderNo}}</text>
          <text class="repair-amount">¥{{item.amountText}}</text>
        </view>
      </view>
      <view wx:if="{{!repairOrders.length}}" class="empty">暂无维修预约记录</view>
      <view class="logs-more" wx:if="{{repairHasMore}}"><button hover-class="press-spring" size="mini" class="plain-btn spring-btn" loading="{{repairLoading}}" bindtap="loadMoreRepairOrders" hover-stay-time="120">加载更多</button></view>
      <view class="logs-more" wx:elif="{{repairOrders.length}}"><text class="row-sub">已加载全部 {{repairOrders.length}} 条记录</text></view>
    </block>
  </view>

  <!-- 订单流程详情弹窗：双方用户信息 + 各节点时间 + 流程时间线 -->
  <view wx:if="{{errandDetail}}" class="form-mask" bindtap="closeErrandDetail">
    <view class="form-card" catchtap="noop">
      <view class="form-title">#{{errandDetail.id}} {{errandDetail.title}}</view>
      <view class="errand-detail-users">
        <view class="errand-user-col">
          <image wx:if="{{errandDetail.publisherAvatar}}" class="post-avatar" src="{{errandDetail.publisherAvatar}}" mode="aspectFill"/>
          <view wx:else class="post-avatar post-avatar-fallback">{{errandDetail.publisherName[0]}}</view>
          <text class="errand-user-name">发单：{{errandDetail.publisherName}}</text>
          <text class="errand-user-sub">{{errandDetail.publisherPhone}}</text>
        </view>
        <view class="errand-user-col">
          <image wx:if="{{errandDetail.acceptorAvatar}}" class="post-avatar" src="{{errandDetail.acceptorAvatar}}" mode="aspectFill"/>
          <view wx:elif="{{errandDetail.acceptorName}}" class="post-avatar post-avatar-fallback">{{errandDetail.acceptorName[0]}}</view>
          <view wx:else class="post-avatar post-avatar-fallback">?</view>
          <text class="errand-user-name">接单：{{errandDetail.acceptorName || '暂无人接单'}}</text>
          <text class="errand-user-sub" wx:if="{{errandDetail.acceptorName}}">{{errandDetail.acceptorPhone}}</text>
          <text class="errand-user-sub" wx:else>--</text>
        </view>
      </view>
      <view class="errand-detail-info">
        <text class="errand-info-row">状态：{{errandDetail.statusText}}<text wx:if="{{errandDetail.paymentText}}"> · {{errandDetail.paymentText}}</text> · 悬赏 ¥{{errandDetail.rewardText}}</text>
        <text class="errand-info-row">下单时间：{{errandDetail.createdAtText}}</text>
        <text class="errand-info-row">接单时间：{{errandDetail.acceptedAtText}}</text>
        <text class="errand-info-row">完成时间：{{errandDetail.finishedAtText}}</text>
        <text class="errand-info-row">取消时间：{{errandDetail.cancelledAtText}}</text>
      </view>

      <!-- 接单方提交的完成说明与凭证（异议裁决的核对依据） -->
      <view class="errand-submit-box" wx:if="{{errandDetail.finishDescription || errandDetail.finishImages.length}}">
        <text class="errand-box-label">接单方提交内容</text>
        <text class="errand-dispute-text">{{errandDetail.finishDescription || '未填写完成说明'}}</text>
        <view class="errand-submit-images" wx:if="{{errandDetail.finishImages.length}}">
          <image wx:for="{{errandDetail.finishImages}}" wx:key="index" class="verify-img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewErrandImage"/>
        </view>
      </view>

      <!-- 异议内容：发单人提出的问题与客服处理结果 -->
      <view class="errand-dispute-box" wx:if="{{errandDetail.disputeReason || errandDetail.disputeResultText}}">
        <text class="errand-box-label">异议内容</text>
        <text class="errand-dispute-text">{{errandDetail.disputeReason || '—'}}</text>
        <text class="errand-dispute-time" wx:if="{{errandDetail.disputedAtText}}">提出时间：{{errandDetail.disputedAtText}}</text>
        <text class="errand-dispute-time" wx:if="{{errandDetail.disputeResultText}}">处理结果：{{errandDetail.disputeResultText}}</text>
        <text class="errand-dispute-time" wx:if="{{errandDetail.disputeNote}}">客服备注：{{errandDetail.disputeNote}}</text>
        <text class="errand-dispute-time" wx:if="{{errandDetail.disputeHandledAtText}}">处理时间：{{errandDetail.disputeHandledAtText}}</text>
      </view>

      <view class="errand-timeline">
        <view class="errand-timeline-title">订单流程</view>
        <view wx:for="{{errandDetail.logs}}" wx:key="id" class="errand-timeline-item">
          <view class="errand-timeline-dot"></view>
          <view class="errand-timeline-body">
            <text class="errand-timeline-text">{{item.text}}</text>
            <text class="errand-timeline-sub" wx:if="{{item.detail && item.detail !== item.text}}">{{item.detail}}</text>
            <text class="errand-timeline-time">{{item.timeText}}</text>
          </view>
        </view>
        <view wx:if="{{!errandDetail.logs.length}}" class="empty">暂无流程记录</view>
      </view>
      <!-- 有异议订单：直接给管理员裁决入口（通过=取消退款 / 拒绝=订单成立） -->
      <view class="form-buttons dispute-buttons" wx:if="{{errandDetail.status === 'disputed'}}">
        <button hover-class="press-spring" class="cancel-btn spring-btn" data-action="approve" bindtap="reviewErrandDispute" hover-stay-time="120">通过（取消订单退款）</button>
        <button hover-class="press-spring" class="save-btn spring-btn" data-action="reject" bindtap="reviewErrandDispute" hover-stay-time="120">拒绝（订单成立结算）</button>
      </view>
      <view class="form-buttons" wx:else><button hover-class="press-spring" class="cancel-btn spring-btn" bindtap="closeErrandDetail" hover-stay-time="120">关闭</button></view>
    </view>
  </view>

  <!-- 维修预约详情弹窗：提交人资料 + 上门信息 + 故障照片 -->
  <view wx:if="{{repairDetail}}" class="form-mask" bindtap="closeRepairDetail">
    <view class="form-card" catchtap="noop">
      <view class="form-title">维修预约 #{{repairDetail.id}}<text class="errand-status st-{{repairDetail.statusClass}}">{{repairDetail.statusText}}</text></view>
      <view class="errand-detail-users">
        <view class="errand-user-col">
          <image wx:if="{{repairDetail.avatarUrl}}" class="post-avatar" src="{{repairDetail.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="post-avatar post-avatar-fallback">{{repairDetail.nickName[0]}}</view>
          <text class="errand-user-name">{{repairDetail.nickName}}</text>
          <text class="errand-user-sub">用户 #{{repairDetail.userId}}</text>
          <text class="errand-user-sub">{{repairDetail.userPhone || '未绑定手机号'}}</text>
        </view>
      </view>
      <view class="errand-detail-info">
        <text class="errand-info-row">订单号：{{repairDetail.orderNo}}</text>
        <text class="errand-info-row">联系人：{{repairDetail.contactName}} · {{repairDetail.contactPhone}}</text>
        <text class="errand-info-row" wx:if="{{repairDetail.wechatId}}">微信号：{{repairDetail.wechatId}}</text>
        <text class="errand-info-row">上门地址：{{repairDetail.serviceAddress}}</text>
        <text class="errand-info-row">服务内容：{{repairDetail.deviceType}}</text>
        <text class="errand-info-row">故障描述：{{repairDetail.description}}</text>
        <text class="errand-info-row">预约上门：{{repairDetail.expectedTime || '未填写'}}</text>
        <text class="errand-info-row">提交时间：{{repairDetail.createdText}}</text>
        <text class="errand-info-row" wx:if="{{repairDetail.paidText}}">支付时间：{{repairDetail.paidText}}</text>
        <text class="errand-info-row">预约费用：¥{{repairDetail.amountText}}</text>
        <text class="errand-info-row">维修人员：{{repairDetail.technicianName || '待平台分配'}}{{repairDetail.technicianPhone ? ' · ' + repairDetail.technicianPhone : ''}}</text>
      </view>
      <!-- 一键复制：管理员要打电话 / 加微信约上门时间 -->
      <view class="form-buttons">
        <button hover-class="press-spring" class="cancel-btn spring-btn" data-value="{{repairDetail.contactPhone}}" bindtap="copyRepairContact" hover-stay-time="120">复制手机号</button>
        <button hover-class="press-spring" class="save-btn spring-btn" wx:if="{{repairDetail.wechatId}}" data-value="{{repairDetail.wechatId}}" bindtap="copyRepairContact" hover-stay-time="120">复制微信号</button>
      </view>
      <view class="errand-submit-box" wx:if="{{repairDetail.images.length}}">
        <text class="errand-box-label">故障照片</text>
        <view class="errand-submit-images">
          <image wx:for="{{repairDetail.images}}" wx:key="index" class="verify-img" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewRepairImage"/>
        </view>
      </view>
      <view class="form-buttons"><button hover-class="press-spring" class="cancel-btn spring-btn" bindtap="closeRepairDetail" hover-stay-time="120">关闭</button></view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'review' && subTabs.review.length > 1}}" class="sub-tabs">
    <view wx:for="{{subTabs.review}}" wx:key="key" class="sub-tab {{activeSubTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchSubTab">{{item.name}}</view>
  </view>

  <!-- 群聊审核列表已迁移至「群聊/社团 → 群聊 → 群聊审核」，此处仅保留共用详情弹窗 -->

  <!-- 群聊审核详情弹窗 -->
  <view wx:if="{{chatApplyDetail}}" class="form-mask" bindtap="closeChatApplyDetail">
    <view class="form-card" catchtap="noop">
      <view class="form-title">申请详情<text class="chat-apply-status cs-{{chatApplyDetail.status}}">{{chatApplyDetail.statusText}}</text></view>
      <view class="form-item">
        <view class="form-label">{{chatApplyDetail.name}}（{{chatApplyDetail.groupType || '微信群'}}）</view>
        <text class="audit-detail-line">类别：{{chatApplyDetail.category || '未分类'}} · 校区：{{chatApplyDetail.campus || '全部校区'}}</text>
        <text class="audit-detail-line">申请时间：{{chatApplyDetail.createdAtText}}</text>
        <text class="audit-detail-line" wx:if="{{chatApplyDetail.reviewedAtText}}">审核时间：{{chatApplyDetail.reviewedAtText}}</text>
      </view>
      <view class="form-item">
        <view class="form-label">创建人</view>
        <view class="act-initiator">
          <image wx:if="{{chatApplyDetail.creatorAvatar}}" class="act-initiator-avatar" src="{{chatApplyDetail.creatorAvatar}}" mode="aspectFill"/>
          <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{chatApplyDetail.creatorChar}}</view>
          <view class="act-initiator-info">
            <text class="act-initiator-name">{{chatApplyDetail.nickName || '未知用户'}} #{{chatApplyDetail.userId}}</text>
            <text class="row-sub">{{chatApplyDetail.creatorPhone || '未绑定手机号'}}</text>
          </view>
        </view>
      </view>
      <view class="form-item" wx:if="{{chatApplyDetail.intro}}">
        <view class="form-label">群介绍</view>
        <!-- 同社团审核：该字段可能来自用户端纯文本 textarea，也可能来自后台标记语法，统一渲染 -->
        <richtext-content class="audit-detail-rich" content="{{chatApplyDetail.intro}}" selectable></richtext-content>
      </view>
      <view class="form-item" wx:if="{{chatApplyDetail.images.length}}">
        <view class="form-label">图片介绍</view>
        <view class="rider-verify-images">
          <image wx:for="{{chatApplyDetail.images}}" wx:key="index" class="verify-img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewVerifyImg"/>
        </view>
      </view>
      <view class="form-item" wx:if="{{chatApplyDetail.qrcodeUrl || chatApplyDetail.adminQrcodeUrl || chatApplyDetail.gzhQrcodeUrl}}">
        <view class="form-label">群二维码 / 管理员微信 / 公众号</view>
        <view class="rider-verify-images">
          <image wx:if="{{chatApplyDetail.qrcodeUrl}}" class="verify-img" src="{{chatApplyDetail.qrcodeUrl}}" mode="aspectFill" data-src="{{chatApplyDetail.qrcodeUrl}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
          <image wx:if="{{chatApplyDetail.adminQrcodeUrl}}" class="verify-img" src="{{chatApplyDetail.adminQrcodeUrl}}" mode="aspectFill" data-src="{{chatApplyDetail.adminQrcodeUrl}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
          <image wx:if="{{chatApplyDetail.gzhQrcodeUrl}}" class="verify-img" src="{{chatApplyDetail.gzhQrcodeUrl}}" mode="aspectFill" data-src="{{chatApplyDetail.gzhQrcodeUrl}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
        </view>
      </view>
      <view class="form-item" wx:if="{{chatApplyDetail.reviewNote}}">
        <view class="form-label">审核意见</view>
        <text class="audit-detail-line">{{chatApplyDetail.reviewNote}}</text>
      </view>
      <view class="form-actions">
        <button hover-class="press-spring" size="mini" class="plain-btn spring-btn" bindtap="closeChatApplyDetail" hover-stay-time="120">关闭</button>
        <button hover-class="press-spring" wx:if="{{chatApplyDetail.status !== 'approved'}}" size="mini" class="primary-mini spring-btn" data-id="{{chatApplyDetail.id}}" data-action="approve" bindtap="openChatReview" hover-stay-time="120">通过</button>
        <button hover-class="press-spring" wx:if="{{chatApplyDetail.status !== 'rejected'}}" size="mini" class="danger-mini spring-btn" data-id="{{chatApplyDetail.id}}" data-action="reject" bindtap="openChatReview" hover-stay-time="120">驳回</button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'review' && activeSubTab === 'activityAudit'}}">
    <view class="section-head"><text class="section-title-inline">活动审核（{{activityAudits.length}}）</text></view>
    <view class="config-hint">普通用户发布的活动需审核通过后才会在用户端展示；管理员发布免审。支持查看详情、通过与驳回（驳回必填意见，发起人可见），支持改判。</view>
    <scroll-view class="filters" scroll-x="true"><view class="filters-inner">
      <view class="filter {{activityAuditStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseActivityAuditStatus">全部</view>
      <view class="filter {{activityAuditStatus === 'pending' ? 'selected' : ''}}" data-status="pending" bindtap="chooseActivityAuditStatus">待审核</view>
      <view class="filter {{activityAuditStatus === 'approved' ? 'selected' : ''}}" data-status="approved" bindtap="chooseActivityAuditStatus">已通过</view>
      <view class="filter {{activityAuditStatus === 'rejected' ? 'selected' : ''}}" data-status="rejected" bindtap="chooseActivityAuditStatus">已驳回</view>
    </view></scroll-view>
    <view wx:for="{{activityAudits}}" wx:key="id" class="list-card compact-row act-admin-row anim-stagger" style="--i: {{index < 6 ? index : 0}};">
      <image wx:if="{{item.coverUrl}}" class="act-admin-cover" src="{{item.coverUrl}}" mode="aspectFill"/>
      <view wx:else class="act-admin-cover act-admin-cover--fallback"><text>活动</text></view>
      <view class="act-admin-main">
        <text class="row-title">{{item.title}}<text class="chat-apply-status cs-{{item.auditStatus}}">{{item.auditStatusText}}</text><text wx:if="{{!item.status}}" class="chat-apply-status cs-rejected">已下架</text></text>
        <text class="row-sub">发起人：{{item.nickName || '用户'}} · {{item.campus || '全部校区'}} · 已报名 {{item.signupCount}} 人</text>
        <text class="row-sub">活动时间：{{item.activityStart || '未设置'}}</text>
        <text class="row-sub">发布于 {{item.createdAtText}}<text wx:if="{{item.auditTimeText}}"> · 审核于 {{item.auditTimeText}}</text></text>
        <text class="row-sub" wx:if="{{item.auditNote}}">审核意见：{{item.auditNote}}</text>
      </view>
      <view class="row-actions act-admin-actions">
        <text data-id="{{item.id}}" bindtap="viewActivityAudit">详情</text>
        <text wx:if="{{item.auditStatus !== 'approved'}}" data-id="{{item.id}}" bindtap="approveActivityAudit">通过</text>
        <text wx:if="{{item.auditStatus !== 'rejected'}}" class="danger" data-id="{{item.id}}" bindtap="rejectActivityAudit">驳回</text>
      </view>
    </view>
    <view wx:if="{{!activityAudits.length}}" class="empty">暂无活动</view>
  </view>

  <!-- 活动审核详情弹窗 -->
  <view wx:if="{{activityAuditDetail}}" class="form-mask" bindtap="closeActivityAuditDetail">
    <view class="form-card" catchtap="noop">
      <view class="form-title">活动详情<text class="chat-apply-status cs-{{activityAuditDetail.auditStatus}}">{{activityAuditDetail.auditStatusText}}</text></view>
      <image wx:if="{{activityAuditDetail.coverUrl}}" class="audit-detail-cover" src="{{activityAuditDetail.coverUrl}}" mode="widthFix"/>
      <view class="form-item">
        <view class="form-label">{{activityAuditDetail.title}}</view>
        <text class="audit-detail-line">发起人：{{activityAuditDetail.nickName || '用户'}}</text>
        <text class="audit-detail-line">校区：{{activityAuditDetail.campus || '全部校区'}} · 已报名 {{activityAuditDetail.signupCount}} 人{{activityAuditDetail.capacity > 0 ? ' · 名额 ' + activityAuditDetail.capacity : ' · 名额不限'}}</text>
        <text class="audit-detail-line">报名：{{activityAuditDetail.signupStart || '未设置'}} ~ {{activityAuditDetail.signupEnd || '未设置'}}</text>
        <text class="audit-detail-line">活动：{{activityAuditDetail.activityStart || '未设置'}} ~ {{activityAuditDetail.activityEnd || '未设置'}}</text>
        <text class="audit-detail-line">位置：{{activityAuditDetail.location || '未设置'}}{{activityAuditDetail.address ? '（' + activityAuditDetail.address + '）' : ''}}</text>
      </view>
      <view class="form-item">
        <view class="form-label">发起人</view>
        <view class="act-initiator">
          <image wx:if="{{activityAuditDetail.initiator.avatarUrl}}" class="act-initiator-avatar" src="{{activityAuditDetail.initiator.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{activityAuditDetail.nickName ? activityAuditDetail.nickName[0] : '友'}}</view>
          <view class="act-initiator-info">
            <text class="act-initiator-name">{{activityAuditDetail.nickName || '未命名用户'}} #{{activityAuditDetail.initiator.userId}}</text>
            <text class="row-sub">{{activityAuditDetail.initiator.phone || '未绑定手机号'}}</text>
          </view>
        </view>
      </view>
      <view class="form-item" wx:if="{{activityAuditDetail.detailTitle || activityAuditDetail.detailContent}}">
        <view class="form-label">活动介绍</view>
        <text class="audit-detail-line" wx:if="{{activityAuditDetail.detailTitle}}">{{activityAuditDetail.detailTitle}}</text>
        <!-- detailContent 正是后台「活动」表单里 richtext-editor 编辑的字段，
             审核时必须按用户端口径渲染，否则审核人看到的是 **加粗** / ## 标题 这类裸标记 -->
        <richtext-content wx:if="{{activityAuditDetail.detailContent}}" class="audit-detail-rich" content="{{activityAuditDetail.detailContent}}" selectable></richtext-content>
        <text wx:else class="audit-detail-line">（无文字介绍）</text>
      </view>
      <view class="form-item" wx:if="{{activityAuditDetail.images.length}}">
        <view class="form-label">详细图片</view>
        <view class="rider-verify-images">
          <image wx:for="{{activityAuditDetail.images}}" wx:key="index" class="verify-img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewVerifyImg"/>
        </view>
      </view>
      <view class="form-item" wx:if="{{activityAuditDetail.signupImages.length}}">
        <view class="form-label">报名图片（如群二维码）</view>
        <view class="rider-verify-images">
          <image wx:for="{{activityAuditDetail.signupImages}}" wx:key="index" class="verify-img" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"/>
        </view>
      </view>
      <view class="form-item" wx:if="{{activityAuditDetail.auditNote}}">
        <view class="form-label">审核意见</view>
        <text class="audit-detail-line">{{activityAuditDetail.auditNote}}</text>
      </view>
      <view class="form-actions">
        <button hover-class="press-spring" size="mini" class="plain-btn spring-btn" bindtap="closeActivityAuditDetail" hover-stay-time="120">关闭</button>
        <button hover-class="press-spring" wx:if="{{activityAuditDetail.auditStatus !== 'approved'}}" size="mini" class="primary-mini spring-btn" data-id="{{activityAuditDetail.id}}" bindtap="approveActivityAudit" hover-stay-time="120">通过</button>
        <button hover-class="press-spring" wx:if="{{activityAuditDetail.auditStatus !== 'rejected'}}" size="mini" class="danger-mini spring-btn" data-id="{{activityAuditDetail.id}}" bindtap="rejectActivityAudit" hover-stay-time="120">驳回</button>
      </view>
    </view>
  </view>

  <!-- 活动详情弹窗（管理端）：活动概要 + 报名用户名单，仅管理员可见 -->
  <view wx:if="{{activitySignupDetail}}" class="form-mask" bindtap="closeActivitySignups">
    <view class="form-card" catchtap="noop">
      <view class="form-title">活动详情<text class="signup-count-tag">已报名 {{activitySignupDetail.activity.signupCount}} 人</text></view>
      <view class="form-item">
        <view class="form-label">{{activitySignupDetail.activity.title}}</view>
        <text class="audit-detail-line">校区：{{activitySignupDetail.activity.campus || '全部校区'}} · {{activitySignupDetail.activity.capacity > 0 ? '名额 ' + activitySignupDetail.activity.capacity : '名额不限'}}</text>
        <text class="audit-detail-line">报名：{{activitySignupDetail.activity.signupStart || '未设置'}} ~ {{activitySignupDetail.activity.signupEnd || '未设置'}}</text>
        <text class="audit-detail-line">活动：{{activitySignupDetail.activity.activityStart || '未设置'}} ~ {{activitySignupDetail.activity.activityEnd || '未设置'}}</text>
        <text class="audit-detail-line">位置：{{activitySignupDetail.activity.location || '未设置'}}{{activitySignupDetail.activity.address ? '（' + activitySignupDetail.activity.address + '）' : ''}}</text>
        <text class="audit-detail-line">发起人：{{activitySignupDetail.activity.ownerNickName || '未命名用户'}} #{{activitySignupDetail.activity.userId}}</text>
        <text class="audit-detail-line">状态：{{activitySignupDetail.activity.status ? '上架中' : '已下架'}}{{activitySignupDetail.activity.auditStatus === 'pending' ? ' · 待审核' : activitySignupDetail.activity.auditStatus === 'rejected' ? ' · 已驳回' : ''}}</text>
      </view>
      <view class="form-item">
        <view class="form-label">报名用户（{{activitySignupDetail.list.length}}/{{activitySignupDetail.total}}）</view>
        <view class="signup-search"><input placeholder="搜索昵称或手机号" value="{{activitySignupKeyword}}" bindinput="onSignupKeywordInput" confirm-type="search" bindconfirm="searchActivitySignups"/><text bindtap="searchActivitySignups">搜索</text></view>
        <view wx:for="{{activitySignupDetail.list}}" wx:key="id" class="signup-row">
          <image wx:if="{{item.avatarUrl}}" class="signup-avatar" src="{{item.avatarUrl}}" mode="aspectFill" data-src="{{item.avatarUrl}}" bindtap="previewVerifyImg"/>
          <view wx:else class="signup-avatar signup-avatar--fallback">{{item.nickName ? item.nickName[0] : '用'}}</view>
          <view class="signup-info">
            <text class="signup-name">{{item.nickName || '未命名用户'}} #{{item.userId}}<text wx:if="{{item.accountDisabled}}" class="chat-apply-status cs-rejected">已禁用</text></text>
            <text class="signup-phone" data-phone="{{item.phone}}" bindtap="copySignupPhone">{{item.phone || '未绑定手机号'}}</text>
            <text class="signup-sub">{{item.campus || '未设置校区'}} · 报名于 {{item.signedAtText}}</text>
          </view>
        </view>
        <view wx:if="{{!activitySignupDetail.list.length}}" class="empty">{{activitySignupLoading ? '加载中…' : (activitySignupKeyword ? '没有匹配的报名用户' : '暂无用户报名')}}</view>
        <view wx:if="{{activitySignupDetail.hasMore}}" class="signup-more" bindtap="loadMoreActivitySignups">{{activitySignupLoading ? '加载中…' : '加载更多'}}</view>
      </view>
      <view class="form-hint">名单仅管理员可见，含报名用户昵称、手机号等个人信息，请勿外传。</view>
      <view class="form-actions">
        <button hover-class="press-spring" size="mini" class="plain-btn spring-btn" bindtap="closeActivitySignups" hover-stay-time="120">关闭</button>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'review' && activeSubTab === 'withdrawals'}}"><scroll-view class="filters" scroll-x="true"><view class="filters-inner">
    <view class="filter {{withdrawalStatus === '' ? 'selected' : ''}}" data-status="" bindtap="chooseWithdrawalStatus">全部</view>
    <view class="filter {{withdrawalStatus === 'PENDING' ? 'selected' : ''}}" data-status="PENDING" bindtap="chooseWithdrawalStatus">待审核</view>
    <view class="filter {{withdrawalStatus === 'SUCCESS' ? 'selected' : ''}}" data-status="SUCCESS" bindtap="chooseWithdrawalStatus">已成功</view>
    <view class="filter {{withdrawalStatus === 'PROCESSING' ? 'selected' : ''}}" data-status="PROCESSING" bindtap="chooseWithdrawalStatus">处理中</view>
    <view class="filter {{withdrawalStatus === 'FAILED' ? 'selected' : ''}}" data-status="FAILED" bindtap="chooseWithdrawalStatus">打款失败</view>
    <view class="filter {{withdrawalStatus === 'REJECTED' ? 'selected' : ''}}" data-status="REJECTED" bindtap="chooseWithdrawalStatus">已驳回</view>
  </view></scroll-view><view wx:for="{{withdrawals}}" wx:key="id" class="list-card compact-row anim-stagger" style="--i: {{index < 6 ? index : 0}};"><view class="act-initiator"><image wx:if="{{item.avatarUrl}}" class="act-initiator-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{item.nickName ? item.nickName[0] : '用'}}</view><view class="act-initiator-info"><text class="act-initiator-name">{{item.nickName || '用户'}} #{{item.userId}}</text><text class="row-sub">申请 ¥{{item.amount}} · {{item.statusText}} · 手机：{{item.phone || '未绑定'}} · {{item.createdAt}}</text><text wx:if="{{item.reviewNote && item.status !== 'PENDING'}}" class="row-sub">审核备注：{{item.reviewNote}}</text><text wx:if="{{item.lastErrorBrief}}" class="row-warn">上次打款失败：{{item.lastErrorBrief}}</text></view></view><view class="row-actions" wx:if="{{item.status === 'PENDING'}}"><text data-id="{{item.id}}" data-action="approve" bindtap="reviewWithdrawal">通过</text><text wx:if="{{item.lastError}}" data-id="{{item.id}}" data-action="approve" data-retry="1" bindtap="reviewWithdrawal">重试打款</text><text class="danger" data-id="{{item.id}}" data-action="reject" bindtap="reviewWithdrawal">驳回</text></view></view><view wx:if="{{!withdrawals.length}}" class="empty">暂无提现记录</view></view>

  <view wx:if="{{activeTab === 'review' && activeSubTab === 'riderVerifications'}}">
    <view wx:for="{{riderVerifications}}" wx:key="id" class="list-card compact-row rider-verify-row anim-stagger" style="--i: {{index < 6 ? index : 0}};">
      <view class="rider-verify-info">
        <view class="act-initiator">
          <image wx:if="{{item.avatarUrl}}" class="act-initiator-avatar" src="{{item.avatarUrl}}" mode="aspectFill"/>
          <view wx:else class="act-initiator-avatar act-initiator-avatar--fallback">{{item.nickName ? item.nickName[0] : '用'}}</view>
          <view class="act-initiator-info">
            <text class="act-initiator-name">{{item.nickName || '用户'}} #{{item.userId}}</text>
            <text class="row-sub">手机：{{item.phone || '未绑定'}}</text>
          </view>
        </view>
        <text class="row-sub">姓名：{{item.realName}} · 学号：{{item.studentId}}</text>
        <text class="row-sub">身份证：{{item.identityNumber}}</text>
        <text class="row-sub">提交时间：{{item.createdAt}}</text>
        <view class="rider-verify-images" wx:if="{{item.campusCredential || item.identityCredential}}">
          <image wx:if="{{item.campusCredential}}" class="verify-img" src="{{item.campusCredential}}" mode="aspectFill" data-src="{{item.campusCredential}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"></image>
          <image wx:if="{{item.identityCredential}}" class="verify-img" src="{{item.identityCredential}}" mode="aspectFill" data-src="{{item.identityCredential}}" bindtap="previewVerifyImg" bindlongpress="onImageQrScan"></image>
        </view>
        <text class="verify-status status-{{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'approved' ? '已通过' : '已驳回'}}</text>
        <text class="row-sub" wx:if="{{item.reviewNote}}">审核备注：{{item.reviewNote}}</text>
      </view>
      <view class="row-actions" wx:if="{{item.status === 'pending'}}">
        <text data-id="{{item.id}}" data-action="approve" bindtap="reviewRiderVerification">通过</text>
        <text class="danger" data-id="{{item.id}}" data-action="reject" bindtap="reviewRiderVerification">驳回</text>
      </view>
    </view>
    <view wx:if="{{!riderVerifications.length}}" class="empty">暂无认证申请</view>
  </view>

  <view wx:if="{{form}}" class="form-mask">
    <view class="form-card">
      <view class="form-title">{{form.kind === 'post' ? '编辑帖子' : form.kind === 'content' ? (form.id ? '编辑' : '新增') + contentFormTitle : form.kind === 'chatReview' ? (form.action === 'approve' ? '通过建群申请' : '驳回建群申请') : form.kind === 'activityAudit' ? '驳回活动' : form.kind === 'clubCategory' ? (form.id ? '编辑社团分类' : '新增社团分类') : form.kind === 'club' ? (form.id ? '编辑社团' : '添加社团') : form.kind === 'chatGroup' ? (form.id ? '编辑群聊' : '添加群聊') : form.kind === 'gcCategory' ? (form.id ? '编辑群聊类别' : '新增群聊类别') : form.kind === 'activity' ? '编辑活动' : form.kind === 'service' ? (form.id ? '编辑服务' : '新增服务') : form.kind === 'drivingSchool' ? (form.id ? '编辑驾校' : '新增驾校') : '虚拟物品'}}</view>

      <block wx:if="{{form.kind === 'content'}}">
        <view class="form-guide">{{contentFormGuide}}</view>
        <block wx:if="{{form.type === 'notice'}}">
          <view class="form-item">
            <view class="form-label">公告文字 <text class="form-req">*</text>（展示在首页顶部公告栏）</view>
            <input data-key="title" value="{{form.title}}" maxlength="60" placeholder="例如：如果你在使用中遇到问题，请联系我们" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">右侧链接文字（显示在公告最右侧，默认"点此查看"）</view>
            <input data-key="meta.linkText" value="{{form.meta.linkText}}" maxlength="12" placeholder="例如：点此查看" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">跳转页面路径（用户点击右侧链接后跳转到该页面；留空则弹出管理员微信二维码）</view>
            <input data-key="meta.linkUrl" value="{{form.meta.linkUrl}}" maxlength="100" placeholder="例如：/pages/service-all/index" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">链接图片（可选；作为公告链接及各页面"添加管理员微信"弹窗展示的图片，建议上传方形二维码图）</view>
            <view class="upload-row" bindtap="chooseFormImage" data-key="tailImage">
              <image class="upload-thumb" wx:if="{{form.meta.tailImage}}" src="{{form.meta.tailImage}}" mode="aspectFill"></image>
              <view wx:else class="upload-add">＋ 上传链接图片</view>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">背景颜色（可选；点击弹出颜色选择器，自定义首页公告栏背景）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
              <view class="color-swatch" style="background: {{form.meta.bgColor || '#fffade'}};"></view>
              <text class="color-value">{{form.meta.bgColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">文字颜色（可选；公告文字与右侧链接将使用该颜色）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
              <view class="color-swatch" style="background: {{form.meta.textColor || '#646566'}};"></view>
              <text class="color-value">{{form.meta.textColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">实时预览（保存后首页公告栏按此效果展示）</view>
            <view class="notice-preview" style="background: {{form.meta.bgColor || '#fffade'}}; color: {{form.meta.textColor || '#646566'}};">
              <text class="notice-preview-text">{{form.title || '公告文字预览效果'}}</text>
              <text class="notice-preview-link">{{form.meta.linkText || '点此查看'}}</text>
              <text class="notice-preview-tail" wx:if="{{form.meta.tailText}}">{{form.meta.tailText}}</text>
            </view>
          </view>
        </block>
        <block wx:elif="{{form.type === 'tag'}}">
          <view class="form-item">
            <view class="form-label">标签名称 <text class="form-req">*</text>（启用后展示在发帖页标签选项中）</view>
            <input data-key="title" value="{{form.title}}" maxlength="20" placeholder="例如：二手好物" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">描述正文（可选，可留空）</view>
            <textarea data-key="body" value="{{form.body}}" placeholder="标签的补充说明，可留空" bindinput="formInput"/>
          </view>
          <view class="form-item">
            <view class="form-label">背景颜色（可选；点击弹出颜色选择器，配置列表将按此颜色展示标签）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
              <view class="color-swatch" style="background: {{form.meta.bgColor || '#eef4ff'}};"></view>
              <text class="color-value">{{form.meta.bgColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">文字颜色（可选；点击弹出颜色选择器）</view>
            <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
              <view class="color-swatch" style="background: {{form.meta.textColor || '#4a6b9c'}};"></view>
              <text class="color-value">{{form.meta.textColor || '使用默认配色'}}</text>
              <text class="color-action">选择 ›</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">实时预览（保存后配置列表中的标签按此效果展示）</view>
            <view class="tag-chip-preview" style="background: {{form.meta.bgColor || '#eef4ff'}}; color: {{form.meta.textColor || '#4a6b9c'}};">{{form.title || '标签预览'}}</view>
          </view>
        </block>
        <block wx:elif="{{form.type === 'banner'}}">
          <view class="form-item">
