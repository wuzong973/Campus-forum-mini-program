.page { min-height: 100vh; padding: 0 24rpx 48rpx; background: var(--bg); }
.hero { margin: 0 -24rpx; padding: 34rpx 32rpx 28rpx; background: #315cff; color: #fff; }
.hero-title { display: block; font-size: 38rpx; font-weight: 600; }
.hero-subtitle { display: block; margin-top: 6rpx; font-size: 24rpx; opacity: .82; }
.tabs { margin: 20rpx -24rpx 24rpx; white-space: nowrap; background: #fff; }
.tabs-inner, .filters-inner, .mini-tabs { display: flex; align-items: center; }
.tab { flex: 0 0 auto; padding: 22rpx 28rpx 18rpx; color: var(--text-secondary); font-size: 28rpx; border-bottom: 4rpx solid transparent; }
.tab.active { color: var(--primary); font-weight: 600; border-color: var(--primary); }
.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.metric { padding: 24rpx; background: #fff; border: 1rpx solid var(--border); border-radius: 12rpx; }
.metric text { display: block; color: var(--primary); font-size: 40rpx; font-weight: 600; }
.metric label { display: block; margin-top: 4rpx; color: var(--text-secondary); font-size: 23rpx; }
.section-title, .section-title-inline { display: block; margin: 28rpx 0 14rpx; font-size: 28rpx; font-weight: 600; }
.list-card { margin-bottom: 16rpx; padding: 24rpx; background: #fff; border: 1rpx solid var(--border); border-radius: 12rpx; }
.audit-row, .compact-row, .section-head, .batch-bar, .toolbar, .post-head, .actions, .row-actions, .switch-row, .form-buttons { display: flex; align-items: center; justify-content: space-between; }
.audit-row { padding: 12rpx 0; color: var(--text-secondary); font-size: 24rpx; border-bottom: 1rpx solid var(--divider); }
.toolbar { height: 72rpx; padding: 0 18rpx; margin-bottom: 16rpx; background: #fff; border-radius: 10rpx; border: 1rpx solid var(--border); }
.toolbar input { flex: 1; height: 100%; font-size: 26rpx; }.toolbar text { color: var(--primary); padding-left: 18rpx; font-size: 26rpx; }
.filters { white-space: nowrap; margin: 0 -6rpx 14rpx; }.filter { flex: 0 0 auto; margin: 0 6rpx; padding: 10rpx 18rpx; background: #fff; color: var(--text-secondary); border-radius: 8rpx; font-size: 23rpx; }.filter.selected { color: #fff; background: var(--primary); }
.batch-bar { margin-bottom: 14rpx; color: var(--text-secondary); font-size: 24rpx; }.plain-btn, .primary-mini { margin: 0; line-height: 56rpx; font-size: 24rpx; }.plain-btn { color: var(--primary); background: #fff; }.primary-mini, .save-btn { color: #fff; background: var(--primary); }.primary-mini::after, .plain-btn::after, .save-btn::after, .cancel-btn::after { border: none; }
.post-row { display: flex; align-items: flex-start; padding-left: 16rpx; }.post-row checkbox { margin: 5rpx 16rpx 0 0; }.post-main { flex: 1; min-width: 0; }
/* 帖子卡片：头像+昵称行（无标题，直接展示正文） */
.post-user-row { display: flex; align-items: center; gap: 14rpx; }
.post-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; background: #eef2f8; }
.post-avatar-fallback { display: flex; align-items: center; justify-content: center; color: #4a6b9c; font-size: 28rpx; font-weight: 600; }
.post-nick { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--text-primary); font-size: 27rpx; font-weight: 600; }
.post-title, .row-title { font-size: 28rpx; font-weight: 500; }.post-content { display: -webkit-box; margin: 14rpx 0 8rpx; overflow: hidden; color: var(--text-primary); font-size: 27rpx; line-height: 1.55; word-break: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.meta, .row-sub { display: block; margin-top: 8rpx; color: var(--text-tertiary); font-size: 22rpx; }.status { flex: 0 0 auto; padding: 3rpx 8rpx; border-radius: 6rpx; color: #fff; font-size: 20rpx; }.s1 { background: #52c41a; }.s2 { background: #faad14; }.s3 { background: #969799; }.s0 { background: #ff4d4f; }.actions { justify-content: flex-start; gap: 24rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid var(--divider); color: var(--primary); font-size: 24rpx; }.danger { color: var(--error) !important; }.section-head { margin: 0 0 16rpx; }.section-head .section-title-inline { margin: 0; }.mini-tabs text { margin-right: 24rpx; color: var(--text-secondary); font-size: 26rpx; }.mini-tabs .on { color: var(--primary); font-weight: 600; }.feature-head { margin-top: 34rpx; }.compact-row { min-height: 94rpx; }
.cert-label-display { display: inline-block; margin-left: 8rpx; padding: 2rpx 10rpx; border-radius: 4rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-size: 20rpx; font-weight: 500; line-height: 1.4; }.row-actions { gap: 20rpx; color: var(--primary); font-size: 24rpx; }.link { color: var(--primary); font-size: 24rpx; }.empty { padding: 48rpx 20rpx; color: var(--text-tertiary); text-align: center; font-size: 26rpx; }
.form-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(0,0,0,.42); }.form-card { width: 100%; max-height: 88vh; padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); overflow-y: auto; background: #fff; border-radius: 16rpx 16rpx 0 0; }.form-title { margin-bottom: 20rpx; font-size: 32rpx; font-weight: 600; }.form-card input, .form-card textarea { width: 100%; min-height: 76rpx; margin-bottom: 16rpx; padding: 16rpx; border: 1rpx solid var(--border); border-radius: 8rpx; font-size: 26rpx; }.form-card textarea { height: 160rpx; }.switch-row { margin: 10rpx 0 22rpx; color: var(--text-secondary); font-size: 26rpx; }.form-buttons { gap: 16rpx; }.form-buttons button { flex: 1; margin: 0; }.cancel-btn { background: #f2f3f5; color: var(--text-primary); }.save-btn { color: #fff; }
/* 首页配置：轮播/公告表单 */
.config-hint { margin: 0 0 16rpx; padding: 14rpx 18rpx; border-radius: 10rpx; background: #eef4ff; color: #4a6b9c; font-size: 22rpx; line-height: 1.5; }
/* 页面横幅管理入口 */
.banner-entry-row { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.banner-entry-row .plain-btn { flex: 1; }
/* 概览：刷新状态条 */
.stats-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; color: var(--text-tertiary); font-size: 22rpx; }
.stats-refresh { color: var(--primary); }
/* 管理员管理 */
.admin-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.self-tag { display: inline-block; margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 4rpx; background: #315cff; color: #fff; font-size: 20rpx; font-weight: 400; vertical-align: 2rpx; }
/* 新增管理员弹窗 */
.picker-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-bottom: 16rpx; padding: 16rpx; border: 1rpx solid var(--border); border-radius: 8rpx; font-size: 26rpx; color: var(--text-primary); }
.picker-value { color: var(--text-secondary); }
/* 操作日志 */
.logs-row { align-items: flex-start; }
.logs-main { flex: 1; min-width: 0; }
.logs-action { display: block; color: var(--text-primary); font-size: 26rpx; font-weight: 500; }
.logs-sub { display: block; margin-top: 6rpx; color: var(--text-tertiary); font-size: 22rpx; word-break: break-all; }
.logs-more { display: flex; justify-content: center; padding: 8rpx 0 24rpx; }
.upload-row { margin-bottom: 16rpx; }
.upload-thumb { width: 320rpx; height: 180rpx; border-radius: 10rpx; background: #f2f4f8; }
.upload-add { display: flex; align-items: center; justify-content: center; width: 320rpx; height: 180rpx; border: 1rpx dashed var(--border, #d9dee8); border-radius: 10rpx; color: var(--text-tertiary); font-size: 24rpx; }
.form-hint { display: block; margin: -6rpx 0 16rpx; color: var(--text-tertiary); font-size: 22rpx; line-height: 1.5; }
/* ===== 内容配置弹窗：与「页面横幅」编辑器统一的表单样式 ===== */
.form-guide { margin-bottom: 24rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #eef4ff; color: #4a6b9c; font-size: 23rpx; line-height: 1.6; }
.form-item { margin-bottom: 24rpx; }
.form-item .form-label { display: block; margin-bottom: 12rpx; color: #667085; font-size: 25rpx; line-height: 1.5; }
.form-req { color: #ff5a5f; }
.form-item input { width: 100%; height: 84rpx; margin-bottom: 0; padding: 0 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; color: var(--text-primary); font-size: 26rpx; box-sizing: border-box; }
.form-item textarea { width: 100%; min-height: 140rpx; margin-bottom: 0; padding: 18rpx 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; color: var(--text-primary); font-size: 26rpx; line-height: 1.6; box-sizing: border-box; }
.form-item .picker-row { margin-bottom: 0; background: #f8fafc; }
/* ===== 横幅自定义颜色：颜色字段 + 实时预览 ===== */
.color-field { display: flex; align-items: center; gap: 16rpx; min-height: 76rpx; padding: 14rpx 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; box-sizing: border-box; }
.color-swatch { flex-shrink: 0; width: 44rpx; height: 44rpx; border: 1rpx solid rgba(0, 0, 0, .08); border-radius: 8rpx; }
.color-value { flex: 1; min-width: 0; overflow: hidden; color: var(--text-primary); font-size: 25rpx; white-space: nowrap; text-overflow: ellipsis; }
.color-action { flex-shrink: 0; color: var(--text-secondary); font-size: 24rpx; }
.banner-preview { display: flex; align-items: center; gap: 12rpx; min-height: 72rpx; padding: 0 24rpx; border-radius: 36rpx; font-size: 26rpx; box-sizing: border-box; }
.banner-preview-icon { flex-shrink: 0; }
.banner-preview-text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 标签彩色芯片（配置列表与预览） */
.tag-chip { display: inline-block; max-width: 100%; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 500; box-sizing: border-box; word-break: break-all; }
.tag-chip-preview { display: inline-block; padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 500; }
/* 公告栏预览 */
.notice-preview { display: flex; align-items: center; gap: 16rpx; min-height: 72rpx; padding: 16rpx 22rpx; border-radius: 14rpx; box-sizing: border-box; }
.notice-preview-text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 24rpx; }
.notice-preview-link { flex-shrink: 0; margin-left: -8rpx; color: #3478f6; font-size: 24rpx; font-weight: 600; }
.notice-preview-tail { flex-shrink: 0; padding: 4rpx 14rpx; border-radius: 999rpx; background: rgba(0, 0, 0, .06); font-size: 20rpx; }
/* 轮播主题色预览 */
.banner-accent-preview { display: flex; align-items: stretch; gap: 16rpx; padding: 20rpx; border: 1rpx solid var(--border); border-radius: 12rpx; background: #f8fafc; box-sizing: border-box; }
.banner-accent-strip { flex-shrink: 0; width: 10rpx; border-radius: 6rpx; background: #4A7AFF; }
.banner-accent-main { flex: 1; min-width: 0; }
.banner-accent-tag { display: inline-block; margin-bottom: 6rpx; padding: 2rpx 12rpx; border-radius: 6rpx; background: rgba(74, 122, 255, .12); color: #4A7AFF; font-size: 20rpx; }
.banner-accent-title { display: block; overflow: hidden; color: var(--text-primary); font-size: 27rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.banner-accent-sub { display: block; margin-top: 4rpx; overflow: hidden; color: var(--text-secondary); font-size: 22rpx; white-space: nowrap; text-overflow: ellipsis; }
/* ===== 列表行防截断：主内容占满剩余宽度并可换行，操作按钮不被挤压 ===== */
.compact-row > view:first-child { flex: 1; min-width: 0; margin-right: 16rpx; }
.row-title { word-break: break-all; white-space: normal; }

/* ===== 日志 tab：跑腿订单流程 ===== */
.errand-log-card { display: block; }
.errand-card-hover { opacity: .75; }
.errand-log-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.errand-flow { display: block; margin-top: 10rpx; color: var(--text-secondary); font-size: 25rpx; line-height: 1.5; }
.errand-status { flex: 0 0 auto; padding: 3rpx 10rpx; border-radius: 6rpx; color: #fff; font-size: 20rpx; }
.st-pending { background: #faad14; }
.st-accepted { background: #315cff; }
.st-finished { background: #52c41a; }
.st-cancelled { background: #969799; }

/* 订单流程详情弹窗 */
.errand-detail-users { display: flex; gap: 16rpx; margin: 8rpx 0 16rpx; }
.errand-user-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 18rpx 12rpx; background: #f7f9fc; border-radius: 12rpx; }
.errand-user-col .post-avatar { width: 76rpx; height: 76rpx; }
.errand-user-name { max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--text-primary); font-size: 25rpx; font-weight: 600; }
.errand-user-sub { color: var(--text-tertiary); font-size: 22rpx; }
.errand-detail-info { display: flex; flex-direction: column; gap: 8rpx; padding: 16rpx; background: #f7f9fc; border-radius: 12rpx; }
.errand-info-row { color: var(--text-secondary); font-size: 24rpx; line-height: 1.5; }
/* 流程时间线 */
.errand-timeline { margin-top: 18rpx; }
.errand-timeline-title { margin-bottom: 12rpx; color: var(--text-primary); font-size: 27rpx; font-weight: 600; }
.errand-timeline-item { position: relative; display: flex; gap: 16rpx; padding: 0 0 20rpx 26rpx; border-left: 3rpx solid #dfe6f0; margin-left: 8rpx; }
.errand-timeline-item:last-child { border-left-color: transparent; padding-bottom: 4rpx; }
.errand-timeline-dot { position: absolute; left: -11rpx; top: 4rpx; width: 18rpx; height: 18rpx; border-radius: 50%; background: #315cff; }
.errand-timeline-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.errand-timeline-text { color: var(--text-primary); font-size: 25rpx; line-height: 1.5; }
.errand-timeline-sub { color: var(--text-tertiary); font-size: 22rpx; line-height: 1.5; }
.errand-timeline-time { color: var(--text-tertiary); font-size: 21rpx; }

/* ===== 群聊管理 tab ===== */
.chat-apply-row { flex-direction: column; align-items: stretch; gap: 8rpx; }
.chat-apply-info { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.chat-apply-status { margin-left: 12rpx; font-size: 20rpx; font-weight: 600; border-radius: 8rpx; padding: 3rpx 10rpx; vertical-align: middle; }
.chat-apply-status.cs-pending { color: #e8940a; background: rgba(245, 167, 10, 0.14); }
.chat-apply-status.cs-approved { color: #3aa356; background: rgba(22, 182, 100, 0.12); }
.chat-apply-status.cs-rejected { color: #e34d4d; background: rgba(240, 68, 56, 0.10); }
.chat-apply-intro { color: var(--text-secondary); }

/* ===== 社团管理 tab ===== */
.club-admin-card { flex-direction: column; align-items: stretch; gap: 0; }
.club-admin-head { display: flex; align-items: center; gap: 18rpx; }
.club-admin-char { width: 76rpx; height: 76rpx; border-radius: 20rpx; color: #ffffff; font-size: 34rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.club-admin-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.club-admin-arrow { color: var(--text-tertiary); font-size: 23rpx; flex-shrink: 0; }
.club-admin-body { margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--border-color, #eef1f5); }
.club-admin-slogan { margin-bottom: 12rpx; }
.club-admin-actions { margin-bottom: 14rpx; }
.club-admin-club { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 14rpx 0; border-top: 1rpx dashed var(--border-color, #eef1f5); }
.club-admin-club-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.club-admin-club-name { color: var(--text-primary); font-size: 26rpx; font-weight: 600; }
.club-admin-off { color: #e8940a; font-size: 22rpx; font-weight: 400; }

/* ===== 「社团/群聊」合并导航：父级菜单下的子页面切换入口 ===== */
.sub-tabs { display: flex; align-items: stretch; margin-bottom: 20rpx; background: #fff; border: 1rpx solid var(--border); border-radius: 12rpx; overflow: hidden; }
.sub-tab { flex: 1; padding: 20rpx 0 16rpx; color: var(--text-secondary); font-size: 28rpx; text-align: center; border-bottom: 4rpx solid transparent; transition: background-color .15s ease; }
.sub-tab.active { color: var(--primary); font-weight: 600; border-color: var(--primary); background: #f5f8ff; }

/* 官方群标记 */
.official-tag { margin-left: 12rpx; font-size: 20rpx; font-weight: 600; color: #ffffff; background: #1a1c20; border-radius: 8rpx; padding: 3rpx 10rpx; vertical-align: middle; }

/* 自定义群标签（管理员配置 + 列表展示） */
.custom-tag { margin-left: 12rpx; font-size: 20rpx; font-weight: 600; color: #2e6bff; background: rgba(46, 107, 255, 0.10); border-radius: 8rpx; padding: 3rpx 10rpx; vertical-align: middle; }
.tag-input-row { display: flex; align-items: center; gap: 16rpx; }
.tag-input-row .tag-input { flex: 1; }

/* 校区选择网格（表单内，参照设计稿 2×2 高亮样式） */
.campus-grid { margin-top: 14rpx; display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.campus-option { height: 80rpx; border-radius: 12rpx; background: #f2f3f5; border: 3rpx solid transparent; color: var(--text-secondary, #4a5468); font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
.campus-option--active { background: #eef4ff; border-color: #315cff; color: #315cff; }

/* ===== 活动管理 ===== */
.act-admin-row { flex-direction: row; align-items: stretch; gap: 18rpx; }
.act-admin-cover { width: 120rpx; height: 120rpx; border-radius: 14rpx; background: #eef1f5; flex-shrink: 0; }
.act-admin-cover--fallback { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #5ba8ff 0%, #315cff 100%); }
.act-admin-cover--fallback text { color: #ffffff; font-size: 24rpx; font-weight: 600; }
.act-admin-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.act-admin-actions { flex-direction: column; justify-content: center; align-items: flex-end; gap: 10rpx; }

/* 活动发起人信息（头像/昵称/手机号） */
.act-initiator { margin-top: 10rpx; display: flex; align-items: center; gap: 14rpx; padding: 12rpx 16rpx; background: #f7f9fc; border-radius: 12rpx; }
.act-initiator-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #e3ecff; color: #315cff; font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.act-initiator-avatar--fallback { background: linear-gradient(135deg, #5ba8ff 0%, #315cff 100%); color: #ffffff; }
.act-initiator-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.act-initiator-name { color: var(--text-primary, #1a1a1a); font-size: 24rpx; font-weight: 600; }
