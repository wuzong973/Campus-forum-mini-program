    <!-- ============ pushGroup：信息推送群卡片 ============ -->
    <block wx:elif="{{scope === 'pushGroup'}}">
      <view class="form-item">
        <view class="form-label">卡片标题 <text class="form-req">*</text>（30 字内）</view>
        <input data-key="title" value="{{form.title}}" maxlength="30" placeholder="例如：点击进入树洞消息推送群" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">描述（60 字内，展示在标题下方）</view>
        <input data-key="desc" value="{{form.desc}}" maxlength="60" placeholder="例如：推送树洞和大学城消息，浏览校园互动" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">图标图片（选填，上传后优先显示图片；建议 1:1 方形图）</view>
        <view class="upload-row" bindtap="chooseFormImage" data-key="iconPath">
          <image class="upload-thumb" wx:if="{{form.iconPath}}" src="{{form.iconPath}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传图标图片</view>
        </view>
        <view class="upload-clear" wx:if="{{form.iconPath}}" catchtap="clearFormImage" data-key="iconPath">清除图标图片</view>
      </view>
      <view class="form-item">
        <view class="form-label">图标文字（未上传图片时生效：表情或文字，最多 4 字；填「微信」显示微信绿标，留空不显示）</view>
        <input data-key="icon" value="{{form.icon}}" maxlength="4" placeholder="例如：💬 或 微信" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">配色（卡片底色与边框色系）</view>
        <picker mode="selector" range="{{pushGroupThemeOptions}}" value="{{form.themeIndex}}" bindchange="onPushGroupThemeChange">
          <view class="picker-row"><text>色系</text><text class="picker-value">{{pushGroupThemeOptions[form.themeIndex] || '请选择'}} ›</text></view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">卡片正文（选填，详情页展示；换行分段，可用下方工具栏加样式）</view>
        <richtext-editor data-key="content" value="{{form.content}}" maxlength="2000" placeholder="例如：进群先看群公告，禁止广告与私聊骚扰…" bindinput="formInput"></richtext-editor>
      </view>
      <view class="form-item">
        <view class="form-label">配图（选填，最多 3 张，详情页正文下方展示，用户点击可全屏预览）</view>
        <view class="img-grid">
          <view class="img-item" wx:for="{{form.images}}" wx:key="index">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"></image>
            <text class="img-remove" data-index="{{index}}" catchtap="removeImage">×</text>
          </view>
          <view wx:if="{{form.images.length < 3}}" class="upload-add upload-add--grid" bindtap="addImages" data-max="3">＋</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">跳转链接（选填，/pages/ 或 https:// 开头；填了则详情页出现「立即前往」按钮）</view>
        <input data-key="link" value="{{form.link}}" maxlength="200" placeholder="例如：/pages/group-chat/index" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">复制文本（选填，如微信号；填了则详情页出现「复制微信号」按钮）</view>
        <input data-key="copyText" value="{{form.copyText}}" maxlength="64" placeholder="例如：Wenroujun1" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">排序（数字越小越靠前）</view>
        <input data-key="sortOrder" type="number" value="{{form.sortOrder}}" placeholder="0" bindinput="formInput"/>
      </view>
      <label class="switch-row"><text>启用状态（关闭即对用户隐藏）</text><switch checked="{{form.status}}" color="#315CFF" bindchange="onPushGroupStatusChange"/></label>
    </block>

    <!-- ============ gcCategory：群聊类别 ============ -->
    <block wx:elif="{{scope === 'gcCategory'}}">
      <view class="form-item">
        <view class="form-label">类别名称 <text class="form-req">*</text>（展示在用户端群聊宫格与建群申请选择器）</view>
        <input data-key="name" value="{{form.name}}" maxlength="12" placeholder="例如：学院群" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">类别描述（宫格卡片副标题，可留空）</view>
        <input data-key="description" value="{{form.description}}" maxlength="30" placeholder="例如：各学院群聊" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">排序（数字越小越靠前）</view>
        <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
      </view>
    </block>

    <!-- ============ clubCategory：社团分类 ============ -->
    <block wx:elif="{{scope === 'clubCategory'}}">
      <view class="form-item">
        <view class="form-label">分类名称 <text class="form-req">*</text>（展示在社团&组织页卡片）</view>
        <input data-key="name" value="{{form.name}}" maxlength="20" placeholder="例如：艺术类" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">图标字符（单字，展示在分类卡片的彩色图标上）</view>
        <input data-key="iconChar" value="{{form.iconChar}}" maxlength="2" placeholder="例如：艺" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">副标语（卡片第二行文字）</view>
        <input data-key="slogan" value="{{form.slogan}}" maxlength="30" placeholder="例如：捕捉灵感，创造无限之美" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">主题色（前端按此颜色自动生成渐变、浅色底与阴影）</view>
        <view class="color-field" bindtap="openContentColorPicker" data-field="color">
          <view class="color-swatch" style="background: {{form.meta.color || '#2E6BFF'}};"></view>
          <text class="color-value">{{form.meta.color || '选择主题色'}}</text>
          <text class="color-action">选择 ›</text>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">分类定位介绍（详情页第一板块）</view>
        <textarea data-key="position" value="{{form.position}}" maxlength="1000" placeholder="介绍该分类的定位与整体情况…" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">涵盖范围介绍</view>
        <input data-key="scopeIntro" value="{{form.scopeIntro}}" maxlength="200" placeholder="对涵盖范围的整体说明" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">涵盖范围（用顿号或逗号分隔）</view>
        <textarea data-key="scopeText" value="{{form.scopeText}}" maxlength="500" placeholder="例如：街舞社、民乐团、吉他社、合唱团" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">特色说明（每行一条，格式：标题|描述）</view>
        <textarea data-key="featuresText" value="{{form.featuresText}}" maxlength="2000" placeholder="例如：舞台实践|每年承办迎新晚会、校园十佳歌手大赛等大型演出" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">加入咨询文案（详情页底部展示，可复制）</view>
        <input data-key="contact" value="{{form.contact}}" maxlength="100" placeholder="例如：艺术类招新咨询：大学生社团联合会" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">排序（数字越小越靠前）</view>
        <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
      </view>
    </block>

    <!-- ============ club：社团 ============ -->
    <block wx:elif="{{scope === 'club'}}">
      <view class="form-item">
        <view class="form-label">所属分类</view>
        <picker mode="selector" range="{{clubCategoryNames}}" value="{{form.categoryIndex}}" bindchange="onClubCategoryChange">
          <view class="picker-row"><text>分类</text><text class="picker-value">{{clubCategoryNames[form.categoryIndex] || '请选择'}} ›</text></view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">社团类型（当前仅支持学生社团）</view>
        <view class="picker-row"><text>类型</text><text class="picker-value">{{form.clubType || '学生社团'}}</text></view>
      </view>
      <view class="form-item">
        <view class="form-label">所属校区（用户端按校区筛选展示；「全部校区」在所有校区可见）</view>
        <view class="campus-grid">
          <view wx:for="{{campusOptions}}" wx:key="value" class="campus-option {{form.campus === item.value ? 'campus-option--active' : ''}}" data-value="{{item.value}}" bindtap="onFormCampus">{{item.label}}</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">社团名称 <text class="form-req">*</text></view>
        <input data-key="name" value="{{form.name}}" maxlength="30" placeholder="例如：街舞社" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">社团头像（申请时上传）</view>
        <view class="upload-row" bindtap="chooseFormImage" data-key="avatarUrl">
          <image class="upload-thumb" wx:if="{{form.meta.avatarUrl}}" src="{{form.meta.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传社团头像</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">社团二维码（招新群/联系方式）</view>
        <view class="upload-row" bindtap="chooseFormImage" data-key="qrcodeUrl">
          <image class="upload-thumb" wx:if="{{form.meta.qrcodeUrl}}" src="{{form.meta.qrcodeUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传社团二维码</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">负责人微信二维码</view>
        <view class="upload-row" bindtap="chooseFormImage" data-key="adminQrcodeUrl">
          <image class="upload-thumb" wx:if="{{form.meta.adminQrcodeUrl}}" src="{{form.meta.adminQrcodeUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传负责人微信二维码</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">公众号二维码（选填）</view>
        <view class="upload-row" bindtap="chooseFormImage" data-key="gzhQrcodeUrl">
          <image class="upload-thumb" wx:if="{{form.meta.gzhQrcodeUrl}}" src="{{form.meta.gzhQrcodeUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传公众号二维码</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">图片介绍（选填，最多 5 张）</view>
        <view class="img-grid">
          <view class="img-item" wx:for="{{form.meta.images}}" wx:key="index">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"></image>
            <text class="img-remove" data-index="{{index}}" catchtap="removeImage">×</text>
          </view>
          <view wx:if="{{form.meta.images.length < 5}}" class="upload-add upload-add--grid" bindtap="addImages" data-max="5">＋</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">标签（用 · 分隔）</view>
        <input data-key="tags" value="{{form.tags}}" maxlength="60" placeholder="例如：舞蹈 · 演出 · 斗舞赛" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">社团简介</view>
        <richtext-editor data-key="intro" value="{{form.intro}}" maxlength="1000" placeholder="社团详细介绍…" bindinput="formInput"></richtext-editor>
      </view>
      <view class="form-item">
        <view class="form-label">招新说明</view>
        <input data-key="recruit" value="{{form.recruit}}" maxlength="120" placeholder="例如：每年 9 月招新，零基础可加入训练营" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">排序（数字越小越靠前）</view>
        <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
      </view>
    </block>

    <!-- ============ chatGroup：群聊 ============ -->
    <block wx:elif="{{scope === 'chatGroup'}}">
      <view class="form-group-title">基础信息</view>
      <view class="form-item">
        <view class="form-label">群聊名称 <text class="form-req">*</text><text class="form-counter">{{form.name.length || 0}}/30</text></view>
        <input data-key="name" value="{{form.name}}" maxlength="30" placeholder="例如：2026 级新生交流群" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">群类别 <text class="form-req">*</text>（决定用户端「广轻群聊」下的分类归属）</view>
        <picker mode="selector" range="{{chatCategoryNames}}" value="{{form.categoryIndex}}" bindchange="onChatCategoryChange">
          <view class="picker-row"><text>类别</text><text class="picker-value">{{chatCategoryNames[form.categoryIndex] || '请选择'}} ›</text></view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">所属校区（用户端按校区筛选展示；「全部校区」在所有校区可见）</view>
        <view class="campus-grid campus-grid--triple">
          <view wx:for="{{campusOptions}}" wx:key="value" class="campus-option {{form.campus === item.value ? 'campus-option--active' : ''}}" data-value="{{item.value}}" bindtap="onFormCampus">{{item.label}}</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label">群介绍 <text class="form-req">*</text>（展示在用户端群聊列表，一句话说清这个群是干什么的）<text class="form-counter">{{form.intro.length || 0}}/300</text></view>
        <textarea data-key="intro" value="{{form.intro}}" maxlength="300" placeholder="例如：为所有对桌游感兴趣的同学提供尽可能完整的桌游体验" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">群公告（选填，展示在用户端群详情顶部，写进群须知、活动时间等）<text class="form-counter">{{form.notice.length || 0}}/500</text></view>
        <richtext-editor data-key="notice" value="{{form.notice}}" maxlength="500" placeholder="例如：进群请先改备注为「年级-专业-昵称」；每周六晚 19:30 在社团活动室固定开局" bindinput="formInput"></richtext-editor>
      </view>

      <view class="form-group-title">群成员与进群权限</view>
      <view class="form-config-hint">微信群成员在微信内管理，这里维护的是展示信息与进群规则，用户端群详情会据此提示。</view>
      <view class="form-item">
        <view class="form-label">群主 / 负责人（选填，展示在用户端群详情，便于成员知道找谁）<text class="form-counter">{{form.ownerName.length || 0}}/32</text></view>
        <input data-key="ownerName" value="{{form.ownerName}}" maxlength="32" placeholder="例如：桌游社-小林" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">群成员数（选填，仅用于展示，留空或 0 则不显示）</view>
        <input data-key="memberCount" value="{{form.memberCount}}" type="number" maxlength="6" placeholder="例如：200" bindinput="formInput"/>
      </view>
