        <view class="form-label">进群方式（决定用户端「加入方式」区块的文案）</view>
        <picker mode="selector" range="{{joinModeLabels}}" value="{{form.joinModeIndex}}" bindchange="onChatJoinModeChange">
          <view class="picker-row"><text>方式</text><text class="picker-value">{{joinModeLabels[form.joinModeIndex]}} ›</text></view>
        </picker>
      </view>
      <label class="switch-row"><text>进群需管理员审核（用户端会提示「进群后请等待管理员审核」）</text><switch checked="{{form.needAudit}}" color="#315CFF" bindchange="formNeedAudit"/></label>

      <view class="form-group-title">展示素材</view>
      <view class="form-item">
        <view class="form-label">群头像（用户端列表与详情头像；未上传时按群名首字自动生成）</view>
        <view class="upload-row" bindtap="chooseFormImage" data-key="avatarUrl">
          <image class="upload-thumb" wx:if="{{form.meta.avatarUrl}}" src="{{form.meta.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传群头像</view>
        </view>
        <view class="upload-clear" wx:if="{{form.meta.avatarUrl}}" catchtap="clearFormImage" data-key="avatarUrl">清除群头像</view>
      </view>
      <view class="form-item">
        <view class="form-label">群二维码（用户端群详情「加入方式」展示，可长按保存）<text class="form-req" wx:if="{{joinModeLabels[form.joinModeIndex] === '扫码进群'}}">*</text></view>
        <view class="upload-row upload-row--qr" bindtap="chooseFormImage" data-key="qrcodeUrl">
          <image class="upload-thumb upload-thumb--qr" wx:if="{{form.meta.qrcodeUrl}}" src="{{form.meta.qrcodeUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add upload-add--qr">＋ 上传群二维码</view>
        </view>
        <view class="upload-clear" wx:if="{{form.meta.qrcodeUrl}}" catchtap="clearFormImage" data-key="qrcodeUrl">清除群二维码</view>
        <view class="upload-tip" wx:if="{{joinModeLabels[form.joinModeIndex] === '扫码进群' && !form.meta.qrcodeUrl}}">当前进群方式为「扫码进群」，未上传群二维码用户将无法进群，保存时会被拦下。</view>
      </view>
      <view class="form-item">
        <view class="form-label">公众号二维码（选填，用户端群详情「群管理」卡展示）</view>
        <view class="upload-row upload-row--qr" bindtap="chooseFormImage" data-key="gzhQrcodeUrl">
          <image class="upload-thumb upload-thumb--qr" wx:if="{{form.meta.gzhQrcodeUrl}}" src="{{form.meta.gzhQrcodeUrl}}" mode="aspectFill"></image>
          <view wx:else class="upload-add upload-add--qr">＋ 上传公众号二维码</view>
        </view>
        <view class="upload-clear" wx:if="{{form.meta.gzhQrcodeUrl}}" catchtap="clearFormImage" data-key="gzhQrcodeUrl">清除公众号二维码</view>
      </view>
      <view class="form-item">
        <view class="form-label">图片介绍（选填，最多 5 张，展示在用户端群聊详情）<text class="form-counter">{{form.meta.images.length || 0}}/5</text></view>
        <view class="img-grid">
          <view class="img-item" wx:for="{{form.meta.images}}" wx:key="index">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"></image>
            <text class="img-remove" data-index="{{index}}" catchtap="removeImage">×</text>
          </view>
          <view wx:if="{{form.meta.images.length < 5}}" class="upload-add upload-add--grid" bindtap="addImages" data-max="5">＋</view>
        </view>
      </view>

      <view class="form-group-title">展示与状态</view>
      <label class="switch-row"><text>官方群标记（用户端群名右侧展示黑色「官方」徽标）</text><switch checked="{{form.isOfficial}}" color="#315CFF" bindchange="formOfficial"/></label>
