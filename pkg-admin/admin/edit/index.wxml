<!-- 管理后台独立编辑页（取代原抽屉表单）
     一个页面按 scope 渲染对应表单；布局与 pages/banner-detail 编辑态风格统一（整页 + 底部固定操作条）。 -->
<view class="edit-page">
  <view wx:if="{{loadError}}" class="load-error">
    <text class="load-error-text">{{loadError}}</text>
    <view class="load-error-btn" bindtap="onCancel">返回列表</view>
  </view>

  <block wx:elif="{{loaded}}">
    <!-- 操作指引（内容配置/群聊等长表单给出分步说明，与抽屉一致） -->
    <view class="form-guide" wx:if="{{scope === 'content' && contentFormGuide}}">{{contentFormGuide}}</view>
    <view class="form-guide" wx:elif="{{scope === 'chatGroup'}}">操作指引：① 基础信息里「群聊名称 / 群类别 / 群介绍」为必填；② 群公告与群成员、进群权限按需维护；③ 进群方式选「扫码进群」时必须上传群二维码，否则用户无法进群；④ 打开底部「启用状态」；⑤ 点击「保存{{editingId ? '修改' : '并上架'}}」。下架后用户端「广轻群聊」立即不可见。</view>
    <view class="form-guide" wx:elif="{{scope === 'chatReview'}}">申请群名：{{applyName}}（仅支持微信群）</view>
    <view class="form-guide" wx:elif="{{scope === 'clubReview'}}">申请社团：{{applyName}}（审核通过后出现在用户端「社团&组织」的对应分类中）</view>
    <view class="form-guide" wx:elif="{{scope === 'activityAudit'}}">活动名称：{{activityTitle}}</view>

    <!-- ============ content：公告 / 标签 / 轮播 / 发布横幅（4 子型） ============ -->
    <block wx:if="{{scope === 'content'}}">
      <block wx:if="{{form.type === 'notice'}}">
        <view class="form-item">
          <view class="form-label">公告文字 <text class="form-req">*</text>（展示在首页顶部公告栏）</view>
          <input data-key="title" value="{{form.title}}" maxlength="60" placeholder="例如：如果你在使用中遇到问题，请联系我们" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">右侧链接文字（显示在公告最右侧，默认"点此查看"）</view>
          <input data-key="meta.linkText" value="{{form.meta.linkText}}" maxlength="12" placeholder="例如：点此查看" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">跳转页面路径（用户点击右侧链接后跳转到该页面；留空则弹出管理员微信二维码）</view>
          <input data-key="meta.linkUrl" value="{{form.meta.linkUrl}}" maxlength="100" placeholder="例如：/pages/service-all/index" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">链接图片（可选；作为公告链接及各页面"添加管理员微信"弹窗展示的图片，建议上传方形二维码图）</view>
          <view class="upload-row" bindtap="chooseFormImage" data-key="tailImage">
            <image class="upload-thumb" wx:if="{{form.meta.tailImage}}" src="{{form.meta.tailImage}}" mode="aspectFill"></image>
            <view wx:else class="upload-add">＋ 上传链接图片</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">背景颜色（可选；点击弹出颜色选择器，自定义首页公告栏背景）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
            <view class="color-swatch" style="background: {{form.meta.bgColor || '#fffade'}};"></view>
            <text class="color-value">{{form.meta.bgColor || '使用默认配色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">文字颜色（可选；公告文字与右侧链接将使用该颜色）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
            <view class="color-swatch" style="background: {{form.meta.textColor || '#646566'}};"></view>
            <text class="color-value">{{form.meta.textColor || '使用默认配色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">实时预览（保存后首页公告栏按此效果展示）</view>
          <view class="notice-preview" style="background: {{form.meta.bgColor || '#fffade'}}; color: {{form.meta.textColor || '#646566'}};">
            <text class="notice-preview-text">{{form.title || '公告文字预览效果'}}</text>
            <text class="notice-preview-link">{{form.meta.linkText || '点此查看'}}</text>
            <text class="notice-preview-tail" wx:if="{{form.meta.tailText}}">{{form.meta.tailText}}</text>
          </view>
        </view>
      </block>

      <block wx:elif="{{form.type === 'tag'}}">
        <view class="form-item">
          <view class="form-label">标签名称 <text class="form-req">*</text>（启用后展示在发帖页标签选项中）</view>
          <input data-key="title" value="{{form.title}}" maxlength="20" placeholder="例如：二手好物" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">描述正文（可选，可留空）</view>
          <textarea data-key="body" value="{{form.body}}" placeholder="标签的补充说明，可留空" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">背景颜色（可选；点击弹出颜色选择器，配置列表将按此颜色展示标签）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
            <view class="color-swatch" style="background: {{form.meta.bgColor || '#eef4ff'}};"></view>
            <text class="color-value">{{form.meta.bgColor || '使用默认配色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">文字颜色（可选；点击弹出颜色选择器）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
            <view class="color-swatch" style="background: {{form.meta.textColor || '#4a6b9c'}};"></view>
            <text class="color-value">{{form.meta.textColor || '使用默认配色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">实时预览（保存后配置列表中的标签按此效果展示）</view>
          <view class="tag-chip-preview" style="background: {{form.meta.bgColor || '#eef4ff'}}; color: {{form.meta.textColor || '#4a6b9c'}};">{{form.title || '标签预览'}}</view>
        </view>
      </block>

      <block wx:elif="{{form.type === 'banner'}}">
        <view class="form-item">
          <view class="form-label">主标题 <text class="form-req">*</text>（展示在首页轮播图上）</view>
          <input data-key="title" value="{{form.title}}" maxlength="30" placeholder="例如：AI 课表助手" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">轮播图片 <text class="form-req">*</text>（建议宽高比 16:9，点击图片可更换）</view>
          <view class="upload-row" bindtap="chooseFormImage" data-key="image">
            <image class="upload-thumb" wx:if="{{form.meta.image}}" src="{{form.meta.image}}" mode="aspectFill"></image>
            <view wx:else class="upload-add">＋ 上传轮播图片</view>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">内容描述（可选）</view>
          <input data-key="meta.subtitle" value="{{form.meta.subtitle}}" maxlength="40" placeholder="例如：上传课表截图，自动拆解课程" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">角标（可选，展示在轮播图角落）</view>
          <input data-key="meta.tag" value="{{form.meta.tag}}" maxlength="10" placeholder="例如：课表助手" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">点击跳转路径（可选；小程序内部页面填 /pages/... 路径）</view>
          <input data-key="meta.link" value="{{form.meta.link}}" placeholder="例如：/pages/schedule/index" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">主题色（可选；点击弹出颜色选择器，展示在轮播图左上角色条）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="accent">
            <view class="color-swatch" style="background: {{form.meta.accent || '#4A7AFF'}};"></view>
            <text class="color-value">{{form.meta.accent || '使用默认主题色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">实时预览（保存后首页轮播按此主题色展示）</view>
          <view class="banner-accent-preview">
            <view class="banner-accent-strip" style="background: {{form.meta.accent || '#4A7AFF'}};"></view>
            <view class="banner-accent-main">
              <text class="banner-accent-tag" wx:if="{{form.meta.tag}}">{{form.meta.tag}}</text>
              <text class="banner-accent-title">{{form.title || '轮播主标题预览'}}</text>
              <text class="banner-accent-sub" wx:if="{{form.meta.subtitle}}">{{form.meta.subtitle}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:elif="{{form.type === 'publish_banner'}}">
        <view class="form-item">
          <view class="form-label">横幅文字 <text class="form-req">*</text>（展示在「发布帖子」「发布跑腿」页顶部）</view>
          <input data-key="title" value="{{form.title}}" maxlength="40" placeholder="例如：禁止引导私下交易，违规封禁！" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">预设配色（未设置自定义颜色时生效）</view>
          <picker mode="selector" range="{{styleNames}}" value="{{form.meta.styleIndex}}" bindchange="onFormStyleChange">
            <view class="picker-row"><text>颜色</text><text class="picker-value">{{styleNames[form.meta.styleIndex]}} ›</text></view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">背景颜色（可选；点击弹出颜色选择器，设置后优先于预设配色）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="bgColor">
            <view class="color-swatch" style="background: {{form.meta.bgColor || '#f0f2f5'}};"></view>
            <text class="color-value">{{form.meta.bgColor || '跟随预设配色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">文字颜色（可选；点击弹出颜色选择器）</view>
          <view class="color-field" bindtap="openContentColorPicker" data-field="textColor">
            <view class="color-swatch" style="background: {{form.meta.textColor || '#f0f2f5'}};"></view>
            <text class="color-value">{{form.meta.textColor || '跟随预设配色'}}</text>
            <text class="color-action">选择 ›</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">实时预览（保存后在发布页顶部按此效果展示）</view>
          <view class="banner-preview" style="background: {{form.meta.bgColor || styleBg[form.meta.style]}}; color: {{form.meta.textColor || styleFg[form.meta.style]}};">
            <text class="banner-preview-icon" wx:if="{{form.meta.icon}}">{{form.meta.icon}}</text>
            <text class="banner-preview-text">{{form.title || '横幅文字预览效果'}}</text>
          </view>
        </view>
        <view class="form-item">
          <view class="form-label">小图标（emoji，可选，展示在横幅文字前）</view>
          <input data-key="meta.icon" value="{{form.meta.icon}}" maxlength="4" placeholder="例如：🚫 或 ⚠️" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">跳转链接（可选；用户点击横幅后跳转，填 /pages/... 页面路径或 https 网页；留空则跳转横幅详情页）</view>
          <input data-key="meta.link" value="{{form.meta.link}}" maxlength="200" placeholder="例如：/pages/service-all/index" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">链接文字（可选；详情页底部相关链接的显示文字）</view>
          <input data-key="meta.linkText" value="{{form.meta.linkText}}" maxlength="20" placeholder="例如：查看详情" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">详情标题（可选；横幅详情页大标题）</view>
          <input data-key="meta.detailTitle" value="{{form.meta.detailTitle}}" maxlength="60" placeholder="例如：规范发帖公告" bindinput="formInput"/>
        </view>
        <view class="form-item">
          <view class="form-label">详情内容（可选；横幅详情页正文，换行分段）</view>
          <textarea data-key="meta.detailContent" value="{{form.meta.detailContent}}" maxlength="2000" placeholder="向用户详细说明横幅内容…" bindinput="formInput"/>
        </view>
      </block>

      <view class="form-item">
        <view class="form-label">排序（数字越小越靠前）</view>
        <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
      </view>
    </block>

    <!-- ============ item：虚拟物品 ============ -->
    <block wx:elif="{{scope === 'item'}}">
      <view class="form-item">
        <view class="form-label">物品名称</view>
        <input data-key="name" value="{{form.name}}" placeholder="物品名称" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">价格（元）</view>
        <input data-key="price" value="{{form.price}}" type="digit" placeholder="价格" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">库存</view>
        <input data-key="stock" value="{{form.stock}}" type="number" placeholder="库存" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">封面地址（可选）</view>
        <input data-key="coverUrl" value="{{form.coverUrl}}" placeholder="封面地址（可选）" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">物品说明</view>
        <textarea data-key="description" value="{{form.description}}" placeholder="物品说明" bindinput="formInput"/>
      </view>
    </block>

    <!-- ============ service：校园服务 ============ -->
    <block wx:elif="{{scope === 'service'}}">
      <view class="form-item">
        <view class="form-label">服务名称 <text class="form-req">*</text></view>
        <input data-key="name" value="{{form.name}}" maxlength="32" placeholder="例如：乘车码" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">所属分类</view>
        <picker mode="selector" range="{{serviceCategoryNames}}" value="{{form.categoryIndex}}" bindchange="onServiceCategoryChange">
          <view class="picker-row"><text>分类</text><text class="picker-value">{{serviceCategoryNames[form.categoryIndex] || '请选择'}} ›</text></view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">图标 Emoji</view>
        <input data-key="icon" value="{{form.icon}}" maxlength="4" placeholder="例如：🚌（本地图标可留空）" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">本地图标路径（可选）</view>
        <input data-key="iconPath" value="{{form.iconPath}}" placeholder="/assets/icons/xxx.png" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">角标（可选）</view>
        <input data-key="badge" value="{{form.badge}}" maxlength="8" placeholder="例如：推荐" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">外部小程序 AppID（可选）</view>
        <input data-key="miniAppId" value="{{form.miniAppId}}" maxlength="64" placeholder="wx 开头，跳转小程序优先于链接" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">H5 链接（可选）</view>
        <input data-key="link" value="{{form.link}}" placeholder="https:// 或 http://" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">排序（越小越前）</view>
        <input data-key="sortOrder" value="{{form.sortOrder}}" type="number" placeholder="0" bindinput="formInput"/>
      </view>
    </block>

    <!-- ============ drivingSchool：驾校 ============ -->
    <block wx:elif="{{scope === 'drivingSchool'}}">
      <view class="form-item">
        <view class="form-label">驾校名称 <text class="form-req">*</text></view>
        <input data-key="name" value="{{form.name}}" maxlength="64" placeholder="例如：驾顺驾校" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">校区归属 <text class="form-req">*</text>（用户端仅按两个主校区分类）</view>
        <picker mode="selector" range="{{drivingSchoolCampusOptions}}" value="{{form.campusIndex}}" bindchange="onDrivingSchoolCampusChange">
          <view class="picker-row"><text>校区</text><text class="picker-value">{{form.campus || '请选择'}} ›</text></view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">区域标签（可选，展示在校区后）</view>
        <input data-key="region" value="{{form.region}}" maxlength="32" placeholder="例如：南海区" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">训练场地址</view>
        <input data-key="address" value="{{form.address}}" maxlength="255" placeholder="详细地址" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">训练场位置（用户端「在地图查看」用，不选则不显示地图入口）</view>
        <view class="picker-row" bindtap="chooseSchoolLocation">
          <text>在地图上选点</text>
          <text class="picker-value">{{form.lat && form.lng ? form.lat + ', ' + form.lng : '未选择 ›'}}</text>
        </view>
        <view wx:if="{{form.lat && form.lng}}" class="upload-clear" catchtap="clearSchoolLocation">清除坐标</view>
      </view>
      <view class="form-item">
        <view class="form-label">联系方式（招生电话）</view>
        <input data-key="phone" value="{{form.phone}}" maxlength="32" placeholder="例如：13380209901" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">咨询微信昵称（选填，弹窗标题）</view>
        <input data-key="contactName" value="{{form.contactName}}" maxlength="32" placeholder="例如：驾顺驾校客服" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">咨询二维码（选填，用户端「立即咨询」直接弹这张）</view>
        <view class="upload-row" bindtap="chooseSchoolQr">
          <image class="upload-thumb" wx:if="{{form.contactQr}}" src="{{form.contactQr}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传二维码</view>
        </view>
        <view wx:if="{{form.contactQr}}" class="upload-clear" catchtap="clearSchoolQr">清除二维码</view>
        <view class="config-hint">不上传则沿用全站管理员微信；上传后用户点「立即咨询」会直接弹出本驾校二维码，长按可识别。</view>
      </view>
      <view class="form-item">
        <view class="form-label">可报名班型/车型</view>
        <input data-key="carTypes" value="{{form.carTypes}}" maxlength="64" placeholder="例如：C1 C2" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">价格</view>
        <input data-key="price" value="{{form.price}}" maxlength="64" placeholder="例如：C1 全包 3200 元" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">一句话简介</view>
        <input data-key="intro" value="{{form.intro}}" maxlength="255" placeholder="例如：AAAA 驾校，费用全包，快至 45 天拿证" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">通过率（0-100）</view>
        <input data-key="passRate" value="{{form.passRate}}" type="number" placeholder="例如：92" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">推荐等级</view>
        <picker mode="selector" range="{{drivingSchoolLevelOptions}}" value="{{form.levelIndex}}" bindchange="onDrivingSchoolLevelChange">
          <view class="picker-row"><text>等级</text><text class="picker-value">{{form.level || 'A'}} ›</text></view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">服务保障标签（逗号分隔）</view>
        <input data-key="tags" value="{{form.tags}}" maxlength="80" placeholder="例如：免费试驾，包考试费，包接送" bindinput="formInput"/>
        <view class="config-hint">多个标签用「，」「、」或空格分隔；每个标签不超过 16 字，超长会被服务端拒绝并提示（整句话请填到「驾校简介」里）。</view>
      </view>
      <view class="form-item">
        <view class="form-label">距校（km，可选）</view>
        <input data-key="distanceKm" value="{{form.distanceKm}}" type="digit" placeholder="例如：5.6" bindinput="formInput"/>
      </view>
      <view class="form-item">
        <view class="form-label">封面图（列表卡片左侧，点击更换）</view>
        <view class="upload-row" bindtap="chooseSchoolCover">
          <image wx:if="{{form.cover}}" class="upload-thumb" src="{{form.cover}}" mode="aspectFill"></image>
          <view wx:else class="upload-add">＋ 上传封面图</view>
        </view>
        <view wx:if="{{form.cover}}" class="upload-clear" catchtap="clearSchoolCover">清除封面</view>
      </view>
      <view class="form-item">
        <view class="form-label">场地图片（详情页展示，最多 9 张）</view>
        <view class="img-grid">
          <view class="img-item" wx:for="{{form.images}}" wx:key="index">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewImage"></image>
            <text class="img-remove" data-index="{{index}}" catchtap="removeImage">×</text>
          </view>
          <view wx:if="{{form.images.length < 9}}" class="upload-add upload-add--grid" bindtap="addImages" data-max="9">＋</view>
