@import "styles/iconfont.wxss";

page {
  /* 品牌色 */
  --primary: #315CFF;
  --primary-light: #6A8BFF;
  --primary-dark: #2448D8;
  --primary-bg: #EEF3FF;
  --accent: #12B8A6;
  --accent-soft: #E9FBF8;
  --warm: #FF8A3D;
  --warm-soft: #FFF4EC;
  --success: #52C41A;
  --warning: #FAAD14;
  --error: #FF4D4F;
  --price: #E64340;
  /* 中性色 */
  --bg: #F4F6FA;
  --card-bg: #FFFFFF;
  --border: #EBEDF0;
  --divider: #F5F7FA;
  --text-primary: #323233;
  --text-secondary: #646566;
  --text-tertiary: #969799;
  --text-placeholder: #C8C9CC;
  --surface: #FFFFFF;
  --surface-soft: #F8FAFD;
  /* 阴影层级 */
  --shadow-sm: 0 2rpx 10rpx rgba(28, 43, 86, 0.04);
  --shadow: 0 8rpx 24rpx rgba(28, 43, 86, 0.07);
  --shadow-md: 0 14rpx 36rpx rgba(28, 43, 86, 0.1);
  --shadow-lg: 0 20rpx 52rpx rgba(28, 43, 86, 0.14);
  /* 圆角 */
  --radius-sm: 10rpx;
  --radius: 18rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-pill: 40rpx;
  /* 间距规范 (8rpx 基准) */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  /* 过渡 token：交互 <300ms */
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --transition-fast: all 0.16s var(--ease-standard);
  --transition: all 0.24s var(--ease-standard);
  --transition-slow: all 0.32s var(--ease-standard);
  background-color: var(--bg);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 0;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, image, input, textarea, button {
  box-sizing: border-box;
}

image {
  display: block;
}

.card {
  background: var(--card-bg);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  border: 1rpx solid rgba(234, 238, 247, 0.82);
}

.gradient-nav {
  background:
    radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.62) 0, rgba(255, 255, 255, 0) 220rpx),
    linear-gradient(135deg, #bfe6ff 0%, #d9f0ff 52%, #f7fbff 100%);
  box-shadow: 0 8rpx 24rpx rgba(74, 137, 186, 0.12);
  transition: background 0.32s ease, box-shadow 0.32s ease;
}

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-placeholder { color: var(--text-placeholder); }

.badge-green {
  background: var(--success);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: var(--radius-sm);
  line-height: 1.4;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  border: none;
  transition: var(--transition-fast);
  box-shadow: 0 10rpx 24rpx rgba(49, 92, 255, 0.22);
}

.btn-primary:active {
  background: var(--primary-dark);
  transform: scale(0.97);
}

.btn-primary::after { border: none; }

/* ============ 图标尺寸规范 (统一 8rpx 步进) ============ */
.icon-xs { width: 24rpx; height: 24rpx; }
.icon-sm { width: 32rpx; height: 32rpx; }
.icon-md { width: 40rpx; height: 40rpx; }
.icon-lg { width: 48rpx; height: 48rpx; }
.icon-xl { width: 64rpx; height: 64rpx; }

.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ============ 字体层级规范 ============ */
.text-h1 { font-size: 40rpx; font-weight: 600; line-height: 1.4; letter-spacing: 0; color: var(--text-primary); }
.text-h2 { font-size: 34rpx; font-weight: 600; line-height: 1.4; letter-spacing: 0; color: var(--text-primary); }
.text-h3 { font-size: 30rpx; font-weight: 500; line-height: 1.5; color: var(--text-primary); }
.text-body { font-size: 28rpx; line-height: 1.6; letter-spacing: 0; color: var(--text-primary); }
.text-caption { font-size: 24rpx; line-height: 1.5; color: var(--text-tertiary); }
.text-small { font-size: 22rpx; line-height: 1.4; color: var(--text-tertiary); }

/* 懒加载图片占位 */
.img-lazy {
  background: #F0F1F5;
  transition: opacity 0.3s ease-out;
}
.img-lazy.loaded {
  background: transparent;
}

/* ============ 通用按压反馈 (点击 <100ms 响应) ============ */
.pressable {
  transition: var(--transition-fast);
  will-change: transform, opacity;
}
.pressable:active {
  transform: scale(0.96);
  opacity: 0.85;
}

/* ============ 骨架屏 ============ */
.skeleton {
  background: linear-gradient(100deg, #F0F1F5 30%, #F7F8FA 50%, #F0F1F5 70%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s ease-in-out infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ============ 进场动画 (<300ms) ============ */
.anim-fade {
  animation: fade-in 0.25s ease-out both;
}
.anim-slide-up {
  animation: slide-up 0.28s ease-out both;
}
.anim-slide-right {
  animation: slide-right 0.25s ease-out both;
}
/* 页面入场动画：不要写 fill-mode(both/forwards)。
   动画结束后若保留最后一帧的 transform(translateY(0))，.page 会一直存在非 none 的
   transform，从而成为后代 position:fixed 元素的包含块 —— fixed 视觉上退化为
   “相对该祖先定位”，再叠加 .page 比屏幕高一个导航占位，会出现导航栏/浮动按钮/
   弹层被顶出屏幕且无法复位的问题。keyframes 的终态与元素默认样式一致，
   去掉 fill-mode 后视觉完全等价。 */
.page-enter {
  animation: page-enter 0.28s var(--ease-standard);
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes slide-up {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes slide-right {
  from { opacity: 0; transform: translateX(-24rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes page-enter {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.glass-panel {
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: var(--shadow);
}

/* 列表项交错进场（配合 style="--i: n"，见 docs/2026-09-30_列表入场交错动画清单与实现.md）。
   微弱弹性滑入：弹性不靠关键帧补 overshoot 段，靠缓动曲线 y 控制点 > 1——
   位移在落定前轻微越过终点再回弹，回弹量由曲线决定。取 1.3 而不是标准 back-out
   的 1.56：越过约 4%~6%，一屏多卡同时入场时不会显得"蹦"。
   --i 建议封顶（页面写 {{index < 6 ? index : 0}}）：长列表后段项延迟 360ms+ 会显得迟钝。
   fill-mode 必须用 backwards 而不是 both：both 会在动画结束后永久钉住末帧的 transform，
   而 keyframes 的 transform 会压过 transition —— 交错项同时是可按压元素（act-card 等）
   时，按压 scale(0.96) 将永远不生效。末帧与自然态完全一致，backwards 视觉等价。 */
.anim-stagger {
  animation: stagger-in 0.45s cubic-bezier(0.34, 1.3, 0.64, 1) backwards;
  animation-delay: calc(var(--i, 0) * 60ms);
}

@keyframes stagger-in {
  from { opacity: 0; transform: translateY(28rpx) scale(0.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* 降级与 card-fx 共用同一个 fx-off class（用户主动关动效 / 低端机时页面已挂）。
   入场动画只播一次且只动 transform/opacity，比常驻合成动画轻一个量级，
   低端机不必单独停它；但用户偏好与系统减弱动效必须尊重。 */
.fx-off.anim-stagger {
  animation: none;
}

@media (prefers-reduced-motion: reduce) {
  .anim-stagger { animation: none; }
  /* 按压弹性同样尊重减弱动效：保留瞬间 scale 变化（状态仍可见），去掉位移过渡 */
  .spring-btn, .press-spring { transition: none;  transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }
}

/* ===== 按钮弹性按压反馈（docs/2026-09-30_按钮弹性按压反馈.md） =====
   触发机制用小程序的 hover-class：touchstart 加类、touchend/touchcancel/鼠标移出移除，
   触摸与鼠标（开发者工具/PC 端）行为一致；小程序视图无键盘焦点语义，不涉及键盘分支。
   挂法：交互元素 class 追加 spring-btn（基础态 transition），按压态由 hover-class 给出 ——
   既可以是共享的 press-spring，也可以是页面自己的 hover 类（构建脚本已注入同款按压样式）。
   按压 0.12s 快速压缩；释放回到基础态，走 spring-btn 的 0.35s 弹性贝塞尔 ——
   y1 = 1.42 带来约 3%~5% 的轻微超调回弹，模拟物理弹簧。 */
.spring-btn {
  transition:
    transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1),
    box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

/* 按压态：物理压缩 + 深度内阴影（凹陷感来自 inset 上暗下亮）。 */
.press-spring {
  transform: scale(0.96);
  box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08);
  transition-duration: 0.12s;
  transition-timing-function: cubic-bezier(0.3, 0.9, 0.5, 1);
}

/* ===== 液态标签指示条（elastic tab indicator，docs/2026-09-30_液态标签指示条.md） =====
   双相位模型，由 utils/liquid-tab.js 驱动（每次切换只有 2 次 setData）：
   rush（0.1s ≈ 6 帧）：前沿以强 ease-out 奔向目标，后沿原地不动 → 指示条被拉伸；
   chase（0.3s）：后沿延迟 6 帧后以弹性贝塞尔追赶、宽度收回，y1 > 1 带来末端轻微超调。
   位置与宽度一律用 left/width —— 禁止 scaleX：圆角会被横向拉伸变形（需求红线）；
   指示条是绝对定位小元素，layout 回流被限制在标签栏容器内，成本可忽略。
   页面可在 .liquid-indicator 上用 --liquid-indicator-color 覆盖颜色。 */
.liquid-tab-track { position: relative; }

.liquid-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--liquid-indicator-color, var(--primary, #315CFF));
  pointer-events: none;
}

/* 基础态无 transition：首次落位（snap）不播动画，只有相位类才带过渡 */
.liquid-indicator--rush {
  transition:
    left 0.1s cubic-bezier(0.3, 0.9, 0.5, 1),
    width 0.1s cubic-bezier(0.3, 0.9, 0.5, 1);
}

.liquid-indicator--chase {
  transition:
    left 0.3s cubic-bezier(0.34, 1.42, 0.6, 1),
    width 0.3s cubic-bezier(0.34, 1.42, 0.6, 1);
}

@media (prefers-reduced-motion: reduce) {
  .liquid-indicator--rush,
  .liquid-indicator--chase {
    transition: none;
  }
}

/* ===== 全局返回按钮（白色胶囊：‹ 返回）—— 所有页面统一使用 ===== */
.back-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(32, 48, 76, 0.12);
  color: #27364a;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  box-sizing: border-box;
  white-space: nowrap;
}

.back-pill-icon {
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
  margin-top: -3rpx;
}

.back-pill-hover {
  background: #eef1f5;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

/* ===== 全局图标悬浮交互工具类 =====
   用法：在可点击的图标容器上加 hover-class="fx-icon-hover" hover-stay-time="120"，
   容器本身加 class="fx-icon-lift" 获得平滑过渡。 */
.fx-icon-lift {
  transition: transform .18s ease;
}
.fx-icon-hover {
  transform: translateY(-6rpx) scale(1.02);
}
.fx-icon-hover .icon-wrap,
.fx-icon-hover .feature-icon-wrap,
.fx-icon-hover .shortcut-icon-wrap,
.fx-icon-hover .tab-icon-wrap {
  box-shadow:
    0 16rpx 30rpx rgba(49, 92, 255, .24),
    0 4rpx 10rpx rgba(49, 92, 255, .10);
}

/* ===== 页面顶部「通知设置入口」行（8 个页面共用） =====
   钱包 / 校园活动 / 发布活动 / 活动详情 / 骑手认证 / 发布跑腿 / 私信 / 发布帖子 各一处。
   样式统一放在这里，避免各页各写一份后视觉漂移（历史上同一元素分页写就是怎么调都对不齐的根因）。
   显隐与授权逻辑见 utils/subscribe.js 的 entryVisible / requestEntryByTap。 */
.sub-notice-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
}
.sub-notice-main { flex: 1; min-width: 0; }
/* <text> 是 inline：必须 display:block，否则标题与描述会挤在同一行 */
.sub-notice-title { display: block; color: #10213a; font-size: 31rpx; font-weight: 700; }
.sub-notice-desc { display: block; margin-top: 8rpx; color: #98a4b2; font-size: 23rpx; line-height: 1.5; }
.sub-notice-switch { flex: 0 0 auto; transform: scale(0.88); transform-origin: right center; }
