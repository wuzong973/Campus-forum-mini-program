<view class="page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="goBack">
        <text class="back-arrow">‹</text>
      </view>
      <text class="nav-title">发布帖子</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 标题 -->
  <view class="form-section">
    <text class="section-label">标题 <text class="label-optional">（可选）</text></text>
    <input class="title-input" placeholder="添加标题更容易被发现..." bindinput="onTitleInput" value="{{title}}" />
  </view>

  <!-- 内容 -->
  <view class="form-section">
    <text class="section-label">内容 <text class="label-required">*</text></text>
    <view class="textarea-wrap">
      <textarea class="content-input" placeholder="分享你的想法..." maxlength="500" bindinput="onInput" value="{{content}}" auto-height />
      <text class="char-count">{{content.length || 0}}/500</text>
    </view>
  </view>

  <!-- 添加图片 -->
  <view class="form-section">
    <text class="section-label">添加图片 <text class="label-optional">（可选）</text></text>
    <view class="image-list">
      <view class="image-item" wx:for="{{mediaList}}" wx:key="path">
        <image src="{{item.thumb || item.path}}" mode="aspectFill" class="thumb" />
        <view class="media-type" wx:if="{{item.type === 'video'}}">视频</view>
        <view class="remove" data-index="{{index}}" bindtap="onRemoveImage">×</view>
      </view>
      <view class="add-image-box" bindtap="onChooseImage" wx:if="{{mediaList.length < 9}}">
        <text class="add-plus">+</text>
        <text class="add-text">图片/视频</text>
      </view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="form-section tag-section" bindtap="openTagPicker">
    <text class="section-label">标签 <text class="label-required">*</text></text>
    <view class="tag-picker">
      <text class="tag-picker-text {{categoryIndex >= 0 ? 'selected' : ''}}">{{categoryIndex >= 0 ? categories[categoryIndex] : '请选择标签'}}</text>
      <text class="tag-arrow">›</text>
    </view>
  </view>

  <!-- 标签选择弹窗 -->
  <view class="tag-mask {{showTagPicker ? 'show' : ''}}" bindtap="closeTagPicker"></view>
  <view class="tag-popup {{showTagPicker ? 'show' : ''}}">
    <view class="tag-popup-header">
      <text class="tag-popup-cancel" bindtap="closeTagPicker">取消</text>
      <text class="tag-popup-title">选择标签</text>
      <text class="tag-popup-confirm" bindtap="confirmTag">确定</text>
    </view>
    <scroll-view class="tag-popup-list" scroll-y>
      <view
        class="tag-popup-item {{tempCategoryIndex === index ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTempTagSelect"
      >{{item}}</view>
    </scroll-view>
  </view>

  <!-- 发布按钮 -->
  <view class="submit-error" wx:if="{{submitError}}">
    <text>{{submitError}}</text>
    <text class="retry-link" bindtap="onRetrySubmit">重试</text>
  </view>
  <view class="submit-wrap">
    <button class="submit-btn {{canSubmit ? 'active' : ''}}" loading="{{submitting}}" bindtap="onSubmit">{{submitting ? '发布中' : '发布'}}</button>
  </view>
</view>
