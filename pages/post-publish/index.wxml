<view class="page">


  <scroll-view class="publish-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="editor-card">
      <view class="notice-tip"><text class="notice-mark">!</text> 禁止发布重复信息、广告营销类、含二维码等内容</view>
      <textarea class="content-input" placeholder="请输入投稿内容..." maxlength="500" value="{{content}}" bindinput="onInput" auto-height></textarea>
      <view class="image-grid">
        <view class="image-item" wx:for="{{mediaList}}" wx:key="path">
          <image src="{{item.thumb || item.path}}" mode="aspectFill" class="thumb"></image>
          <view class="image-remove" data-index="{{index}}" bindtap="onRemoveImage">×</view>
        </view>
        <view class="image-add" bindtap="onChooseImage" wx:if="{{mediaList.length < 9}}">
          <image src="/assets/icons/camera.png" class="camera-icon" mode="aspectFit"></image>
          <text>{{mediaList.length}} / 9</text>
        </view>
      </view>
    </view>

    <view class="settings-card">
      <view class="setting-row" bindtap="openContactSheet">
        <text class="setting-title">填写联系方式</text>
        <view class="setting-value"><text>{{contactSummary}}</text><text class="chevron">›</text></view>
      </view>
      <view class="setting-row">
        <text class="setting-title">切换第二身份</text>
        <switch checked="{{secondIdentity}}" color="#3478f6" bindchange="onSecondIdentityChange"></switch>
      </view>
      <view class="setting-row" bindtap="openTagPicker">
        <text class="setting-title">主题分类</text>
        <view class="setting-value"><text>{{categoryIndex >= 0 ? categories[categoryIndex] : '未选择'}}</text><text class="chevron">›</text></view>
      </view>
    </view>

    <view class="forum-tips">
      <view class="tips-title"><text class="notice-mark">!</text> 论坛小贴士</view>
      <text class="tips-content">普通消息免费发布；商业推广、招聘及营销内容请先联系管理员审核。请文明发言，遵守社区规则。</text>
      <text class="tips-rules" bindtap="openRules">查看《社区规则》</text>
    </view>
  </scroll-view>

  <view class="tag-mask" wx:if="{{showTagPicker}}" bindtap="closeTagPicker"></view>
  <view class="tag-popup" wx:if="{{showTagPicker}}" catchtap="noop">
    <view class="sheet-header"><text></text><text class="sheet-title">请选择主题分类</text><text class="sheet-close" bindtap="closeTagPicker">×</text></view>
    <text class="sheet-subtitle">选择主题</text>
    <view class="category-grid">
      <view wx:for="{{categories}}" wx:key="*this" data-index="{{index}}" bindtap="onTempTagSelect" class="category-option {{tempCategoryIndex === index ? 'active' : ''}}">{{item}}</view>
    </view>
    <button class="sheet-confirm" bindtap="confirmTag">确认</button>
  </view>

  <view class="tag-mask" wx:if="{{showContactSheet}}" bindtap="closeContactSheet"></view>
  <view class="contact-popup" wx:if="{{showContactSheet}}" catchtap="noop">
    <view class="sheet-header"><text></text><text class="sheet-title">请填写联系方式</text><text class="sheet-close" bindtap="closeContactSheet">×</text></view>
    <view class="contact-card">
      <text class="contact-label">联系姓名</text>
      <input class="contact-input" value="{{contactName}}" placeholder="例如：小明" bindinput="onContactNameInput"></input>
    </view>
    <view class="contact-card">
      <text class="contact-label">联系方式</text>
      <view class="contact-types">
        <view wx:for="{{contactTypes}}" wx:key="*this" class="contact-type {{contactType === item ? 'active' : ''}}" data-value="{{item}}" bindtap="onContactTypeSelect"><text class="radio-dot"></text>{{item}}</view>
      </view>
      <input class="contact-input" value="{{contactValue}}" placeholder="{{contactType}}" bindinput="onContactValueInput"></input>
    </view>
    <button class="sheet-confirm" bindtap="confirmContact">确认</button>
  </view>

  <view class="submit-wrap">
    <button class="submit-btn {{canSubmit ? 'active' : ''}}" loading="{{submitting}}" bindtap="onSubmit">{{submitting ? '发布中' : '确认发布'}}</button>
  </view>
</view>
