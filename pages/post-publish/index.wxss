.page { display: flex; flex-direction: column; height: 100vh; background: #f6f7f9; overflow: hidden; }
.publish-scroll { flex: 1; min-height: 0; box-sizing: border-box; padding: 24rpx 22rpx 164rpx; }
.editor-card, .settings-card, .forum-tips { background: #ffffff; border-radius: 20rpx; }
.editor-card { padding: 26rpx; min-height: 610rpx; }
.notice-tip { display: flex; align-items: center; min-height: 60rpx; padding: 0 16rpx; border-radius: 30rpx; background: #fff7ec; color: #f08220; font-size: 26rpx; line-height: 1.4; }
.notice-mark { display: inline-flex; justify-content: center; align-items: center; width: 28rpx; height: 28rpx; margin-right: 10rpx; border-radius: 50%; background: #f39122; color: #ffffff; font-size: 21rpx; font-weight: 700; flex: 0 0 auto; }
.content-input { display: block; width: 100%; min-height: 390rpx; margin-top: 24rpx; color: #15233a; font-size: 32rpx; line-height: 1.55; box-sizing: border-box; }
.content-input::placeholder { color: #a9b0ba; }
.image-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.image-item, .image-add { position: relative; width: 154rpx; height: 154rpx; overflow: hidden; border-radius: 12rpx; }
.thumb { width: 100%; height: 100%; }
.image-remove { position: absolute; top: 6rpx; right: 6rpx; width: 34rpx; height: 34rpx; line-height: 30rpx; border-radius: 50%; background: rgba(20, 31, 49, .65); color: #fff; text-align: center; font-size: 28rpx; }
.image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; background: #f7f8fa; color: #85909e; font-size: 25rpx; }
.camera-icon { width: 54rpx; height: 54rpx; opacity: .62; }
.settings-card { margin-top: 20rpx; padding: 0 26rpx; }
.setting-row { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; border-bottom: 1rpx solid #f0f2f5; }
.setting-row:last-child { border-bottom: none; }
.setting-title { color: #10213a; font-size: 31rpx; font-weight: 700; }
.setting-value { display: flex; align-items: center; gap: 14rpx; color: #8e97a4; font-size: 28rpx; }
.chevron { color: #a7afb9; font-size: 44rpx; line-height: 1; }
.forum-tips { margin-top: 20rpx; padding: 26rpx; }
.tips-title { display: flex; align-items: center; color: #10213a; font-size: 32rpx; font-weight: 700; }
.tips-content, .tips-rules { display: block; margin-top: 16rpx; color: #727d8c; font-size: 26rpx; line-height: 1.6; }
.tips-rules { color: #3478f6; margin-top: 8rpx; }
.submit-wrap { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(246,247,249,.96); }
.submit-btn, .sheet-confirm { width: 100%; height: 92rpx; line-height: 92rpx; border: 0; border-radius: 46rpx; background: #dfe5ec; color: #a7b0bb; font-size: 32rpx; font-weight: 700; }
.submit-btn.active, .sheet-confirm { background: #3478f6; color: #ffffff; }
.submit-btn::after, .sheet-confirm::after { border: none; }
.tag-mask { position: fixed; z-index: 100; inset: 0; background: rgba(0, 0, 0, .58); }
.tag-popup, .contact-popup { position: fixed; z-index: 101; right: 0; bottom: 0; left: 0; padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #ffffff; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; }
.sheet-header > text:first-child, .sheet-close { width: 64rpx; }
.sheet-title { color: #15233a; font-size: 38rpx; font-weight: 700; }
.sheet-close { height: 64rpx; line-height: 58rpx; border-radius: 50%; background: #f6f7f9; color: #10213a; text-align: center; font-size: 50rpx; }
.sheet-subtitle { display: block; margin: 30rpx 0 22rpx; color: #10213a; font-size: 30rpx; font-weight: 700; }
.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx 22rpx; margin-bottom: 42rpx; }
.category-option { height: 74rpx; line-height: 74rpx; border-radius: 38rpx; background: #f6f7f9; color: #243448; text-align: center; font-size: 28rpx; }
.category-option.active { background: #eaf1ff; color: #3478f6; font-weight: 700; }
.contact-popup { min-height: 570rpx; }
.contact-card { margin-top: 28rpx; padding: 24rpx; border-radius: 18rpx; background: #ffffff; box-shadow: 0 8rpx 30rpx rgba(31, 55, 90, .06); }
.contact-label { display: block; color: #10213a; font-size: 30rpx; font-weight: 700; }
.contact-types { display: flex; gap: 32rpx; margin: 24rpx 0; }
.contact-type { display: flex; align-items: center; gap: 10rpx; color: #243448; font-size: 27rpx; }
.radio-dot { width: 28rpx; height: 28rpx; box-sizing: border-box; border: 3rpx solid #d6dce5; border-radius: 50%; }
.contact-type.active .radio-dot { border: 8rpx solid #3478f6; }
.contact-input { width: 100%; height: 82rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 41rpx; background: #f6f7f9; color: #15233a; font-size: 28rpx; }
.contact-popup .sheet-confirm { margin-top: 34rpx; }
