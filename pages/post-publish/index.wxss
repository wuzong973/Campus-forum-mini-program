.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 140rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid #ebedf0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  width: 48rpx;
  display: flex;
  align-items: center;
}

.back-arrow {
  font-size: 48rpx;
  color: #323233;
  font-weight: 300;
}

.nav-title {
  color: #323233;
  font-size: 32rpx;
  font-weight: 600;
}

.nav-placeholder {
  width: 48rpx;
}

/* 表单区块 */
.form-section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 16rpx;
  display: block;
}

.label-optional {
  font-size: 26rpx;
  font-weight: 400;
  color: #969799;
}

.label-required {
  color: #f56c6c;
  font-weight: 400;
}

/* 标题输入 */
.title-input {
  width: 100%;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #323233;
  box-sizing: border-box;
}

.title-input::placeholder {
  color: #c8c9cc;
}

/* 内容文本域 */
.textarea-wrap {
  position: relative;
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #323233;
  line-height: 1.6;
  box-sizing: border-box;
}

.content-input::placeholder {
  color: #c8c9cc;
}

.char-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 24rpx;
  color: #c8c9cc;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.media-type {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.54);
  color: #ffffff;
  font-size: 20rpx;
}

.add-image-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #4a7aff;
  border-radius: 12rpx;
  background: #f0f4ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-plus {
  font-size: 52rpx;
  color: #4a7aff;
  font-weight: 300;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #4a7aff;
}

/* 标签选择 */
.tag-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}

.tag-section .section-label {
  margin-bottom: 0;
  flex-shrink: 0;
}

.tag-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tag-picker-text {
  font-size: 28rpx;
  color: #c8c9cc;
}

.tag-picker-text.selected {
  color: #323233;
}

.tag-arrow {
  font-size: 32rpx;
  color: #c8c9cc;
}

/* 标签选择弹窗 */
.tag-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 200;
  transition: background 0.3s ease;
  pointer-events: none;
}

.tag-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.tag-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.tag-popup.show {
  transform: translateY(0);
}

.tag-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.tag-popup-cancel {
  font-size: 30rpx;
  color: #969799;
}

.tag-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.tag-popup-confirm {
  font-size: 30rpx;
  color: #52c41a;
  font-weight: 500;
}

.tag-popup-list {
  flex: 1;
  overflow-y: auto;
}

.tag-popup-item {
  padding: 36rpx 32rpx;
  font-size: 38rpx;
  color: #323233;
  text-align: center;
  border-bottom: 1rpx solid #f5f7fa;
  transition: background 0.2s ease;
}

.tag-popup-item:active {
  background: #f5f7fa;
}

.tag-popup-item.active {
  color: #4a7aff;
  font-weight: 600;
  background: #f0f4ff;
}

/* 发布按钮 */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
  z-index: 50;
}

.submit-error {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(116rpx + env(safe-area-inset-bottom));
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff1f0;
  color: #cf1322;
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
  z-index: 60;
}

.retry-link {
  color: var(--primary);
  font-weight: 700;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #e8e8e8;
  color: #c8c9cc;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}

.submit-btn.active {
  background: #4a7aff;
  color: #fff;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.85;
}
