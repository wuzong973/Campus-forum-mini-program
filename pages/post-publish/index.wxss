.page { display: flex; flex-direction: column; height: 100vh; background: radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%), linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%); overflow: hidden; }
/* 顶部自动轮播横幅 */
.publish-banner-swiper { height: 72rpx; margin-bottom: 20rpx; }
.publish-banner { display: flex; align-items: center; gap: 12rpx; height: 72rpx; padding: 0 24rpx; border-radius: 36rpx; font-size: 26rpx; box-sizing: border-box; }
.publish-banner.style-red { background: #ffe2e2; color: #e34d4d; }
.publish-banner.style-green { background: #e0f5e6; color: #3aa356; }
.publish-banner.style-orange { background: #fff1de; color: #e8930c; }
.publish-banner.style-blue { background: #e3edff; color: #3a6fe3; }
.publish-banner.style-purple { background: #f0e5ff; color: #8a4de0; }
.publish-banner-icon { flex-shrink: 0; font-size: 28rpx; }
.publish-banner-text { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.publish-banner-close { flex-shrink: 0; padding: 4rpx 8rpx; opacity: 0.55; }
.publish-scroll { flex: 1; min-height: 0; box-sizing: border-box; padding: 24rpx 22rpx 164rpx; }
/* 顶部订阅入口 .sub-notice-* 的样式定义在 app.wxss（8 个页面共用，避免各页各写一份） */
.editor-card, .settings-card, .forum-tips { background: #ffffff; border-radius: 20rpx; }
.editor-card { padding: 26rpx; min-height: 610rpx; }
.notice-tip { display: flex; align-items: center; min-height: 60rpx; padding: 0 16rpx; border-radius: 30rpx; background: #fff7ec; color: #f08220; font-size: 26rpx; line-height: 1.4; }
.notice-mark { display: inline-flex; justify-content: center; align-items: center; width: 28rpx; height: 28rpx; margin-right: 10rpx; border-radius: 50%; background: #f39122; color: #ffffff; font-size: 21rpx; font-weight: 700; flex: 0 0 auto; }
.content-input { display: block; width: 100%; min-height: 390rpx; margin-top: 24rpx; color: #15233a; font-size: 32rpx; line-height: 1.55; box-sizing: border-box; }
.content-input::placeholder { color: #a9b0ba; }
.image-grid { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.image-item, .image-add { position: relative; width: 154rpx; height: 154rpx; overflow: hidden; border-radius: 12rpx; }
.thumb { width: 100%; height: 100%; }
.image-remove { position: absolute; top: 6rpx; right: 6rpx; width: 34rpx; height: 34rpx; line-height: 30rpx; border-radius: 50%; background: rgba(20, 31, 49, .65); color: #fff; text-align: center; font-size: 28rpx; }
.thumb-video-badge { position: absolute; left: 6rpx; bottom: 6rpx; padding: 2rpx 10rpx; border-radius: 12rpx; background: rgba(0, 0, 0, .56); color: #fff; font-size: 20rpx; line-height: 30rpx; }
.image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; background: #f7f8fa; color: #85909e; font-size: 25rpx; }
.camera-icon { width: 54rpx; height: 54rpx; opacity: .62; }
.settings-card { margin-top: 20rpx; padding: 0 26rpx; }
.setting-row { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; border-bottom: 1rpx solid #f0f2f5; }
.setting-row:last-child { border-bottom: none; }
.setting-title { color: #10213a; font-size: 31rpx; font-weight: 700; }
.setting-value { display: flex; align-items: center; gap: 14rpx; color: #8e97a4; font-size: 28rpx; }
.chevron { color: #a7afb9; font-size: 44rpx; line-height: 1; }
.forum-tips { margin-top: 20rpx; padding: 26rpx; }
.tips-title { display: flex; align-items: center; color: #10213a; font-size: 32rpx; font-weight: 700; }
.tips-content, .tips-rules { display: block; margin-top: 16rpx; color: #727d8c; font-size: 26rpx; line-height: 1.6; }
.tips-rules { color: #3478f6; margin-top: 8rpx; text-decoration: underline; }
.contact-admin { display: inline; padding: 0; margin: 0; background: none; border: none; color: #3478f6; font-size: 26rpx; line-height: 1.6; font-weight: 600; vertical-align: baseline; text-decoration: underline; }
.contact-admin::after { border: none; }
.contact-admin-hover { color: #2461cc; }
contact-admin.inline-contact { display: inline; }
.submit-wrap { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(246,247,249,.96); }
.submit-btn, .sheet-confirm { width: 100%; height: 92rpx; line-height: 1; border: 0; border-radius: 46rpx; background: #dfe5ec; color: #a7b0bb; font-size: 32rpx; font-weight: 700; padding: 0; display: flex; align-items: center; justify-content: center; }
.submit-btn.active, .sheet-confirm { background: #3478f6; color: #ffffff; }
.submit-btn::after, .sheet-confirm::after { border: none; }
.tag-mask { position: fixed; z-index: 100; inset: 0; background: rgba(0, 0, 0, .58); }
.tag-popup, .contact-popup { position: fixed; z-index: 101; right: 0; bottom: 0; left: 0; padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #ffffff; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; min-height: 64rpx; }
.sheet-header > text:first-child, .sheet-close { width: 64rpx; }
.sheet-title { color: #15233a; font-size: 38rpx; font-weight: 700; }
.sheet-close { height: 64rpx; line-height: 58rpx; border-radius: 50%; background: #f6f7f9; color: #10213a; text-align: center; font-size: 50rpx; }
.sheet-subtitle { display: block; margin: 30rpx 0 22rpx; color: #10213a; font-size: 30rpx; font-weight: 700; }
.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx 22rpx; margin-bottom: 20rpx; }
.category-option { height: 74rpx; line-height: 74rpx; border-radius: 38rpx; background: #f6f7f9; color: #243448; text-align: center; font-size: 28rpx; }
.category-option.active { background: #eaf1ff; color: #3478f6; font-weight: 700; }
/* 分类说明：二手闲置不进「最新」列表，发布前先告知，避免作者发完找不到自己的帖子 */
.category-note { display: flex; align-items: center; min-height: 56rpx; margin-bottom: 34rpx; padding: 0 16rpx; border-radius: 28rpx; background: #fff7ec; color: #f08220; font-size: 24rpx; line-height: 1.4; }
.contact-popup { min-height: 570rpx; }
.contact-card { margin-top: 28rpx; padding: 24rpx; border-radius: 18rpx; background: #ffffff; box-shadow: 0 8rpx 30rpx rgba(31, 55, 90, .06); }
.contact-label { display: block; color: #10213a; font-size: 30rpx; font-weight: 700; }
.contact-types { display: flex; gap: 32rpx; margin: 24rpx 0; }
.contact-type { display: flex; align-items: center; gap: 10rpx; color: #243448; font-size: 27rpx; }
.radio-dot { width: 28rpx; height: 28rpx; box-sizing: border-box; border: 3rpx solid #d6dce5; border-radius: 50%; }
.contact-type.active .radio-dot { border: 8rpx solid #3478f6; }
.contact-input { width: 100%; height: 82rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 41rpx; background: #f6f7f9; color: #15233a; font-size: 28rpx; }
.contact-popup .sheet-confirm { margin-top: 34rpx; }
.component-card { margin-top: 20rpx; padding: 24rpx 26rpx; border-radius: 20rpx; background: #fff; }
.component-title-row, .component-summary, .form-label-row, .public-contact { display: flex; align-items: center; justify-content: space-between; }
.component-title { display: block; color: #10213a; font-size: 31rpx; font-weight: 700; }
.component-subtitle { display: block; margin-top: 6rpx; color: #98a4b2; font-size: 22rpx; }
.add-component-btn { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 16rpx; border-radius: 28rpx; background: #edf4ff; color: #3478f6; font-size: 25rpx; font-weight: 600; }
.add-component-btn.disabled { background: #eef0f4; color: #a5acb7; }
.add-symbol { font-size: 31rpx; line-height: 1; }
.component-summary { min-height: 76rpx; margin-top: 20rpx; padding: 0 14rpx; border-radius: 10rpx; background: #f7f9fc; color: #506078; font-size: 25rpx; }
.summary-icon { margin-right: 10rpx; color: #3478f6; font-size: 31rpx; }
.summary-title { margin-right: 12rpx; color: #20324a; font-weight: 700; }
.summary-text { color: #8390a0; }
.remove-component { color: #a0a9b5; font-size: 23rpx; }
.anonymous-state { display: block; margin-top: 7rpx; color: #3478f6; font-size: 21rpx; font-weight: 400; }
.component-sheet { position: fixed; z-index: 101; right: 0; bottom: 0; left: 0; max-height: 82vh; padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #fff; }
/* 投票编辑器：居中浮动圆角卡片（对齐参考样式，不贴底；高度随内容收紧，无安全区底垫） */
.component-editor { position: fixed; z-index: 101; left: 40rpx; right: 40rpx; top: 50%; transform: translateY(-50%); max-height: 80vh; padding: 36rpx 32rpx 36rpx; overflow-y: auto; box-sizing: border-box; border-radius: 32rpx; background: #fff; }
.component-choice-row { display: flex; gap: 20rpx; margin-top: 28rpx; }
.component-choice { display: flex; flex: 1; align-items: center; justify-content: center; gap: 12rpx; height: 106rpx; border-radius: 14rpx; background: #f4f7fb; color: #25364d; font-size: 30rpx; font-weight: 600; }
.choice-icon { color: #3478f6; font-size: 43rpx; }
.form-input { width: 100%; margin-top: 20rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 16rpx; background: #f5f7fa; color: #203149; font-size: 27rpx; }
.form-input { height: 88rpx; line-height: 88rpx; }
.form-label-row { margin-top: 28rpx; }
.form-label { color: #26374d; font-size: 28rpx; font-weight: 700; }
.mode-switch { display: flex; padding: 4rpx; overflow: hidden; border-radius: 26rpx; background: #f2f4f7; box-sizing: border-box; }
.mode-item { padding: 8rpx 24rpx; border-radius: 22rpx; color: #7a8797; font-size: 24rpx; }
/* 选中项：白底胶囊 + 蓝字（对齐参考样式） */
.mode-item.active { background: #ffffff; color: #3478f6; font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(52, 120, 246, 0.18); }
.option-input-row { position: relative; display: flex; align-items: center; }
.option-input { padding-right: 68rpx; }
.option-remove { position: absolute; right: 24rpx; top: 37rpx; color: #a7b0bb; font-size: 36rpx; }
.add-option { margin: 26rpx 0 0; padding-bottom: 6rpx; color: #3478f6; font-size: 27rpx; text-align: center; }
/* 投票编辑器头部：柱状投票图标 + 标题居中，右上「添加」胶囊为确认入口（对齐参考样式） */
.poll-editor-header { position: relative; margin-bottom: 8rpx; }
.poll-header-title { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.poll-header-icon { display: inline-flex; align-items: flex-end; gap: 5rpx; height: 36rpx; }
.poll-icon-bar { width: 9rpx; border-radius: 3rpx; background: #1c2b3f; }
.poll-icon-bar.b1 { height: 16rpx; }
.poll-icon-bar.b2 { height: 26rpx; }
.poll-icon-bar.b3 { height: 36rpx; }
.poll-header-spacer { width: 118rpx; }
.poll-editor-add { display: flex; align-items: center; justify-content: center; min-width: 96rpx; height: 60rpx; padding: 0 26rpx; border: 2rpx solid #232a35; border-radius: 999rpx; background: #ffffff; color: #232a35; font-size: 26rpx; font-weight: 600; box-sizing: border-box; }
.poll-editor-add-hover { background: #f4f6f8; transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

/* ===== 订阅消息提醒弹窗（发布成功后） ===== */
.sub-mask { position: fixed; z-index: 100; inset: 0; background: rgba(0, 0, 0, .58); }
.sub-dialog { position: fixed; z-index: 101; top: 50%; left: 50%; width: 600rpx; transform: translate(-50%, -50%); padding: 40rpx 32rpx 32rpx; border-radius: 28rpx; background: #ffffff; box-sizing: border-box; }
.sub-title { display: block; color: #15233a; font-size: 36rpx; font-weight: 700; text-align: center; }
.sub-desc { display: block; margin: 14rpx 0 6rpx; color: #8a94a6; font-size: 25rpx; text-align: center; }
.sub-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; border-bottom: 1rpx solid #f0f2f5; }
.sub-row-label { display: block; color: #10213a; font-size: 30rpx; }
.sub-row-hint { display: block; margin-top: 4rpx; color: #8a94a6; font-size: 22rpx; }
.sub-actions { display: flex; margin-top: 32rpx; }
.sub-btn-skip, .sub-btn-confirm { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; font-size: 30rpx; }
.sub-btn-skip { flex: 1; margin-right: 20rpx; background: #f6f7f9; color: #5a6572; }
.sub-btn-confirm { flex: 1.6; background: #3478f6; color: #ffffff; font-weight: 600; }
