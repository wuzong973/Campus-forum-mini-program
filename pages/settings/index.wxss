.page { min-height: 100vh; background: #f7f7f7; color: #2f2f2f; }
.nav { position: fixed; z-index: 10; top: 0; left: 0; right: 0; box-sizing: border-box; background: #ffffff; border-bottom: 1rpx solid #eeeeee; }
.nav-content { display: flex; align-items: center; justify-content: space-between; padding: 0 22rpx; }
/* 返回按钮使用全局 .back-pill 样式（app.wxss） */
.nav-title { color: #141b2b; font-size: 33rpx; font-weight: 700; }
.nav-placeholder { width: 132rpx; }
.settings-content { padding: 18rpx 18rpx calc(48rpx + env(safe-area-inset-bottom)); }
.setting-group { margin-bottom: 16rpx; overflow: hidden; border-radius: 16rpx; background: #ffffff; }
.group-title { display: block; padding: 18rpx 30rpx; background: #f3f3f3; color: #a4a4a4; font-size: 25rpx; }
.setting-row { display: flex; min-height: 98rpx; align-items: center; justify-content: space-between; padding: 0 30rpx; border-bottom: 1rpx solid #eeeeee; }
.setting-row:last-child { border-bottom: 0; }
.setting-left { display: flex; min-width: 0; align-items: center; color: #343434; font-size: 29rpx; }
.setting-icon { width: 42rpx; height: 42rpx; margin-right: 18rpx; }
.setting-row switch { flex-shrink: 0; transform: scale(.9); transform-origin: right center; }
