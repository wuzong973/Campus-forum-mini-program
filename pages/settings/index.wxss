.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

.section-title {
  font-size: 26rpx;
  color: #969799;
  padding: 32rpx 32rpx 16rpx;
}

.card {
  margin: 0 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f7fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #323233;
  white-space: nowrap;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-value {
  font-size: 28rpx;
  color: #969799;
  margin-right: 12rpx;
}

.menu-value.placeholder {
  color: #c8c9cc;
}

.menu-value.version {
  color: #969799;
}

.menu-value.school-fixed {
  color: #969799;
}

.avatar-preview {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.arrow {
  color: #c8c9cc;
  font-size: 0rpx;
}

.logout-btn {
  margin: 48rpx 24rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #323233;
}

/* ========== 常用地址 ========== */
.common-addr-section {
  margin: 24rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.common-addr-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.common-addr-label {
  font-size: 30rpx;
  color: #323233;
  font-weight: 500;
}

.common-addr-map-btn {
  font-size: 26rpx;
  color: #4a7aff;
  font-weight: 500;
}

.common-addr-map-btn:active {
  opacity: 0.7;
}

.common-addr-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #323233;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 1rpx solid #ebedf0;
  box-sizing: border-box;
}

/* ========== 弹窗遮罩 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition:
    opacity 0.3s,
    visibility 0.3s;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

/* ========== 头像来源底部弹窗 ========== */
.modal-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 102;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-bottom.show {
  transform: translateY(0);
}

.modal-bottom-title {
  text-align: center;
  font-size: 30rpx;
  color: #323233;
  font-weight: 600;
  padding: 32rpx 0 24rpx;
}

.modal-bottom-item {
  text-align: center;
  font-size: 30rpx;
  color: #4a7aff;
  padding: 28rpx 0;
  border-top: 1rpx solid #f5f7fa;
}

.avatar-source-btn {
  width: 100%;
  line-height: 1.4;
  background: #ffffff;
  border-radius: 0;
  border: none;
}

.avatar-source-btn::after {
  border: none;
}

.modal-bottom-cancel {
  text-align: center;
  font-size: 30rpx;
  color: #969799;
  padding: 28rpx 0;
  margin-top: 16rpx;
  border-top: 16rpx solid #f5f7fa;
}

/* ========== 完善个人资料弹窗 ========== */
.profile-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

.profile-modal.show {
  transform: translateY(0);
}

.profile-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  flex-shrink: 0;
}

.profile-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #323233;
}

.profile-modal-close {
  font-size: 40rpx;
  color: #969799;
  padding: 8rpx;
}

.profile-modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 每一行 */
.profile-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
  min-height: 80rpx;
}

.profile-row:last-child {
  border-bottom: none;
}

.profile-label {
  width: 120rpx;
  font-size: 30rpx;
  color: #323233;
  flex-shrink: 0;
}

.profile-input {
  flex: 1;
  font-size: 30rpx;
  color: #323233;
  text-align: right;
}

.nickname-edit {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.nickname-edit .profile-input {
  min-width: 0;
}

.wechat-fill-btn {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef3ff;
  color: #4a7aff;
  font-size: 22rpx;
  line-height: 1.4;
  margin: 0;
  white-space: nowrap;
}

.wechat-fill-btn::after {
  border: none;
}

.profile-school-fixed {
  flex: 1;
  font-size: 30rpx;
  color: #969799;
  text-align: right;
}

/* 头像行 */
.avatar-row {
  justify-content: space-between;
}

.avatar-edit-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.avatar-camera-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: #4a7aff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #ffffff;
}

.camera-icon-img {
  width: 24rpx;
  height: 24rpx;
}

.camera-text {
  font-size: 20rpx;
}

/* 性别行 */
.gender-row {
  justify-content: space-between;
}

.gender-options {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gender-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #dcdfe6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-checked-male {
  border-color: #4a7aff;
  background: #4a7aff;
}

.radio-checked-male::after {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
}

.radio-checked-female {
  border-color: #ff6b9d;
  background: #ff6b9d;
}

.radio-checked-female::after {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
}

.radio-unchecked {
  border-color: #dcdfe6;
  background: #ffffff;
}

.gender-icon {
  font-size: 36rpx;
}

.male-icon {
  color: #4a7aff;
}

.female-icon {
  color: #ff6b9d;
}

/* 校区行 */
.campus-row {
  justify-content: space-between;
}

.campus-options {
  display: flex;
  gap: 16rpx;
}

.campus-tag {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #646566;
  border: 1rpx solid #dcdfe6;
  background: #ffffff;
  white-space: nowrap;
}

.campus-tag.campus-active {
  background: #4a7aff;
  color: #ffffff;
  border-color: #4a7aff;
}

.campus-sub-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 0 24rpx 120rpx;
  border-bottom: 1rpx solid #f5f7fa;
}

.campus-subtag {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #646566;
  border: 1rpx solid #dcdfe6;
  background: #ffffff;
  white-space: nowrap;
}

.campus-subtag.campus-active {
  background: #eef3ff;
  color: #4a7aff;
  border-color: #4a7aff;
}

/* 底部确认按钮 */
.profile-modal-footer {
  padding: 24rpx 32rpx 32rpx;
  flex-shrink: 0;
}

.confirm-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #4a7aff;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

.phone-row { position: relative; }

.phone-authorize-hit {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: auto;
  min-height: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.phone-authorize-hit::after { border: none; }
