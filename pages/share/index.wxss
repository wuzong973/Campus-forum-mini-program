.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
}

/* 导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.white-nav {
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  font-size: 36rpx;
  color: #333;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-right {
  width: 80rpx;
}

/* 原帖卡片 */
.original-post {
  margin: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.original-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.original-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #f0f0f0;
}

.original-nick {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.original-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  margin-bottom: 16rpx;
}

.original-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.original-img {
  width: calc((100% - 16rpx) / 3);
  height: 180rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

/* 转发输入区 */
.share-input-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.share-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  display: block;
}

.share-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  font-size: 22rpx;
  color: #999999;
  text-align: right;
  margin-top: 8rpx;
}

/* 转发按钮 */
.share-actions {
  padding: 0 24rpx 48rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4A7AFF;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}

.share-btn:active {
  background: #3a6aef;
}

.share-btn[disabled] {
  background: #cccccc;
  color: #ffffff;
}
