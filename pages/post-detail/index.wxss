.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 140rpx;
}

/* 导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.white-nav {
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  font-size: 36rpx;
  color: #333;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-right {
  width: 80rpx;
}

/* 帖子卡片 */
.post-card {
  margin: 24rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.post-user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.post-nick {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.post-time {
  font-size: 22rpx;
  color: #999999;
}

.post-content {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
  margin-bottom: 20rpx;
  word-break: break-word;
}

.post-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.42;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.post-img {
  width: calc((100% - 16rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.post-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* 评论区 */
.comments-section {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.comments-header {
  margin-bottom: 20rpx;
}

.comments-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.comment-list {
  display: flex;
  flex-direction: column;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-content-wrap {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.comment-nick {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.comment-time {
  font-size: 22rpx;
  color: #999999;
}

.comment-body {
  margin-bottom: 10rpx;
}

.comment-reply-to {
  font-size: 26rpx;
  color: #4A7AFF;
}

.comment-text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #333333;
}

.comment-actions {
  display: flex;
  gap: 24rpx;
}

.comment-action-btn {
  font-size: 22rpx;
  color: #999999;
  padding: 4rpx 8rpx;
}

.comment-action-btn:active {
  color: #4A7AFF;
}

.comment-action-btn.delete {
  color: #FF4D4F;
}

.empty-comments {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 12rpx 24rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 100;
}

.comment-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 8rpx 0 24rpx;
  height: 72rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: #333333;
}

.send-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #999999;
  font-weight: 500;
  flex-shrink: 0;
}

.send-btn.active {
  color: #4A7AFF;
  font-weight: 600;
}

.action-buttons {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  background: #f5f5f5;
}

.action-btn.liked .action-count {
  color: #FF4D4F;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 4rpx;
}

.action-count {
  font-size: 20rpx;
  color: #666666;
  font-weight: 500;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.edit-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  z-index: 201;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  padding: 8rpx;
}

.modal-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666666;
}

.modal-btn.confirm {
  background: #4A7AFF;
  color: #ffffff;
}
