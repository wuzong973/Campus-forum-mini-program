.page { height: 100vh; background: #f6f7f9; overflow: hidden; }
.page-scroll { box-sizing: border-box; }
.post-detail, .comments-section { margin: 16rpx 14rpx; padding: 24rpx 22rpx; border-radius: 12rpx; background: #ffffff; }
.post-header { display: flex; align-items: center; }
.post-avatar, .comment-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; background: #edf1f6; flex: 0 0 auto; }
.post-avatar { margin-right: 14rpx; }
.post-user-info { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.post-nick, .comment-nick { color: #203147; font-size: 27rpx; font-weight: 700; }
.post-nick-row { display: flex; align-items: center; gap: 8rpx; }
.post-cert-label { flex: 0 0 auto; padding: 2rpx 10rpx; border-radius: 4rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-size: 20rpx; font-weight: 500; line-height: 1.4; }
.post-time, .comment-time { color: #a1aab6; font-size: 21rpx; }
.post-meta { display: flex; align-items: center; gap: 9rpx; color: #9ea9b7; font-size: 21rpx; }
.meta-dot { color: #d3d9e0; }
.meta-category { flex: 0 1 auto; max-width: 168rpx; overflow: hidden; padding: 2rpx 10rpx; border-radius: 6rpx; background: #f0edff; color: #7268b8; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.post-review-note { display: inline-flex; align-items: center; flex: 0 1 auto; min-width: 0; max-width: 240rpx; overflow: hidden; padding: 2rpx 10rpx; border: 2rpx solid #ef5b73; border-radius: 6rpx; background: #fff1f3; color: #b4233e; font-size: 20rpx; font-weight: 600; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.more-icon { width: 30rpx; height: 30rpx; opacity: .62; }
.note-editor-mask { position: fixed; z-index: 1000; inset: 0; background: rgba(0, 0, 0, .48); }
.note-editor { position: fixed; z-index: 1001; left: 50%; width: 660rpx; padding: 28rpx; box-sizing: border-box; border-radius: 8rpx; background: #fff; box-shadow: 0 14rpx 36rpx rgba(23, 38, 59, .18); transform: translateX(-50%); }
.note-editor-header { display: flex; align-items: center; justify-content: space-between; }
.note-editor-title { color: #1e2f45; font-size: 32rpx; font-weight: 700; }
.note-editor-count { color: #9aa6b6; font-size: 22rpx; }
.note-editor-input { width: 100%; height: 174rpx; margin-top: 20rpx; padding: 18rpx; box-sizing: border-box; border: 1rpx solid #dce3ec; border-radius: 6rpx; background: #f8fafc; color: #203147; font-size: 27rpx; line-height: 1.5; }
.note-editor-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.note-editor-btn { flex: 1; height: 74rpx; margin: 0; border: 0; border-radius: 6rpx; font-size: 27rpx; line-height: 74rpx; }
.note-editor-btn::after { border: none; }
.note-editor-btn.cancel { background: #f1f3f6; color: #627084; }
.note-editor-btn.confirm { background: #3478f6; color: #fff; }
.note-editor-btn.confirm.is-disabled { background: #b7c7e4; color: #fff; }
.post-title { display: block; margin-top: 18rpx; color: #1c2e44; font-size: 31rpx; font-weight: 700; line-height: 1.45; }
.post-content { display: block; margin-top: 16rpx; color: #1e3048; font-size: 30rpx; line-height: 1.6; word-break: break-word; }
/* 图片九宫格：1图大图(4:3)、2图半宽、3图及以上三列，aspect-ratio 随屏宽等比缩放 */
.post-images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.post-img-wrap { width: calc(33.33% - 8rpx); aspect-ratio: 1 / 1; overflow: hidden; border-radius: 8rpx; background: #edf1f6; }
.post-images.count-1 .post-img-wrap { width: 65%; aspect-ratio: 4 / 3; }
.post-images.count-2 .post-img-wrap { width: calc(50% - 6rpx); }
.post-img { width: 100%; height: 100%; }
.post-img-error { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #8290a0; font-size: 22rpx; }
.post-components { margin-top: 22rpx; }
.detail-poll { margin-top: 16rpx; padding: 22rpx; border: 1rpx solid #e7edf5; border-radius: 12rpx; background: #fbfcfe; }
.component-detail-head { display: flex; align-items: center; gap: 8rpx; color: #20334b; font-size: 27rpx; font-weight: 700; }
.component-detail-icon { color: #3478f6; font-size: 34rpx; }
.component-detail-mode { margin-left: auto; padding: 4rpx 12rpx; border-radius: 16rpx; background: #eaf1ff; color: #3478f6; font-size: 21rpx; font-weight: 500; }
.component-question { display: block; margin: 18rpx 0 10rpx; color: #1e3048; font-size: 29rpx; font-weight: 700; line-height: 1.45; }
.poll-option { display: flex; align-items: center; min-height: 70rpx; gap: 10rpx; color: #405068; font-size: 26rpx; }
.poll-option checkbox, .poll-option radio { transform: scale(.82); }
.poll-votes { margin-left: auto; color: #99a6b4; font-size: 22rpx; }
.component-action-btn { width: 100%; height: 72rpx; margin-top: 16rpx; border: 0; border-radius: 8rpx; background: #3478f6; color: #fff; font-size: 26rpx; line-height: 72rpx; }
.component-action-btn[disabled] { background: #c5d3e8; color: #fff; }
.component-action-btn::after { border: none; }
.post-topic-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 18rpx; }
.campus-tag { max-width: 180rpx; overflow: hidden; padding: 4rpx 10rpx; border-radius: 4rpx; background: #f0f5ff; color: #5e7fb6; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.post-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding-top: 15rpx; border-top: 1rpx solid #eef1f4; }
.post-action-group { display: flex; align-items: center; gap: 14rpx; }
.post-action-group-right { gap: 14rpx; }
.post-action { display: flex; align-items: center; gap: 3rpx; color: #8995a3; font-size: 22rpx; white-space: nowrap; }
.post-action image { width: 38rpx; height: 38rpx; opacity: .74; }
.active-like { color: #e55b69; }
.active-favorite { color: #ca8e26; }
.active-follow { color: #5e7fb6; }
.active-like image, .active-favorite image, .active-follow image { opacity: 1; }
.contact-info { margin-top: 22rpx; padding-top: 2rpx; border-top: 1rpx solid #eef1f4; }
.contact-info-content { max-height: 0; padding: 0; opacity: 0; overflow: hidden; transition: max-height .32s ease, padding .32s ease, opacity .26s ease; }
.contact-info-content.expanded { max-height: 600rpx; padding: 18rpx 0 14rpx; opacity: 1; }
.contact-row { display: flex; align-items: center; min-height: 54rpx; }
.contact-label { width: 126rpx; flex: 0 0 auto; color: #9aa5b2; font-size: 24rpx; }
.contact-value { flex: 1; min-width: 0; color: #25364d; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.contact-copy { width: 34rpx; height: 34rpx; margin-left: 14rpx; opacity: .7; }
.contact-tip { display: block; margin-top: 12rpx; padding-top: 16rpx; border-top: 1rpx solid #edf0f4; color: #9da7b2; font-size: 22rpx; text-align: center; }
.contact-toggle { display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 52rpx; border-radius: 12rpx; color: #98a4b1; font-size: 24rpx; transition: background-color .2s ease; }
.contact-toggle-hover { background: #f2f5f9; }
.contact-toggle-icon { font-size: 28rpx; transition: transform .32s ease; }
.contact-toggle-icon.expanded { transform: rotate(180deg); }
.comments-section { margin-bottom: 150rpx; }
.comments-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18rpx; border-bottom: 1rpx solid #eef1f4; }
/* 评论区胶囊标签：白底 + 蓝灰柔影 */
.comments-tag { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 26rpx; border-radius: 999rpx; background: #ffffff; box-shadow: 0 6rpx 16rpx rgba(46, 61, 82, 0.10); transition: background-color 0.2s ease; }
.comments-tag-hover { background: #f1f3f6; }
.comments-tag-text { color: #2e3d52; font-size: 26rpx; font-weight: 600; }
.comments-tag-count { color: #98a2b3; font-size: 22rpx; }
/* 排序按钮：外层浅灰胶囊，选中项白色浮动胶囊 */
.comment-sort { display: flex; gap: 4rpx; padding: 6rpx; border-radius: 999rpx; background: #f1f3f6; }
.sort-option { padding: 8rpx 26rpx; border-radius: 999rpx; color: #6b7686; font-size: 24rpx; transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease; }
.sort-option.active { background: #ffffff; color: #3478f6; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(46, 61, 82, 0.12); }
.sort-hover { opacity: 0.6; }
.comment-content-wrap { flex: 1; min-width: 0; }
.comment-reply-trigger { min-height: 64rpx; }
.comment-text { display: block; margin-top: 6rpx; color: #27394f; font-size: 26rpx; line-height: 1.5; word-break: break-word; }
.comment-like-count { display: flex; align-items: center; gap: 4rpx; color: #9aa5b2; font-size: 22rpx; white-space: nowrap; }
.comment-like-count image { width: 28rpx; height: 28rpx; opacity: .72; }
.comment-item { display: flex; align-items: flex-start; gap: 14rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.comment-meta { display: flex; align-items: center; gap: 12rpx; }
.author-comment-label { flex: 0 0 auto; padding: 1rpx 8rpx; border: 1rpx solid #ffcaca; border-radius: 4rpx; background: #fff4f4; color: #e34b4b; font-size: 20rpx; font-weight: 600; line-height: 1.45; }
/* 评论头部：昵称/时间在左，三个点菜单在右上角 */
.comment-head { display: flex; align-items: center; }
.comment-head .comment-meta { flex: 1; min-width: 0; }
.comment-more { flex: 0 0 auto; margin-left: 16rpx; padding: 6rpx 0 6rpx 16rpx; }
.comment-more-icon { display: block; width: 32rpx; height: 32rpx; opacity: .55; }
/* 评论内容行：文字在左，点赞固定在文字行的最右边 */
.comment-body { display: flex; align-items: center; margin-top: 5rpx; }
.comment-text-wrap { flex: 1; min-width: 0; }
.comment-reply-to { color: #3478f6; font-size: 25rpx; }
.comment-image-list { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.comment-image { width: 130rpx; height: 130rpx; border-radius: 8rpx; background: #edf1f6; }
.comment-actions { display: flex; gap: 20rpx; margin-top: 12rpx; color: #98a3af; font-size: 22rpx; }
.comment-actions .delete { color: #d8666d; }
.comment-like { display: flex; align-items: center; gap: 6rpx; flex: 0 0 auto; margin-left: 16rpx; color: #99a4b1; font-size: 21rpx; white-space: nowrap; transition: color 0.2s ease, opacity 0.2s ease; }
.comment-like image { width: 32rpx; height: 32rpx; opacity: .72; }
.comment-like .like-count { font-size: 22rpx; line-height: 1.2; }
.like-hover { opacity: 0.6; }
.reply-list { margin-top: 20rpx; padding: 4rpx 0 0 18rpx; border-left: 2rpx solid #e8edf3; }
.reply-item { display: flex; align-items: flex-start; gap: 12rpx; padding: 14rpx 0; }
.reply-avatar { width: 46rpx; height: 46rpx; flex: 0 0 auto; border-radius: 50%; background: #edf1f6; }
.reply-content { flex: 1; min-width: 0; }
.reply-item .comment-nick { font-size: 25rpx; }
.reply-item .comment-text { font-size: 25rpx; }
.reply-toggle { display: flex; align-items: center; gap: 12rpx; min-height: 54rpx; margin-top: 2rpx; color: #3478f6; font-size: 24rpx; font-weight: 600; }
.reply-toggle-line { width: 34rpx; height: 1rpx; background: #cfd8e3; }
.empty-comments { padding: 50rpx 0 30rpx; color: #a2acb8; font-size: 26rpx; text-align: center; }
.bottom-bar { position: fixed; z-index: 20; right: 0; bottom: 0; left: 0; padding: 12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1rpx solid #edf0f4; }
.comment-toolbar { display: flex; align-items: center; gap: 10rpx; }
.comment-anonymous-btn { display: flex; align-items: center; gap: 5rpx; height: 54rpx; padding: 0 12rpx; border: 1rpx solid #d9e0e9; border-radius: 28rpx; color: #7d8999; font-size: 22rpx; white-space: nowrap; }
.comment-anonymous-btn.active { border-color: #3478f6; background: #eaf1ff; color: #3478f6; font-weight: 700; }
.anonymous-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #b2bdca; }
.comment-anonymous-btn.active .anonymous-dot { background: #3478f6; }
.comment-input { flex: 1; min-width: 0; height: 70rpx; padding: 0 20rpx; border-radius: 36rpx; background: #f3f5f8; color: #1d3048; font-size: 26rpx; }
.send-btn { color: #9ca7b4; font-size: 26rpx; }
.send-btn.active { color: #3478f6; font-weight: 700; }
.tool-btn { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #64748b; font-size: 32rpx; }
.comment-preview-images { display: flex; gap: 10rpx; margin-bottom: 10rpx; }
.comment-preview-item { position: relative; width: 82rpx; height: 82rpx; }
.comment-preview-img { width: 100%; height: 100%; border-radius: 8rpx; }
.comment-preview-remove { position: absolute; top: -9rpx; right: -9rpx; width: 28rpx; height: 28rpx; line-height: 26rpx; border-radius: 50%; background: #364152; color: #fff; text-align: center; }
.emoji-panel { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #eef1f4; }
.emoji-item { width: 54rpx; height: 54rpx; line-height: 54rpx; text-align: center; font-size: 32rpx; }
.modal-mask { position: fixed; z-index: 30; inset: 0; background: rgba(0, 0, 0, .5); }
.edit-modal { position: fixed; z-index: 31; top: 50%; left: 50%; width: 600rpx; padding: 28rpx; box-sizing: border-box; border-radius: 16rpx; background: #fff; transform: translate(-50%, -50%); }
.modal-header { display: flex; align-items: center; justify-content: space-between; }
.modal-title { color: #1d3048; font-size: 30rpx; font-weight: 700; }
.modal-close { color: #8c98a6; font-size: 40rpx; }
.modal-textarea { width: 100%; min-height: 180rpx; margin-top: 22rpx; padding: 18rpx; box-sizing: border-box; border-radius: 10rpx; background: #f4f6f9; font-size: 27rpx; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.modal-btn { flex: 1; height: 72rpx; line-height: 72rpx; border: 0; border-radius: 36rpx; font-size: 27rpx; }
.modal-btn.cancel { background: #f2f4f7; color: #607084; }
.modal-btn.confirm { background: #3478f6; color: #fff; }
.modal-btn::after { border: none; }


/* 今日热榜预览：与首页保持相同尺寸、轮换和交互样式 */
.today-hot-card {
  margin: 0 20rpx 12rpx;
  padding: 12rpx 18rpx 8rpx;
  border: 1rpx solid rgba(234, 238, 247, 0.82);
  border-radius: 22rpx;
  background: #fffdf1;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 86, 0.07);
  box-sizing: border-box;
  transition: all 0.24s cubic-bezier(0.2, 0, 0, 1);
}
.today-hot-card:active { transform: translateY(-2rpx); box-shadow: 0 12rpx 26rpx rgba(237, 176, 42, 0.14); }
.today-hot-header { display: flex; align-items: center; min-height: 40rpx; }
.today-hot-title-wrap { display: flex; align-items: center; gap: 14rpx; flex: 1; min-width: 0; }
.today-hot-fire { color: #f04f36; font-size: 34rpx; line-height: 1; }
.today-hot-title { color: #272727; font-size: 30rpx; font-weight: 800; }
.today-hot-more { padding: 6rpx 12rpx; border-radius: 8rpx; background: #ff3d62; color: #fff; font-size: 20rpx; font-weight: 700; }
.today-hot-swiper { height: 76rpx; margin-top: 2rpx; }
.today-hot-row { display: flex; height: 38rpx; align-items: center; gap: 10rpx; }
.today-hot-rank { width: 30rpx; flex: 0 0 30rpx; color: #e4af11; font-size: 24rpx; font-weight: 800; text-align: right; }
.today-hot-text { overflow: hidden; flex: 1; color: #222; font-size: 25rpx; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.today-hot-loading { padding: 24rpx 18rpx; color: #9aa5b1; font-size: 25rpx; text-align: center; }

.anon-sheet-mask { position: fixed; z-index: 1100; inset: 0; background: rgba(0, 0, 0, .45); }
.anon-sheet { position: fixed; z-index: 1101; left: 0; right: 0; bottom: 0; background: #f4f4f6; border-radius: 36rpx 36rpx 0 0; padding: 44rpx 40rpx calc(56rpx + env(safe-area-inset-bottom)); }
.anon-sheet-close { position: absolute; top: 36rpx; right: 32rpx; width: 64rpx; height: 64rpx; border-radius: 50%; background: #e9e9ec; color: #7c7c82; font-size: 40rpx; line-height: 60rpx; text-align: center; }
.anon-sheet-user { display: flex; align-items: center; }
.anon-sheet-avatar { width: 108rpx; height: 108rpx; border-radius: 26rpx; background: #fff; flex: 0 0 auto; }
.anon-sheet-nick { margin-left: 24rpx; font-size: 36rpx; font-weight: 700; color: #1a1a1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.anon-sheet-owner { position: relative; flex: 0 0 auto; margin-left: 14rpx; padding: 3rpx 12rpx; background: #f43a26; border-radius: 8rpx; }
.anon-sheet-owner-text { color: #fff; font-size: 22rpx; font-weight: 700; }
.anon-sheet-owner-op { position: absolute; top: -12rpx; right: -10rpx; padding: 0 6rpx; background: #ffd54a; border-radius: 6rpx 6rpx 6rpx 0; color: #6b4a00; font-size: 18rpx; font-weight: 800; line-height: 22rpx; }
.anon-sheet-msg-btn { display: block; margin: 76rpx auto 0; width: 330rpx; height: 90rpx; line-height: 90rpx; padding: 0; border-radius: 45rpx; background: #f8503a; color: #fff; font-size: 32rpx; font-weight: 600; text-align: center; }
.anon-sheet-msg-btn::after { border: none; }
.anon-sheet-tip { display: block; margin-top: 44rpx; text-align: center; color: #9b9ba1; font-size: 28rpx; }

/* 普通帖帖主头像弹出的选择层（个人主页 / 分身私信） */
.author-sheet-badge { flex: 0 0 auto; margin-left: 14rpx; padding: 4rpx 14rpx; background: #52b0a8; border-radius: 8rpx; }
.author-sheet-badge-text { color: #fff; font-size: 22rpx; font-weight: 600; }
.author-sheet-actions { display: flex; margin-top: 60rpx; }
.author-sheet-btn { flex: 1; height: 90rpx; line-height: 90rpx; padding: 0; margin: 0; border-radius: 45rpx; font-size: 32rpx; font-weight: 600; text-align: center; }
.author-sheet-btn + .author-sheet-btn { margin-left: 28rpx; }
.author-sheet-btn::after { border: none; }
.author-sheet-btn.ghost { background: #fff; color: #333; border: 1rpx solid #e3e3e8; }
.author-sheet-btn.primary { background: #f8503a; color: #fff; }

