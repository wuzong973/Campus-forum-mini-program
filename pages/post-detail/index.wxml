<view class="page" wx:if="{{post}}">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{pageHeight}}px;">
    <view class="post-detail">
      <view class="post-header">
        <image class="post-avatar" src="{{post.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" catchtap="onAvatarTap" data-userid="{{post.userId}}"></image>
        <view class="post-user-info">
        <view class="post-nick-row">
          <text class="post-nick">{{post.nickName || '校园同学'}}</text>
          <text class="post-review-note" wx:if="{{post.reviewNote}}">备注：{{post.reviewNote}}</text>
          <text class="post-cert-label" wx:if="{{post.certLabel}}">{{post.certLabel}}</text>
        </view>
        <view class="post-meta">
          <text class="meta-category">{{post.category || '日常话题'}}</text>
          <text class="meta-dot">·</text>
          <text>{{timeText}}</text>
          <text class="meta-dot">·</text>
          <text>{{viewText}}</text>
        </view>
      </view>
        <image class="more-icon" src="/assets/icons/more.png" mode="aspectFit" catchtap="openActionMenu"></image>
      </view>
      <text class="post-title" wx:if="{{post.title}}">{{post.title}}</text>
      <text class="post-content">{{post.content}}</text>
      <view class="post-images count-{{detailImages.length > 3 ? 'n' : detailImages.length}}" wx:if="{{detailImages.length}}">
        <view class="post-img-wrap" wx:for="{{detailImages}}" wx:key="url">
          <image wx:if="{{!item.failed}}" src="{{item.url}}" mode="aspectFill" class="post-img" lazy-load="{{true}}" data-url="{{item.url}}" catchtap="onPreviewPostImage" binderror="onPostImageError"></image>
          <view wx:else class="post-img-error" data-url="{{item.url}}" catchtap="onRetryPostImage">图片加载失败</view>
        </view>
      </view>
      <view class="post-components" wx:if="{{post.components && post.components.length}}">
        <view class="detail-poll" wx:for="{{post.components}}" wx:for-index="compIndex" wx:key="_key" wx:if="{{item.type === 'poll'}}">
          <view class="component-detail-head"><text class="component-detail-icon">☆</text><text>投票</text><text class="component-detail-mode">{{item.mode === 'multiple' ? '多选' : '单选'}}</text></view>
          <text class="component-question">{{item.question}}</text>
          <checkbox-group bindchange="onPollChoice" data-poll-index="{{compIndex}}" wx:if="{{item.mode === 'multiple'}}"><label class="poll-option" wx:for="{{item.options}}" wx:for-item="option" wx:key="index"><checkbox value="{{index}}" checked="{{pollChecked[compIndex][index]}}" color="#3478f6"></checkbox><text>{{option.text}}</text><text class="poll-votes">{{option.votes || 0}} 票</text></label></checkbox-group>
          <radio-group bindchange="onPollChoice" data-poll-index="{{compIndex}}" wx:else><label class="poll-option" wx:for="{{item.options}}" wx:for-item="option" wx:key="index"><radio value="{{index}}" checked="{{pollChecked[compIndex][index]}}" color="#3478f6"></radio><text>{{option.text}}</text><text class="poll-votes">{{option.votes || 0}} 票</text></label></radio-group>
          <button class="component-action-btn" loading="{{submittingVote}}" disabled="{{submittingVote || (item.selectedOptionIndexes && item.selectedOptionIndexes.length)}}" data-poll-index="{{compIndex}}" bindtap="onSubmitVote">{{item.selectedOptionIndexes && item.selectedOptionIndexes.length ? '已投票' : '提交投票'}}</button>
        </view>
      </view>
      <view class="post-topic-meta">
        <view class="campus-tag">{{post.campus || '未设置校区'}}</view>
      </view>
      <view class="post-actions">
        <view class="post-action-group">
          <view class="post-action {{post.isFavorited ? 'active-favorite' : ''}}" catchtap="onFavoritePost"><image src="/assets/icons/star-outline.png" mode="aspectFit"></image><text>收藏{{post.favoriteCount ? ' ' + post.favoriteCount : ''}}</text></view>
          <view class="post-action {{post.isFollowed ? 'active-follow' : ''}}" catchtap="onFollowPost"><image src="/assets/icons/bookmark-outline.png" mode="aspectFit"></image><text>蹲帖</text></view>
        </view>
        <view class="post-action-group post-action-group-right">
          <view class="post-action" catchtap="onSharePost"><image src="/assets/icons/share.png" mode="aspectFit"></image><text>分享{{post.shareCount ? ' ' + post.shareCount : ''}}</text></view>
          <view class="post-action {{post.isLiked ? 'active-like' : ''}}" catchtap="onLikePost"><image src="/assets/icons/heart-outline.png" mode="aspectFit"></image><text>点赞{{post.likeCount ? ' ' + post.likeCount : ''}}</text></view>
          <view class="post-action" catchtap="onFocusComment"><image src="/assets/icons/comment.png" mode="aspectFit"></image><text>评论{{post.commentCount ? ' ' + post.commentCount : ''}}</text></view>
        </view>
      </view>
      <view class="contact-info" wx:if="{{post.contact}}">
        <view class="contact-info-content {{contactExpanded ? 'expanded' : ''}}">
          <view class="contact-row"><text class="contact-label">联系姓名</text><text class="contact-value">{{post.contact.name}}</text></view>
          <view class="contact-row"><text class="contact-label">{{post.contact.type}}</text><text class="contact-value">{{post.contact.value}}</text><image class="contact-copy" src="/assets/icons/clipboard.png" mode="aspectFit" catchtap="onCopyContact"></image></view>
          <text class="contact-tip">联系 Ta 时请备注在「校园社区」看到的</text>
        </view>
        <view class="contact-toggle" hover-class="contact-toggle-hover" hover-stay-time="80" catchtap="toggleContactInfo"><text>{{contactExpanded ? '收起联系方式' : '展开联系方式'}}</text><text class="contact-toggle-icon {{contactExpanded ? 'expanded' : ''}}">⌄</text></view>
      </view>
    </view>

    <view class="comments-section">
      <view class="comments-header"><view class="comments-tag" hover-class="comments-tag-hover" hover-stay-time="80"><text class="comments-tag-text">评论区</text><text class="comments-tag-count" wx:if="{{commentTotal > 0}}">{{commentTotal}}</text></view><view class="comment-sort"><view class="sort-option {{commentSort === 'time' ? 'active' : ''}}" hover-class="sort-hover" hover-stay-time="80" data-sort="time" catchtap="onCommentSort">时间</view><view class="sort-option {{commentSort === 'hot' ? 'active' : ''}}" hover-class="sort-hover" hover-stay-time="80" data-sort="hot" catchtap="onCommentSort">赞数↓</view></view></view>
      <view class="top-comment" wx:if="{{commentSort === 'hot' && topLikedComment}}"><text class="top-comment-label">热门评论</text><view class="top-comment-body"><image class="comment-avatar" src="{{topLikedComment.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" data-userid="{{topLikedComment.userId}}" data-anonymous="{{topLikedComment.isAnonymous}}" catchtap="onCommentAvatarTap"></image><view class="comment-content-wrap comment-reply-trigger" catchtap="onReplyComment" data-id="{{topLikedComment.id}}" data-nick="{{topLikedComment.nickName}}"><view class="comment-meta"><text class="comment-nick">{{topLikedComment.nickName}}</text><text class="author-comment-label" wx:if="{{topLikedComment.isAuthor}}">作者</text></view><text class="comment-text">{{topLikedComment.content}}</text></view><view class="comment-like-count"><image src="/assets/icons/heart-outline.png" mode="aspectFit"></image><text>点赞{{topLikedComment.likeCount ? ' ' + topLikedComment.likeCount : ''}}</text></view></view></view>
      <view class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <image class="comment-avatar" src="{{item.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" data-userid="{{item.userId}}" data-anonymous="{{item.isAnonymous}}" catchtap="onCommentAvatarTap"></image>
          <view class="comment-content-wrap comment-reply-trigger" catchtap="onReplyComment" data-id="{{item.id}}" data-nick="{{item.nickName}}">
            <view class="comment-meta"><text class="comment-nick">{{item.nickName}}</text><text class="author-comment-label" wx:if="{{item.isAuthor}}">作者</text><text class="comment-time">{{item.timeText}}</text></view>
            <view class="comment-body"><text class="comment-reply-to" wx:if="{{item.replyToNick}}">回复 {{item.replyToNick}}：</text><text class="comment-text">{{item.content}}</text></view>
            <view class="comment-image-list" wx:if="{{item.images && item.images.length}}"><image class="comment-image" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill"></image></view>
            <view class="comment-actions" wx:if="{{item.userId === currentUserId}}"><text catchtap="onEditComment" data-id="{{item.id}}" data-content="{{item.content}}">编辑</text><text class="delete" catchtap="onDeleteComment" data-id="{{item.id}}">删除</text></view>
            <view class="reply-list" wx:if="{{item.replies.length}}">
              <view class="reply-item" wx:for="{{item.expanded ? item.replies : item.recentReplies}}" wx:for-item="reply" wx:key="id" catchtap="onReplyComment" data-id="{{reply.id}}" data-nick="{{reply.nickName}}">
                <image class="reply-avatar" src="{{reply.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" data-userid="{{reply.userId}}" data-anonymous="{{reply.isAnonymous}}" catchtap="onCommentAvatarTap"></image>
                <view class="reply-content">
                  <view class="comment-meta"><text class="comment-nick">{{reply.nickName}}</text><text class="author-comment-label" wx:if="{{reply.isAuthor}}">作者</text><text class="comment-time">{{reply.timeText}}</text></view>
                  <view class="comment-body"><text class="comment-reply-to" wx:if="{{reply.replyToNick}}">回复 {{reply.replyToNick}}：</text><text class="comment-text">{{reply.content}}</text></view>
                  <view class="comment-image-list" wx:if="{{reply.images && reply.images.length}}"><image class="comment-image" wx:for="{{reply.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill"></image></view>
                  <view class="comment-actions" wx:if="{{reply.userId === currentUserId}}"><text catchtap="onEditComment" data-id="{{reply.id}}" data-content="{{reply.content}}">编辑</text><text class="delete" catchtap="onDeleteComment" data-id="{{reply.id}}">删除</text></view>
                </view>
                <view class="comment-like {{reply.isLiked ? 'active-like' : ''}}" hover-class="like-hover" hover-stay-time="80" catchtap="onLikeComment" data-id="{{reply.id}}"><image src="/assets/icons/heart-outline.png" mode="aspectFit"></image><text class="like-count" wx:if="{{reply.likeCount > 0}}">{{reply.likeCount}}</text></view>
              </view>
              <view class="reply-toggle" wx:if="{{item.hasHiddenReplies}}" catchtap="toggleCommentReplies" data-id="{{item.id}}"><text class="reply-toggle-line"></text><text>{{item.expanded ? '收起回复' : '展开 ' + item.hiddenReplyCount + ' 条回复'}}</text></view>
            </view>
          </view>
          <view class="comment-like {{item.isLiked ? 'active-like' : ''}}" hover-class="like-hover" hover-stay-time="80" catchtap="onLikeComment" data-id="{{item.id}}"><image src="/assets/icons/heart-outline.png" mode="aspectFit"></image><text class="like-count" wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text></view>
        </view>
        <view class="empty-comments" wx:if="{{commentTotal === 0}}">还没有评论，来说两句吧</view>
      </view>
    </view>
  </scroll-view>

  <view class="note-editor-mask" wx:if="{{showNoteEditor}}" catchtap="closeNoteEditor"></view>
  <view class="note-editor" wx:if="{{showNoteEditor}}" catchtap="noop" style="bottom: {{noteKeyboardHeight ? noteKeyboardHeight : 16}}px;">
    <view class="note-editor-header">
      <view class="note-editor-title">添加备注</view>
      <text class="note-editor-count">{{noteLength}}/255</text>
    </view>
    <textarea class="note-editor-input" placeholder="请输入备注内容" maxlength="255" value="{{noteDraft}}" focus="{{noteInputFocus}}" cursor-spacing="20" adjust-position="{{false}}" bindinput="onNoteInput" bindkeyboardheightchange="onNoteKeyboardChange" />
    <view class="note-editor-actions">
      <button class="note-editor-btn cancel" catchtap="closeNoteEditor">取消</button>
      <button class="note-editor-btn confirm {{savingNote || !noteDraft ? 'is-disabled' : ''}}" loading="{{savingNote}}" disabled="{{savingNote || !noteDraft}}" catchtap="saveNote">保存备注</button>
    </view>
  </view>

  <view class="bottom-bar" style="bottom: {{keyboardHeight}}px;">
    <view class="comment-preview-images" wx:if="{{commentImages.length}}"><view class="comment-preview-item" wx:for="{{commentImages}}" wx:key="*this"><image class="comment-preview-img" src="{{item}}" mode="aspectFill"></image><view class="comment-preview-remove" data-index="{{index}}" catchtap="onRemoveCommentImage">×</view></view></view>
    <view class="comment-toolbar"><view class="comment-anonymous-btn {{commentAnonymous ? 'active' : ''}}" catchtap="toggleCommentAnonymous"><text class="anonymous-dot"></text>匿名</view><input class="comment-input" focus="{{commentFocus}}" cursor-spacing="18" adjust-position="{{false}}" placeholder="{{replyTo ? '回复 ' + replyToNick + '...' : '写评论...'}}" value="{{commentText}}" bindinput="onCommentInput" bindfocus="onInputFocus" bindblur="onInputBlur"></input><view class="send-btn {{commentText || commentImages.length ? 'active' : ''}}" bindtap="onSendComment">发送</view><view class="tool-btn" catchtap="toggleEmojiPanel">☺</view><view class="tool-btn" catchtap="onChooseCommentImage">＋</view></view>
    <view class="emoji-panel" wx:if="{{showEmojiPanel}}"><view class="emoji-item" wx:for="{{emojis}}" wx:key="*this" data-emoji="{{item}}" catchtap="onEmojiTap">{{item}}</view></view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal"></view>
  <view class="edit-modal" wx:if="{{showEditModal}}"><view class="modal-header"><text class="modal-title">编辑评论</text><text class="modal-close" bindtap="onCloseEditModal">×</text></view><textarea class="modal-textarea" value="{{editContent}}" bindinput="onEditContentInput" maxlength="200"></textarea><view class="modal-actions"><button class="modal-btn cancel" bindtap="onCloseEditModal">取消</button><button class="modal-btn confirm" bindtap="onConfirmEdit">确定</button></view></view>

  <share-popup
    visible="{{showSharePopup}}"
    postId="{{post.id}}"
    postTitle="{{post.title}}"
    postContent="{{post.content}}"
    bind:close="onCloseSharePopup"
    bind:shareToFriend="onShareToFriend"
    bind:sharePoster="onSharePoster"
  />
</view>
