<view class="page" wx:if="{{post}}">
  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{commentAnchor}}" scroll-with-animation style="height: {{pageHeight}}px;" bindscrolltolower="loadMoreComments">
    <view class="post-detail">
      <view class="post-header">
        <image class="post-avatar" src="{{post.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" catchtap="onAvatarTap" data-userid="{{post.userId}}"></image>
        <view class="post-user-info">
        <view class="post-nick-row">
          <text class="post-nick">{{post.nickName || '校园同学'}}</text>
          <text class="post-review-note" wx:if="{{post.reviewNote}}">备注：{{post.reviewNote}}</text>
          <text class="post-cert-label" wx:if="{{post.certLabel && !post.isAnonymous}}">{{post.certLabel}}</text>
        </view>
        <view class="post-meta">
          <text class="meta-category">{{post.category || '日常话题'}}</text>
          <text class="meta-dot">·</text>
          <text>{{timeText}}</text>
          <text class="meta-dot">·</text>
          <text>{{viewText}}</text>
        </view>
      </view>
        <image class="more-icon" src="/assets/icons/more.png" mode="aspectFit" catchtap="openActionMenu"></image>
      </view>
      <text class="post-title" wx:if="{{post.title}}">{{post.title}}</text>
      <text class="post-content">{{post.content}}</text>
      <view class="post-images count-{{detailImages.length > 3 ? 'n' : detailImages.length}}" wx:if="{{detailImages.length}}">
        <view class="post-img-wrap" wx:for="{{detailImages}}" wx:key="url">
          <video wx:if="{{item.type === 'video'}}" src="{{item.url}}" class="post-img post-video" object-fit="contain" controls show-center-play-btn></video>
          <block wx:else>
            <image wx:if="{{!item.failed}}" src="{{item.url}}" mode="aspectFill" class="post-img" lazy-load="{{true}}" data-url="{{item.url}}" data-urls="{{postImageUrls}}" catchtap="onPreviewPostImage" bindlongpress="onImageQrScan" binderror="onPostImageError"></image>
            <view wx:else class="post-img-error" data-url="{{item.url}}" catchtap="onRetryPostImage">图片加载失败</view>
          </block>
        </view>
      </view>
      <view class="post-components" wx:if="{{post.components && post.components.length}}">
        <view class="detail-poll" wx:for="{{post.components}}" wx:for-index="compIndex" wx:key="_key" wx:if="{{item.type === 'poll'}}">
          <view class="component-detail-head"><text class="component-detail-icon">★</text><text class="component-question-text">{{item.question || '投票'}}</text><text class="component-detail-mode">{{item.mode === 'multiple' ? '多选' : '单选'}}</text></view>
          <view
            class="poll-option-bar {{pollChecked[compIndex][optIndex] ? 'selected' : ''}}"
            wx:for="{{item.options}}"
            wx:for-item="option"
            wx:for-index="optIndex"
            wx:key="index"
            data-poll-index="{{compIndex}}"
            data-option-index="{{optIndex}}"
            catchtap="onPollOptionTap"
          >
            <view class="poll-option-fill" style="width: {{option._pct || 0}}%;"></view>
            <text class="poll-option-text">{{option.text}}</text>
            <text class="poll-option-count">{{option.votes || 0}}</text>
          </view>
          <button hover-class="press-spring" class="component-action-btn spring-btn" loading="{{submittingVote}}" disabled="{{submittingVote || (item.selectedOptionIndexes && item.selectedOptionIndexes.length)}}" data-poll-index="{{compIndex}}" bindtap="onSubmitVote" hover-stay-time="120">{{item.selectedOptionIndexes && item.selectedOptionIndexes.length ? '已投票' : '提交投票'}}</button>
        </view>
      </view>
      <view class="post-topic-meta">
        <view class="campus-tag">{{post.campus || '未设置校区'}}</view>
      </view>
      <view class="post-actions">
        <view class="post-action-group">
          <view class="post-action {{post.isFavorited ? 'active-favorite' : ''}} {{favoriteAnim}} spring-btn" hover-class="post-action-pressed press-spring" hover-start-time="0" hover-stay-time="120" catchtap="onFavoritePost"><view class="pa-icon pa-star {{post.isFavorited ? 'on' : ''}}"></view><text>{{post.favoriteCount > 0 ? post.favoriteCount : '收藏'}}</text></view>
          <view class="post-action {{post.isFollowed ? 'active-follow' : ''}} {{followAnim}} spring-btn" hover-class="post-action-pressed press-spring" hover-start-time="0" hover-stay-time="120" catchtap="onFollowPost"><view class="pa-icon pa-bookmark {{post.isFollowed ? 'on' : ''}}"></view><text>{{post.followCount > 0 ? post.followCount : '蹲贴'}}</text></view>
        </view>
        <view class="post-action-group post-action-group-right">
          <view class="post-action" catchtap="onSharePost"><image src="/assets/icons/share.png" mode="aspectFit"></image><text>{{post.shareCount > 0 ? post.shareCount : '分享'}}</text></view>
          <view class="post-action {{post.isLiked ? 'active-like' : ''}} {{likeAnim}} spring-btn" hover-class="post-action-pressed press-spring" hover-start-time="0" hover-stay-time="120" catchtap="onLikePost"><view class="pa-icon pa-heart {{post.isLiked ? 'on' : ''}}"></view><text>{{post.likeCount > 0 ? post.likeCount : '点赞'}}</text><view class="heart-fly" wx:if="{{likeHeartFly}}"><view class="heart-fly-core"></view></view></view>
          <view class="post-action" catchtap="onFocusComment"><image src="/assets/icons/comment.png" mode="aspectFit"></image><text>{{post.commentCount > 0 ? post.commentCount : '评论'}}</text></view>
        </view>
      </view>
      <view class="contact-info" wx:if="{{post.contact}}">
        <view class="contact-info-content {{contactExpanded ? 'expanded' : ''}}">
          <view class="contact-row"><text class="contact-label">联系姓名</text><text class="contact-value">{{post.contact.name}}</text></view>
          <view class="contact-row"><text class="contact-label">{{post.contact.type}}</text><text class="contact-value">{{post.contact.value}}</text><image class="contact-copy" src="/assets/icons/clipboard.png" mode="aspectFit" catchtap="onCopyContact"></image></view>
          <text class="contact-tip">联系 Ta 时请备注在「帕云校园论坛」看到的</text>
        </view>
        <view class="contact-toggle spring-btn" hover-class="contact-toggle-hover press-spring" hover-stay-time="80" catchtap="toggleContactInfo"><text>{{contactExpanded ? '收起联系方式' : '展开联系方式'}}</text><view class="contact-toggle-icon {{contactExpanded ? 'expanded' : ''}}"><view class="contact-toggle-chevron"></view></view></view>
      </view>
    </view>

    <!-- 帖子详情页横幅（管理员在详情页独立配置），点击查看详情 -->
    <view class="detail-banner" wx:if="{{postBanner.text}}" style="{{postBanner.bannerStyle}}" bindtap="goPostBannerDetail">
      <view class="detail-banner-left">
        <text class="detail-banner-icon">{{postBanner.icon}}</text>
        <text class="detail-banner-text">{{postBanner.text}}</text>
      </view>
      <text class="detail-banner-arrow">查看 »</text>
    </view>

    <!-- 与首页一致的今日热榜预览（用户关闭偏好时整体隐藏） -->
    <view class="today-hot-card card" wx:if="{{dailyHotVisible && hotPosts.length}}" bindtap="onTodayHotTap">
      <view class="today-hot-header">
        <view class="today-hot-title-wrap"><text class="today-hot-fire">🔥</text><text class="today-hot-title">每日热榜</text></view>
        <view class="today-hot-more">点击查看</view>
      </view>
      <swiper class="today-hot-swiper" vertical autoplay circular interval="5000" duration="420">
        <swiper-item wx:for="{{hotRankGroups}}" wx:key="index">
          <view class="today-hot-row" wx:for="{{item}}" wx:for-item="hotItem" wx:key="id">
            <text class="today-hot-rank">{{hotItem.rank}}.</text>
            <text class="today-hot-text">{{hotItem.hotText}}</text>
          </view>
        </swiper-item>
      </swiper>
    </view>
    <view class="today-hot-card card today-hot-loading" wx:elif="{{dailyHotVisible && hotLoading}}">热榜更新中...</view>

    <view class="comments-section">
      <view class="comments-header"><view class="comments-tag spring-btn" hover-class="comments-tag-hover press-spring" hover-stay-time="80"><text class="comments-tag-text">评论区</text><text class="comments-tag-count" wx:if="{{commentTotal > 0}}">{{commentTotal}}</text></view><view class="comment-sort"><view class="sort-option {{commentSort === 'time' ? 'active' : ''}} spring-btn" hover-class="sort-hover press-spring" hover-stay-time="80" data-sort="time" catchtap="onCommentSort">时间</view><view class="sort-option {{commentSort === 'hot' ? 'active' : ''}} spring-btn" hover-class="sort-hover press-spring" hover-stay-time="80" data-sort="hot" catchtap="onCommentSort">赞数↓</view></view></view>
      <view class="comment-list">
        <view class="comment-item anim-stagger" id="comment-{{item.id}}" style="--i: {{index < 6 ? index : 0}};" wx:for="{{comments}}" wx:key="id">
          <image class="comment-avatar" src="{{item.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" data-userid="{{item.userId}}" data-anonymous="{{item.isAnonymous}}" data-nick="{{item.nickName}}" data-avatar="{{item.avatarUrl}}" data-isowner="{{item.isAuthor}}" data-allowpm="{{item.allowAnonymousPm}}" catchtap="onCommentAvatarTap"></image>
          <view class="comment-content-wrap comment-reply-trigger" catchtap="onReplyComment" data-id="{{item.id}}" data-nick="{{item.nickName}}">
            <view class="comment-head">
              <view class="comment-meta"><text class="comment-nick">{{item.nickName}}</text><view class="author-comment-label" wx:if="{{item.isAuthor}}">作者</view><text class="comment-time">{{item.timeText}}</text></view>
              <view class="comment-more" catchtap="onCommentMore" data-id="{{item.id}}" data-userid="{{item.userId}}" data-nick="{{item.nickName}}"><image class="comment-more-icon" src="/assets/icons/more.png" mode="aspectFit"></image></view>
            </view>
            <view class="comment-body"><view class="comment-text-wrap"><text class="comment-reply-to" wx:if="{{item.replyToNick}}">回复 {{item.replyToNick}}：</text><text class="comment-text" user-select>{{item.content}}</text></view><view class="comment-like {{item.isLiked ? 'active-like' : ''}} spring-btn" hover-class="like-hover press-spring" hover-stay-time="80" catchtap="onLikeComment" data-id="{{item.id}}"><view class="pa-icon pa-heart {{item.isLiked ? 'on' : ''}}"></view><text class="like-count" wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text></view></view>
            <view class="comment-image-list" wx:if="{{item.images.length || item.videos.length}}"><image class="comment-image" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" lazy-load data-urls="{{item.images}}" data-url="{{img}}" catchtap="onPreviewCommentImage" bindlongpress="onImageQrScan"></image><video wx:for="{{item.videos}}" wx:for-item="vid" wx:key="*this" class="comment-video" src="{{vid}}" object-fit="contain" controls catchtap="onCommentVideoTap"></video></view>
            <view class="comment-actions" wx:if="{{item.userId === currentUserId}}"><text catchtap="onEditComment" data-id="{{item.id}}" data-content="{{item.content}}">编辑</text><text class="delete" catchtap="onDeleteComment" data-id="{{item.id}}">删除</text></view>
            <view class="reply-list" wx:if="{{item.replies.length}}">
              <view class="reply-item" id="reply-{{reply.id}}" wx:for="{{item.expanded ? item.replies : item.recentReplies}}" wx:for-item="reply" wx:key="id" catchtap="onReplyComment" data-id="{{reply.id}}" data-nick="{{reply.nickName}}">
                <image class="reply-avatar" src="{{reply.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" lazy-load data-userid="{{reply.userId}}" data-anonymous="{{reply.isAnonymous}}" data-nick="{{reply.nickName}}" data-avatar="{{reply.avatarUrl}}" data-isowner="{{reply.isAuthor}}" data-allowpm="{{reply.allowAnonymousPm}}" catchtap="onCommentAvatarTap"></image>
                <view class="reply-content">
                  <view class="comment-head">
                    <view class="comment-meta"><text class="comment-nick">{{reply.nickName}}</text><view class="author-comment-label" wx:if="{{reply.isAuthor}}">作者</view><text class="comment-time">{{reply.timeText}}</text></view>
                    <view class="comment-more" catchtap="onCommentMore" data-id="{{reply.id}}" data-userid="{{reply.userId}}" data-nick="{{reply.nickName}}"><image class="comment-more-icon" src="/assets/icons/more.png" mode="aspectFit"></image></view>
                  </view>
                  <view class="comment-body"><view class="comment-text-wrap"><text class="comment-reply-to" wx:if="{{reply.replyToNick}}">回复 {{reply.replyToNick}}：</text><text class="comment-text" user-select>{{reply.content}}</text></view><view class="comment-like {{reply.isLiked ? 'active-like' : ''}} spring-btn" hover-class="like-hover press-spring" hover-stay-time="80" catchtap="onLikeComment" data-id="{{reply.id}}"><view class="pa-icon pa-heart {{reply.isLiked ? 'on' : ''}}"></view><text class="like-count" wx:if="{{reply.likeCount > 0}}">{{reply.likeCount}}</text></view></view>
                  <view class="comment-image-list" wx:if="{{reply.images.length || reply.videos.length}}"><image class="comment-image" wx:for="{{reply.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill" lazy-load data-urls="{{reply.images}}" data-url="{{image}}" catchtap="onPreviewCommentImage" bindlongpress="onImageQrScan"></image><video wx:for="{{reply.videos}}" wx:for-item="vid" wx:key="*this" class="comment-video" src="{{vid}}" object-fit="contain" controls catchtap="onCommentVideoTap"></video></view>
                  <view class="comment-actions" wx:if="{{reply.userId === currentUserId}}"><text catchtap="onEditComment" data-id="{{reply.id}}" data-content="{{reply.content}}">编辑</text><text class="delete" catchtap="onDeleteComment" data-id="{{reply.id}}">删除</text></view>
                </view>
              </view>
              <view class="reply-toggle" wx:if="{{item.hasHiddenReplies}}" catchtap="toggleCommentReplies" data-id="{{item.id}}"><text class="reply-toggle-line"></text><text>{{item.expanded ? '收起回复' : '展开 ' + item.hiddenReplyCount + ' 条回复'}}</text></view>
            </view>
          </view>
        </view>
        <view class="empty-comments" wx:if="{{commentTotal === 0}}">还没有评论，来说两句吧</view>
        <view class="load-more" wx:if="{{commentTotal > 0 && comments.length}}">
          <text wx:if="{{commentsLoadingMore}}">加载中…</text>
          <text wx:elif="{{commentHasMore}}">上滑加载更多</text>
          <text wx:else>没有更多评论了</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="note-editor-mask" wx:if="{{showNoteEditor}}" catchtap="closeNoteEditor"></view>
  <view class="note-editor" wx:if="{{showNoteEditor}}" catchtap="noop" style="bottom: {{noteKeyboardHeight ? noteKeyboardHeight : 16}}px;">
    <view class="note-editor-header">
      <view class="note-editor-title">添加备注</view>
      <text class="note-editor-count">{{noteLength}}/255</text>
    </view>
    <textarea class="note-editor-input" placeholder="请输入备注内容" maxlength="255" value="{{noteDraft}}" focus="{{noteInputFocus}}" cursor-spacing="20" adjust-position="{{false}}" bindinput="onNoteInput" bindkeyboardheightchange="onNoteKeyboardChange" />
    <view class="note-editor-actions">
      <button hover-class="press-spring" class="note-editor-btn cancel spring-btn" catchtap="closeNoteEditor" hover-stay-time="120">取消</button>
      <button hover-class="press-spring" class="note-editor-btn confirm {{savingNote || !noteDraft ? 'is-disabled' : ''}} spring-btn" loading="{{savingNote}}" disabled="{{savingNote || !noteDraft}}" catchtap="saveNote" hover-stay-time="120">保存备注</button>
    </view>
  </view>

  <view class="bottom-bar" style="bottom: {{keyboardHeight}}px;">
    <view class="comment-preview-images" wx:if="{{commentMedia.length}}"><view class="comment-preview-item" wx:for="{{commentMedia}}" wx:key="path"><image wx:if="{{item.type === 'image'}}" class="comment-preview-img" src="{{item.path}}" mode="aspectFill"></image><video wx:else class="comment-preview-video" src="{{item.path}}" object-fit="cover"></video><view class="comment-preview-remove" data-index="{{index}}" catchtap="onRemoveCommentMedia">×</view></view></view>
    <view class="comment-toolbar"><view class="comment-anonymous-btn {{commentAnonymous ? 'active' : ''}}" catchtap="toggleCommentAnonymous"><text class="anonymous-dot"></text>分身</view><input class="comment-input" focus="{{commentFocus}}" cursor-spacing="18" adjust-position="{{false}}" placeholder="{{replyTo ? '回复 ' + replyToNick + '...' : '写评论...'}}" value="{{commentText}}" bindinput="onCommentInput" bindfocus="onInputFocus" bindblur="onInputBlur"></input><view class="send-btn {{(commentText || commentMedia.length) && !submittingComment ? 'active' : ''}} {{submittingComment ? 'sending' : ''}}" bindtap="onSendComment">{{submittingComment ? '···' : '发送'}}</view><view class="tool-btn" catchtap="toggleEmojiPanel">☺</view><view class="tool-btn" catchtap="onChooseCommentMedia">＋</view></view>
    <view class="emoji-panel" wx:if="{{showEmojiPanel}}"><view class="emoji-item" wx:for="{{emojis}}" wx:key="*this" data-emoji="{{item}}" catchtap="onEmojiTap">{{item}}</view></view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal"></view>
  <view class="edit-modal" wx:if="{{showEditModal}}"><view class="modal-header"><text class="modal-title">编辑评论</text><text class="modal-close" bindtap="onCloseEditModal">×</text></view><textarea class="modal-textarea" value="{{editContent}}" bindinput="onEditContentInput" maxlength="200"></textarea><view class="modal-actions"><button hover-class="press-spring" class="modal-btn cancel spring-btn" bindtap="onCloseEditModal" hover-stay-time="120">取消</button><button hover-class="press-spring" class="modal-btn confirm spring-btn" bindtap="onConfirmEdit" hover-stay-time="120">确定</button></view></view>

  <!-- 点击头像弹出的功能菜单：匿名（分身）用户仅展示「私信」；普通用户展示「个人主页」+「分身私信/私信」 -->
  <view class="anon-sheet-mask" wx:if="{{avatarSheet}}" catchtap="onCloseAvatarSheet"></view>
  <view class="anon-sheet" wx:if="{{avatarSheet}}" catchtap="noop">
    <view class="anon-sheet-close" catchtap="onCloseAvatarSheet">×</view>
    <view class="anon-sheet-user">
      <image class="anon-sheet-avatar" src="{{avatarSheet.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      <text class="anon-sheet-nick">{{avatarSheet.nick}}</text>
      <view class="anon-sheet-owner" wx:if="{{avatarSheet.isOwner}}">
        <text class="anon-sheet-owner-text">帖主</text>
        <text class="anon-sheet-owner-op">OP</text>
      </view>
      <view class="author-sheet-badge" wx:if="{{avatarSheet.certLabel}}"><text class="author-sheet-badge-text">{{avatarSheet.certLabel}}</text></view>
    </view>
    <block wx:if="{{avatarSheet.mode === 'anon'}}">
      <button hover-class="press-spring" class="anon-sheet-msg-btn spring-btn" catchtap="onAvatarSheetMessage" hover-stay-time="120">私信</button>
    </block>
    <block wx:else>
      <view class="author-sheet-actions">
        <button hover-class="press-spring" class="author-sheet-btn ghost spring-btn" catchtap="onAvatarSheetProfile" hover-stay-time="120">个人主页</button>
        <button hover-class="press-spring" class="author-sheet-btn primary spring-btn" catchtap="onAvatarSheetMessage" hover-stay-time="120">{{avatarSheet.actionLabel}}</button>
      </view>
    </block>
    <text class="anon-sheet-tip">{{avatarSheet.tip}}</text>
  </view>

  <share-popup
    visible="{{showSharePopup}}"
    postId="{{post.id}}"
    postTitle="{{post.title}}"
    postContent="{{post.content}}"
    bind:close="onCloseSharePopup"
    bind:shareToFriend="onShareToFriend"
    bind:sharePoster="onSharePoster"
  />
</view>
