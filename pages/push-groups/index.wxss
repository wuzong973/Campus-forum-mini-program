.page {
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.group-card {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 34rpx 30rpx;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  transition: transform 0.2s ease;
}

.card-pressed { transform: scale(0.96); }

.card-icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.7);
}

/* 「微信」关键字渲染成 iconfont 微信绿标（公众号/墙墙微信两卡） */
.card-icon-wechat { color: #28c445; font-size: 58rpx; }

/* 上传的图片图标：铺满图标槽位，圆角与卡片一致 */
.card-icon-img { width: 100%; height: 100%; border-radius: 20rpx; }

.card-body { flex: 1; min-width: 0; }

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.card-desc {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.5;
  opacity: 0.85;
}

/* 五套配色（与后台「信息推送群」编辑里的色系一一对应） */
.theme-orange { background: #fff6e5; border-color: #f5c87e; }
.theme-orange .card-title { color: #b25b00; }
.theme-orange .card-desc { color: #a36418; }

.theme-green { background: #edf7e9; border-color: #b5dba8; }
.theme-green .card-title { color: #3a7d2c; }
.theme-green .card-desc { color: #5a8f4c; }

.theme-blue { background: #eaf3ff; border-color: #a9c8f5; }
.theme-blue .card-title { color: #2e5fa3; }
.theme-blue .card-desc { color: #4d76ad; }

.theme-purple { background: #f3eefb; border-color: #c9b8ec; }
.theme-purple .card-title { color: #6b3fa0; }
.theme-purple .card-desc { color: #8261ae; }

.theme-teal { background: #e8f7f6; border-color: #a3d9d4; }
.theme-teal .card-title { color: #1f7a6e; }
.theme-teal .card-desc { color: #439085; }

.tip {
  text-align: center;
  color: #8b93a3;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* ===================== 二维码弹窗（口径对齐 components/contact-admin 的 QR 弹层） ===================== */
.qr-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 25, 42, 0.52);
}

.qr-dialog {
  position: fixed;
  z-index: 2001;
  top: 50%;
  left: 50%;
  box-sizing: border-box;
  width: calc(100vw - 72rpx);
  max-width: 680rpx;
  padding: 30rpx 30rpx 34rpx;
  transform: translate(-50%, -50%);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 18rpx 60rpx rgba(16, 33, 58, 0.2);
}

.qr-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.qr-head-text { flex: 1; min-width: 0; }

.qr-title {
  display: block;
  color: #18263d;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.qr-desc {
  display: block;
  margin-top: 8rpx;
  color: #8b97a8;
  font-size: 23rpx;
}

.qr-close {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  margin-left: 16rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: #f3f5f8;
  color: #667386;
  text-align: center;
  font-size: 44rpx;
  font-weight: 300;
}

.qr-close:active { opacity: 0.65; }

.qr-img {
  display: block;
  width: 100%;
  max-width: 560rpx;
  height: auto;
  margin: 24rpx auto 0;
}

.qr-empty {
  margin-top: 24rpx;
  padding: 60rpx 0;
  border-radius: 20rpx;
  background: #f7f9fc;
  color: #8b93a3;
  font-size: 26rpx;
  text-align: center;
}

.qr-btn {
  /* 覆盖微信 button 默认样式（width: 184px / margin: auto），保证与弹窗同宽 */
  width: 100% !important;
  height: 88rpx;
  margin: 26rpx 0 0 !important;
  padding: 0;
  border-radius: 44rpx;
  background: #25b978;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.qr-btn::after { border: none; }
.qr-btn:active { opacity: 0.85; }

.qr-tip {
  margin-top: 18rpx;
  color: #8995a5;
  font-size: 23rpx;
  text-align: center;
}

/* 放大态：对齐微信原生图片查看器的观感 —— 深色满屏、只留二维码大图、零 UI。
   放大必须留在页面内（wx.previewImage 里长按菜单由微信决定，注入不进去）。

   ⚠ 底部必须多撑出 tabbar 的高度：position:fixed 的包含块是「页面视口」，
   它**不含自定义 tabbar**（tabbar 在页面流底部，高度 104rpx + 安全区，
   见 custom-tab-bar/index.wxss）——只写 height:100vh 会在底部漏出 tabbar
   和页面内容（用户实测到的就是这个现象）。这里用负 bottom 把面板多撑一段，
   再靠 z-index 2001 盖住 tabbar；tabbar 高度若变，-104rpx 要同步。
   ⚠ 内容区再用 padding 把多撑的那段抵消掉，保证图片是在「屏幕可视区」里居中，
   而不是在「含 tabbar 的整块」里居中（否则图片整体偏下）。 */
.qr-dialog.is-expanded {
  top: 0;
  left: 0;
  width: 100vw;
  max-width: none;
  /* 高度分两行写（标准 CSS 回退）：第一行按视口铺满兜底，第二行再往下多撑出
     自定义 tabbar 的高度（fixed 的包含块是「页面视口」，不含 tabbar）。
     ⚠ 三不要：① 不要只写 height:100vh（底部会漏出 tabbar 与页面内容）；
     ② 不要用 `width: auto` 靠 left/right 拉伸（实测会收缩成一条窄带）；
     ③ 不要用 `height: auto`（图片是 height:0 + flex:1，撑不起 auto 高度，会塌成只剩 padding）。 */
  height: 100vh;
  height: calc(100vh + 104rpx + env(safe-area-inset-bottom));
  padding: calc(24rpx + env(safe-area-inset-top)) 0 calc(104rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: #000;
  box-shadow: none;
  transform: none;
  display: flex;
  flex-direction: column;
}

/* 放大态的遮罩兜底也压成深色：面板已铺满，遮罩只在面板边缘漏光时可见 */
.qr-mask.is-zoom {
  background: #000;
}

.qr-img.is-full {
  flex: 1 1 auto;
  width: 100%;
  /* ⚠ 必须显式覆盖基类的 max-width: 560rpx —— 否则放大态图片宽度被卡在 ~400px，
     看起来「没居中」（2026-10-08 实测：538px 屏宽下卡片只占 413px、偏左 63px） */
  max-width: none;
  /* height:0 + flex-grow 才能稳定吃满剩余空间；mode=aspectFit 在盒子里等比居中 */
  height: 0;
  min-height: 0;
  /* ⚠ 必须留 auto，不能写成 margin: 0：基类是 margin: 24rpx auto 0，
     那个 auto 就是水平居中，写成 0 会让图片靠左贴边 */
  margin: 0 auto;
}
