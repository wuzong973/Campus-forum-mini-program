.page{min-height:100vh;background:#f5f6f8;padding:0 16rpx 130rpx;box-sizing:border-box;color:#33445a}.topbar{position:fixed;z-index:5;top:0;left:0;right:0;background:#dceaff}.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}.back{font-size:64rpx;width:72rpx}.nav-title{font-size:34rpx;font-weight:600}.more{font-size:42rpx;letter-spacing:4rpx;width:72rpx;text-align:center}.nav-space{width:100%}.progress{display:block;font-size:30rpx;margin:14rpx 12rpx;color:#334b68}.card{background:#fff;border-radius:18rpx;padding:24rpx;margin-bottom:18rpx}.order-head,.row,.bottom{display:flex;align-items:center;justify-content:space-between}.user{display:flex;align-items:center;gap:12rpx;font-size:27rpx;color:#718096}.avatar{width:58rpx;height:58rpx;border-radius:50%;background:#eee;display:flex;align-items:center;justify-content:center}.reward{font-size:25rpx;font-weight:600}.reward text,.bottom em{color:#fa5c61;font-style:normal;font-size:34rpx}.title{margin:20rpx 0;padding:14rpx;border-radius:10rpx;background:#f7f7f7;font-size:28rpx;color:#2f3e52}.row{padding:9rpx 0;font-size:27rpx}.row text:first-child{color:#8390a0}.contact{height:74rpx;line-height:74rpx;border:2rpx solid #b9d7ff;border-radius:14rpx;background:#fff;color:#4d96fa;font-size:29rpx;margin-top:14rpx}.contact::after{border:0}.section-title{display:block;font-size:30rpx;font-weight:600;margin-bottom:12rpx}.guide{background:#edf4ff;color:#7d8a9d}.guide-row{display:flex;justify-content:space-around;margin-top:28rpx;color:#4a85d8;font-size:42rpx}.guide-row text{display:flex;flex-direction:column;align-items:center}.guide-row small{font-size:22rpx;color:#7d8a9d;margin-top:8rpx}.bottom{position:fixed;z-index:8;left:0;right:0;bottom:0;padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;gap:14rpx;font-size:26rpx}.bottom em{font-size:34rpx}.bottom button{margin:0;height:74rpx;line-height:74rpx;border-radius:40rpx;font-size:28rpx;padding:0 30rpx}.bottom button::after{border:0}.cancel{background:#f6f7f8;color:#8c97a7}.finish{background:#347ff2;color:#fff}
