.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: var(--bg);
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.header-row,
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-row { margin-bottom: 18rpx; }

.status {
  color: var(--primary);
  font-size: 26rpx;
}

.reward {
  color: var(--price);
  font-size: 40rpx;
  font-weight: 700;
}

.title {
  display: block;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.created,
.remark-locked {
  display: block;
  margin-top: 16rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.section-title {
  margin-bottom: 20rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.detail-row {
  gap: 24rpx;
  padding: 16rpx 0;
  color: var(--text-primary);
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--divider);
}

.detail-row:last-child { border-bottom: 0; }

.detail-label {
  flex: 0 0 150rpx;
  color: var(--text-secondary);
}

.detail-value {
  flex: 1;
  text-align: right;
  overflow-wrap: anywhere;
}

.remark {
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.remark-locked {
  padding: 28rpx;
  margin: 0 0 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
}

.accept-btn {
  color: #fff;
  background: var(--primary);
}

.review-btn { margin-top: 20rpx; color: #fff; background: var(--primary); }
.review-mask { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .45); }
.review-panel { width: 100%; box-sizing: border-box; padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); background: var(--card-bg); border-radius: 16rpx 16rpx 0 0; }
.rating-row { display: flex; gap: 16rpx; margin: 12rpx 0 24rpx; }
.star { color: var(--text-tertiary); font-size: 52rpx; line-height: 1; }
.star.selected { color: #f5a623; }
.review-input { width: 100%; min-height: 150rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid var(--divider); border-radius: 8rpx; color: var(--text-primary); }
.review-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 24rpx; }
.cancel-review, .confirm-review { width: auto; margin: 0; padding: 0 32rpx; font-size: 28rpx; }
.confirm-review { color: #fff; background: var(--primary); }

.loading {
  padding-top: 160rpx;
  text-align: center;
  color: var(--text-tertiary);
}
