.page{min-height:100vh;background:#f5f6f8;padding:0 16rpx 180rpx;box-sizing:border-box;color:#33445a}
.topbar{position:fixed;z-index:5;top:0;left:0;right:0;background:#fff}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}

.topbar-right{width:132rpx}
.nav-title{font-size:34rpx;font-weight:600;color:#1f2b3a}
.nav-space{width:100%}
.loading-tip{display:block;text-align:center;color:#8c97a7;font-size:26rpx;padding:80rpx 0}
.progress{display:block;font-size:30rpx;margin:14rpx 12rpx;color:#334b68}
.card{background:#fff;border-radius:18rpx;padding:24rpx;margin:0 8rpx 18rpx;box-shadow:0 3rpx 14rpx rgba(25,45,75,.05)}
.section-title{display:block;font-size:30rpx;font-weight:600;margin-bottom:12rpx;color:#22303f}
.order-head{display:flex;align-items:center;justify-content:space-between}
.user{display:flex;align-items:center;gap:12rpx;font-size:27rpx;color:#718096}
.avatar{width:58rpx;height:58rpx;border-radius:50%;background:#eef2f7;display:flex;align-items:center;justify-content:center;font-size:36rpx}
.user-name{color:#3a4a5f}
.reward{font-size:25rpx;font-weight:600;color:#718096}
.reward-num{color:#fa5c61;font-style:normal;font-size:34rpx}
.desc-box{margin:18rpx 0;padding:16rpx;border-radius:10rpx;background:#f7f8fa;font-size:28rpx;color:#2f3e52}
.row{display:flex;align-items:center;justify-content:space-between;padding:9rpx 0;font-size:27rpx}
.row-label{color:#8390a0;flex-shrink:0}
.row-value{color:#33445a;text-align:right}
.row-value-wrap{display:flex;align-items:center;gap:12rpx;min-width:0}
.link{color:#4d96fa}
.arrow{color:#b6c0cd;font-size:30rpx}
.copy-btn{flex-shrink:0;padding:2rpx 14rpx;border:1rpx solid #e3e8ef;border-radius:8rpx;color:#8390a0;font-size:23rpx}
.contact{height:74rpx;line-height:74rpx;border:2rpx solid #b9d7ff;border-radius:14rpx;background:#fff;color:#4d96fa;font-size:29rpx;margin-top:14rpx;display:flex;align-items:center;justify-content:center;gap:8rpx}
.contact::after{border:0}
.contact-icon{font-size:30rpx}
.finish-desc{font-size:27rpx;color:#4a5a6e;background:#f7f8fa;border-radius:10rpx;padding:16rpx}
.finish-images{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}
.finish-images image,.request-images image{width:150rpx;height:150rpx;border-radius:10rpx;background:#f0f2f5}
.request-card{background:#fff;border:1rpx solid #ffe3b8}
.request-head{display:flex;align-items:center;justify-content:space-between}
.request-tag{font-size:22rpx;color:#e69329;background:#fff5e2;border-radius:8rpx;padding:4rpx 14rpx}
.request-reason{display:block;font-size:27rpx;color:#4a5a6e;margin:12rpx 0}
.request-images{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:6rpx}
.request-actions{display:flex;gap:18rpx;margin-top:18rpx}
.request-actions button{flex:1;height:72rpx;line-height:72rpx;border-radius:40rpx;font-size:28rpx;margin:0}
.request-actions button::after{border:0}
.btn-reject{background:#f4f6f8;color:#7c8797}
.btn-approve{background:#347ff2;color:#fff}
.request-tip{display:block;font-size:24rpx;color:#a08a5c;margin-top:10rpx}
.guide{background:#edf4ff}
.guide-title{font-size:26rpx;color:#5d7ba3}
.guide-row{display:flex;align-items:flex-start;justify-content:space-between;margin-top:24rpx;padding:0 8rpx}
.guide-step{display:flex;flex-direction:column;align-items:center;gap:8rpx}
.guide-icon{width:64rpx;height:64rpx;border-radius:50%;background:#dce9fb;color:#4a85d8;font-size:34rpx;display:flex;align-items:center;justify-content:center}
.guide-label{font-size:22rpx;color:#7d8a9d}
.guide-step.active .guide-icon{background:#347ff2;color:#fff}
.guide-step.active .guide-label{color:#347ff2;font-weight:600}
.guide-arrow{color:#9dbbe2;font-size:30rpx;line-height:64rpx}
.float-nav{position:fixed;right:16rpx;bottom:220rpx;z-index:7;display:flex;flex-direction:column;gap:6rpx;background:rgba(35,48,70,.88);border-radius:40rpx;padding:10rpx 8rpx}
.float-item{display:flex;flex-direction:column;align-items:center;gap:2rpx;width:88rpx;padding:8rpx 0;color:#fff}
.float-icon{font-size:32rpx;line-height:1.1}
.float-label{font-size:20rpx;color:#cfd8e6}
.bottom-bar{position:fixed;z-index:8;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;gap:14rpx;padding:16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;font-size:26rpx}
.income{color:#4a5a6e;flex-shrink:0}
.income .income-num{color:#fa5c61;font-style:normal;font-size:34rpx;font-weight:600}
.bottom-bar button{margin:0;height:74rpx;line-height:74rpx;border-radius:40rpx;font-size:28rpx;padding:0 34rpx}
.bottom-bar button::after{border:0}
.btn-cancel{background:#f6f7f8;color:#8c97a7}
.btn-finish{background:#347ff2;color:#fff}
.pending-note{justify-content:center}
.pending-note text{color:#a08a5c;font-size:25rpx}
.mask{position:fixed;inset:0;z-index:20;background:rgba(15,25,40,.55);display:flex;align-items:center;justify-content:center}
.logs-popup,.review-popup{width:600rpx;max-height:70vh;background:#fff;border-radius:20rpx;padding:32rpx 28rpx;display:flex;flex-direction:column}
.logs-title{font-size:32rpx;font-weight:600;text-align:center;color:#22303f}
.logs-list{max-height:56vh;margin-top:24rpx}
.log-item{display:flex;gap:16rpx;padding:12rpx 0}
.log-dot{width:14rpx;height:14rpx;border-radius:50%;background:#347ff2;margin-top:12rpx;flex-shrink:0}
.log-body{display:flex;flex-direction:column;gap:6rpx}
.log-text{font-size:26rpx;color:#33445a}
.log-time{font-size:22rpx;color:#9aa6b5}
.logs-empty{text-align:center;color:#9aa6b5;font-size:25rpx;padding:40rpx 0}
.logs-close{margin-top:20rpx;height:76rpx;line-height:76rpx;text-align:center;border-radius:40rpx;background:#f4f6f8;color:#5a6a80;font-size:28rpx}
.stars{display:flex;justify-content:center;gap:14rpx;margin:26rpx 0 8rpx}
.star{font-size:52rpx;color:#dfe4ea}
.star.on{color:#ffb43e}
.review-text{width:100%;height:150rpx;background:#f6f7f9;border-radius:12rpx;padding:16rpx;font-size:26rpx;box-sizing:border-box;margin-top:12rpx}
.review-submit{margin-top:24rpx;height:80rpx;line-height:80rpx;border-radius:40rpx;background:#347ff2;color:#fff;font-size:29rpx}
.review-submit::after{border:0}

/* 联系方式选择弹窗 */
.contact-popup{width:600rpx;background:#fff;border-radius:20rpx;padding:32rpx 28rpx;display:flex;flex-direction:column}
.contact-popup-title{font-size:32rpx;font-weight:600;text-align:center;color:#22303f;margin-bottom:8rpx}
.contact-option{display:flex;align-items:center;gap:20rpx;padding:26rpx 20rpx;margin-top:16rpx;border-radius:16rpx;background:#f7f9fb}
.contact-option-hover{background:#eef4fb}
.contact-option-icon{width:72rpx;height:72rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32rpx;color:#fff;flex-shrink:0}
.contact-option-icon.online{background:#347ff2}
.contact-option-icon.phone{background:#3ba872}
.contact-option-body{display:flex;flex-direction:column;gap:6rpx;flex:1;min-width:0}
.contact-option-name{font-size:28rpx;font-weight:600;color:#22303f}
.contact-option-desc{font-size:22rpx;color:#9aa6b5;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.contact-arrow{font-size:32rpx;color:#c3ccd6}
.contact-cancel{margin-top:24rpx;height:76rpx;line-height:76rpx;text-align:center;border-radius:40rpx;background:#f4f6f8;color:#5a6a80;font-size:28rpx}
