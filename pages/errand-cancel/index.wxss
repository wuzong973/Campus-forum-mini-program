.page{min-height:100vh;background:#f6f7f9;padding:0 16rpx 200rpx;box-sizing:border-box;color:#2f4054}
.topbar{position:fixed;z-index:5;top:0;left:0;right:0;background:#fff}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}
.back{font-size:64rpx;line-height:1;width:72rpx;color:#1f2b3a}
.topbar-right{width:150rpx}
.nav-title{font-size:34rpx;font-weight:600;color:#1f2b3a}
.nav-space{width:100%}
.card{background:#fff;border-radius:18rpx;margin:20rpx 8rpx 0;padding:28rpx 24rpx;box-shadow:0 3rpx 14rpx rgba(25,45,75,.05)}
.section-title{display:block;font-size:30rpx;font-weight:600;color:#22303f}
.required{color:#f05a5a;margin-right:6rpx}
.radio-row{display:flex;gap:42rpx;margin:20rpx 0 28rpx}
.radio-option{display:flex;align-items:center;font-size:28rpx;color:#33445a}
.radio{width:32rpx;height:32rpx;border:4rpx solid #d9dde3;border-radius:50%;margin-right:10rpx;box-sizing:border-box}
.radio.checked{border-color:#347ff2;box-shadow:inset 0 0 0 6rpx #fff;background:#347ff2}
.divider{height:1rpx;background:#eef0f3;margin-bottom:24rpx}
.textarea{width:100%;height:160rpx;margin-top:16rpx;font-size:28rpx;color:#39485b}
.chips{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:14rpx}
.chip{padding:14rpx 22rpx;border:1rpx solid #edf0f4;border-radius:40rpx;color:#8c97a7;font-size:25rpx}
.upload-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx}
.upload-box{width:150rpx;height:150rpx;background:#f6f7f8;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx}
.upload-icon{width:64rpx;height:64rpx;opacity:.5}
.upload-count{color:#9da7b4;font-size:24rpx}
.upload-thumb{position:relative;width:150rpx;height:150rpx;border-radius:12rpx;overflow:hidden}
.upload-thumb image{width:100%;height:100%}
.thumb-delete{position:absolute;top:0;right:0;width:44rpx;height:44rpx;background:rgba(20,30,45,.55);color:#fff;font-size:32rpx;display:flex;align-items:center;justify-content:center;border-bottom-left-radius:12rpx}
.warm-tip{font-size:24rpx;line-height:1.5;color:#7f8da0;padding:20rpx 12rpx 0}
.tip-line{color:#7f8da0}
.tip-link{color:#347ff2}
.bottom-actions{position:fixed;left:16rpx;right:16rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;gap:20rpx}
.bottom-actions button{flex:1;height:88rpx;line-height:88rpx;border-radius:44rpx;font-size:30rpx}
.bottom-actions button::after{border:0}
.secondary{background:#fff;color:#7c8797}
.primary{background:#347ff2;color:#fff}
