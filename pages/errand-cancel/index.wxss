.page{min-height:100vh;background:#f6f7f9;padding:0 16rpx 160rpx;box-sizing:border-box;color:#2f4054}.topbar{position:fixed;z-index:5;top:0;left:0;right:0;background:#fff}.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}.back{font-size:64rpx;line-height:1;width:72rpx}.nav-title{font-size:34rpx;font-weight:600}.more{font-size:42rpx;letter-spacing:4rpx;width:72rpx;text-align:center}.nav-space{width:100%}.card{background:#fff;border-radius:18rpx;margin-bottom:20rpx;padding:28rpx 24rpx;box-shadow:0 3rpx 14rpx rgba(25,45,75,.05)}.section-title{display:block;font-size:30rpx;font-weight:600}.required{color:#f05a5a}.radio-row{display:flex;gap:42rpx;margin:20rpx 0 28rpx}.radio-option{display:flex;align-items:center;font-size:28rpx}.radio{width:32rpx;height:32rpx;border:4rpx solid #d9dde3;border-radius:50%;margin-right:10rpx}.radio.checked{border-color:#347ff2;box-shadow:inset 0 0 0 6rpx #fff;background:#347ff2}.divider{height:1rpx;background:#eef0f3;margin-bottom:24rpx}.textarea{width:100%;height:160rpx;margin-top:16rpx;font-size:28rpx;color:#39485b}.chips{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:14rpx}.chip{padding:14rpx 22rpx;border:1rpx solid #edf0f4;border-radius:40rpx;color:#8c97a7;font-size:25rpx}.upload-card{height:250rpx}.upload-box{position:relative;width:150rpx;height:150rpx;background:#f6f7f8;border-radius:12rpx;margin-top:18rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;flex-wrap:wrap;padding:12rpx}.upload-box image{width:76rpx;height:76rpx;border-radius:8rpx}.upload-count{position:absolute;bottom:8rpx;left:0;right:0;text-align:center;color:#9da7b4;font-size:24rpx}.warm-tip{font-size:24rpx;line-height:1.45;color:#7f8da0;padding:0 4rpx}.warm-tip text{color:#347ff2}.bottom-actions{position:fixed;left:16rpx;right:16rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;gap:20rpx}.bottom-actions button{flex:1;height:88rpx;line-height:88rpx;border-radius:44rpx;font-size:30rpx}.bottom-actions button::after{border:0}.secondary{background:#fff;color:#7c8797}.primary{background:#347ff2;color:#fff}
