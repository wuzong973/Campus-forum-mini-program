<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;"><view class="topbar-inner" style="height: {{navBarHeight}}px;"><view class="back-pill" hover-class="back-pill-hover" hover-stay-time="80" bindtap="goBack"><text class="back-pill-icon">‹</text><text>返回</text></view><text class="nav-title">广轻工论坛</text><view class="topbar-right"></view></view></view>
  <view class="nav-space" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 选择原因方 + 取消理由（图五版式，接单方/发单方通用） -->
  <view class="card">
    <text class="section-title"><text class="required">*</text> 选择原因方</text>
    <view class="radio-row">
      <view class="radio-option" wx:for="{{sides}}" wx:key="*this" data-index="{{index}}" bindtap="selectSide">
        <view class="radio {{sideIndex === index ? 'checked' : ''}}"></view>{{item}}
      </view>
    </view>
    <view class="divider"></view>
    <text class="section-title"><text class="required">*</text> {{role === 'acceptor' ? '取消接单理由' : '取消订单理由'}}</text>
    <textarea class="textarea" placeholder="{{role === 'acceptor' ? '请输入取消接单理由...' : '请输入取消订单理由...'}}" maxlength="200" value="{{reasonText}}" bindinput="onReasonText"/>
    <view class="chips">
      <view class="chip" wx:for="{{presets}}" wx:key="*this" data-text="{{item}}" bindtap="usePreset">{{item}}</view>
    </view>
  </view>

  <!-- 上传图片证明（图五版式） -->
  <view class="card upload-card">
    <text class="section-title">上传图片证明</text>
    <view class="upload-grid">
      <view class="upload-thumb" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-src="{{item}}" data-urls="{{images}}" bindtap="previewImage" bindlongpress="onImageQrScan"/>
        <view class="thumb-delete" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="upload-box" wx:if="{{images.length < 3}}" bindtap="chooseImage">
        <image class="upload-icon" src="/assets/icons/camera.png" mode="aspectFit"/>
        <text class="upload-count">{{images.length}} / 3</text>
      </view>
    </view>
  </view>

  <!-- 温馨提示（图五版式） -->
  <view class="warm-tip" wx:if="{{role === 'acceptor'}}">
    <text class="tip-line">温馨提示：
1、在 30 分钟内取消接单，若为发单人原因，需征求对方同意，才能取消接单；
2、超过 30 分钟取消接单，无论原因，均需征求发单人同意后，才能取消接单；
3、自身原因多次取消接单会降低完成率，完成率过低将被系统冻结接单功能；
4、严禁以任何形式引导用户私下交易。</text><text class="tip-link">举报领奖</text>
  </view>
  <view class="warm-tip" wx:else>
    <text class="tip-line">温馨提示：
1、取消订单后，赏金将按原支付路径退回，订单无法恢复；
2、订单已被接单时取消，请先与接单方沟通说明，避免产生纠纷；
3、频繁取消订单将影响您的发单信用；
4、严禁以任何形式引导用户私下交易。</text><text class="tip-link">举报领奖</text>
  </view>

  <view class="bottom-actions">
    <button class="primary" bindtap="goBack">我再想想</button>
    <button class="secondary" bindtap="submit" disabled="{{submitting}}">确认提交</button>
  </view>
</view>
