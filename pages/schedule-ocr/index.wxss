.page {
  padding: 24rpx;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.tips {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.6;
}

.example {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.example-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.example-img-wrap {
  height: 200rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.example-img-wrap.bad {
  background: #FFF1F0;
  border: 2rpx dashed #FF4D4F;
}

.example-img-wrap.good {
  background: #F6FFED;
  border: 2rpx dashed #52C41A;
}

.example-label {
  font-size: 24rpx;
  color: #969799;
}

.preview {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.preview-img {
  width: 100%;
  border-radius: 12rpx;
}

.upload-btn {
  position: fixed;
  bottom: 48rpx;
  left: 5%;
  width: 90%;
}
