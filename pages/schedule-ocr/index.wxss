.page {
  padding: 24rpx;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.tips {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.tips-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.example {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.example-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.example-img-wrap {
  height: 200rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.example-img-wrap.bad {
  background: #FFF1F0;
  border: 2rpx dashed #FF4D4F;
}

.example-img-wrap.good {
  background: #F6FFED;
  border: 2rpx dashed #52C41A;
}

.example-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.preview {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.preview-img {
  width: 100%;
  border-radius: 18rpx;
}

.quality-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.quality-tip {
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7e6;
  color: #8a5a00;
  font-size: 24rpx;
  line-height: 1.45;
}

.upload-btn {
  margin-bottom: 32rpx;
}

/* ===== 识别结果 ===== */
.result-section {
  margin-top: 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--primary);
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

.result-tip {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.course-edit-item {
  background: var(--card-bg);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.course-edit-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--divider);
}

.course-color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.course-edit-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.course-theme-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(74, 122, 255, 0.1);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}

.course-confidence {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: var(--text-tertiary);
  font-size: 20rpx;
}

.course-remove {
  font-size: 24rpx;
  color: #FF4D4F;
  padding: 8rpx 16rpx;
}

.course-edit-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.edit-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.edit-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  padding: 12rpx 16rpx;
  background: var(--bg);
  border-radius: 8rpx;
}

.result-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  position: fixed;
  bottom: 32rpx;
  left: 24rpx;
  right: 24rpx;
}

.retry-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--card-bg);
  color: var(--text-primary);
  font-size: 30rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--divider);
}

.retry-btn::after {
  border: none;
}

.confirm-btn {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
}
