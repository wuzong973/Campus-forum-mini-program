.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding-bottom: 240rpx;
}

.cover-preview {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(25, 35, 74, 0.08), rgba(25, 35, 74, 0.42));
}

.cover-text {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 24rpx;
}

.profile-form,
.module-card,
.preview-card {
  margin: 24rpx;
  padding: 28rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eef2f8;
}

.avatar-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.avatar-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.form-item {
  padding: 28rpx 0;
  border-top: 1rpx solid #f0f2f6;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.input,
.textarea {
  width: 100%;
  border-radius: 16rpx;
  background: #f7f9fc;
  padding: 24rpx 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.6;
  min-height: 88rpx;
}

.textarea {
  min-height: 220rpx;
  max-height: 320rpx;
  line-height: 1.7;
  padding: 24rpx 24rpx;
}

.module-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.module-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f2f6;
}

.module-item > view:first-child {
  flex: 1;
  min-width: 0;
}

.module-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.module-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

.module-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.sort-btn {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 21rpx;
  line-height: 1.25;
  white-space: nowrap;
}

.preview-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.preview-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(244, 246, 250, 0.94);
  box-shadow: 0 -8rpx 24rpx rgba(35, 45, 80, 0.08);
  z-index: 50;
}

.ghost-btn,
.save-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  border: none;
}

.ghost-btn {
  flex: 1;
  background: #ffffff;
  color: var(--text-primary);
}

.save-btn {
  flex: 1.4;
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(49, 92, 255, 0.22);
}

.ghost-btn::after,
.save-btn::after {
  border: none;
}
