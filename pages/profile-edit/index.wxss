.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 0 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  z-index: 100;
  top: 0;
  left: 0;
  right: 0;
  background: #f5f6f8;
}

.nav-inner {
  position: relative;
  height: 56px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

/* 返回按钮使用全局 .back-pill 样式（app.wxss） */

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #1d3048;
  font-size: 34rpx;
  font-weight: 700;
  pointer-events: none;
}

.nav-space { width: 100%; }

/* ===== 卡片通用：层次阴影 + 入场过渡 ===== */
.card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 8rpx 24rpx rgba(31, 45, 72, 0.06),
    0 2rpx 6rpx rgba(31, 45, 72, 0.04);
  animation: cardIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

.page > .card:nth-child(3) { animation-delay: 0.04s; }
.page > .card:nth-child(4) { animation-delay: 0.09s; }
.page > .card:nth-child(5) { animation-delay: 0.14s; }
.page > .card:nth-child(6) { animation-delay: 0.19s; }
.page > .card:nth-child(7) { animation-delay: 0.24s; }
.page > .card:nth-child(8) { animation-delay: 0.29s; }

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #27364a;
}

/* 分组卡：标题头 + 行列表 */
.section-card { padding: 0 26rpx 10rpx; }

.card-header { padding: 26rpx 0 10rpx; }

/* ===== 用户信息卡（叠加柔和光斑增强层次） ===== */
.user-card {
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  top: -90rpx;
  right: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 32%, rgba(52, 120, 246, 0.10), rgba(52, 120, 246, 0.03) 58%, transparent 72%);
  pointer-events: none;
}

.user-card::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -50rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(52, 120, 246, 0.06), transparent 65%);
  pointer-events: none;
}

.avatar-wrap {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.avatar-hover { transform: scale(0.95); }

.user-avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: #edf1f6;
  box-shadow: 0 6rpx 16rpx rgba(31, 45, 72, 0.10);
  display: block;
}

/* 白色圆形编辑角标（带描边+投影，叠加于头像之上） */
.avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 3rpx solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(31, 45, 72, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.badge-icon { width: 24rpx; height: 24rpx; }

.user-mid {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  transition: background-color 0.2s ease;
}

.row-pressed { background: #f2f4f8; }

.nick-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.nick {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d3048;
}

.pencil {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  opacity: 0.85;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.user-mid.row-pressed .pencil { transform: rotate(-8deg) scale(1.1); }

.lv-badge {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #e9eef7;
  color: #55677f;
  font-size: 24rpx;
  font-weight: 700;
}

/* ===== 个人简介卡 ===== */
.sig-card { padding: 26rpx; }

.sig-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  transition: background-color 0.2s ease;
}

.row-link { color: #8a94a6; font-size: 24rpx; }

.link-arrow {
  color: #8a94a6;
  font-size: 26rpx;
  line-height: 1;
  transition: transform 0.25s ease, color 0.2s ease;
}

.link-pressed { background: #f2f4f8; }
.link-pressed .link-arrow { transform: translateX(6rpx); color: #3478f6; }

.chev {
  color: #c0c6cf;
  font-size: 30rpx;
  line-height: 1;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease;
}

/* ===== 操作行 ===== */
.action-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 8rpx 6rpx;
  border-radius: 14rpx;
  transition: background-color 0.2s ease;
}

.sig-row { margin-top: 8rpx; }

.action-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.row-pressed .action-icon { transform: scale(1.14); }
.row-pressed .chev { transform: translateX(6rpx); color: #3478f6; }

/* 黑名单锁图标压暗，贴近参考图 */
.icon-dark { filter: brightness(0.5) saturate(0.5); }

.action-text {
  flex: 1;
  min-width: 0;
  color: #27364a;
  font-size: 29rpx;
  font-weight: 500;
  white-space: nowrap;
}

.value-text { color: #8a94a6; font-size: 25rpx; }

.phone-masked { color: #8a94a6; font-weight: 600; }

/* 手机绑定整行：view 布局 + 透明按钮遮罩承接 open-type */
.phone-cell {
  position: relative;
  border-radius: 14rpx;
}

.phone-row-ui {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 8rpx 6rpx;
}

.phone-hit {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 14rpx;
  opacity: 0;
}

.phone-hit::after { border: none; }

/* ===== 弹层 ===== */
.sheet-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.5);
  animation: maskFade 0.2s ease both;
}

@keyframes maskFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  position: fixed;
  z-index: 2001;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  animation: sheetUp 0.25s ease both;
}

@keyframes sheetUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d3048;
}

.sheet-count { color: #a6afbb; font-size: 24rpx; }

.sheet-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #27364a;
  box-sizing: border-box;
}

.sheet-input {
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #27364a;
}

.sheet-confirm {
  margin-top: 26rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #347ff2;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.sheet-confirm:active { transform: scale(0.97); }

.sheet-confirm::after { border: none; }

.btn-hover { opacity: 0.85; }

/* ===== 头像选择弹层 ===== */
.avatar-sheet { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.avatar-scroll { height: 560rpx; }

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 6rpx 6rpx 20rpx;
}

.avatar-cell {
  position: relative;
  width: calc((100% - 60rpx) / 4);
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  border: 4rpx solid transparent;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.avatar-cell:active { transform: scale(0.94); }

.avatar-cell.picked {
  border-color: #3478f6;
  transform: scale(1.05);
}

.grid-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #edf1f6;
}

.pick-check {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #3478f6;
  border: 3rpx solid #ffffff;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.current-tag {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  white-space: nowrap;
}

.avatar-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sheet-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #f1f3f6;
  color: #5a6472;
  font-size: 30rpx;
}

.sheet-cancel::after { border: none; }

.avatar-confirm { flex: 1.6; margin-top: 0; }

.avatar-confirm.disabled {
  opacity: 0.45;
  pointer-events: none;
}
