.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 0 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  z-index: 100;
  top: 0;
  left: 0;
  right: 0;
  background: #f5f6f8;
}

.nav-inner {
  position: relative;
  height: 56px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back {
  padding: 10rpx 26rpx;
  background: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(32, 48, 76, 0.12);
  color: #27364a;
  font-size: 28rpx;
  font-weight: 600;
  transition: background-color 0.2s ease, transform 0.2s ease;
}

.nav-back-hover {
  background: #eef1f5;
  transform: scale(0.96);
}

.nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #1d3048;
  font-size: 34rpx;
  font-weight: 700;
  pointer-events: none;
}

.nav-space { width: 100%; }

.card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 3rpx 16rpx rgba(32, 48, 76, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #27364a;
}

/* ===== 用户信息卡 ===== */
.user-card {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #edf1f6;
}

.avatar-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #3478f6;
  border: 3rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-icon { width: 24rpx; height: 24rpx; }

.user-mid {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
}

.row-pressed { background: #f2f4f8; }

.nick-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.nick {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 34rpx;
  font-weight: 700;
  color: #1d3048;
}

.pencil { width: 28rpx; height: 28rpx; flex-shrink: 0; opacity: 0.75; }

.user-sub {
  display: block;
  margin-top: 6rpx;
  color: #a6afbb;
  font-size: 22rpx;
}

.lv-badge {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f3f6;
  color: #8a94a6;
  font-size: 22rpx;
  font-weight: 600;
}

/* ===== 个人简介卡 ===== */
.sig-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  transition: background-color 0.2s ease;
}

.row-link { color: #8a94a6; font-size: 24rpx; }

.chev { color: #c0c6cf; font-size: 30rpx; line-height: 1; }

.sig-body {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
}

.sig-text {
  flex: 1;
  min-width: 0;
  color: #42506b;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-word;
}

.sig-empty { color: #b6bfca; }

/* ===== 操作行卡片 ===== */
.action-card { padding: 8rpx 26rpx; }

.action-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 8rpx 6rpx;
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
}

.action-row + .action-row { border-top: 1rpx solid #f0f2f5; }

.action-icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }

.action-text {
  flex: 1;
  min-width: 0;
  color: #27364a;
  font-size: 29rpx;
  font-weight: 500;
}

.value-text { color: #8a94a6; font-size: 25rpx; }

.value-badge {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f3f6;
  color: #a6afbb;
  font-size: 22rpx;
}

.title-capsule {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid currentColor;
  font-size: 22rpx;
  font-weight: 600;
}

.phone-masked { color: #42506b; font-weight: 600; }

/* 手机绑定整行透明按钮（重置原生button样式） */
.phone-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  min-height: 100rpx;
  padding: 8rpx 6rpx;
  margin: 0;
  background: transparent;
  border-radius: 12rpx;
  font-size: 29rpx;
  line-height: inherit;
  text-align: left;
  transition: background-color 0.2s ease;
}

.phone-row::after { border: none; }

.phone-row .action-text { flex: 1; font-weight: 500; color: #27364a; }

/* ===== 弹层 ===== */
.sheet-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.5);
  animation: maskFade 0.2s ease both;
}

@keyframes maskFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  position: fixed;
  z-index: 2001;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  animation: sheetUp 0.25s ease both;
}

@keyframes sheetUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d3048;
}

.sheet-count { color: #a6afbb; font-size: 24rpx; }

.sheet-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #27364a;
  box-sizing: border-box;
}

.sheet-input {
  height: 84rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  font-size: 28rpx;
  color: #27364a;
}

.sheet-confirm {
  margin-top: 26rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #347ff2;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-confirm::after { border: none; }

.btn-hover { opacity: 0.85; }

/* 选项列表（头衔/兑换） */
.option-list { max-height: 520rpx; overflow-y: auto; }

.option-item {
  padding: 26rpx 16rpx;
  border-radius: 12rpx;
  color: #27364a;
  font-size: 28rpx;
  text-align: center;
  transition: background-color 0.2s ease;
}

.option-item + .option-item { border-top: 1rpx solid #f0f2f5; }

.option-item.active {
  background: #eaf1ff;
  color: #3478f6;
  font-weight: 600;
}

.exchange-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 16rpx;
  border-radius: 12rpx;
}

.exchange-item + .exchange-item { border-top: 1rpx solid #f0f2f5; }

.exchange-name { flex: 1; color: #27364a; font-size: 28rpx; font-weight: 500; }

.exchange-cost { color: #f2b344; font-size: 24rpx; }

.exchange-btn {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #3478f6;
  font-size: 24rpx;
  font-weight: 600;
}

/* 颜色选择 */
.color-list { max-height: 520rpx; overflow-y: auto; }

.color-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 16rpx;
  border-radius: 12rpx;
  transition: background-color 0.2s ease;
}

.color-item + .color-item { border-top: 1rpx solid #f0f2f5; }

.color-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.color-name { flex: 1; color: #27364a; font-size: 28rpx; }

.color-check { color: #3478f6; font-size: 28rpx; font-weight: 700; }

/* ===== 头像选择弹层 ===== */
.avatar-sheet { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.avatar-scroll { height: 560rpx; }

.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 6rpx 6rpx 20rpx;
}

.avatar-cell {
  position: relative;
  width: calc((100% - 60rpx) / 4);
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  border: 4rpx solid transparent;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.avatar-cell.picked {
  border-color: #3478f6;
  transform: scale(1.05);
}

.grid-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #edf1f6;
}

.pick-check {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #3478f6;
  border: 3rpx solid #ffffff;
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.current-tag {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  white-space: nowrap;
}

.avatar-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sheet-cancel {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #f1f3f6;
  color: #5a6472;
  font-size: 30rpx;
}

.sheet-cancel::after { border: none; }

.avatar-confirm { flex: 1.6; margin-top: 0; }

.avatar-confirm.disabled {
  opacity: 0.45;
  pointer-events: none;
}
