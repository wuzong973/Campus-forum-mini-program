<view class="page">
  <!-- 顶部快捷入口（发布需求 / 个人中心） -->
  <view class="quick-card">
    <view class="quick-item" bindtap="goPublish">
      <image class="quick-icon" src="/assets/icons/errand-quick-publish.png" mode="aspectFit"></image>
      <view class="quick-copy">
        <text class="quick-title">发布需求</text>
        <text class="quick-desc">帮买帮取帮送</text>
      </view>
    </view>
    <view class="quick-divider"></view>
    <view class="quick-item" bindtap="goUserCenter">
      <image class="quick-icon" src="/assets/icons/errand-quick-user.png" mode="aspectFit"></image>
      <view class="quick-copy">
        <text class="quick-title">个人中心</text>
        <text class="quick-desc">查看收益</text>
      </view>
    </view>
  </view>

  <!-- 警示横幅 -->
  <view class="warn-banner">
    <text class="warn-chip">！警示</text>
    <text class="warn-text">取消订单后台有记录<text class="warn-u">完成率过低</text>将冻结账户<text class="warn-u">禁止接单</text></text>
  </view>

  <!-- 公告栏 -->
  <view class="notice-bar notice-yellow" wx:if="{{showNoticeA}}">
    <text class="notice-icon">⚠</text>
    <text class="notice-text">跑腿互助订单可随时取消哦，不用担心资金问题，找跑腿上</text>
    <text class="notice-close" data-key="showNoticeA" bindtap="onCloseNotice">✕</text>
  </view>
  <view class="notice-bar notice-red" wx:if="{{showNoticeB}}">
    <text class="notice-icon">⚠</text>
    <text class="notice-text">接单人如引导您私下交易；引导您主动取消订单，欢迎联系</text>
    <text class="notice-close" data-key="showNoticeB" bindtap="onCloseNotice">✕</text>
  </view>

  <!-- 订单标签页 -->
  <view class="list-tabs">
    <view
      class="list-tab {{activeListTab === index ? 'active' : ''}}"
      wx:for="{{listTabs}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onListTab"
    >
      <text class="list-tab-text">{{item}}</text>
      <view class="tab-line"></view>
    </view>
  </view>

  <!-- 区域筛选（仅全部订单标签下显示） -->
  <view class="filter-section" wx:if="{{activeListTab === 0}}">
    <view class="filter-label">区域</view>
    <view class="filter-row">
      <view class="filter-btn {{activeRegion < 0 ? 'active' : ''}}" wx:if="{{isAdmin}}" bindtap="onAllRegionSelect">全部区域</view>
      <view
        class="filter-btn {{activeRegion === index ? 'active' : ''}}"
        wx:for="{{visibleCampusGroups}}"
        wx:key="name"
        data-index="{{index}}"
        bindtap="onRegionSelect"
      >{{item.name}}</view>
    </view>
    <view class="filter-row campus-sub-filter" wx:if="{{subCampuses.length}}">
      <view
        class="filter-btn {{activeSubCampus === item ? 'active' : ''}}"
        wx:for="{{subCampuses}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onSubCampusSelect"
      >{{item}}</view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card" data-order="{{item}}" bindtap="onOpenDetail">
        <view class="card-head">
          <image class="card-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view class="card-user">
            <view class="card-name-row">
              <text class="card-name">{{item.authorName}}</text>
              <text class="campus-tag">{{item.campus}}</text>
            </view>
            <text class="card-time">{{item.publishTime}} 发布</text>
          </view>
          <text class="status-pill {{item.statusClass}}">{{item.status}}</text>
        </view>
        <view class="card-body">
          <text class="card-title">{{item.title}}</text>
          <text class="card-expect">期望完成时间：{{item.expectText}}</text>
        </view>
        <view class="card-foot">
          <view class="amount-wrap">
            <text class="amount-label">订单金额</text>
            <text class="amount-price">¥{{item.price}}</text>
          </view>
          <view class="foot-actions">
            <view class="card-btn" wx:if="{{item.action === 'grab'}}" catchtap="onAccept" data-order="{{item}}">立即抢单</view>
            <view class="card-btn btn-pay" wx:elif="{{item.action === 'pay'}}" catchtap="onPay" data-order="{{item}}">去支付</view>
            <view class="card-btn btn-finish" wx:elif="{{item.action === 'finish'}}" catchtap="onFinish" data-order="{{item}}">立即完成</view>
            <view class="card-btn btn-ghost" wx:elif="{{item.action === 'cancel'}}" catchtap="onCancelOrder" data-order="{{item}}">取消订单</view>
            <view class="card-btn btn-ghost" wx:elif="{{item.action === 'contact'}}" catchtap="onContact" data-order="{{item}}">联系对方</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-title">{{emptyText}}</text>
    <text class="empty-desc">你可以调整筛选条件，或稍后下拉刷新再看看。</text>
    <view class="empty-btn" bindtap="goPublish" wx:if="{{activeListTab !== 1}}">去发布需求</view>
  </view>

  <!-- 底部Tabbar -->
  <view class="sub-tabbar">
    <view class="sub-tab {{activeTab === 0 ? 'active' : ''}}" data-index="0" bindtap="onSubTab">
      <image class="sub-icon" src="{{activeTab === 0 ? '/assets/icons/subtab-home-active.png' : '/assets/icons/subtab-home.png'}}" mode="aspectFit"></image>
      <text>接单大厅</text>
    </view>
    <view class="sub-tab {{activeTab === 1 ? 'active' : ''}}" data-index="1" bindtap="onSubTab">
      <image class="sub-icon" src="{{activeTab === 1 ? '/assets/icons/subtab-publish-active.png' : '/assets/icons/subtab-publish.png'}}" mode="aspectFit"></image>
      <text>发布跑腿</text>
    </view>
    <view class="sub-tab {{activeTab === 2 ? 'active' : ''}}" data-index="2" bindtap="onSubTab">
      <image class="sub-icon" src="{{activeTab === 2 ? '/assets/icons/subtab-order-active.png' : '/assets/icons/subtab-order.png'}}" mode="aspectFit"></image>
      <text>我的订单</text>
    </view>
  </view>
</view>
