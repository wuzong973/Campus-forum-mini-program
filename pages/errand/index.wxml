<view class="page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <image class="nav-home-icon" src="/assets/icons/nav-home.png" mode="aspectFit" bindtap="goBack"></image>
      <text class="nav-title">接单大厅</text>
      <view class="nav-right-placeholder"></view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 订单数量 -->
  <view class="order-count-bar">
    <text class="order-count-label">目前接单大厅总共有待接订单</text>
    <text class="order-count-num">{{orders.length}} 单</text>
  </view>

  <!-- 区域筛选 -->
  <view class="filter-section">
    <view class="filter-label">区域</view>
    <view class="filter-row">
      <view class="filter-btn {{activeRegion < 0 ? 'active' : ''}}" wx:if="{{isAdmin}}" bindtap="onAllRegionSelect">全部区域</view>
      <view
        class="filter-btn {{activeRegion === index ? 'active' : ''}}"
        wx:for="{{visibleCampusGroups}}"
        wx:key="name"
        data-index="{{index}}"
        bindtap="onRegionSelect"
      >{{item.name}}</view>
    </view>
    <view class="filter-row campus-sub-filter" wx:if="{{subCampuses.length}}">
      <view
        class="filter-btn {{activeSubCampus === item ? 'active' : ''}}"
        wx:for="{{subCampuses}}"
        wx:key="*this"
        data-value="{{item}}"
        bindtap="onSubCampusSelect"
      >{{item}}</view>
    </view>
  </view>

  <!-- 类型筛选 -->
  <view class="filter-section">
    <view class="filter-label">类型</view>
    <view class="filter-row">
      <view
        class="filter-btn {{activeType === index ? 'active' : ''}}"
        wx:for="{{types}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTypeSelect"
      >{{item}}</view>
    </view>
  </view>

  <!-- 价格筛选 -->
  <view class="filter-section">
    <view class="filter-label">价格</view>
    <view class="filter-row">
      <view
        class="filter-btn {{activePrice === index ? 'active' : ''}}"
        wx:for="{{prices}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onPriceSelect"
      >{{item}}</view>
    </view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card" data-order="{{item}}" bindtap="onOpenDetail">
        <view class="order-header">
          <view class="order-status">
            <view class="status-dot {{item.statusClass}}"></view>
            <text class="status-text {{item.statusClass}}">{{item.status}}</text>
          </view>
          <text class="order-time">{{item.publishTime}}</text>
        </view>
        <view class="order-title-row">
          <view class="order-title-with-campus">
            <text class="order-title">{{item.title}}</text>
            <text class="order-campus">{{item.campus}}</text>
          </view>
          <text class="order-price">¥{{item.price}}</text>
        </view>
        <view class="order-address-row">
          <text class="address-mark pickup">取</text>
          <text class="address-text">{{item.pickupAddr}}</text>
        </view>
        <view class="order-address-row">
          <text class="address-mark delivery">送</text>
          <text class="address-text">{{item.deliveryAddr}}</text>
        </view>
        <view class="order-tags">
          <view class="tag" wx:if="{{item.itemCount}}">
            <image class="tag-icon" src="/assets/icons/tag-list.png" mode="aspectFit"></image>
            <text>共{{item.itemCount}}件快递，小件{{item.smallCount || 1}}件</text>
          </view>
          <view class="tag" wx:if="{{item.timeLimit}}">
            <image class="tag-icon" src="/assets/icons/tag-clock.png" mode="aspectFit"></image>
            <text>{{item.timeLimit}}</text>
          </view>
          <view class="tag" wx:if="{{item.genderReq}}">
            <image class="tag-icon" src="/assets/icons/tag-person.png" mode="aspectFit"></image>
            <text>{{item.genderReq}}</text>
          </view>
          <view class="tag" wx:for="{{item.extraTags}}" wx:key="*this">
            <image class="tag-icon" src="/assets/icons/tag-list.png" mode="aspectFit"></image>
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orders.length === 0}}">
    <text class="empty-title">当前筛选下暂无可接订单</text>
    <text class="empty-desc">你可以调整筛选条件，或稍后下拉刷新再看看。</text>
    <view class="empty-btn" bindtap="goPublish">去发布需求</view>
  </view>

  <!-- 底部Tabbar -->
  <view class="sub-tabbar">
    <view class="sub-tab {{activeTab === 0 ? 'active' : ''}}" data-index="0" bindtap="onSubTab">
      <image class="sub-icon" src="{{activeTab === 0 ? '/assets/icons/subtab-home-active.png' : '/assets/icons/subtab-home.png'}}" mode="aspectFit"></image>
      <text>接单大厅</text>
    </view>
    <view class="sub-tab {{activeTab === 1 ? 'active' : ''}}" data-index="1" bindtap="onSubTab">
      <image class="sub-icon" src="{{activeTab === 1 ? '/assets/icons/subtab-publish-active.png' : '/assets/icons/subtab-publish.png'}}" mode="aspectFit"></image>
      <text>发布跑腿</text>
    </view>
    <view class="sub-tab {{activeTab === 2 ? 'active' : ''}}" data-index="2" bindtap="onSubTab">
      <image class="sub-icon" src="{{activeTab === 2 ? '/assets/icons/subtab-order-active.png' : '/assets/icons/subtab-order.png'}}" mode="aspectFit"></image>
      <text>我的订单</text>
    </view>
  </view>
</view>
