.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-home-icon {
  width: 40rpx;
  height: 40rpx;
  transition: var(--transition-fast);
}

.nav-home-icon:active {
  transform: scale(0.88);
  opacity: 0.8;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.nav-right-placeholder {
  width: 40rpx;
}

.nav-placeholder {
  width: 100%;
}

/* 订单数量栏 */
.order-count-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--card-bg);
  margin: 20rpx 24rpx;
  border-radius: var(--radius);
}

.order-count-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.order-count-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 筛选区域 */
.filter-section {
  margin: 0 24rpx 20rpx;
}

.filter-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.campus-sub-filter {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

.filter-btn {
  padding: 12rpx 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: var(--transition-fast);
}

.filter-btn:active {
  transform: scale(0.96);
}

.filter-btn.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 500;
}

/* 订单列表 */
.order-list {
  padding: 0 24rpx;
}

/* 订单卡片 */
.order-card {
  margin-bottom: 20rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  transition: var(--transition-fast);
}

.order-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid var(--text-placeholder);
  background: transparent;
}

.status-dot.pending {
  border-color: var(--primary);
}

.status-dot.accepted {
  border-color: var(--primary);
}

.status-dot.done {
  border-color: var(--success);
}

.status-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.status-text.pending {
  color: var(--primary);
}

.status-text.accepted {
  color: var(--primary);
}

.status-text.done {
  color: var(--success);
}

.order-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--price);
}

.order-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.order-title-with-campus {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 10rpx;
  flex: 1;
}

.order-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-campus {
  max-width: 155rpx;
  overflow: hidden;
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

.order-address-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.address-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.address-mark.delivery {
  background: var(--success);
}

.address-text {
  min-width: 0;
  flex: 1;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
  word-break: break-all;
}

.order-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--primary);
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-placeholder);
  flex-shrink: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

.empty-btn:active {
  transform: scale(0.96);
}

/* 底部 Tabbar */
.sub-tabbar {
  position: fixed;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  height: 120rpx;
  background: var(--card-bg);
  display: flex;
  border-top: 1rpx solid var(--border);
  z-index: 50;
}

.sub-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
  transition: var(--transition-fast);
}

.sub-tab:active {
  transform: scale(0.94);
  opacity: 0.85;
}

.sub-tab.active {
  color: var(--primary);
  font-weight: 500;
}

.sub-icon {
  width: 40rpx;
  height: 40rpx;
}
