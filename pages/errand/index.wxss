.page {
  min-height: 100vh;
  /* 与首页 .page 完全一致的渐变背景（180deg，#d7efff → #f4f6fa，叠加淡蓝径向高光） */
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 顶部快捷入口（发布需求 / 个人中心） ===== */
.quick-card {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 28rpx 12rpx;
  background: #ffffff;
  border: 2rpx solid rgba(49, 92, 255, 0.55);
  border-radius: 20rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-width: 0;
}

.quick-item:active { opacity: 0.72; }

.quick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.quick-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2b43;
}

.quick-desc {
  font-size: 22rpx;
  color: #98a2b3;
}

.quick-divider {
  width: 1rpx;
  height: 56rpx;
  background: #eef1f6;
  flex-shrink: 0;
}

/* ===== 警示横幅 ===== */
.warn-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #4a9ef5 0%, #2f7bf6 100%);
}

.warn-chip {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f5484d;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
}

.warn-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.warn-u {
  text-decoration: underline;
}

/* ===== 公告栏（自动轮播） ===== */
.notice-swiper {
  height: 88rpx;
  margin-top: 16rpx;
}

.notice-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.notice-yellow { background: #fff8e6; }
.notice-red { background: #ffece8; }

.notice-icon {
  flex-shrink: 0;
  font-size: 26rpx;
}

.notice-yellow .notice-icon { color: #faad14; }
.notice-red .notice-icon { color: #f5484d; }

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.45;
}

.notice-yellow .notice-text { color: #b25e00; }
.notice-red .notice-text { color: #d83931; }

/* 公告栏内可点击的"管理员"：蓝色加粗下划线，点击弹出管理员微信二维码（与首页公告栏一致） */
.notice-admin {
  color: #0066cc;
  font-weight: 600;
  text-decoration: underline;
}

.notice-admin:active { opacity: 0.6; }

.notice-close {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  color: #c0c6cf;
  font-size: 26rpx;
}

/* ===== 订单标签页 ===== */
.list-tabs {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 6rpx 0 0;
  background: #ffffff;
  border-radius: 16rpx;
}

.list-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 0;
}

.list-tab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333a45;
  line-height: 1.4;
}

.tab-line {
  width: 48rpx;
  height: 6rpx;
  margin-top: 10rpx;
  border-radius: 3rpx;
  background: transparent;
}

.list-tab.active .list-tab-text { color: var(--primary); }
.list-tab.active .tab-line { background: var(--primary); }

/* ===== 区域筛选（保留原有功能，仅全部订单下显示） ===== */
.filter-section {
  margin: 20rpx 24rpx 0;
}

.filter-label {
  font-size: 22rpx;
  color: #8a94a6;
  margin-bottom: 12rpx;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.campus-sub-filter {
  margin-top: 16rpx;
}

.filter-btn {
  padding: 10rpx 28rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5a6472;
  border: 2rpx solid #e7ebf2;
  transition: var(--transition-fast);
}

.filter-btn:active { transform: scale(0.96); }

.filter-btn.active {
  background: #ffffff;
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 500;
}

/* ===== 订单卡片（图一版式） ===== */
.order-list {
  padding: 20rpx 0 0;
}

.order-card {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  transition: var(--transition-fast);
}

.order-card:active {
  transform: scale(0.99);
}

.card-head {
  display: flex;
  align-items: center;
}

.card-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eef2f7;
  flex-shrink: 0;
}

.card-user {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 16rpx;
}

/* 昵称行：昵称 + 校区标签 + 性别限制标签（图四圈注位置） */
.card-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.card-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2b43;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tag {
  flex-shrink: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

/* 校区标签：蓝框白底（图四"南海北校区"样式） */
.tag-campus {
  border: 2rpx solid #4388ff;
  background: #ffffff;
  color: #4388ff;
}

/* 性别限制标签：浅色填充，按限制值区分颜色 */
.tag-gender-male { background: #e8f1ff; color: #3478f6; }
.tag-gender-female { background: #ffeef4; color: #f0479c; }
.tag-gender-any { background: #f1f3f6; color: #8a94a6; }

.card-time {
  font-size: 22rpx;
  color: #a5adbb;
}

/* 描述行：公开描述 + 右侧红色金额（图二版式） */
.card-desc-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.card-desc-row .card-title {
  flex: 1;
  min-width: 0;
}

.card-desc-row .amount-price {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #e64340;
}

/* 右上角状态胶囊（图三样式） */
.status-pill {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid currentColor;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pill.pending { color: #ff9f40; }
.status-pill.accepted { color: var(--primary); }
.status-pill.done { color: var(--success); }
.status-pill.unpaid { color: #e64340; }
.status-pill.cancelled { color: #9aa3b2; }
.status-pill.refunding { color: #faad14; }

/* 卡片内容 */
.card-body {
  margin-top: 20rpx;
}

.card-title {
  display: block;
  font-size: 28rpx;
  color: #2a3547;
  line-height: 1.55;
  word-break: break-all;
}

.card-expect {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #2a3547;
  line-height: 1.5;
}

/* 底部：操作按钮 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 26rpx;
}

.foot-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-btn {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #e9f0ff;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.card-btn:active { opacity: 0.75; }

.card-btn.btn-pay {
  background: #ffece8;
  color: #e64340;
}

.card-btn.btn-finish {
  background: #e7f8ec;
  color: var(--success);
}

.card-btn.btn-ghost {
  background: #f5f6fa;
  color: #5a6472;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a3547;
  text-align: center;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #98a2b3;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 36rpx;
  padding: 18rpx 56rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.empty-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ===== 右侧浮动导航（发布/消息/首页，保持在右下角） ===== */
.float-nav {
  position: fixed;
  right: 16rpx;
  /* 自定义 tabBar 上方，保持页面右下角 */
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  z-index: 7;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: rgba(35, 48, 70, 0.88);
  border-radius: 40rpx;
  padding: 10rpx 8rpx;
}

.float-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  width: 88rpx;
  padding: 8rpx 0;
  color: #fff;
  border-radius: 28rpx;
  transition: opacity 0.2s ease;
}

.float-item-hover {
  opacity: 0.65;
}

.float-icon {
  font-size: 32rpx;
  line-height: 1.1;
}

.float-label {
  font-size: 20rpx;
  color: #cfd8e6;
}

/* ===== 底部 Tabbar（已移除，由全局自定义 tabbar 承担导航） ===== */

