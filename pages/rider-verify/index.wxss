.page { min-height: 100vh; background: #f4f6fa; color: #15213d; }
.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 10; background: #dceaff; box-sizing: border-box; }
.nav-content { display: flex; align-items: center; justify-content: space-between; padding: 0 24rpx; }
.nav-back { width: 56rpx; font-size: 58rpx; line-height: 1; color: #14213d; }
.nav-title { font-size: 30rpx; font-weight: 700; color: #14213d; }
.nav-placeholder { width: 56rpx; }
.scroll { box-sizing: border-box; padding-bottom: 48rpx; }
.hero { padding: 54rpx 42rpx 86rpx; background: #cfe3ff; background-image: linear-gradient(145deg, #cae1ff, #eef6ff); }
.hero-title { display: block; font-size: 68rpx; line-height: 1; font-weight: 800; color: #0e2149; }
.hero-desc { display: block; margin-top: 18rpx; font-size: 25rpx; color: #4f6590; }
.hero-contact { display: inline-block; margin-top: 24rpx; color: #2d7cf6; font-size: 26rpx; }
.status-banner { margin: 18rpx; padding: 28rpx; border-radius: 20rpx; display: flex; align-items: flex-start; gap: 20rpx; box-shadow: 0 8rpx 24rpx rgba(31, 55, 101, 0.06); }
.status-banner.status-pending { background: #fff7e6; }
.status-banner.status-approved { background: #e8f8ef; }
.status-banner.status-rejected { background: #fff0f0; }
.status-icon { font-size: 48rpx; flex-shrink: 0; line-height: 1; }
.status-content { display: flex; flex-direction: column; gap: 8rpx; flex: 1; min-width: 0; }
.status-content .status-title { font-size: 30rpx; font-weight: 700; }
.status-banner.status-pending .status-title { color: #ed831a; }
.status-banner.status-approved .status-title { color: #25a56b; }
.status-banner.status-rejected .status-title { color: #e04040; }
.status-content .status-desc { font-size: 24rpx; color: #68748a; line-height: 1.5; }
.steps { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin: -28rpx 18rpx 20rpx; padding: 20rpx 18rpx; border-radius: 18rpx; background: #337ef0; color: #dfeaff; font-size: 24rpx; }
.steps.light { margin: 24rpx 18rpx 20rpx; background: #fff; color: #68748a; box-shadow: 0 6rpx 18rpx rgba(35, 63, 120, 0.06); }
.step.active { color: #fff; font-weight: 700; }.steps.light .step.active { color: #2478f3; }.step.done { color: #aecbff; }.steps.light .step.done { color: #2478f3; }
.verify-card, .phone-card, .form-card { margin: 18rpx; padding: 6rpx 28rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 8rpx 24rpx rgba(31, 55, 101, 0.06); }
.verify-row { display: flex; align-items: center; min-height: 154rpx; border-bottom: 1rpx solid #edf0f5; }.verify-row:last-child { border-bottom: 0; }
.verify-icon { width: 64rpx; height: 64rpx; line-height: 64rpx; border-radius: 50%; text-align: center; color: #fff; background: #4c9cf7; font-size: 32rpx; font-weight: 700; flex-shrink: 0; }.verify-icon.person { font-size: 24rpx; }
.verify-text { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; margin: 0 18rpx; color: #8490a5; font-size: 23rpx; }.verify-title { color: #17233d; font-size: 30rpx; font-weight: 700; }
.status { padding: 10rpx 20rpx; border-radius: 24rpx; color: #fff; background: #3d82f5; font-size: 23rpx; flex-shrink: 0; }.status.done { background: #e8f8ef; color: #25a56b; }
.phone-card { min-height: 102rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.phone-info { flex: 1; min-width: 0; }.phone-title, .phone-desc { display: block; }.phone-title { color: #1d2840; font-size: 28rpx; font-weight: 700; }.phone-desc { margin-top: 8rpx; color: #8d98aa; font-size: 22rpx; white-space: nowrap; }
.phone-bind-button { flex-shrink: 0; margin: 0; padding: 12rpx 24rpx; border-radius: 26rpx; background: #edf4ff; color: #347ff3; font-size: 24rpx; line-height: 1.3; }
.primary-button { margin: 32rpx 18rpx 0; height: 94rpx; border-radius: 47rpx; background: #327df2; color: #fff; font-size: 30rpx; font-weight: 700; line-height: 94rpx; }.primary-button::after { border: 0; }
.form-card { margin-top: 18rpx; padding: 28rpx; }.form-title { display: block; color: #17233d; font-size: 31rpx; font-weight: 700; }.warning { margin: 20rpx 0; padding: 10rpx 14rpx; border-radius: 10rpx; background: #fff6e9; color: #ed831a; font-size: 23rpx; }
.field { display: flex; align-items: center; min-height: 84rpx; border-bottom: 1rpx solid #eef1f5; font-size: 27rpx; }.field:last-child { border-bottom: 0; }.field text { width: 140rpx; color: #28354e; }.field input { flex: 1; text-align: right; color: #1f2d46; font-size: 26rpx; }
.credential-head { display: flex; gap: 14rpx; }.credential-head > view { flex: 1; }.credential-desc { display: block; margin-top: 12rpx; line-height: 1.5; color: #8995aa; font-size: 23rpx; }.example { color: #2478f3; font-size: 23rpx; white-space: nowrap; }
.credential-upload { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 268rpx; height: 218rpx; margin-top: 24rpx; border: 2rpx dashed #cbd5e5; border-radius: 16rpx; background: #f8fafc; color: #8290a5; font-size: 24rpx; }.camera { margin-bottom: 14rpx; color: #9ba9bb; font-size: 40rpx; }.credential-image { width: 268rpx; height: 218rpx; margin-top: 24rpx; border-radius: 16rpx; }
.agreement-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx; margin: 52rpx 34rpx 0; color: #6f7d92; font-size: 23rpx; }.checkbox { width: 24rpx; height: 24rpx; line-height: 24rpx; border: 2rpx solid #ccd4df; border-radius: 50%; text-align: center; color: #fff; font-size: 18rpx; }.checkbox.checked { border-color: #347ff3; background: #347ff3; }.agreement-link { color: #347ff3; }
.phone-bound-actions { display: flex; align-items: center; flex-shrink: 0; gap: 12rpx; }.change-phone-button { padding: 12rpx 24rpx; border-radius: 26rpx; background: #edf4ff; color: #347ff3; font-size: 24rpx; line-height: 1.3; white-space: nowrap; }
.modal-mask { position: fixed; z-index: 100; inset: 0; background: rgba(0, 0, 0, 0.52); opacity: 0; visibility: hidden; transition: opacity 0.24s ease, visibility 0.24s ease; }.modal-mask.show { opacity: 1; visibility: visible; }
.phone-modal { position: fixed; z-index: 101; left: 50%; top: 50%; width: 600rpx; padding: 36rpx 32rpx 32rpx; border-radius: 24rpx; background: #fff; box-sizing: border-box; transform: translate(-50%, -50%) scale(0.92); opacity: 0; visibility: hidden; transition: all 0.22s ease; }.phone-modal.show { opacity: 1; visibility: visible; transform: translate(-50%, -50%) scale(1); }
.phone-modal-header { display: flex; align-items: center; justify-content: space-between; }.phone-modal-title { color: #1d2840; font-size: 32rpx; font-weight: 700; }.phone-modal-close { padding: 4rpx 8rpx; color: #9aa4b5; font-size: 44rpx; line-height: 1; }
.phone-modal-input { width: 100%; height: 84rpx; margin-top: 30rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #e3e9f2; border-radius: 14rpx; background: #f6f8fc; color: #1f2d46; font-size: 30rpx; }.phone-modal-placeholder { color: #a5aebd; }
.phone-modal-tip { margin-top: 14rpx; color: #98a2b3; font-size: 22rpx; }
.phone-modal-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }.phone-modal-btn { flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 29rpx; line-height: 80rpx; text-align: center; }.phone-modal-btn.cancel { background: #f2f4f8; color: #66718a; }.phone-modal-btn.confirm { background: #327df2; color: #fff; font-weight: 600; }.phone-modal-btn.confirm.disabled { opacity: 0.6; }
