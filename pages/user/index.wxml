<view class="page page-enter">
  <view class="profile-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="profile-content">
      <view class="user-info" bindtap="goLogin">
        <image class="avatar-img" src="{{userInfo.avatarUrl || '/assets/avatar2/1.jpg'}}" mode="aspectFill" lazy-load></image>
        <view class="user-detail">
          <view class="user-name-row">
            <text class="user-name">{{userInfo.nickName || '校园用户'}}</text>
            <image class="gender-icon-img" wx:if="{{isLogin && userInfo.gender === 1}}" src="/assets/icons/gender-male.png" mode="aspectFit"></image>
            <image class="gender-icon-img" wx:if="{{isLogin && userInfo.gender === 2}}" src="/assets/icons/gender-female.png" mode="aspectFit"></image>
          </view>
          <text class="user-school">{{isLogin ? ((userInfo.school || '广轻工职业技术大学') + ' · ' + (userInfo.campus || '未设置校区')) : '点击登录后完善资料'}}</text>
        </view>
      </view>
      <view class="settings-wrap" catchtap="goSettings"><image class="settings-icon" src="/assets/icons/settings.png" mode="aspectFit"></image></view>
    </view>
  </view>

  <view class="shortcuts card">
    <view class="shortcut-item" wx:for="{{shortcuts}}" wx:key="name" wx:if="{{!item.adminOnly || isAdmin}}" data-route="{{item.route}}" data-admin-only="{{item.adminOnly}}" bindtap="onShortcutTap">
      <view class="shortcut-icon-wrap">
        <image class="shortcut-icon-img {{item.iconDark ? 'shortcut-icon-dark' : ''}}" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="shortcut-badge" wx:if="{{item.badge === 'unread' && unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
      <text class="shortcut-name">{{item.name}}</text>
    </view>
  </view>

  <block wx:for="{{sections}}" wx:for-item="section" wx:key="title">
    <view class="feature-section">
      <view class="msg-banner" wx:if="{{section.title === '消息通知' && msgBanner.text}}" style="{{msgBanner.bannerStyle}}" bindtap="goBannerDetail">
        <view class="msg-banner-left">
          <text class="msg-banner-icon">{{msgBanner.icon}}</text>
          <text class="msg-banner-text">{{msgBanner.text}}</text>
        </view>
        <text class="msg-banner-arrow">查看 »</text>
      </view>
      <text class="section-title">{{section.title}}</text>
      <view class="feature-grid columns-{{section.columns}}">
        <block wx:for="{{section.items}}" wx:for-item="feature" wx:key="name">
          <view wx:if="{{feature.type === 'contact'}}" class="feature-item">
            <contact-admin class="feature-contact">
              <view slot="trigger" class="feature-trigger">
                <view class="feature-icon-wrap">
                  <text wx:if="{{feature.fontIcon}}" class="iconfont2 {{feature.fontIcon}} feature-font-icon" style="color: {{feature.fontColor}};"></text>
                  <image wx:else class="feature-icon" src="{{feature.icon}}" mode="aspectFit"></image>
                </view>
                <text class="feature-name">{{feature.name}}</text>
              </view>
            </contact-admin>
          </view>
          <view wx:elif="{{!feature.adminOnly || isAdmin}}" class="feature-item" data-route="{{feature.route}}" data-admin-only="{{feature.adminOnly}}" bindtap="onFeatureTap">
            <view class="feature-icon-wrap">
              <text wx:if="{{feature.fontIcon}}" class="iconfont2 {{feature.fontIcon}} feature-font-icon" style="color: {{feature.fontColor}};"></text>
              <image wx:else class="feature-icon" src="{{feature.icon}}" mode="aspectFit"></image>
              <view class="feature-badge" wx:if="{{feature.badge === 'unread' && unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
            </view>
            <text class="feature-name">{{feature.name}}</text>
          </view>
        </block>
      </view>
      <view class="feature-grid columns-2 stat-grid" wx:if="{{section.stats}}">
        <view class="feature-item" wx:for="{{section.stats}}" wx:for-item="tag" wx:key="name" data-route="{{tag.route}}" bindtap="onFeatureTap">
          <view class="feature-icon-wrap">
            <image class="feature-icon" src="{{tag.icon}}" mode="aspectFit"></image>
          </view>
          <text class="feature-name">{{tag.name}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
