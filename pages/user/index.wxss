.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 94% 4%, rgba(18, 184, 166, 0.18), transparent 280rpx),
    linear-gradient(180deg, #eef4ff 0%, #f4f6fa 390rpx, #f4f6fa 100%);
}

.header {
  padding-bottom: 44rpx;
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 18rpx 44rpx rgba(49, 92, 255, 0.12);
}

.header-cyan {
  background:
    radial-gradient(
      circle at 12% 18%,
      rgba(255, 255, 255, 0.35) 0,
      rgba(255, 255, 255, 0) 180rpx
    ),
    linear-gradient(135deg, #5b8cff 0%, #5ec4d4 48%, #4fd1c5 100%);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 96rpx 28rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  transition: var(--transition-fast);
}

.user-info:active {
  opacity: 0.85;
}

.avatar-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
  box-shadow: 0 12rpx 28rpx rgba(18, 54, 120, 0.16);
}

.user-detail {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 38rpx;
  color: #fff;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.user-school {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

.settings-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: var(--transition-fast);
}

.settings-wrap:active {
  transform: scale(0.9);
  opacity: 0.85;
}

.settings-icon {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) invert(1);
}

.shortcuts {
  margin: 20rpx 24rpx;
  padding: 30rpx 0 26rpx;
  display: flex;
  position: relative;
  z-index: 2;
  border-radius: 26rpx;
  box-shadow: 0 18rpx 42rpx rgba(30, 64, 175, 0.1);
}

.interaction-shortcuts {
  margin-top: 0;
  padding: 26rpx 0;
}

.shortcut-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: var(--transition-fast);
}

.shortcut-item:active {
  transform: translateY(2rpx) scale(0.94);
  opacity: 0.8;
}

.shortcut-icon-img {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 12rpx;
}

.shortcut-icon-wrap {
  position: relative;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 28% 20%, rgba(255,255,255,1), rgba(255,255,255,0) 58rpx),
    linear-gradient(180deg, #f7faff, #eef3ff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 10rpx 22rpx rgba(49, 92, 255, 0.1);
  border: 1rpx solid rgba(222, 231, 255, 0.95);
}

.shortcut-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid #ffffff;
}

.shortcut-badge.data-badge {
  background: #4a7aff;
}

.shortcut-name {
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.menu {
  margin: 0 24rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 32rpx rgba(30, 64, 175, 0.07);
}

.admin-entry {
  margin: 0 24rpx 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(49, 92, 255, 0.16);
  background: #f7f9ff;
}

.admin-entry-title {
  display: block;
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 600;
}

.admin-entry-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.menu-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
  transition: var(--transition-fast);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg);
  opacity: 0.85;
}

.menu-icon-img {
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
}

.menu-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.arrow {
  color: var(--text-placeholder);
  font-size: 28rpx;
}

.customer-service-row {
  position: relative;
}
