.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.profile-header {
  padding-bottom: 44rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: linear-gradient(135deg, #5b8cff 0%, #5ec4d4 50%, #4fd1c5 100%);
  box-shadow: 0 18rpx 40rpx rgba(49, 92, 255, .12);
}

.profile-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 174rpx;
  padding: 46rpx 28rpx 20rpx;
}

.user-info { display: flex; min-width: 0; flex: 1; align-items: center; }
.user-info:active { opacity: .82; }
.avatar-img { width: 120rpx; height: 120rpx; flex-shrink: 0; border: 5rpx solid rgba(255, 255, 255, .74); border-radius: 50%; background: rgba(255,255,255,.22); box-shadow: 0 10rpx 22rpx rgba(22, 55, 120, .16); }
.user-detail { min-width: 0; margin-left: 22rpx; }
.user-name-row { display: flex; min-width: 0; align-items: center; }
.user-name { max-width: 390rpx; overflow: hidden; color: #ffffff; font-size: 38rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.gender-icon-img { width: 30rpx; height: 30rpx; margin-left: 10rpx; flex-shrink: 0; }
.user-school { display: block; margin-top: 8rpx; overflow: hidden; color: rgba(255,255,255,.84); font-size: 24rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.settings-wrap { display: flex; width: 72rpx; height: 72rpx; margin-left: 16rpx; align-items: center; justify-content: center; flex-shrink: 0; border: 1rpx solid rgba(255,255,255,.32); border-radius: 50%; background: rgba(255,255,255,.2); }
.settings-wrap:active { opacity: .78; transform: scale(.92); }.settings-icon { width: 40rpx; height: 40rpx; filter: brightness(0) invert(1); }

.shortcuts {
  display: flex;
  margin: 20rpx 24rpx 8rpx;
  padding: 28rpx 0 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(30, 64, 175, .09);
}
.shortcut-item { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: center; transition: transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1); }.shortcut-item:active { opacity: .74; transform: scale(.95); }
/* 白色圆角卡片底座：边框包裹 + 靠近边框的柔和投影，与功能宫格图标统一 */
.shortcut-icon-wrap { position: relative; display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border: 1rpx solid #e1e9ff; border-radius: 20rpx; background: linear-gradient(180deg, #ffffff 0%, #f5f8ff 100%); box-shadow: 0 8rpx 18rpx rgba(49, 92, 255, .10), inset 0 1rpx 0 rgba(255, 255, 255, .9); }
.shortcut-icon-img { width: 44rpx; height: 44rpx; }.shortcut-icon-dark { filter: brightness(0.5) saturate(0.5); }.shortcut-name { display: block; margin-top: 12rpx; max-width: 100%; overflow: hidden; color: #434850; font-size: 25rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }.shortcut-badge { position: absolute; top: -8rpx; right: -14rpx; min-width: 30rpx; height: 30rpx; padding: 0 7rpx; border: 2rpx solid #ffffff; border-radius: 16rpx; background: #ff5a5f; color: #ffffff; font-size: 18rpx; line-height: 26rpx; text-align: center; }

.feature-section { margin: 16rpx 24rpx 0; padding: 22rpx 16rpx 0; border-radius: 18rpx; background: #ffffff; box-shadow: 0 5rpx 16rpx rgba(33, 55, 88, .045); }
/* 消息通知卡片顶部横幅：蓝色圆角条，样式对齐个人中心运营横幅 */
.msg-banner { display: flex; align-items: center; justify-content: space-between; margin: 0 8rpx 16rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: linear-gradient(90deg, #3d7bfa 0%, #5b8cff 100%); box-shadow: 0 6rpx 16rpx rgba(61, 123, 250, .28); }
.msg-banner:active { opacity: .85; transform: scale(.985); }
.msg-banner-left { display: flex; flex: 1; min-width: 0; align-items: center; }
.msg-banner-icon { margin-right: 12rpx; color: var(--banner-fg, #ffffff); font-size: 30rpx; line-height: 1; flex-shrink: 0; }
.msg-banner-text { overflow: hidden; color: var(--banner-fg, #ffffff); font-size: 28rpx; font-weight: 600; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.msg-banner-arrow { margin-left: 16rpx; color: var(--banner-fg, rgba(255, 255, 255, .92)); opacity: .92; font-size: 24rpx; flex-shrink: 0; }
.section-title { display: block; margin: 0 8rpx 16rpx; color: #667085; font-size: 28rpx; font-weight: 400; line-height: 1.3; }
.feature-grid { display: flex; flex-wrap: wrap; border-top: 1rpx solid #f0f1f4; }.columns-2 .feature-item { width: 50%; }.columns-3 .feature-item { width: 33.3333%; }.columns-4 .feature-item { width: 25%; }
.feature-item { position: relative; display: flex; min-width: 0; min-height: 124rpx; padding: 18rpx 4rpx 20rpx; flex-direction: column; align-items: center; justify-content: flex-start; transition: transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1); }.feature-item:active { opacity: .68; transform: scale(.95); }
/* 白色圆角卡片底座：与顶部快捷入口完全统一（同尺寸/边框/投影） */
.feature-icon-wrap { position: relative; display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border: 1rpx solid #e1e9ff; border-radius: 20rpx; background: linear-gradient(180deg, #ffffff 0%, #f5f8ff 100%); box-shadow: 0 8rpx 18rpx rgba(49, 92, 255, .10), inset 0 1rpx 0 rgba(255, 255, 255, .9); }.feature-icon { width: 44rpx; height: 44rpx; }
/* 第二套 iconfont 功能图标：与原 PNG 图标同尺寸 */
.feature-font-icon { font-size: 44rpx; line-height: 1; }
.feature-trigger { display: flex; width: 100%; min-width: 0; flex-direction: column; align-items: center; }.feature-name { display: block; width: 100%; margin-top: 9rpx; overflow: hidden; color: #34383f; font-size: 25rpx; line-height: 1.35; text-align: center; text-overflow: ellipsis; white-space: nowrap; }.columns-3 .feature-name { font-size: 26rpx; }
.feature-badge { position: absolute; top: -6rpx; right: -12rpx; min-width: 30rpx; height: 30rpx; padding: 0 7rpx; border: 2rpx solid #ffffff; border-radius: 18rpx; background: #ff5a5f; color: #ffffff; font-size: 18rpx; line-height: 26rpx; text-align: center; }

/* 消息通知栏目状态标签区：与上方四列网格保持上下对齐 */
.stat-grid { width: 100%; box-sizing: border-box; margin: 0; padding: 4rpx 0 8rpx; }
.stat-grid .feature-item { width: 25%; }
.stat-grid .feature-item { min-height: 0; padding: 12rpx 4rpx 10rpx; }
.stat-grid .feature-name { margin-top: 6rpx; }
contact-admin.feature-contact { display: block; width: 100%; min-width: 0; }

/* ===== 悬浮交互状态：轻微上浮 + 卡片投影加深 ===== */
.fx-hover { transform: translateY(-6rpx) !important; opacity: 1 !important; }
.fx-hover .shortcut-icon-wrap,
.fx-hover .feature-icon-wrap {
  border-color: #d6e2ff;
  box-shadow:
    0 16rpx 30rpx rgba(49, 92, 255, .24),
    0 4rpx 10rpx rgba(49, 92, 255, .10),
    inset 0 1rpx 0 rgba(255, 255, 255, .9);
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }
.fx-hover .feature-badge,
.fx-hover .shortcut-badge { box-shadow: 0 4rpx 10rpx rgba(255, 90, 95, .35);  transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }
