.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3ff 0%, #f4f6fa 360rpx, #f4f6fa 100%);
}

.header {
  padding-bottom: 48rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.header-cyan {
  background:
    radial-gradient(
      circle at 12% 18%,
      rgba(255, 255, 255, 0.35) 0,
      rgba(255, 255, 255, 0) 180rpx
    ),
    linear-gradient(135deg, #6cb4ee 0%, #5ec4d4 50%, #4fd1c5 100%);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 28rpx 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  transition: var(--transition-fast);
}

.user-info:active {
  opacity: 0.85;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2);
}

.user-detail {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.user-school {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

.settings-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: var(--transition-fast);
}

.settings-wrap:active {
  transform: scale(0.9);
  opacity: 0.85;
}

.settings-icon {
  width: 42rpx;
  height: 42rpx;
  filter: brightness(0) invert(1);
}

.shortcuts {
  margin: 24rpx 24rpx 24rpx;
  padding: 32rpx 0;
  display: flex;
  position: relative;
  z-index: 2;
  box-shadow: var(--shadow);
}

.interaction-shortcuts {
  margin-top: 0;
  padding: 28rpx 0;
}

.shortcut-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: var(--transition-fast);
}

.shortcut-item:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.shortcut-icon-img {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 12rpx;
}

.shortcut-icon-wrap {
  position: relative;
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: #f3f6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.shortcut-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
  border: 2rpx solid #ffffff;
}

.shortcut-badge.data-badge {
  background: #4a7aff;
}

.shortcut-name {
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.menu {
  margin: 0 24rpx;
  padding: 0 24rpx;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider);
  transition: var(--transition-fast);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg);
  opacity: 0.85;
}

.menu-icon-img {
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
}

.menu-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.arrow {
  color: var(--text-placeholder);
  font-size: 28rpx;
}
