<view class="page">
  <view class="section-title">账户设置</view>
  <view class="card account-card">
    <view class="menu-item" bindtap="openProfileModal"><view class="menu-left"><image class="menu-icon" src="/assets/icons/avatar.png" mode="aspectFit"></image><text>头像</text></view><view class="menu-right"><image class="avatar-preview" src="{{userInfo.avatarUrl || '/assets/avatar2/1.jpg'}}" mode="aspectFill"></image><text class="arrow">›</text></view></view>
    <view class="menu-item" bindtap="openProfileModal"><view class="menu-left"><image class="menu-icon" src="/assets/icons/nickname.png" mode="aspectFit"></image><text>昵称</text></view><view class="menu-right"><text class="menu-value">{{userInfo.nickName || '校园用户'}}</text><text class="arrow">›</text></view></view>
    <view class="menu-item" bindtap="openProfileModal"><view class="menu-left"><image class="menu-icon" src="/assets/icons/gender.png" mode="aspectFit"></image><text>性别</text></view><view class="menu-right"><text class="menu-value">{{genderText}}</text><text class="arrow">›</text></view></view>
    <view class="menu-item"><view class="menu-left"><image class="menu-icon" src="/assets/icons/school.png" mode="aspectFit"></image><text>学校</text></view><text class="menu-value">广东轻工职业技术大学</text></view>
    <view class="menu-item" bindtap="openProfileModal"><view class="menu-left"><image class="menu-icon" src="/assets/icons/campus.png" mode="aspectFit"></image><text>校区</text></view><view class="menu-right"><text class="menu-value">{{userInfo.campus || '未设置'}}</text><text class="arrow">›</text></view></view>
    <view class="menu-item phone-row" bindtap="openPhoneModal"><view class="menu-left"><image class="menu-icon" src="/assets/icons/phone.png" mode="aspectFit"></image><text>手机号码</text></view><view class="menu-right"><text class="menu-value">{{userInfo.phone || '未绑定'}}</text><text class="phone-edit-hint">{{userInfo.phone ? '修改' : '绑定'}}</text><text class="arrow">›</text></view></view>
  </view>

  <view class="address-card"><view class="address-head"><text>常用地址</text><text class="map-link" bindtap="chooseAddress">地图选点</text></view><input class="address-input" placeholder="请输入常用地址" value="{{commonAddress}}" bindinput="onAddressInput" bindblur="saveAddress"></input></view>
  <view class="section-title">关于</view>
  <view class="card about-card"><view class="menu-item" bindtap="goSecurity"><view class="menu-left"><image class="menu-icon" src="/assets/icons/security.png" mode="aspectFit"></image><text>账号安全</text></view><text class="arrow">›</text></view><view class="menu-item" bindtap="goRules"><view class="menu-left"><image class="menu-icon" src="/assets/icons/rules.png" mode="aspectFit"></image><text>社区规范</text></view><text class="arrow">›</text></view><view class="menu-item" bindtap="goAgreement"><view class="menu-left"><image class="menu-icon" src="/assets/icons/agreement.png" mode="aspectFit"></image><text>用户协议</text></view><text class="arrow">›</text></view><view class="menu-item" bindtap="goPrivacy"><view class="menu-left"><image class="menu-icon" src="/assets/icons/privacy.png" mode="aspectFit"></image><text>隐私政策</text></view><text class="arrow">›</text></view><view class="menu-item" bindtap="showVersion"><view class="menu-left"><image class="menu-icon" src="/assets/icons/version.png" mode="aspectFit"></image><text>版本信息</text></view><view class="menu-right"><text class="menu-value">v1.1.28</text><text class="arrow">›</text></view></view></view>
  <view class="logout" bindtap="logout">退出登录</view>

  <view class="modal-mask {{showProfileModal || showAvatarSource ? 'show' : ''}}" bindtap="closeActiveSheet"></view>
  <view class="profile-modal {{showProfileModal ? 'show' : ''}}">
    <view class="profile-modal-header"><text class="profile-modal-title">完善个人资料</text><text class="profile-modal-close" bindtap="closeProfileModal">×</text></view>
    <scroll-view scroll-y class="profile-modal-body">
      <view class="profile-row avatar-row"><text class="profile-label">头像</text><view class="avatar-edit-wrap" bindtap="onModalAvatarTap"><image class="avatar-large" src="{{editAvatar || '/assets/avatar2/1.jpg'}}" mode="aspectFill"></image><view class="avatar-camera-icon"><image class="camera-icon" src="/assets/icons/camera.png" mode="aspectFit"></image></view></view></view>
      <view class="profile-row"><text class="profile-label">昵称</text><view class="nickname-edit"><input class="profile-input" type="nickname" focus="{{nicknameFocus}}" placeholder="请输入昵称" value="{{editNickname}}" bindinput="onNicknameInput" bindnicknamereview="onWechatNicknameReview"></input><button class="wechat-fill-btn" loading="{{syncingWechatNickname}}" disabled="{{syncingWechatNickname}}" bindtap="onUseWechatNickname">使用微信昵称</button></view></view>
      <view class="profile-row gender-row"><text class="profile-label">性别</text><view class="gender-options"><view class="gender-option" bindtap="onSelectGender" data-value="1"><view class="gender-radio {{editGender === 1 ? 'radio-checked-male' : 'radio-unchecked'}}"></view><text class="gender-icon male-icon">♂</text></view><view class="gender-option" bindtap="onSelectGender" data-value="2"><view class="gender-radio {{editGender === 2 ? 'radio-checked-female' : 'radio-unchecked'}}"></view><text class="gender-icon female-icon">♀</text></view></view></view>
      <view class="profile-row"><text class="profile-label">学校</text><text class="profile-school-fixed">广东轻工职业技术大学</text></view>
      <view class="profile-row campus-row"><text class="profile-label">校区</text><view class="campus-options"><view class="campus-tag {{editCampusGroup === '广州校区' ? 'campus-active' : ''}}" bindtap="onSelectCampus" data-value="广州校区">广州校区</view><view class="campus-tag {{editCampusGroup === '佛山校区' ? 'campus-active' : ''}}" bindtap="onSelectCampus" data-value="佛山校区">佛山校区</view></view></view>
      <view class="campus-sub-options" wx:if="{{campusOptions.length}}"><view class="campus-subtag {{editCampus === item ? 'campus-active' : ''}}" wx:for="{{campusOptions}}" wx:key="*this" bindtap="onSelectSubCampus" data-value="{{item}}">{{item}}</view></view>
    </scroll-view>
    <view class="profile-modal-footer"><button class="confirm-btn" loading="{{savingProfile}}" bindtap="onConfirmProfile">确定</button></view>
  </view>

  <view class="avatar-source-sheet {{showAvatarSource ? 'show' : ''}}">
    <text class="source-title">选择头像来源</text>
    <button class="source-action" open-type="chooseAvatar" bindchooseavatar="onChooseWechatAvatar" loading="{{syncingWechatAvatar}}" disabled="{{syncingWechatAvatar}}">使用微信头像</button>
    <view class="source-action" bindtap="onChooseAlbumAvatar">从相册选择</view>
    <view class="source-cancel" bindtap="closeAvatarSource">取消</view>
  </view>

  <view class="modal-mask {{showPhoneModal ? 'show' : ''}}" bindtap="closePhoneModal"></view>
  <view class="phone-modal {{showPhoneModal ? 'show' : ''}}">
    <view class="phone-modal-header"><text class="phone-modal-title">{{userInfo.phone ? '修改手机号' : '绑定手机号'}}</text><text class="phone-modal-close" bindtap="closePhoneModal">×</text></view>
    <input class="phone-modal-input" type="number" maxlength="11" placeholder="请输入11位手机号" placeholder-class="phone-modal-placeholder" value="{{phoneInput}}" bindinput="onPhoneInput" />
    <view class="phone-modal-actions"><view class="phone-modal-btn cancel" bindtap="closePhoneModal">取消</view><view class="phone-modal-btn confirm {{savingPhone ? 'disabled' : ''}}" bindtap="confirmPhone">确认</view></view>
  </view>
</view>
