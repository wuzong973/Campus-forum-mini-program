.page { min-height: 100vh; padding-bottom: calc(46rpx + env(safe-area-inset-bottom)); background: #f5f7fa; }.section-title { padding: 30rpx 30rpx 16rpx; color: #969799; font-size: 26rpx; }.card, .address-card { margin: 0 24rpx; overflow: hidden; border-radius: 16rpx; background: #ffffff; box-shadow: 0 4rpx 14rpx rgba(34, 55, 91, .04); }.menu-item { position: relative; display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; padding: 16rpx 24rpx; border-bottom: 1rpx solid #f0f2f5; }.menu-item:last-child { border-bottom: 0; }.menu-item:active { background: #f8f9fb; }.menu-left, .menu-right { display: flex; min-width: 0; align-items: center; }.menu-left text { color: #2f3642; font-size: 30rpx; }.menu-icon { width: 40rpx; height: 40rpx; margin-right: 18rpx; }.menu-value { max-width: 350rpx; overflow: hidden; color: #969daa; font-size: 27rpx; text-align: right; text-overflow: ellipsis; white-space: nowrap; }.arrow { margin-left: 12rpx; color: #c7ccd5; font-size: 36rpx; line-height: 1; }.avatar-preview { width: 70rpx; height: 70rpx; margin-right: 12rpx; border-radius: 50%; background: #f0f2f5; }.confirm-btn::after, .source-action::after { border: 0; }.address-card { margin-top: 24rpx; padding: 24rpx; }.address-head { display: flex; align-items: center; justify-content: space-between; color: #2f3642; font-size: 30rpx; }.map-link { color: #4a7aff; font-size: 26rpx; }.address-input { width: 100%; height: 74rpx; margin-top: 18rpx; padding: 0 20rpx; border: 1rpx solid #e7eaf0; border-radius: 12rpx; background: #f5f7fa; color: #2f3642; font-size: 27rpx; box-sizing: border-box; }.logout { height: 88rpx; margin: 46rpx 24rpx 0; border-radius: 16rpx; background: #ffffff; color: #e65353; font-size: 30rpx; line-height: 88rpx; text-align: center; }
.modal-mask { position: fixed; z-index: 100; inset: 0; visibility: hidden; background: rgba(0,0,0,.52); opacity: 0; transition: opacity .24s ease, visibility .24s ease; }.modal-mask.show { visibility: visible; opacity: 1; }.profile-modal { position: fixed; z-index: 101; right: 0; bottom: 0; left: 0; display: flex; max-height: 84vh; padding-bottom: env(safe-area-inset-bottom); flex-direction: column; border-radius: 26rpx 26rpx 0 0; background: #ffffff; transform: translateY(105%); transition: transform .28s ease; }.profile-modal.show { transform: translateY(0); }.profile-modal-header { display: flex; align-items: center; justify-content: space-between; padding: 30rpx 30rpx 20rpx; flex-shrink: 0; }.profile-modal-title { color: #202938; font-size: 36rpx; font-weight: 700; }.profile-modal-close { padding: 6rpx; color: #929ba8; font-size: 48rpx; line-height: 1; }.profile-modal-body { padding: 0 30rpx; box-sizing: border-box; }.profile-row { display: flex; min-height: 94rpx; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #eff1f5; }.profile-label { width: 116rpx; flex-shrink: 0; color: #2d3542; font-size: 30rpx; }.avatar-row { justify-content: space-between; min-height: 132rpx; }.avatar-edit-wrap { position: relative; width: 100rpx; height: 100rpx; }.avatar-large { width: 100rpx; height: 100rpx; border-radius: 50%; background: #eef1f5; }.avatar-camera-icon { position: absolute; right: -4rpx; bottom: -2rpx; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border: 3rpx solid #ffffff; border-radius: 50%; background: #4a7aff; }.camera-icon { width: 24rpx; height: 24rpx; filter: brightness(0) invert(1); }.nickname-edit { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: flex-end; gap: 12rpx; }.profile-input { min-width: 0; flex: 1; color: #252d39; font-size: 30rpx; text-align: right; }.wechat-fill-btn { flex: 0 0 auto; margin: 0; padding: 8rpx 14rpx; border-radius: 28rpx; background: #edf3ff; color: #4a7aff; font-size: 22rpx; line-height: 1.4; }.gender-row, .campus-row { justify-content: space-between; }.gender-options, .campus-options { display: flex; align-items: center; gap: 20rpx; }.gender-option { display: flex; align-items: center; gap: 8rpx; }.gender-radio { width: 34rpx; height: 34rpx; border: 2rpx solid #d8dde7; border-radius: 50%; }.radio-checked-male, .radio-checked-female { position: relative; border-color: #4a7aff; background: #4a7aff; }.radio-checked-female { border-color: #ff6b9d; background: #ff6b9d; }.radio-checked-male::after, .radio-checked-female::after { position: absolute; top: 8rpx; left: 8rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #ffffff; content: ''; }.gender-icon { font-size: 34rpx; }.male-icon { color: #4a7aff; }.female-icon { color: #ff6b9d; }.profile-school-fixed { flex: 1; color: #969daa; font-size: 28rpx; text-align: right; }.campus-tag, .campus-subtag { padding: 10rpx 22rpx; border: 1rpx solid #dce1ea; border-radius: 30rpx; color: #657080; font-size: 26rpx; line-height: 1.35; white-space: nowrap; }.campus-tag.campus-active, .campus-subtag.campus-active { border-color: #4a7aff; background: #4a7aff; color: #ffffff; }.campus-sub-options { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 16rpx 0 22rpx 116rpx; border-bottom: 1rpx solid #eff1f5; }.profile-modal-footer { padding: 24rpx 30rpx 30rpx; flex-shrink: 0; }.confirm-btn { width: 100%; height: 88rpx; border-radius: 44rpx; background: #4a7aff; color: #ffffff; font-size: 32rpx; line-height: 88rpx; }
.avatar-source-sheet { position: fixed; z-index: 102; right: 0; bottom: 0; left: 0; padding-bottom: env(safe-area-inset-bottom); border-radius: 26rpx 26rpx 0 0; background: #ffffff; transform: translateY(105%); transition: transform .28s ease; }.avatar-source-sheet.show { transform: translateY(0); }.source-title { display: block; padding: 30rpx; color: #2b3443; font-size: 30rpx; font-weight: 700; text-align: center; }.source-action { display: block; width: 100%; margin: 0; padding: 28rpx 24rpx; border-top: 1rpx solid #edf0f4; border-radius: 0; background: #ffffff; color: #4a7aff; font-size: 30rpx; line-height: 1.4; text-align: center; }.source-cancel { margin-top: 14rpx; padding: 28rpx; border-top: 14rpx solid #f5f7fa; color: #8f98a6; font-size: 30rpx; text-align: center; }
.phone-edit-hint { margin-left: 10rpx; color: #4a7aff; font-size: 24rpx; white-space: nowrap; }
.phone-modal { position: fixed; z-index: 103; left: 50%; top: 50%; width: 600rpx; padding: 36rpx 32rpx 32rpx; border-radius: 24rpx; background: #ffffff; box-sizing: border-box; transform: translate(-50%, -50%) scale(0.92); opacity: 0; visibility: hidden; transition: all 0.22s ease; }.phone-modal.show { opacity: 1; visibility: visible; transform: translate(-50%, -50%) scale(1); }
.phone-modal-header { display: flex; align-items: center; justify-content: space-between; }.phone-modal-title { color: #202938; font-size: 32rpx; font-weight: 700; }.phone-modal-close { padding: 4rpx 8rpx; color: #929ba8; font-size: 44rpx; line-height: 1; }
.phone-modal-input { width: 100%; height: 84rpx; margin-top: 30rpx; padding: 0 24rpx; box-sizing: border-box; border: 1rpx solid #e7eaf0; border-radius: 14rpx; background: #f5f7fa; color: #2f3642; font-size: 30rpx; }.phone-modal-placeholder { color: #a5aebd; }
.phone-modal-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }.phone-modal-btn { flex: 1; height: 80rpx; border-radius: 40rpx; font-size: 29rpx; line-height: 80rpx; text-align: center; }.phone-modal-btn.cancel { background: #f2f4f8; color: #66718a; }.phone-modal-btn.confirm { background: #4a7aff; color: #ffffff; font-weight: 600; }.phone-modal-btn.confirm.disabled { opacity: 0.6; }
