.page{min-height:100vh;background:#f6f7f9;padding:0 16rpx 150rpx;box-sizing:border-box;color:#2f4054}.topbar{position:fixed;z-index:5;top:0;left:0;right:0;background:#fff}.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}.back{font-size:64rpx;line-height:1;width:72rpx}.nav-title{font-size:34rpx;font-weight:600}.more{font-size:42rpx;letter-spacing:4rpx;width:72rpx;text-align:center}.nav-space{width:100%}.card{background:#fff;border-radius:18rpx;margin-bottom:20rpx;padding:28rpx 24rpx;box-shadow:0 3rpx 14rpx rgba(25,45,75,.05)}.section-title{display:block;font-size:31rpx;font-weight:600}.required{color:#f05a5a}.textarea{width:100%;height:180rpx;margin-top:16rpx;font-size:28rpx;color:#39485b}.chips{display:flex;gap:16rpx;margin-top:12rpx}.chip{padding:14rpx 24rpx;border:1rpx solid #edf0f4;border-radius:40rpx;color:#8c97a7;font-size:25rpx}.upload-card{height:250rpx}.upload-box{position:relative;width:150rpx;height:150rpx;background:#f6f7f8;border-radius:12rpx;margin-top:18rpx;display:flex;align-items:center;justify-content:center;gap:8rpx;flex-wrap:wrap;padding:12rpx}.upload-box image{width:76rpx;height:76rpx;border-radius:8rpx}.upload-count{position:absolute;bottom:8rpx;left:0;right:0;text-align:center;color:#9da7b4;font-size:24rpx}.service-tip{text-align:center;color:#8f9aaa;font-size:26rpx;margin-top:26rpx}.service-tip strong{color:#347ff2;font-weight:400}.bottom-actions{position:fixed;left:16rpx;right:16rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));display:flex;gap:20rpx}.bottom-actions button{flex:1;height:88rpx;line-height:88rpx;border-radius:44rpx;font-size:30rpx}.bottom-actions button::after{border:0}.secondary{background:#fff;color:#7c8797}.primary{background:#347ff2;color:#fff}
