<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;"><view class="topbar-inner" style="height: {{navBarHeight}}px;"><view class="back" bindtap="goBack">‹</view><text class="nav-title">信院论坛</text><view class="more">•••</view></view></view>
  <view class="nav-space" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
  <view class="card"><text class="section-title"><text class="required">*</text> 提交完成说明</text><textarea class="textarea" maxlength="300" placeholder="请输入提交完成说明..." value="{{description}}" bindinput="onDescription"/><view class="chips"><view class="chip" bindtap="usePreset" data-text="已送达指定地点">已送达指定地点</view><view class="chip" bindtap="usePreset" data-text="已送给需求方">已送给需求方</view></view></view>
  <view class="card upload-card"><text class="section-title">上传图片证明</text><view class="upload-box" bindtap="chooseImage"><image wx:if="{{images.length === 0}}" src="/assets/icons/camera.png" mode="aspectFit"/><image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill"/><text class="upload-count">{{images.length}} / 3</text></view></view>
  <view class="service-tip">如有疑问，请尽快联系<text bindtap="contactService">客服处理</text></view>
  <view class="bottom-actions"><button class="secondary" bindtap="submit">确认提交</button><button class="primary" bindtap="goBack">我再想想</button></view>
</view>
