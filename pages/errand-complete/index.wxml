<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;"><view class="topbar-inner" style="height: {{navBarHeight}}px;"><view class="back-pill spring-btn" hover-class="back-pill-hover press-spring" hover-stay-time="80" bindtap="goBack"><text class="back-pill-icon">‹</text><text>返回</text></view><text class="nav-title">订单处理</text><view class="topbar-right"></view></view></view>
  <view class="nav-space" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <view class="card">
    <text class="section-title"><text class="required">*</text> 提交完成说明</text>
    <textarea class="textarea" maxlength="300" placeholder="请输入提交完成说明..." value="{{description}}" bindinput="onDescription"/>
    <view class="chips">
      <view class="chip" bindtap="usePreset" data-text="已送达指定地点">已送达指定地点</view>
      <view class="chip" bindtap="usePreset" data-text="已送给需求方">已送给需求方</view>
    </view>
  </view>

  <view class="card upload-card">
    <text class="section-title">上传图片证明</text>
    <view class="upload-grid">
      <view class="upload-thumb" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-src="{{item}}" data-urls="{{images}}" bindtap="previewImage" bindlongpress="onImageQrScan"/>
        <view class="thumb-delete" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="upload-box" wx:if="{{images.length < 3}}" bindtap="chooseImage">
        <image class="upload-icon" src="/assets/icons/camera.png" mode="aspectFit"/>
        <text class="upload-count">{{images.length}} / 3</text>
      </view>
    </view>
  </view>

  <view class="service-tip">如有疑问，请尽快联系<contact-admin style="display: inline;"><text slot="trigger">客服处理</text></contact-admin></view>

  <view class="bottom-actions">
    <button hover-class="press-spring" class="primary spring-btn" bindtap="goBack" hover-stay-time="120">我再想想</button>
    <button hover-class="press-spring" class="secondary spring-btn" bindtap="submit" disabled="{{submitting}}" hover-stay-time="120">确认提交</button>
  </view>

  <!-- 提交成功提示：倒计时结束自动返回订单详情，也可点击立即返回 -->
  <view class="tip-mask" wx:if="{{showTip}}">
    <view class="tip-popup">
      <text class="tip-title">待办提示</text>
      <text class="tip-content">已通知发单人确认，若发单人 {{autoConfirmHours}} 小时还未确认，系统将自动确认完成并结算赏金。</text>
      <view class="tip-action" bindtap="backToDetail">立即返回订单详情（{{countdown}}s）</view>
    </view>
  </view>
</view>
