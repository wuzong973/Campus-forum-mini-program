<view class="page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;"><view class="topbar-inner" style="height: {{navBarHeight}}px;"><view class="back" bindtap="goBack">‹</view><text class="nav-title">广轻工论坛</text><view class="topbar-right"></view></view></view>
  <view class="nav-space" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <view class="card">
    <text class="section-title"><text class="required">*</text> 提交完成说明</text>
    <textarea class="textarea" maxlength="300" placeholder="请输入提交完成说明..." value="{{description}}" bindinput="onDescription"/>
    <view class="chips">
      <view class="chip" bindtap="usePreset" data-text="已送达指定地点">已送达指定地点</view>
      <view class="chip" bindtap="usePreset" data-text="已送给需求方">已送给需求方</view>
    </view>
  </view>

  <view class="card upload-card">
    <text class="section-title">上传图片证明</text>
    <view class="upload-grid">
      <view class="upload-thumb" wx:for="{{images}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="previewImage"/>
        <view class="thumb-delete" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="upload-box" wx:if="{{images.length < 3}}" bindtap="chooseImage">
        <image class="upload-icon" src="/assets/icons/camera.png" mode="aspectFit"/>
        <text class="upload-count">{{images.length}} / 3</text>
      </view>
    </view>
  </view>

  <view class="service-tip">如有疑问，请尽快联系<text bindtap="contactService">客服处理</text></view>

  <view class="bottom-actions">
    <button class="secondary" bindtap="submit" disabled="{{submitting}}">确认提交</button>
    <button class="primary" bindtap="goBack">我再想想</button>
  </view>
</view>
