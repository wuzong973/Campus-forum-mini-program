<view class="page">
  <view class="hero">
    <image class="hero-icon" src="/assets/icons/repair-logo.jpg" mode="aspectFit" />
    <view class="hero-copy"><text class="hero-title">校园广轻维修</text><text class="hero-sub">预约上门 · 包括数码电子、宿舍家具、小型家电、代步单车、日常器物等，只要你能想到的，我们都能修！！
注：零件需付费或自行采购</text></view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'book' ? 'active' : ''}}" data-tab="book" bindtap="onTab">预约维修</view>
    <view class="tab {{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="onTab">我的订单</view>
  </view>

  <block wx:if="{{tab === 'book'}}">
    <view class="section card">
      <text class="section-title">设备与故障</text>
      <text class="label">设备类型</text>
      <view class="option-grid"><view class="option {{deviceType === item ? 'active' : ''}}" wx:for="{{deviceTypes}}" wx:key="*this" data-field="deviceType" data-value="{{item}}" bindtap="onSelect">{{item}}</view></view>
      <text class="label label-gap">故障问题</text>
      <textarea class="textarea" maxlength="500" placeholder="请描述故障现象，例如无法开机、频繁蓝屏等 *（必填）" data-field="description" value="{{description}}" bindinput="onInput" />
      <view class="upload" bindtap="onChooseImage" wx:if="{{images.length < 3}}"><text class="upload-plus">+</text><text>添加故障照片（选填）</text></view>
      <view class="images"><view class="image-wrap" wx:for="{{images}}" wx:key="*this"><image class="image" src="{{item}}" mode="aspectFill"/><text class="remove" data-index="{{index}}" bindtap="onRemoveImage">×</text></view></view>
    </view>

    <view class="section card">
      <text class="section-title">选择维修人员</text>
      <view class="technician-list">
        <view class="technician {{selectedTechnicianPhone === item.phone ? 'active' : ''}}" wx:for="{{technicians}}" wx:key="phone" data-phone="{{item.phone}}" bindtap="onSelectTechnician">
          <image class="technician-avatar" src="/assets/icons/repair-logo.jpg" mode="aspectFill" />
          <view class="technician-info"><text class="technician-name">{{item.name}}</text><text class="technician-phone">{{item.phone}}</text></view>
          <text class="technician-chat" data-phone="{{item.phone}}" catchtap="onChatTechnician">聊天</text>
          <text class="selected-mark" wx:if="{{selectedTechnicianPhone === item.phone}}">已选</text>
        </view>
      </view>
    </view>

    <view class="section card">
      <text class="section-title">上门信息</text>
      <input class="input" placeholder="联系人 *" data-field="contactName" value="{{contactName}}" bindinput="onInput" />
      <input class="input" type="number" maxlength="11" placeholder="联系电话 *" data-field="contactPhone" value="{{contactPhone}}" bindinput="onInput" />
      <view class="address-row"><input class="input address-input" placeholder="宿舍楼、房间号或详细地址" data-field="serviceAddress" value="{{serviceAddress}}" bindinput="onInput"/><text class="location" bindtap="onFillCommonAddr">填入常用地址</text><text class="location" bindtap="onChooseLocation">定位</text></view>
      <view class="picker-row"><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="onDateChange"><view class="picker">{{date}}</view></picker><picker mode="time" value="{{time}}" bindchange="onTimeChange"><view class="picker">{{time}}</view></picker></view>
    </view>

    <view class="price-bar"><view><text class="price-label">检测预约费</text><text class="price-note">最终维修费用由工程师检测后确认</text></view><text class="price">¥{{price}}</text></view>
    <button class="submit btn-primary" loading="{{submitting}}" bindtap="onSubmit">预约并支付</button>
  </block>

  <view wx:else class="orders">
    <view class="order card" wx:for="{{orders}}" wx:key="id"><view class="order-head"><text class="order-type">{{item.device_type || item.deviceType}}</text><text class="status status-{{item.status}}">{{statusText[item.status]}}</text></view><text class="order-line">预约：{{item.appointment_time}}</text><text class="order-line">维修人员：{{item.technicianName || item.technician_name || item.technicianName || '待分配'}}</text><text class="order-line">地址：{{item.service_address || item.serviceAddress}}</text><text class="order-line">故障描述：{{item.description}}</text><view class="order-foot"><text class="order-no">{{item.order_no}}</text><view class="order-actions"><text class="order-chat" wx:if="{{item.technicianUserId}}" data-phone="{{item.technicianPhone || item.technician_phone}}" bindtap="onChatTechnician">联系师傅</text><text class="order-price">¥{{item.amount}}</text></view></view></view>
    <view class="empty" wx:if="{{!loadingOrders && orders.length === 0}}">暂无维修订单</view>
    <view class="empty" wx:if="{{loadingOrders}}">正在加载...</view>
  </view>
</view>
