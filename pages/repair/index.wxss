.page{min-height:100vh;padding:24rpx 24rpx 150rpx;background:#f5f7fa;box-sizing:border-box}.hero{display:flex;align-items:center;padding:28rpx 30rpx;background:linear-gradient(110deg,#315cff,#12b8a6);border-radius:8rpx;color:#fff}.hero-icon{width:104rpx;height:104rpx;margin-right:24rpx;border-radius:8rpx;background:#fff}.hero-copy{display:flex;flex-direction:column;gap:10rpx}.hero-title{font-size:38rpx;font-weight:700}.hero-sub{font-size:24rpx;opacity:.9}.tabs{height:88rpx;display:flex;background:#fff;margin:24rpx 0;border-bottom:1rpx solid #eef0f5}.tab{flex:1;text-align:center;line-height:88rpx;font-size:28rpx;color:#87909e;position:relative}.tab.active{color:#315cff;font-weight:700}.tab.active:after{content:"";position:absolute;bottom:0;left:35%;width:30%;height:5rpx;background:#315cff;border-radius:3rpx}.section{padding:30rpx;margin-bottom:24rpx;border-radius:8rpx}.section-title{display:block;font-size:32rpx;font-weight:700;color:#1f2329;margin-bottom:28rpx}.label{display:block;font-size:26rpx;color:#5d6675;margin-bottom:16rpx}.label-gap{margin-top:26rpx}.option-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}.option{height:68rpx;line-height:68rpx;text-align:center;background:#f5f7fa;border:2rpx solid transparent;border-radius:8rpx;font-size:25rpx;color:#596273}.option.active{color:#315cff;border-color:#315cff;background:#f0f4ff;font-weight:600}.technician-list{display:flex;flex-direction:column;gap:16rpx}.technician{display:flex;align-items:center;min-height:100rpx;padding:16rpx;background:#f7f9fc;border:2rpx solid transparent;border-radius:8rpx;box-sizing:border-box}.technician.active{border-color:#315cff;background:#f0f4ff}.technician-avatar{width:66rpx;height:66rpx;border-radius:50%;background:#fff}.technician-info{display:flex;flex:1;min-width:0;margin-left:18rpx;flex-direction:column;gap:4rpx}.technician-name{font-size:28rpx;font-weight:600;color:#1f2329}.technician-phone{font-size:23rpx;color:#7c8798}.technician-chat,.order-chat{padding:12rpx;color:#315cff;font-size:25rpx}.selected-mark{font-size:23rpx;color:#12a06f}.textarea{width:100%;height:170rpx;padding:22rpx;margin-top:28rpx;background:#f5f7fa;border-radius:8rpx;box-sizing:border-box;font-size:27rpx}.upload{height:90rpx;margin-top:20rpx;border:2rpx dashed #cad3e3;display:flex;align-items:center;justify-content:center;gap:12rpx;color:#657188;font-size:25rpx;border-radius:8rpx}.upload-plus{font-size:38rpx;color:#315cff}.images{display:flex;gap:14rpx;margin-top:16rpx}.image-wrap{position:relative;width:150rpx;height:150rpx}.image{width:100%;height:100%;border-radius:8rpx}.remove{position:absolute;right:-8rpx;top:-8rpx;width:36rpx;height:36rpx;text-align:center;line-height:33rpx;border-radius:50%;background:#344054;color:#fff}.input{height:88rpx;border-bottom:1rpx solid #edf0f4;font-size:27rpx}.address-row{display:flex;align-items:center}.address-input{flex:1}.location{padding:20rpx;color:#315cff;font-size:26rpx}.picker-row{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:24rpx}.picker{height:76rpx;line-height:76rpx;text-align:center;background:#f5f7fa;border-radius:8rpx;color:#3e4756;font-size:27rpx}.price-bar{display:flex;justify-content:space-between;align-items:center;padding:26rpx 30rpx;background:#fff;border-radius:8rpx}.price-label,.price-note{display:block}.price-label{font-size:28rpx;font-weight:600}.price-note{font-size:21rpx;color:#98a0ad;margin-top:6rpx}.price{font-size:38rpx;font-weight:700;color:#ff6b4a}.submit{height:92rpx;line-height:92rpx;margin-top:24rpx;border-radius:8rpx;font-size:31rpx}.order{padding:28rpx;margin-bottom:20rpx;border-radius:8rpx}.order-head,.order-foot{display:flex;justify-content:space-between;align-items:center}.order-type{font-weight:700;font-size:29rpx}.status{font-size:24rpx;color:#315cff}.status-finished{color:#12a06f}.order-line{display:block;margin-top:18rpx;color:#697386;font-size:25rpx}.order-foot{margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #eef0f4}.order-no{font-size:21rpx;color:#a0a7b2}.order-actions{display:flex;align-items:center;gap:12rpx}.order-price{font-weight:700;color:#ff6b4a}.empty{text-align:center;padding:120rpx 0;color:#9aa3b2;font-size:27rpx}
