.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding: 24rpx;
  box-sizing: border-box;
}

.black-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 3rpx 16rpx rgba(32, 48, 76, 0.06);
}

.black-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.black-row + .black-row { border-top: 1rpx solid #f0f2f5; }

.black-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #edf1f6;
  flex-shrink: 0;
}

.black-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.black-nick {
  color: #27364a;
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.black-date { color: #a6afbb; font-size: 23rpx; }

.unblock-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e64340;
  color: #e64340;
  font-size: 24rpx;
  font-weight: 500;
  transition: opacity 0.2s ease;
}

.btn-hover { opacity: 0.7; }

.black-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 40rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.5;
}

.empty-text {
  margin-top: 20rpx;
  color: #42506b;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 10rpx;
  color: #a6afbb;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.black-loading {
  padding: 60rpx 0;
  color: #a6afbb;
  font-size: 26rpx;
  text-align: center;
}
