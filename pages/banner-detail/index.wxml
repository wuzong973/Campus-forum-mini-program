<view class="page">
  <!-- ===== 展示态 ===== -->
  <block wx:if="{{!editing}}">
    <view class="hero card">
      <view class="hero-banner" wx:if="{{banner.text}}" style="{{banner.bannerStyle}}">
        <text class="hero-banner-icon">{{banner.icon}}</text>
        <text class="hero-banner-text">{{banner.text}}</text>
      </view>
      <view class="offline-tip" wx:if="{{isAdmin && banner.text && !banner.status}}">横幅已下线，普通用户不可见；可点击下方编辑重新发布</view>

      <block wx:if="{{banner.text}}">
        <view class="hero-title" wx:if="{{banner.detailTitle}}">{{banner.detailTitle}}</view>
        <view class="hero-content" wx:if="{{paragraphs.length}}">
          <text class="hero-para" wx:for="{{paragraphs}}" wx:key="index">{{item}}</text>
        </view>
        <view class="hero-images" wx:if="{{banner.images.length}}">
          <image
            wx:for="{{banner.images}}"
            wx:key="*this"
            class="hero-img"
            src="{{item}}"
            mode="widthFix"
            lazy-load
            data-url="{{item}}"
            bindtap="onPreviewImage"
            bindlongpress="onImageLongPress"
          ></image>
        </view>
        <view class="hero-link" wx:if="{{banner.link}}" bindtap="onOpenLink">
          <text class="hero-link-label">{{banner.linkText || '相关链接'}}</text>
          <text class="hero-link-value">{{banner.link}}</text>
          <text class="hero-link-action">复制</text>
        </view>
        <view class="hero-empty" wx:if="{{!paragraphs.length && !banner.images.length && !banner.link}}">管理员还没有发布详细内容，敬请期待</view>
      </block>

      <view class="hero-empty" wx:if="{{loaded && !banner.text}}">暂无公告内容</view>
      <view class="hero-empty" wx:if="{{!loaded}}">加载中...</view>
    </view>

    <view class="edit-entry" wx:if="{{isAdmin}}" bindtap="onStartEdit">✏️ 编辑并发布内容</view>
  </block>

  <!-- ===== 管理员编辑态 ===== -->
  <block wx:if="{{editing}}">
    <view class="form card">
      <view class="form-title">编辑横幅与详情</view>

      <view class="form-item">
        <view class="form-label">横幅文字 <text class="form-req">*</text>（展示在「我的-消息通知」卡片顶部）</view>
        <input class="form-input" value="{{form.text}}" maxlength="60" placeholder="例如：驾校报名咨询" data-field="text" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <view class="form-label">横幅图标（emoji，可选）</view>
        <input class="form-input" value="{{form.icon}}" maxlength="4" placeholder="默认 👍" data-field="icon" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <view class="form-label">背景颜色（可选；点击弹出颜色选择器，未设置时使用默认渐变）</view>
        <view class="color-field" bindtap="openPageColorPicker" data-field="bgColor">
          <view class="color-swatch" style="background: {{form.bgColor || '#f0f2f5'}};"></view>
          <text class="color-value">{{form.bgColor || '使用默认配色'}}</text>
          <text class="color-action">选择 ›</text>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">文字颜色（可选；点击弹出颜色选择器）</view>
        <view class="color-field" bindtap="openPageColorPicker" data-field="textColor">
          <view class="color-swatch" style="background: {{form.textColor || '#f0f2f5'}};"></view>
          <text class="color-value">{{form.textColor || '使用默认配色'}}</text>
          <text class="color-action">选择 ›</text>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">实时预览（保存后「我的-消息通知」等位置按此效果展示）</view>
        <view class="banner-preview" style="background: {{form.bgColor || 'linear-gradient(90deg, #3d7bfa 0%, #5b8cff 100%)'}}; color: {{form.textColor || '#ffffff'}};">
          <text class="banner-preview-icon">{{form.icon || '👍'}}</text>
          <text class="banner-preview-text">{{form.text || '横幅文字预览效果'}}</text>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">详情标题（可选）</view>
        <input class="form-input" value="{{form.detailTitle}}" maxlength="60" placeholder="详情页大标题" data-field="detailTitle" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <view class="form-label">详情内容（换行分段）</view>
        <textarea class="form-textarea" value="{{form.detailContent}}" maxlength="5000" placeholder="向用户解释横幅内容的详细文字..." data-field="detailContent" bindinput="onFieldInput" auto-height></textarea>
      </view>

      <view class="form-item">
        <view class="form-label">图片（最多9张，点击可预览）</view>
        <view class="img-grid">
          <view class="img-cell" wx:for="{{form.images}}" wx:key="*this">
            <image class="img-thumb" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewFormImage"></image>
            <view class="img-del" data-index="{{index}}" catchtap="onRemoveImage">×</view>
          </view>
          <view class="img-add" wx:if="{{form.images.length < 9}}" bindtap="onChooseImage">
            <text class="img-add-plus">+</text>
            <text class="img-add-text">上传</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <view class="form-label">跳转链接（可选；内部页面填 /pages/... 路径，外部链接将提供复制）</view>
        <input class="form-input" value="{{form.link}}" placeholder="https:// 或 /pages/xxx/index" data-field="link" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <view class="form-label">链接文字（可选）</view>
        <input class="form-input" value="{{form.linkText}}" maxlength="30" placeholder="例如：报名入口" data-field="linkText" bindinput="onFieldInput" />
      </view>

      <view class="form-item form-switch-row">
        <view class="form-label">发布横幅（关闭即对用户下线）</view>
        <switch checked="{{form.status}}" color="#3d7bfa" bindchange="onStatusChange" />
      </view>

      <view class="form-actions">
        <view class="btn btn-ghost" bindtap="onCancelEdit">取消</view>
        <view class="btn btn-primary {{saving ? 'btn-disabled' : ''}}" bindtap="onSave">{{saving ? '保存中...' : '保存并发布'}}</view>
      </view>
    </view>
  </block>
</view>

<color-picker show="{{colorPickerShow}}" value="{{colorPickerValue}}" title="{{colorPickerTitle}}" bind:close="onPageColorPickerClose" bind:confirm="onPageColorPickerConfirm" />
