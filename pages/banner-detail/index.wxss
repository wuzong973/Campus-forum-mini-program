.page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; background: #f5f7fa; }

.card { margin-bottom: 24rpx; padding: 30rpx; border-radius: 18rpx; background: #ffffff; box-shadow: 0 5rpx 16rpx rgba(33, 55, 88, .045); }

/* ===== 展示态 ===== */
/* 详情页顶部复刻横幅样式，保持视觉一致 */
.hero-banner { display: flex; align-items: center; margin-bottom: 24rpx; padding: 22rpx 26rpx; border-radius: 14rpx; background: linear-gradient(90deg, #3d7bfa 0%, #5b8cff 100%); box-shadow: 0 6rpx 16rpx rgba(61, 123, 250, .28); }
.hero-banner-icon { margin-right: 12rpx; color: var(--banner-fg, #ffffff); font-size: 32rpx; line-height: 1; }
.hero-banner-text { color: var(--banner-fg, #ffffff); font-size: 30rpx; font-weight: 600; line-height: 1.4; }

.offline-tip { margin-bottom: 20rpx; padding: 14rpx 20rpx; border: 1rpx dashed #ffb02e; border-radius: 12rpx; background: #fff7e8; color: #b26a00; font-size: 24rpx; line-height: 1.5; }

.hero-title { margin-bottom: 16rpx; color: #1f2329; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.hero-content { display: block; }
.hero-para { display: block; margin-bottom: 16rpx; color: #414652; font-size: 28rpx; line-height: 1.75; word-break: break-all; }

.hero-images { display: block; }
.hero-img { display: block; width: 100%; margin-bottom: 16rpx; border-radius: 12rpx; background: #f0f2f5; }

.hero-link { display: flex; align-items: center; margin-top: 8rpx; padding: 20rpx 24rpx; border-radius: 12rpx; background: #f5f8ff; }
.hero-link:active { opacity: .75; }
.hero-link-label { flex-shrink: 0; color: #3d7bfa; font-size: 27rpx; font-weight: 600; }
.hero-link-value { flex: 1; min-width: 0; margin: 0 16rpx; overflow: hidden; color: #7a8699; font-size: 24rpx; white-space: nowrap; text-overflow: ellipsis; }
.hero-link-action { flex-shrink: 0; color: #3d7bfa; font-size: 24rpx; }

.hero-empty { padding: 30rpx 0 10rpx; color: #98a2b3; font-size: 26rpx; text-align: center; }

/* 管理员编辑入口 */
.edit-entry { margin-top: 8rpx; padding: 24rpx; border-radius: 18rpx; background: #ffffff; color: #3d7bfa; font-size: 29rpx; font-weight: 600; text-align: center; box-shadow: 0 5rpx 16rpx rgba(33, 55, 88, .045); }
.edit-entry:active { opacity: .75; }

/* ===== 编辑态 ===== */
.form-title { margin-bottom: 26rpx; color: #1f2329; font-size: 32rpx; font-weight: 700; }
.form-item { margin-bottom: 26rpx; }
.form-label { margin-bottom: 12rpx; color: #667085; font-size: 25rpx; line-height: 1.5; }
.form-req { color: #ff5a5f; }
.form-input { height: 88rpx; padding: 0 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; color: #1f2329; font-size: 27rpx; line-height: 88rpx; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 220rpx; padding: 18rpx 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; color: #1f2329; font-size: 27rpx; line-height: 1.6; box-sizing: border-box; }

.img-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-cell { position: relative; width: 150rpx; height: 150rpx; }
.img-thumb { width: 100%; height: 100%; border-radius: 12rpx; background: #f0f2f5; }
.img-del { position: absolute; top: -12rpx; right: -12rpx; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(0, 0, 0, .55); color: #ffffff; font-size: 28rpx; line-height: 1; }
.img-add { display: flex; width: 150rpx; height: 150rpx; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #b9c6dd; border-radius: 12rpx; background: #f8fafc; }
.img-add:active { background: #eef2f9; }
.img-add-plus { color: #98a2b3; font-size: 52rpx; line-height: 1.1; }
.img-add-text { color: #98a2b3; font-size: 22rpx; }

.form-switch-row { display: flex; align-items: center; justify-content: space-between; }
.form-switch-row .form-label { margin-bottom: 0; }

.form-actions { display: flex; gap: 20rpx; margin-top: 10rpx; }
.btn { flex: 1; padding: 22rpx 0; border-radius: 14rpx; font-size: 29rpx; font-weight: 600; text-align: center; }
.btn:active { opacity: .8; }
.btn-ghost { border: 1rpx solid #d7dee9; background: #ffffff; color: #5b6472; }
.btn-primary { background: linear-gradient(90deg, #3d7bfa 0%, #5b8cff 100%); color: #ffffff; box-shadow: 0 6rpx 16rpx rgba(61, 123, 250, .28); }
.btn-disabled { opacity: .6; }

/* ===== 横幅自定义颜色：颜色字段 + 实时预览 ===== */
.color-field { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 14rpx 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; box-sizing: border-box; }
.color-swatch { flex-shrink: 0; width: 44rpx; height: 44rpx; border: 1rpx solid rgba(0, 0, 0, .08); border-radius: 8rpx; }
.color-value { flex: 1; min-width: 0; overflow: hidden; color: #1f2329; font-size: 25rpx; white-space: nowrap; text-overflow: ellipsis; }
.color-action { flex-shrink: 0; color: #98a2b3; font-size: 24rpx; }
.banner-preview { display: flex; align-items: center; gap: 12rpx; min-height: 80rpx; padding: 0 26rpx; border-radius: 14rpx; box-shadow: 0 6rpx 16rpx rgba(61, 123, 250, .28); box-sizing: border-box; }
.banner-preview-icon { flex-shrink: 0; font-size: 32rpx; line-height: 1; }
.banner-preview-text { flex: 1; min-width: 0; overflow: hidden; font-size: 30rpx; font-weight: 600; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
