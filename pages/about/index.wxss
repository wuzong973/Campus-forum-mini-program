.page { min-height: 100vh; padding: 92rpx 48rpx 60rpx; background: #f5f7fb; text-align: center; }.brand-mark { display: flex; width: 128rpx; height: 128rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 30rpx; background: #e8f0ff; }.brand-mark image { width: 86rpx; height: 86rpx; }.brand-name, .brand-subtitle, .about-title, .about-text, .version { display: block; }.brand-name { margin-top: 24rpx; color: #16213a; font-size: 40rpx; font-weight: 700; }.brand-subtitle { margin-top: 8rpx; color: #8190a5; font-size: 25rpx; }.about-card { margin-top: 60rpx; padding: 30rpx; border-radius: 18rpx; background: #ffffff; text-align: left; box-shadow: 0 8rpx 22rpx rgba(31, 52, 92, .06); }.about-title { color: #202a3c; font-size: 30rpx; font-weight: 700; }.about-text { margin-top: 16rpx; color: #6d7a8f; font-size: 25rpx; line-height: 1.7; }.version { margin-top: 38rpx; color: #abb3c0; font-size: 22rpx; }
