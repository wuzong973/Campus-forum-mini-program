<view class="page">
  <view class="search-hero" wx:if="{{!searched}}">
    <image class="search-mark" src="/assets/icons/校园图标.jpg" mode="aspectFill"></image>
  </view>

  <view class="search-box">
    <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit"></image>
    <input class="search-input" placeholder="搜索社区内容" value="{{keyword}}" bindinput="onInput" confirm-type="search" bindconfirm="onSearch"></input>
    <text class="clear-btn" wx:if="{{keyword}}" catchtap="onClear">×</text>
    <view class="search-btn" catchtap="onSearch">搜索</view>
  </view>

  <view class="today-hot" wx:if="{{!searched}}">
    <view class="today-hot-heading"><text class="today-hot-title">今日热榜</text><text class="today-hot-note">每日更新 · 大家都在搜</text></view>
    <view class="today-hot-list" wx:if="{{hotPosts.length}}">
      <view class="today-hot-item" wx:for="{{hotPosts}}" wx:key="id" data-id="{{item.id}}" catchtap="onHotPostTap"><text class="today-hot-rank {{index < 3 ? 'top top-' + index : ''}}">{{index + 1}}</text><text class="today-hot-text">{{item.hotText}}</text></view>
    </view>
    <view class="today-hot-empty" wx:elif="{{hotLoading}}">热榜更新中...</view>
    <view class="today-hot-empty" wx:else>今日暂无热榜内容</view>
  </view>

  <view class="search-results" wx:if="{{searched}}">
    <view class="result-state" wx:if="{{loading}}">搜索中...</view>
    <block wx:for="{{results}}" wx:key="id"><post-card post="{{item}}" /></block>
    <empty-state wx:if="{{!loading && results.length === 0}}" text="未找到相关内容" />
  </view>
</view>
