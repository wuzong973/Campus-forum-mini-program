.page {
  min-height: 100vh;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  background: #F5F7FA;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #969799;
}

.search-btn {
  color: #4A7AFF;
  font-size: 28rpx;
  white-space: nowrap;
}
