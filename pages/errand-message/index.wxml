<view class="page">
  <!-- 跑腿聊天会话列表（与私信消息列表独立） -->
  <view class="chat-list" wx:if="{{chats.length}}">
    <view
      class="chat-item anim-stagger spring-btn"
      style="--i: {{index < 6 ? index : 0}};"
      wx:for="{{chats}}"
      wx:key="orderId"
      hover-class="chat-item-hover press-spring"
      hover-stay-time="80"
      data-id="{{item.orderId}}"
      bindtap="openChat"
    >
      <view class="avatar-wrap">
        <image class="avatar" src="{{item.peerAvatar}}" mode="aspectFill"></image>
        <view class="unread-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
      </view>
      <view class="chat-main">
        <view class="chat-row-top">
          <text class="peer-name">{{item.peerName}}</text>
          <text class="chat-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
        </view>
        <view class="chat-row-middle">
          <text class="last-msg">{{item.lastText}}</text>
          <text class="reward">悬赏 ¥{{item.rewardText}}</text>
        </view>
        <view class="chat-row-bottom">
          <text class="order-tag {{item.roleLabel === '我发布的' ? 'pub' : 'acc'}}">{{item.roleLabel}}</text>
          <text class="order-desc">{{item.orderDesc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:if="{{!loading && !chats.length}}">
    <empty-state text="暂无跑腿聊天，接单后即可与对方沟通" icon=""></empty-state>
    <view class="empty-btn" bindtap="goHall">去接单大厅看看</view>
  </view>
</view>
