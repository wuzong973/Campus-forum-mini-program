.map-page,.map{width:100vw;height:100vh;overflow:hidden}.map-page{position:relative;background:#eaf1f7}.map{position:absolute;inset:0}.topbar{position:absolute;left:0;right:0;top:0;height:calc(92rpx + env(safe-area-inset-top));display:flex;align-items:center;padding-left:22rpx;padding-right:22rpx;background:rgba(255,255,255,.94);box-shadow:0 2rpx 12rpx rgba(24,39,75,.08);z-index:3}.top-spacer{width:132rpx}.campus-trigger{flex:1;display:flex;justify-content:center;align-items:center;gap:10rpx;font-size:34rpx;font-weight:700;color:#1f2a44}.chevron{font-size:26rpx;color:#7c8798}.map-actions{position:absolute;right:24rpx;top:calc(150rpx + env(safe-area-inset-top));width:128rpx;border-radius:10rpx;background:rgba(255,255,255,.96);overflow:hidden;box-shadow:0 10rpx 30rpx rgba(27,51,92,.18);z-index:2}.map-action{min-height:96rpx;padding:13rpx 8rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5rpx;color:#315cff;font-size:20rpx;line-height:1.15;text-align:center}.map-action:active{background:#eff4ff}.toggle-action{color:#536078}.action-icon{font-size:30rpx;font-weight:700;line-height:1}.toggle-action .switch{width:52rpx;height:30rpx;border-radius:20rpx;background:#dce2ec;padding:3rpx;transition:all .2s}.switch.on{background:#315cff}.switch-thumb{width:24rpx;height:24rpx;background:#fff;border-radius:50%;box-shadow:0 1rpx 4rpx rgba(0,0,0,.18);transition:transform .2s}.switch.on .switch-thumb{transform:translateX(22rpx)}.divider{height:1rpx;background:#edf0f4;margin:0 14rpx}.map-action.compact{min-height:72rpx;padding:0}.zoom-icon,.locate-icon{font-size:44rpx;font-weight:300;line-height:1}.locate-icon{font-size:36rpx}.place-card{position:absolute;left:24rpx;right:24rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));min-height:136rpx;padding:24rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;border-radius:10rpx;background:rgba(255,255,255,.97);box-shadow:0 12rpx 34rpx rgba(27,51,92,.2);z-index:2}.place-copy{display:flex;min-width:0;flex-direction:column;gap:5rpx}.place-name{font-size:31rpx;font-weight:700;color:#1f2a44}.place-detail,.place-campus{font-size:22rpx;color:#7a8595;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.route-btn{width:100rpx;height:64rpx;line-height:64rpx;flex-shrink:0;text-align:center;border-radius:8rpx;background:#12b876;color:#fff;font-size:26rpx;font-weight:700}.route-btn:active{background:#0e9c65}.picker-mask{position:fixed;inset:0;background:rgba(10,22,42,.32);z-index:9}.campus-sheet{position:fixed;left:0;right:0;bottom:0;z-index:10;padding:18rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));background:#fff;border-radius:18rpx 18rpx 0 0;transform:translateY(105%);transition:transform .24s ease}.campus-sheet.show{transform:translateY(0)}.sheet-handle{width:70rpx;height:8rpx;border-radius:4rpx;background:#d8dee8;margin:0 auto 24rpx}.sheet-title{display:block;font-size:34rpx;font-weight:700;color:#1f2a44;margin-bottom:12rpx}.campus-option{display:flex;align-items:center;justify-content:space-between;padding:26rpx 8rpx;border-bottom:1rpx solid #edf0f4}.campus-option.selected{background:#f1f5ff}.option-name,.option-address{display:block}.option-name{font-size:29rpx;font-weight:600;color:#293448}.option-address{font-size:23rpx;color:#8a94a5;margin-top:6rpx}.check{font-size:35rpx;color:#315cff;font-weight:700;padding-right:12rpx}
