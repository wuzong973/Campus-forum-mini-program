.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
  background: #f4f6fa;
}

/* ===== 顶部 hero ===== */
.hero {
  padding: 26rpx 24rpx 10rpx;
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 30rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 42, 68, 0.06);
}

.hero-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-icon-char {
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.3;
}

.hero-slogan {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7a8494;
  line-height: 1.5;
}

.hero-chip {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* ===== 内容分区 ===== */
.section {
  margin: 22rpx 24rpx 0;
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 30rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 68, 0.05);
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.section-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
}

.section-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #a6adba;
}

.section-text {
  display: block;
  font-size: 27rpx;
  color: #4a5468;
  line-height: 1.75;
  text-align: justify;
}

/* ===== 涵盖范围标签 ===== */
.chip-wrap {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* ===== 特色说明 ===== */
.feature {
  display: flex;
  gap: 18rpx;
  padding: 16rpx 0;
}

.feature + .feature {
  border-top: 1rpx solid #f5f6f8;
}

.feature-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.feature-body {
  flex: 1;
  min-width: 0;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2a3450;
  line-height: 1.5;
}

.feature-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 25rpx;
  color: #6b7486;
  line-height: 1.7;
}

/* ===== 代表社团 ===== */
.club-item + .club-item {
  margin-top: 16rpx;
}

.club-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid #f0f2f6;
  transition: background 0.16s ease;
}

.club-row--hover {
  background: #f1f4f9;
}

.club-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.club-brief {
  flex: 1;
  min-width: 0;
}

.club-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2a44;
  line-height: 1.4;
}

.club-tags {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #9aa3b2;
  line-height: 1.5;
}

.club-toggle {
  font-size: 34rpx;
  color: #c0c7d2;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.24s var(--ease-standard);
  flex-shrink: 0;
}

.club-toggle.open {
  transform: rotate(90deg);
}

.club-detail {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.28s var(--ease-standard), opacity 0.24s ease;
}

.club-detail.show {
  max-height: 560rpx;
  opacity: 1;
}

.club-detail-inner {
  padding: 20rpx 22rpx 8rpx;
}

.club-intro {
  display: block;
  font-size: 25rpx;
  color: #4a5468;
  line-height: 1.75;
  text-align: justify;
}

.club-recruit {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
}

.club-recruit-label {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
}

.club-recruit-text {
  font-size: 23rpx;
  color: #4a5468;
  line-height: 1.5;
}

/* ===== 底部加入卡片 ===== */
.join-card {
  margin: 24rpx 24rpx 0;
  border-radius: 30rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.join-text {
  flex: 1;
  min-width: 0;
}

.join-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2a44;
}

.join-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7a8494;
  line-height: 1.5;
}

.join-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

.join-btn::after {
  border: none;
}
