.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
  background: #f4f6fa;
}

/* ===== 顶部 hero ===== */
.hero {
  padding: 26rpx 24rpx 6rpx;
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 30rpx;
  padding: 26rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 42, 68, 0.06);
}

.hero-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 申请页上传的社团头像：有头像用图，没有则回退首字符徽标 */
.hero-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  background: #f0f2f6;
}

.hero-icon-char {
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.3;
}

.hero-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-cat {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

.hero-campus {
  font-size: 22rpx;
  color: #8b93a3;
  line-height: 1.5;
}

/* ===== 标签 ===== */
.chip-wrap {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
}

/* ===== 内容分区 ===== */
.section {
  margin: 22rpx 24rpx 0;
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 30rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 68, 0.05);
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.section-bar {
  width: 8rpx;
  height: 30rpx;
  border-radius: 999rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
}

.section-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #a6adba;
  padding: 6rpx 10rpx;
}

.section-text {
  display: block;
  font-size: 27rpx;
  color: #4a5468;
  line-height: 1.75;
  text-align: justify;
  /* 不设 max-height / overflow：简介上限 1000 字，截断后无从查看 */
}

/* ===== 二维码（负责人微信 / 社团二维码 / 公众号二维码）===== */
.qr-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.qr-img {
  width: 340rpx;
  border-radius: 18rpx;
  background: #f0f2f6;
}

.qr-img--hover {
  opacity: 0.88;
}

.qr-tip {
  font-size: 22rpx;
  color: #a6adba;
  line-height: 1.6;
  text-align: center;
}

.qr-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.qr-cell {
  flex: 1;
  min-width: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #f0f2f6;
}

.qr-img--cell {
  width: 220rpx;
}

.qr-cell-label {
  font-size: 23rpx;
  color: #6b7486;
  font-weight: 600;
  line-height: 1.5;
}

/* ===== 图片介绍 ===== */
.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.gallery-item {
  width: 212rpx;
  height: 212rpx;
  border-radius: 16rpx;
  background: #f0f2f6;
}

/* ===== 招新信息 ===== */
.recruit {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
}

.recruit-label {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  margin-top: 2rpx;
}

.recruit-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #4a5468;
  line-height: 1.6;
}

/* ===== 创建信息 ===== */
.info-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 14rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #f5f6f8;
}

.info-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #8b93a3;
  line-height: 1.6;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #2a3450;
  font-weight: 600;
  line-height: 1.6;
  word-break: break-all;
}

/* ===== 成员列表 ===== */
.member {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
}

.member + .member {
  border-top: 1rpx solid #f5f6f8;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #f0f2f6;
}

.member-avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2a44;
  line-height: 1.4;
}

.member-role {
  display: block;
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* ===== 近期活动 ===== */
.act {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid #f0f2f6;
  transition: background 0.16s ease, transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.act + .act {
  margin-top: 14rpx;
}

.act--hover {
  background: #f1f4f9;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.act-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #eef1f6;
}

.act-cover--text {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.act-info {
  flex: 1;
  min-width: 0;
}

.act-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2a44;
  line-height: 1.4;
}

.act-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8b93a3;
  line-height: 1.5;
}

.act-signup {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a6adba;
  line-height: 1.5;
}

.act-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #c0c7d2;
  line-height: 1;
}

/* ===== 空态提示 ===== */
.tip {
  padding: 20rpx 0 8rpx;
  font-size: 25rpx;
  color: #a6adba;
  text-align: center;
}

.foot-note {
  margin: 28rpx 24rpx 0;
  font-size: 21rpx;
  color: #b3b9c5;
  text-align: center;
  line-height: 1.6;
}

/* ===== 整页空态（社团不存在 / 加载失败）===== */
.empty {
  padding: 180rpx 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #eef1f6;
  color: #aab2c0;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #8b93a3;
  line-height: 1.7;
  text-align: center;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 0 56rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #4a7aff;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* ===== 加载骨架 ===== */
.sk {
  background: linear-gradient(90deg, #eef1f6 25%, #f6f8fb 37%, #eef1f6 63%);
  background-size: 800rpx 100%;
  animation: sk-shimmer 1.3s ease-in-out infinite;
  border-radius: 12rpx;
}

@keyframes sk-shimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

.sk-badge {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.sk-line {
  height: 26rpx;
  margin-top: 14rpx;
}

.sk-line-lg {
  height: 40rpx;
  width: 60%;
  margin-top: 0;
}

.sk-line-sm {
  width: 40%;
}

.sk-line-title {
  height: 32rpx;
  width: 30%;
  margin-top: 0;
  margin-bottom: 10rpx;
}
