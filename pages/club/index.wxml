<view class="page page-enter">
  <view class="hero">
    <view class="campus-bar" hover-class="campus-bar--hover" hover-stay-time="80" bindtap="onToggleCampus">
      <text class="campus-bar-label">校区</text>
      <text class="campus-bar-value">{{campus}}</text>
      <text class="campus-bar-arrow">{{showCampusPanel ? '▴' : '▾'}}</text>
    </view>
    <view class="hero-copy">
      <view class="hero-title">{{pageTitle}}</view>
      <view class="hero-sub">六大类别 · 总有一群人和你有一样的热爱</view>
    </view>
    <view class="hero-stats glass-panel">
      <view class="stat">
        <text class="stat-num">{{stats.categoryCount}}</text>
        <text class="stat-label">大分类</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat">
        <text class="stat-num">{{stats.clubCount}}+</text>
        <text class="stat-label">重点社团</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat">
        <text class="stat-num">{{stats.scopeCount}}+</text>
        <text class="stat-label">兴趣方向</text>
      </view>
    </view>
  </view>

  <view class="club-grid">
    <view
      class="club-card anim-stagger"
      style="--i:{{index}}"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
      hover-class="club-card--hover"
      hover-stay-time="120"
    >
      <view class="club-icon" style="background:{{item.theme.gradient}};box-shadow:0 12rpx 24rpx {{item.theme.shadow}};">
        <text class="club-icon-char">{{item.char}}</text>
      </view>
      <view class="club-name">{{item.name}}</view>
      <view class="club-desc ellipsis">{{item.slogan}}</view>
      <view class="club-foot">
        <text class="club-count" style="color:{{item.theme.deep}}">{{item.clubs.length}} 个重点社团</text>
        <text class="club-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="page-foot">社团信息持续更新 · 招新季请留意最新动态</view>
</view>

<!-- 校区选择弹层（fixed 元素放在带动画容器外） -->
<view wx:if="{{showCampusPanel}}" class="campus-mask" bindtap="onCloseCampus">
  <view class="campus-panel" catchtap="noop">
    <view class="campus-panel-title">校区选择</view>
    <view class="campus-grid">
      <view
        wx:for="{{campusOptions}}"
        wx:key="*this"
        class="campus-option {{campus === item ? 'campus-option--active' : ''}}"
        data-value="{{item}}"
        bindtap="onSelectCampus"
      >{{item}}</view>
    </view>
    <view class="campus-panel-tip">切换后将展示该校区下的社团</view>
  </view>
</view>
