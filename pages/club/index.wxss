.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.26) 0%, rgba(137, 202, 255, 0) 46%),
    linear-gradient(180deg, #dcf0ff 0%, #edf6fd 18%, #f4f6fa 52%, #f4f6fa 100%);
}

/* ===== 头部 ===== */
.hero {
  padding: 12rpx 6rpx 26rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a8494;
}

.hero-stats {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  border-radius: 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #8b93a3;
}

.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(31, 42, 68, 0.08);
}

/* ===== 分类卡片网格（参照设计稿：两列白卡 + 彩色字符图标） ===== */
.club-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.club-card {
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 30rpx;
  padding: 26rpx 24rpx 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 68, 0.05);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  will-change: transform;
}

.club-card--hover {
  transform: translateY(-6rpx);
  box-shadow: 0 20rpx 40rpx rgba(31, 42, 68, 0.12);
}

.club-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.club-icon-char {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.club-name {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a44;
  line-height: 1.35;
}

.club-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa3b2;
  line-height: 1.5;
}

.club-foot {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eef0f4;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.club-count {
  font-size: 22rpx;
  font-weight: 600;
}

.club-arrow {
  font-size: 30rpx;
  color: #c0c7d2;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 页脚 ===== */
.page-foot {
  margin-top: 34rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a6adba;
}

/* ===== 校区选择器（参照设计稿：2×2 选项，选中蓝色高亮） ===== */
.campus-bar {
  margin-bottom: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(31, 42, 68, 0.06);
}

.campus-bar--hover {
  background: #f0f6fd;
}

.campus-bar-label {
  font-size: 24rpx;
  color: #9aa3b2;
}

.campus-bar-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2a44;
}

.campus-bar-arrow {
  font-size: 22rpx;
  color: #9aa3b2;
}

.campus-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}

.campus-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 30rpx 26rpx;
}

.campus-panel-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
}

.campus-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.campus-option {
  height: 88rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  border: 3rpx solid transparent;
  color: #4a5468;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.campus-option--active {
  background: #eef4ff;
  border-color: #2e6bff;
  color: #2e6bff;
}

.campus-panel-tip {
  margin-top: 22rpx;
  font-size: 23rpx;
  color: #9aa3b2;
  text-align: center;
}
