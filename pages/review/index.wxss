.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.content {
  padding: 40rpx 32rpx 60rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.3;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #969799;
}

/* 校区选择触发条（与社团/群聊页同款：校区 xxx ▾ 胶囊，点开二级面板） */
.campus-bar {
  margin-top: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  transition: background 0.16s ease, transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.campus-bar--hover {
  background: #f7f9fc;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.campus-bar-label {
  font-size: 24rpx;
  color: #9aa3b2;
}

.campus-bar-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2a44;
}

.campus-bar-arrow {
  font-size: 22rpx;
  color: #9aa3b2;
}

/* 分类卡片：两列网格 */
.cate-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.cate-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 86, 0.06);
  transition: transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.cate-card--hover {
  transform: scale(0.96);
 box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.cate-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.cate-icon--course {
  background: #e8f7ee;
}

.cate-icon--canteen {
  background: #fff4e0;
}

.cate-icon--business {
  background: #eef3ff;
}

.cate-name {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.cate-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #969799;
}
