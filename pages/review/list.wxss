.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.content {
  padding: 24rpx 24rpx 160rpx;
}

/* 学历层次切换（仅课程） */
.level-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.level-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #ebedf0;
  font-size: 24rpx;
  color: #646566;
}

.level-chip--active {
  background: #1f2329;
  border-color: #1f2329;
  color: #ffffff;
  font-weight: 600;
}

/* 搜索 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(28, 43, 86, 0.04);
}

.search-icon {
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2329;
}

.search-placeholder {
  color: #c8c9cc;
}

/* 子级页顶部父条目条：当前食堂/商圈 + 进入其详情的入口 */
/* 子级页顶部：当前所在食堂/商圈名称（容器本身不可评分，仅作层级标识，不可点击） */
.parent-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  box-shadow: 0 4rpx 14rpx rgba(28, 43, 86, 0.04);
}

.parent-bar-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

/* 次导航 */
.tab-scroll {
  margin-top: 22rpx;
  white-space: nowrap;
}

.tab-bar {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx;
}

.tab-chip {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #ebedf0;
  font-size: 26rpx;
  color: #646566;
  transition: all 0.16s ease;
}

.tab-chip--active {
  background: #eef3ff;
  border-color: #9db8ff;
  color: #315cff;
  font-weight: 600;
}

/* 排序 */
.sort-bar {
  display: inline-flex;
  gap: 24rpx;
  margin-top: 22rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

.sort-chip {
  font-size: 24rpx;
  color: #969799;
}

.sort-chip--active {
  color: #1f2329;
  font-weight: 600;
}

/* 评分对象卡片 */
.target-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.target-card {
  display: flex;
  gap: 22rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(28, 43, 86, 0.05);
  transition: transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.target-card--hover {
  transform: scale(0.96);
 box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.target-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.target-avatar--char {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.target-main {
  flex: 1;
  min-width: 0;
}

.target-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.target-quote {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4a90d9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.target-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #969799;
}

.target-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
}

.score-badge {
  background: #fff7e0;
  color: #d9a400;
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.target-counts {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.count-item {
  font-size: 22rpx;
  color: #969799;
}

.empty-tip {
  padding: 80rpx 0;
  text-align: center;
  color: #969799;
  font-size: 26rpx;
}

/* 随机抽取按钮 */
.random-btn {
  margin: 40rpx auto 0;
  width: 70%;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #ebedf0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  box-shadow: 0 10rpx 26rpx rgba(28, 43, 86, 0.08);
  transition: transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.random-btn--hover {
  transform: scale(0.96);
 box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

/* 发布入口（蓝色渐变圆 + 白色斜铅笔，与图一一致） */
.publish-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #6da4ff 0%, #4385ff 55%, #2f6bff 100%);
  box-shadow: 0 14rpx 32rpx rgba(49, 92, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  transition: transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.publish-fab--hover {
  transform: scale(0.96);
 box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.publish-pencil {
  position: relative;
  width: 10rpx;
  height: 36rpx;
  background: #ffffff;
  border-radius: 5rpx;
  transform: rotate(-45deg);
}

.publish-pencil::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-bottom: 10rpx solid #ffffff;
}

/* ===== 抽取今日美食筛选弹层 ===== */
.random-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.random-sheet {
  width: 640rpx;
  padding: 36rpx 36rpx 44rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 80rpx rgba(20, 30, 60, 0.24);
}

.random-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.random-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2a44;
}

.random-close {
  padding: 8rpx 12rpx;
  font-size: 34rpx;
  color: #98a2b3;
}

.random-block {
  position: relative;
  margin-top: 34rpx;
}

.random-label {
  font-size: 30rpx;
  color: #3a4356;
}

.random-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #f2f3f7;
}

.random-select-value {
  font-size: 28rpx;
  color: #1f2a44;
}

.random-select-arrow {
  font-size: 24rpx;
  color: #98a2b3;
}

.random-options {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 8rpx);
  z-index: 5;
  max-height: 480rpx;
  overflow-y: auto;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(20, 30, 60, 0.16);
}

.random-option {
  padding: 26rpx 24rpx;
  font-size: 28rpx;
  color: #1f2a44;
  border-bottom: 1rpx solid #f5f6f8;
}

.random-option:last-child {
  border-bottom: none;
}

.random-option--active {
  color: #315cff;
}

.random-rating-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
}

.random-rating-prefix {
  font-size: 28rpx;
  color: #3a4356;
}

.random-chip-select {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #fff3e0;
}

.random-chip-value {
  font-size: 27rpx;
  font-weight: 600;
  color: #e8a23d;
}

.random-chip-select .random-select-arrow {
  color: #e8a23d;
}

.random-draw-btn {
  margin-top: 44rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  border: 2rpx solid #e3e7ee;
  background: #f5f6f8;
  color: #1f2a44;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(30, 40, 70, 0.08), inset 0 -4rpx 0 rgba(30, 40, 70, 0.06);
}

.random-draw-btn:active {
  opacity: 0.85;
}

.random-draw-btn--busy {
  color: #98a2b3;
}
