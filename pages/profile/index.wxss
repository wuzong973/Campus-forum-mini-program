.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 32rpx;
}

.hero {
  position: relative;
  height: 392rpx;
  overflow: hidden;
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(90, 86, 178, 0.18) 0%, rgba(103, 92, 186, 0.42) 100%);
}

.nav-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: #fff;
}

/* 返回按钮使用全局 .back-pill 样式（app.wxss） */
.nav-placeholder {
  width: 132rpx;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
}

/* 三个点固定在封面右下角（底部被资料面板上移遮挡 76rpx，故留出间距） */
.hero-more {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  bottom: 96rpx;
  color: #fff;
  font-size: 28rpx;
  text-align: right;
  letter-spacing: 0;
}

.hero-service {
  position: absolute;
  z-index: 2;
  top: 116rpx;
  left: 50%;
  transform: translateX(-50%);
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.profile-panel {
  position: relative;
  z-index: 3;
  margin: -76rpx 0 20rpx;
  padding: 0 28rpx 24rpx;
  background: #ffffff;
}

.profile-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 128rpx;
}

.profile-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #edf1f7;
  flex-shrink: 0;
}

.profile-avatar-editable:active { opacity: .76; transform: scale(.97); }

.profile-info {
  min-width: 0;
  margin-top: 16rpx;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-verify {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff3cd;
  color: #a06a00;
  font-size: 20rpx;
  font-weight: 600;
}

.profile-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.profile-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.signature-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-signature {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.about-link {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.message-btn {
  height: 64rpx;
  min-width: 160rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  margin: 0 0 0 24rpx;
  padding: 0 32rpx;
  background: #f7f4ff;
  color: #4d5b8c;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.message-btn-text {
  text-align: center;
}

.message-btn::after {
  border: none;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f1f5;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.content-section {
  padding-top: 0;
}

.profile-tabbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 84rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-top: 1rpx solid #f2f3f5;
  border-bottom: 1rpx solid #f2f3f5;
}

.profile-tab {
  position: relative;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.profile-tab.active {
  font-weight: 700;
}

/* 原每标签的 .profile-tab.active::after 静态下划线已移除：
   指示条换成 .liquid-indicator 滑动液态条（utils/liquid-tab.js），避免双重下划线 */

.profile-tab:not(.active) {
  color: var(--text-tertiary);
}

/* 加载失败态：profile 为空时整页原本会白屏，这里给出原因与重试入口 */
.load-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 60rpx 48rpx;
}

.load-state-text {
  margin-bottom: 32rpx;
  font-size: 28rpx;
  color: #8a94a6;
  text-align: center;
}

.load-state-btn {
  min-width: 240rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: #4a7aff;
  color: #ffffff;
  font-size: 28rpx;
}

.load-state-btn-hover {
  opacity: 0.86;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }
