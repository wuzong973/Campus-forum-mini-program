.page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 32rpx;
}

.hero {
  position: relative;
  height: 392rpx;
  overflow: hidden;
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(90, 86, 178, 0.18) 0%, rgba(103, 92, 186, 0.42) 100%);
}

.nav-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: #fff;
}

.nav-back,
.nav-more {
  width: 64rpx;
}

.nav-back {
  font-size: 44rpx;
  line-height: 1;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
}

.nav-more {
  font-size: 28rpx;
  text-align: right;
  letter-spacing: 0;
}

.hero-service {
  position: absolute;
  z-index: 2;
  top: 116rpx;
  left: 50%;
  transform: translateX(-50%);
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.profile-panel {
  position: relative;
  z-index: 3;
  margin: -76rpx 0 20rpx;
  padding: 0 28rpx 24rpx;
  background: #ffffff;
}

.profile-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 128rpx;
}

.profile-avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  background: #edf1f7;
  flex-shrink: 0;
}

.profile-info {
  min-width: 0;
  margin-top: 16rpx;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.profile-verify {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff3cd;
  color: #a06a00;
  font-size: 20rpx;
  font-weight: 600;
}

.profile-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.profile-meta {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.signature-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.profile-signature {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.about-link {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.profile-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-bottom: 12rpx;
}

.follow-btn,
.message-btn {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 0 28rpx;
}

.follow-btn {
  background: linear-gradient(135deg, #4A7AFF 0%, #5F8EFF 100%);
  color: #fff;
}

.follow-btn.followed {
  background: #eef2ff;
  color: var(--primary);
}

.message-btn {
  background: #f7f4ff;
  color: #4d5b8c;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.message-icon {
  width: 28rpx;
  height: 28rpx;
}

.follow-btn::after,
.message-btn::after {
  border: none;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f1f5;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.content-section {
  padding-top: 0;
}

.profile-tabbar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 84rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-top: 1rpx solid #f2f3f5;
  border-bottom: 1rpx solid #f2f3f5;
}

.profile-tab {
  position: relative;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.profile-tab.active {
  font-weight: 700;
}

.profile-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 44rpx;
  height: 8rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: var(--primary);
}

.profile-tab:not(.active) {
  color: var(--text-tertiary);
}
