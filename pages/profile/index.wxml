<view class="page" wx:if="{{profile}}">
  <view class="hero" style="padding-top: {{statusBarHeight}}px;">
    <image class="hero-cover" src="{{profile.coverUrl || '/assets/banners/profile-cover.jpg'}}" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    <view class="nav-bar" style="height: {{navBarHeight}}px;">
      <view class="back-pill" hover-class="back-pill-hover" hover-stay-time="80" bindtap="onBack"><text class="back-pill-icon">‹</text><text>返回</text></view>
      <text class="nav-title">校园主页</text>
      <view class="nav-placeholder"></view>
    </view>
    <view class="hero-more" wx:if="{{!isSelf}}" bindtap="onMoreTap">•••</view>
  </view>

  <view class="profile-panel">
    <view class="profile-main">
      <image class="profile-avatar {{isSelf ? 'profile-avatar-editable' : ''}}" src="{{profile.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" bindtap="onSelfAvatarTap"></image>
      <button class="message-btn" wx:if="{{!isSelf}}" bindtap="onSendMessage">
        <text class="message-btn-text">私信</text>
      </button>
    </view>

    <view class="profile-info">
      <view class="profile-name-row">
        <text class="profile-name">{{profile.nickName}}</text>
      </view>
      <view class="signature-row"><text class="profile-signature">{{profile.signature || '该用户还没有填写签名...'}}</text></view>
    </view>

    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{profile.likeReceived || 0}}</text>
        <text class="stat-label">获赞</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{profile.postCount || 0}}</text>
        <text class="stat-label">帖子</text>
      </view>
    </view>
  </view>

  <view class="content-section">
    <view class="profile-tabbar">
      <view
        class="profile-tab {{activeTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTab"
      >
        <text>{{item}}{{index === 0 ? ' ' + posts.length : ''}}</text>
      </view>
    </view>

    <view wx:if="{{activeTab === 0}}" wx:for="{{posts}}" wx:key="id">
      <post-card post="{{item}}" showFooter="{{false}}" />
    </view>

    <empty-state wx:if="{{!loading && activeTab === 0 && posts.length === 0}}" text="还没有发布帖子" />
    <empty-state wx:if="{{activeTab === 1}}" text="收藏内容暂未公开" />
  </view>
</view>
