<view class="page page-enter">
  <!-- 后台可编辑的自定义页面：标题 + 正文（标记语法）+ 图片，普通用户只读 -->
  <view class="card" wx:if="{{page && (blocks.length || page.images.length)}}">
    <view class="sec-title" wx:if="{{page.title}}">{{page.title}}</view>
    <richtext-content class="guide-rich" blocks="{{blocks}}" image-group="{{page.images}}"></richtext-content>
    <view class="image-list" wx:if="{{page.images.length}}">
      <image
        class="image"
        wx:for="{{page.images}}"
        wx:key="*this"
        src="{{item}}"
        mode="widthFix"
        lazy-load
        data-url="{{item}}"
        bindtap="onPreviewImage"
      ></image>
    </view>
    <!-- 正文下方的跳转按钮：链接与文字由后台「编辑学车指南」配置，留空则不显示 -->
    <page-link-button link="{{page.link}}" link-text="{{page.linkText}}"></page-link-button>
    <text class="updated" wx:if="{{page.updatedAtText}}">更新于 {{page.updatedAtText}}</text>
  </view>

  <view class="card" wx:elif="{{loaded}}">
    <view class="empty">
      <text class="empty-text">学车指南正在整理中，上线后会在这里展示学车流程、报名材料与避坑提示。</text>
    </view>
  </view>

  <text class="foot-note">本页面信息由平台整理发布，不涉及任何驾校招生、报价与收费。</text>
</view>
