/* 学车指南：后台可编辑的自定义页（与校园卡页同款排版） */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
  background: #f4f6fa;
}

.card {
  padding: 28rpx 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  box-shadow: 0 10rpx 26rpx rgba(31, 42, 68, 0.05);
}

.sec-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2a44;
  padding-left: 18rpx;
  border-left: 8rpx solid #315cff;
  line-height: 1.3;
}

.para {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #3a4356;
  line-height: 1.75;
  word-break: break-word;
}

.image-list {
  margin-top: 24rpx;
}

.image {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #f2f4f8;
}

.updated {
  display: block;
  margin-top: 24rpx;
  font-size: 21rpx;
  color: #b3bac7;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 8rpx 52rpx;
}

.empty-text {
  font-size: 25rpx;
  color: #8b93a3;
  line-height: 1.7;
  text-align: center;
}

.foot-note {
  display: block;
  margin: 28rpx 12rpx 0;
  font-size: 21rpx;
  color: #b3bac7;
  line-height: 1.6;
  text-align: center;
}
