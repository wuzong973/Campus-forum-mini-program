<view class="page">
  <view class="logo-area">
    <image class="logo" src="/assets/icons/校园图标.jpg" mode="aspectFit"></image>
  </view>

  <view class="welcome-area">
    <text class="welcome-line welcome-line-lead">你的广轻工同学都在这里：</text>
    <text class="welcome-line">专属广轻同学的朋友圈</text>
    <text class="welcome-line">一站式解决校园生活所有需求</text>
    <text class="welcome-line">遇见同校，解锁校园烟火</text>
    <text class="welcome-line">帕云校园陪伴你整个大学生活</text>
    <text class="welcome-line welcome-line-strong">探索帕云校园</text>
  </view>

  <view class="action-area">
    <button hover-class="press-spring"
      class="login-btn btn-primary {{agreementChecked ? '' : 'login-btn-disabled'}} spring-btn"
      open-type="{{agreementChecked ? 'getPhoneNumber' : ''}}"
      bindtap="onLoginTap"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{loading}}" hover-stay-time="120">手机号快捷登录</button>
    <view class="agreement-area">
      <view class="agreement-row" bindtap="toggleAgreement" role="checkbox" aria-checked="{{agreementChecked}}">
        <view class="agreement-checkbox {{agreementChecked ? 'checked' : ''}}">
          <text wx:if="{{agreementChecked}}">✓</text>
        </view>
        <text class="agreement-tip">我已阅读并同意</text>
        <text class="agreement-link" catchtap="goAgreement">《用户服务协议》</text>
        <text class="agreement-tip">和</text>
        <text class="agreement-link" catchtap="goPrivacy">《隐私政策》</text>
      </view>
    </view>
    <button hover-class="press-spring" class="cancel-btn spring-btn" bindtap="onCancel" hover-stay-time="120">返回首页</button>
  </view>
</view>
