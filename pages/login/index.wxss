.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: linear-gradient(180deg, #4A7AFF 0%, #F5F7FA 50%);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.login-btn {
  width: 80%;
  padding: 24rpx 0;
  font-size: 32rpx;
}

.agreement {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #969799;
}
