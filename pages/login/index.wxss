.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: linear-gradient(180deg, #4A7AFF 0%, #F5F7FA 50%);
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.slogan {
  font-size: 28rpx;
  color: #666;
}

.login-btn {
  width: 80%;
  padding: 24rpx 0;
  font-size: 32rpx;
}

.login-btn-disabled {
  opacity: 0.55;
}

/* 协议区域 */
.agreement-area {
  width: 80%;
  margin-top: 30rpx;
}

.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 40rpx;
}

.agreement-checkbox {
  width: 26rpx;
  height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #aeb7c5;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
}

.agreement-checkbox.checked {
  border-color: #4a7aff;
  background: #4a7aff;
}

.agreement-tip {
  font-size: 22rpx;
  color: #999;
}

.agreement-link {
  font-size: 22rpx;
  color: #4a7aff;
  text-decoration: underline;
}

/* 取消按钮 */
.cancel-btn {
  margin-top: 40rpx;
  width: 60%;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  background: transparent;
  border: 2rpx solid #ccc;
  border-radius: 40rpx;
}
