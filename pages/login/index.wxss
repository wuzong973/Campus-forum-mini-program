.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  background: #ffffff;
}

/* ===== 顶部 Logo ===== */
.logo-area {
  display: flex;
  justify-content: center;
  margin-top: 140rpx;
}

.logo {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 48rpx rgba(74, 122, 255, 0.14);
}

/* ===== 欢迎文案 ===== */
.welcome-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 90rpx;
}

.welcome-line {
  font-size: 32rpx;
  font-weight: 500;
  color: #4a7aff;
  line-height: 1;
  margin-bottom: 52rpx;
}

.welcome-line-lead {
  font-weight: 600;
}

.welcome-line-strong {
  font-weight: 700;
}

/* ===== 底部操作区 ===== */
.action-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
  padding-bottom: 60rpx;
}

.login-btn {
  width: 86%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  font-size: 32rpx;
  font-weight: 600;
}

.login-btn-disabled {
  opacity: 0.55;
}

/* 协议区域 */
.agreement-area {
  width: 86%;
  margin-top: 28rpx;
}

.agreement-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 40rpx;
}

.agreement-checkbox {
  width: 26rpx;
  height: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #aeb7c5;
  border-radius: 50%;
  color: #fff;
  font-size: 20rpx;
}

.agreement-checkbox.checked {
  border-color: #4a7aff;
  background: #4a7aff;
}

.agreement-tip {
  font-size: 22rpx;
  color: #999;
}

.agreement-link {
  font-size: 22rpx;
  color: #4a7aff;
  text-decoration: underline;
}

/* 取消按钮 */
.cancel-btn {
  margin-top: 36rpx;
  width: 86%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  font-size: 28rpx;
  color: #666;
  background: transparent;
  border: 2rpx solid #d9dfeb;
  border-radius: 44rpx;
}
