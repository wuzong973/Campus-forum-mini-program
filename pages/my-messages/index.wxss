.page {
  min-height: 100vh;
  padding: 24rpx;
}

.tabs {
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.tab {
  font-size: 28rpx;
  color: #969799;
  padding-bottom: 8rpx;
}

.tab.active {
  color: #4A7AFF;
  font-weight: 500;
  border-bottom: 4rpx solid #4A7AFF;
}

.read-all {
  margin-left: auto;
  font-size: 24rpx;
  color: #4A7AFF;
}

/* 私信会话列表 */
.conv-list {
  margin-top: 8rpx;
}

.conv-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.conv-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.conv-info {
  flex: 1;
  min-width: 0;
}

.conv-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.conv-nick {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.conv-time {
  font-size: 22rpx;
  color: #bbbbbb;
  flex-shrink: 0;
}

.conv-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conv-last {
  font-size: 26rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.conv-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  background: #FF4D4F;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  flex-shrink: 0;
}

.msg-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.msg-item.unread {
  background: #F0F5FF;
}

.msg-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 12rpx;
  height: 12rpx;
  background: #FF4D4F;
  border-radius: 50%;
  z-index: 1;
}

.msg-row {
  display: flex;
  align-items: flex-start;
}

.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.msg-main {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.msg-title {
  display: block;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.msg-time {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.msg-actor {
  display: block;
  font-size: 26rpx;
  color: #4A7AFF;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-content {
  display: block;
  color: #646566;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.msg-post {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  padding: 12rpx 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.msg-post-label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4A7AFF;
  background: #eaf1ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.msg-post-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #51606f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  text-align: center;
  padding: 80rpx;
}
