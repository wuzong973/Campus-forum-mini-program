.page {
  min-height: 100vh;
  padding: 24rpx;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
}

.tabs {
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.tab {
  position: relative;
  font-size: 28rpx;
  color: #969799;
  padding-bottom: 8rpx;
}

.tab.active {
  color: #4A7AFF;
  font-weight: 500;
  /* 原静态 border-bottom 下划线已移除：换成 .liquid-indicator 滑动液态条
     （utils/liquid-tab.js），避免双重下划线 */
}

/* tab 文字右上角的未读数字角标（样式对齐「我的-消息通知」feature-badge） */
.tab-badge {
  position: absolute;
  top: -14rpx;
  right: -30rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 2rpx solid #ffffff;
  border-radius: 18rpx;
  background: #ff5a5f;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
  box-sizing: border-box;
  pointer-events: none;
}

.read-all {
  margin-left: auto;
  font-size: 24rpx;
  color: #4A7AFF;
}

/* 私信会话列表 */
.conv-list {
  margin-top: 8rpx;
}

.conv-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.conv-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.conv-info {
  flex: 1;
  min-width: 0;
}

.conv-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.conv-nick {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.conv-time {
  font-size: 22rpx;
  color: #bbbbbb;
  flex-shrink: 0;
}

.conv-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.conv-last {
  font-size: 26rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.conv-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  background: #FF4D4F;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  text-align: center;
  flex-shrink: 0;
}

.msg-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.msg-item.unread {
  background: #F0F5FF;
}

.msg-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 12rpx;
  height: 12rpx;
  background: #FF4D4F;
  border-radius: 50%;
  z-index: 1;
}

.msg-row {
  display: flex;
  align-items: flex-start;
}

.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.msg-main {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.msg-title {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
  color: var(--text-primary);
}

.msg-action-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 2rpx 0 14rpx;
}

.msg-action,
.msg-action + .msg-time {
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--text-tertiary);
}

.msg-time {
  flex-shrink: 0;
}

.msg-content {
  display: block;
  margin: 0 0 8rpx;
  padding: 2rpx 0 2rpx 16rpx;
  border-left: 6rpx solid #FF4D4F;
}

.msg-content-text {
  display: block;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-all;
}

.msg-post {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  padding: 12rpx 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.msg-post-label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4A7AFF;
  background: #eaf1ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.msg-post-title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #51606f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  text-align: center;
  padding: 80rpx;
}

/* ===== 蹲贴标签页（我蹲的 / 蹲我的）===== */
.squat-wrap {
  margin-top: 8rpx;
}

.squat-tabs {
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.squat-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #51606f;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
}

.squat-tab.active {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #6a9bff 0%, #4a7aff 100%);
}

.squat-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.squat-item-hover {
  opacity: 0.86;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

/* 卡片不展示标题：作者（头像 + 昵称）在上，正文在下 */
.squat-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.squat-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.squat-author {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #333d4b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.squat-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #bbbbbb;
}

/* 正文最多两行，超出省略 */
.squat-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.55;
  word-break: break-all;
}

.squat-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.squat-count {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  color: #4a7aff;
  background: #eaf1ff;
  border-radius: 8rpx;
}

.squat-users {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 22rpx;
  color: #969799;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
