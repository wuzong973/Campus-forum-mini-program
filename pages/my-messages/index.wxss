.page {
  min-height: 100vh;
  padding: 24rpx;
}

.tabs {
  margin-bottom: 24rpx;
  gap: 24rpx;
}

.tab {
  font-size: 28rpx;
  color: #969799;
  padding-bottom: 8rpx;
}

.tab.active {
  color: #4A7AFF;
  font-weight: 500;
  border-bottom: 4rpx solid #4A7AFF;
}

.read-all {
  margin-left: auto;
  font-size: 24rpx;
  color: #4A7AFF;
}

.msg-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.msg-item.unread {
  background: #F0F5FF;
}

.msg-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 12rpx;
  height: 12rpx;
  background: #FF4D4F;
  border-radius: 50%;
}

.msg-title {
  display: block;
  margin-bottom: 8rpx;
}

.msg-content {
  display: block;
  color: #646566;
  margin-bottom: 8rpx;
}

.empty {
  text-align: center;
  padding: 80rpx;
}
