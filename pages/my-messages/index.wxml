<view class="page">
  <view class="tabs flex-row">
    <view
      class="tab {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="*this"
      data-tab="{{index}}"
      bindtap="onTab"
    >{{item}}</view>
    <view class="read-all" bindtap="onReadAll" wx:if="{{activeTab !== 0}}">全部已读</view>
  </view>

  <!-- 私信会话列表 -->
  <view class="conv-list" wx:if="{{activeTab === 0}}">
    <view
      class="conv-item card"
      wx:for="{{conversations}}"
      wx:key="peerId"
      data-peer="{{item.peerId}}"
      data-nick="{{item.peerNick}}"
      data-avatar="{{item.peerAvatar}}"
      data-anonymous="{{item.isAnonymous}}"
      bindtap="onOpenChat"
    >
      <image class="conv-avatar" src="{{item.peerAvatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      <view class="conv-info">
        <view class="conv-top">
          <text class="conv-nick text-h3">{{item.peerNick}}</text>
          <text class="conv-time text-caption">{{item.timeText}}</text>
        </view>
        <view class="conv-bottom">
          <text class="conv-last text-body">{{item.lastMessage || '暂无消息'}}</text>
          <view class="conv-badge" wx:if="{{item.unreadCount > 0}}">
            <text>{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty text-caption" wx:if="{{conversations.length === 0}}">
      <text>暂无私信，去论坛找好友聊聊吧~</text>
    </view>
  </view>

  <!-- 互动消息列表 -->
  <view class="msg-list" wx:if="{{activeTab !== 0}}">
    <view class="msg-item card {{item.read ? '' : 'unread'}}" wx:for="{{messages}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenNotification">
      <view class="msg-dot" wx:if="{{!item.read}}"></view>
      <view class="msg-row">
        <image wx:if="{{activeTab === 1 || activeTab === 2}}" class="msg-avatar" src="{{item.actorAvatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
        <view class="msg-main">
          <view class="msg-head">
            <text class="msg-title text-h3">{{item.title}}</text>
            <text class="msg-time text-caption">{{item.time}}</text>
          </view>
          <text class="msg-actor" wx:if="{{item.actorNick}}">{{item.actorNick}}</text>
          <text class="msg-content text-body" wx:if="{{item.content && item.content !== item.postTitle}}">{{item.content}}</text>
          <view class="msg-post" wx:if="{{item.postTitle}}">
            <text class="msg-post-label">帖子</text>
            <text class="msg-post-title">{{item.postTitle}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty text-caption" wx:if="{{messages.length === 0}}">暂无消息</view>
  </view>
</view>
