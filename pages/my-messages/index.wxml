<view class="page">
  <view class="tabs flex-row">
    <view
      class="tab {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="*this"
      data-tab="{{index}}"
      bindtap="onTab"
    >{{item}}</view>
    <view class="read-all" bindtap="onReadAll">全部已读</view>
  </view>
  <view class="msg-list">
    <view class="msg-item card {{item.read ? '' : 'unread'}}" wx:for="{{messages}}" wx:key="id">
      <view class="msg-dot" wx:if="{{!item.read}}"></view>
      <text class="msg-title text-h3">{{item.title}}</text>
      <text class="msg-content text-body">{{item.content}}</text>
      <text class="msg-time text-caption">{{item.time}}</text>
    </view>
    <view class="empty text-caption" wx:if="{{messages.length === 0}}">暂无消息</view>
  </view>
</view>
