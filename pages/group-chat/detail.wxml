<view class="page page-enter">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="back-pill spring-btn" hover-class="back-pill-hover press-spring" hover-stay-time="80" bindtap="goBack"><text class="back-pill-icon">‹</text><text>返回</text></view>
  </view>

  <view class="content" wx:if="{{group}}">
    <!-- 头部：头像 + 群名 + 类型/官方徽标 -->
    <view class="head-card">
      <image wx:if="{{group.avatarUrl}}" class="head-avatar" src="{{group.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="head-avatar head-avatar-fallback" style="background:{{group.fallbackBg}};">
        <text>{{group.firstChar}}</text>
      </view>
      <view class="head-info">
        <view class="head-name">{{group.name}}</view>
        <view class="head-badges">
          <text class="type-badge">微信群</text>
          <text wx:if="{{group.isOfficial}}" class="official-badge">官方</text>
          <text wx:if="{{group.customTag}}" class="custom-badge">{{group.customTag}}</text>
        </view>
        <!-- 群主与成员规模：后台手工维护，两者都没有时整行不出现 -->
        <view class="head-meta" wx:if="{{group.ownerName || group.memberCount}}">
          <text wx:if="{{group.ownerName}}">群主 {{group.ownerName}}</text>
          <text class="head-meta-dot" wx:if="{{group.ownerName && group.memberCount}}">·</text>
          <text wx:if="{{group.memberCount}}">群成员 {{group.memberCount}} 人</text>
        </view>
      </view>
    </view>

    <!-- 群公告：后台维护的进群须知，用浅黄底与正文区分 -->
    <view class="sec-card notice-card" wx:if="{{group.notice}}">
      <view class="sec-title">群公告</view>
      <richtext-content class="notice-text" content="{{group.notice}}" selectable></richtext-content>
    </view>

    <!-- 群管理：管理员微信二维码 -->
    <view class="sec-card" wx:if="{{adminQrcodeUrl || gzhQrcodeUrl}}">
      <view class="sec-title">群管理</view>
      <view class="admin-row spring-btn" hover-stay-time="80" hover-class="admin-row--hover press-spring" bindtap="onPreviewAdmin">
        <image class="admin-qr" src="{{adminQrcodeUrl}}" mode="aspectFill" />
        <view class="admin-info">
          <text class="admin-name">管理员微信</text>
          <text class="admin-tip">点击放大，添加管理员咨询进群</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="admin-row spring-btn" hover-stay-time="80" hover-class="admin-row--hover press-spring" bindtap="onPreviewGzh" wx:if="{{gzhQrcodeUrl}}">
        <image class="admin-qr" src="{{gzhQrcodeUrl}}" mode="aspectFill" />
        <view class="admin-info">
          <text class="admin-name">公众号二维码</text>
          <text class="admin-tip">点击放大，扫码关注公众号</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>

    <!-- 加入方式：群二维码大图 + 进群规则提示（方式与是否需审核由后台配置） -->
    <view class="sec-card" wx:if="{{group.qrcodeUrl || joinModeTip}}">
      <view class="sec-title">加入方式</view>
      <view class="qr-wrap spring-btn" wx:if="{{group.qrcodeUrl}}" hover-stay-time="80" hover-class="qr-wrap--hover press-spring" bindtap="onPreviewQr">
        <image class="qr-img" src="{{group.qrcodeUrl}}" mode="widthFix" />
      </view>
      <view class="qr-tip" wx:if="{{joinModeTip}}">{{joinModeTip}}</view>
    </view>

    <!-- 群介绍 -->
    <view class="sec-card" wx:if="{{group.intro || images.length}}">
      <view class="sec-title">群介绍</view>
      <text wx:if="{{group.intro}}" class="intro-text">{{group.intro}}</text>
      <scroll-view class="img-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" wx:if="{{images.length > 3}}">
        <image
          wx:for="{{images}}"
          wx:key="index"
          class="img-scroll-item"
          src="{{item}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          data-url="{{item}}"
          bindtap="onPreviewImage"
        />
      </scroll-view>
      <view class="img-grid" wx:if="{{images.length && images.length <= 3}}">
        <image
          wx:for="{{images}}"
          wx:key="index"
          class="img-item"
          src="{{item}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          data-url="{{item}}"
          bindtap="onPreviewImage"
        />
      </view>
    </view>
  </view>
</view>
