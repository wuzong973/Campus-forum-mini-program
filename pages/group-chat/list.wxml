<view class="page page-enter">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="back-pill" hover-class="back-pill-hover" hover-stay-time="80" bindtap="goBack"><text class="back-pill-icon">‹</text><text>返回</text></view>
  </view>

  <view class="content">
    <view class="page-title">{{categoryName}}</view>
    <view class="page-sub">查看该类别下的群聊列表</view>

    <view class="campus-bar" hover-class="campus-bar--hover" hover-stay-time="80" bindtap="onToggleCampus">
      <text class="campus-bar-label">校区</text>
      <text class="campus-bar-value">{{campus}}</text>
      <text class="campus-bar-arrow">{{showCampusPanel ? '▴' : '▾'}}</text>
    </view>

    <view class="empty" wx:if="{{loaded && !groups.length}}">
      <view class="empty-icon"><text class="empty-q">?</text></view>
      <text class="empty-text">该分类下暂无群聊</text>
    </view>

    <view class="group-panel" wx:if="{{groups.length}}">
      <view
        class="group-row"
        wx:for="{{groups}}"
        wx:key="id"
        hover-class="group-row--hover"
        hover-stay-time="80"
        data-id="{{item.id}}"
        bindtap="onGroupTap"
      >
        <image wx:if="{{item.avatarUrl}}" class="row-avatar" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        <view wx:else class="row-avatar row-avatar-fallback" style="background:{{item.fallbackBg}};">
          <text class="row-avatar-char">{{item.firstChar}}</text>
        </view>
        <view class="row-main">
          <view class="row-name-line">
            <text class="row-name">{{item.name}}</text>
            <text wx:if="{{item.isOfficial}}" class="official-badge">官方</text>
            <text wx:if="{{item.customTag}}" class="custom-badge">{{item.customTag}}</text>
          </view>
          <text class="row-intro">{{item.intro || '点击查看群二维码'}}</text>
        </view>
        <text class="row-arrow">›</text>
      </view>
    </view>
  </view>
</view>

<!-- 校区选择弹层（fixed 元素放在带动画容器外） -->
<campus-picker visible="{{showCampusPanel}}" value="{{campus}}" bind:change="onCampusChange" bind:close="onCloseCampus" />
