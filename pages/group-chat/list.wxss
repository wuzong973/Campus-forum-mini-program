.page {
  min-height: 100vh;
  background: #f2f3f5;
}

.topbar {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.content {
  padding: 24rpx 32rpx 60rpx;
}

.page-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.3;
}

.page-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7a8494;
}

/* ===== 校区选择器（参照设计稿：2×2 选项，选中蓝色高亮） ===== */
.campus-bar {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(31, 42, 68, 0.05);
}

.campus-bar--hover {
  background: #f7f9fc;
}

.campus-bar-label {
  font-size: 24rpx;
  color: #9aa3b2;
}

.campus-bar-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2a44;
}

.campus-bar-arrow {
  font-size: 22rpx;
  color: #9aa3b2;
}

.campus-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}

.campus-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 30rpx 26rpx;
}

.campus-panel-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
}

.campus-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.campus-option {
  height: 88rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  border: 3rpx solid transparent;
  color: #4a5468;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.campus-option--active {
  background: #eef4ff;
  border-color: #2e6bff;
  color: #2e6bff;
}

.campus-panel-tip {
  margin-top: 22rpx;
  font-size: 23rpx;
  color: #9aa3b2;
  text-align: center;
}

/* ===== 群聊列表面板（单张白卡 + 行分隔线，参照图三） ===== */
.group-panel {
  margin-top: 30rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 68, 0.05);
  overflow: hidden;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 26rpx;
  border-bottom: 1rpx solid #f2f3f6;
  transition: background 0.15s ease;
}

.group-row:last-child {
  border-bottom: none;
}

.group-row--hover {
  background: #f7f9fc;
}

.row-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #eef1f5;
  flex-shrink: 0;
}

.row-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-avatar-char {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.row-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a44;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.official-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  background: #1a1c20;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  line-height: 1.3;
}

.custom-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #2e6bff;
  background: rgba(46, 107, 255, 0.10);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  line-height: 1.3;
}

.row-intro {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9aa3b2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #c0c7d2;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 7rpx solid #d7dade;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-q {
  font-size: 60rpx;
  font-weight: 700;
  color: #c6cad1;
  line-height: 1;
  margin-top: -6rpx;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 28rpx;
  color: #9aa3b2;
}
