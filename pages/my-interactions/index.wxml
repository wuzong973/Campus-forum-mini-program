<view class="page">
  <view class="page-title">{{title}}</view>

  <block>
    <view wx:for="{{list}}" wx:key="id" class="feed-item anim-stagger" style="--i: {{index < 6 ? index : 0}};">
      <post-card post="{{item}}" />
    </view>
  </block>

  <empty-state wx:if="{{!loading && list.length === 0}}" text="{{emptyText}}" />
</view>
