.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
  padding: 24rpx 0 48rpx;
}

.page-title {
  margin: 0 24rpx 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2a44;
}

.user-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #eef2f8;
  flex-shrink: 0;
}

.user-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a44;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-meta {
  font-size: 24rpx;
  color: #8a94a6;
}

.arrow {
  color: #c8c9cc;
  font-size: 28rpx;
}
