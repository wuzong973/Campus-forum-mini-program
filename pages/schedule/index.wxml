<view class="page" style="background: {{bgColor}};">
  <!-- 导航栏 -->
  <view class="custom-nav white-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-left" bindtap="toggleDrawer">
        <image class="nav-icon-img" src="/assets/icons/menu.png" mode="aspectFit"></image>
      </view>
      <view class="nav-center">
        <view class="nav-btn-wrap" bindtap="goAdd">
          <image class="nav-icon-img" src="/assets/icons/plus.png" mode="aspectFit"></image>
        </view>
        <view class="nav-btn-wrap" bindtap="goOcr">
          <text class="nav-ai-text">AI</text>
        </view>
        <view class="nav-btn-wrap" bindtap="onRefresh">
          <image class="nav-icon-img refresh-icon" src="/assets/icons/refresh.png" mode="aspectFit"></image>
        </view>
        <text class="week-text">第{{currentWeek}}周</text>
      </view>
      <view class="nav-right"></view>
    </view>
  </view>
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 周次信息条 -->
  <view class="week-info-bar" wx:if="{{courses.length > 0}}">
    <view class="week-info-left">
      <text class="week-label">本周课表</text>
      <text class="week-date">{{currentWeekText}}</text>
    </view>
    <view class="week-info-right">
      <text class="course-count">共 {{courses.length}} 门</text>
    </view>
  </view>

  <!-- 周次导航栏 -->
  <view class="week-nav-bar" wx:if="{{courses.length > 0}}">
    <view class="week-nav-btn {{currentWeek <= 1 ? 'disabled' : ''}}" bindtap="onPrevWeek">
      <text class="week-nav-icon">‹</text>
      <text class="week-nav-text">上一周</text>
    </view>
    <view class="week-nav-center">
      <text class="week-nav-current">第 {{currentWeek}} 周</text>
      <text class="week-nav-total">/ {{totalWeeks}} 周</text>
    </view>
    <view class="week-nav-btn {{currentWeek >= totalWeeks ? 'disabled' : ''}}" bindtap="onNextWeek">
      <text class="week-nav-text">下一周</text>
      <text class="week-nav-icon">›</text>
    </view>
  </view>

  <!-- 学期课表按钮 -->
  <view class="semester-btn-wrap" wx:if="{{courses.length > 0}}">
    <view class="semester-btn" bindtap="toggleSemesterView">
      <text class="semester-btn-icon">📅</text>
      <text class="semester-btn-text">{{showSemesterView ? '返回周课表' : '本学期课表'}}</text>
    </view>
  </view>

  <!-- 学期课表视图 -->
  <view class="semester-view" wx:if="{{showSemesterView && courses.length > 0}}">
    <view class="semester-header">
      <text class="semester-title">本学期课表</text>
      <text class="semester-subtitle">点击周次查看详细课表</text>
    </view>
    <view class="semester-grid">
      <block wx:for="{{semesterWeeks}}" wx:for-item="sw" wx:key="week">
        <view
          class="semester-week-item {{sw.isCurrent ? 'current' : ''}} {{sw.isExpired ? 'expired' : ''}}"
          data-week="{{sw.week}}"
          bindtap="onSemesterWeekTap"
        >
          <text class="semester-week-num">第{{sw.week}}周</text>
          <text class="semester-week-date">{{sw.dateRange}}</text>
          <view class="semester-week-count {{sw.courseCount > 0 ? 'has-course' : ''}}">
            <text class="semester-count-num">{{sw.courseCount}}</text>
            <text class="semester-count-label">门课</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 过期提示 -->
  <view class="expired-card card" wx:if="{{isExpired && courses.length === 0}}">
    <view class="stamp-wrap">
      <view class="stamp-box">
        <text class="stamp-text">已过期</text>
      </view>
    </view>
    <text class="expired-title">课表已过期</text>
    <text class="expired-desc">当前学期已结束，请更新开学时间获取最新课表</text>
    <button class="modify-btn" bindtap="goSetDate">去修改日期</button>
  </view>

  <!-- 课程表表格 -->
  <view class="schedule-container" wx:if="{{courses.length > 0 && !showSemesterView}}">
    <scroll-view scroll-x class="schedule-scroll" enhanced show-scrollbar="{{false}}">
      <view class="schedule-grid {{hideWeekend ? 'hide-weekend' : ''}}">
        <block wx:for="{{gridItems}}" wx:key="id" wx:for-item="item">
          <view
            class="grid-item type-{{item.type}}"
            style="grid-row-start: {{item.rowStart}}; grid-row-end: {{item.rowEnd}}; grid-column: {{item.col}}; {{item.emptyStyle || ''}}; {{item.courseBg || ''}}"
          >
            <text wx:if="{{item.type === 'header-date'}}" class="cell-text header-date-text">{{item.text}}</text>
            <text wx:if="{{item.type === 'header'}}" class="cell-text">{{item.text}}</text>
            <text wx:if="{{item.type === 'period'}}" class="cell-text period-text">{{item.text}}</text>
            <text wx:if="{{item.type === 'section'}}" class="cell-text section-text">{{item.text}}</text>
            <view wx:if="{{item.type === 'time'}}" class="time-cell">
              <text class="time-text">{{item.text}}</text>
            </view>
            <view wx:if="{{item.type === 'course'}}" class="course-content" style="{{item.courseStyle}}">
              <text class="course-name" style="color: {{item.course.courseColorText || '#22304d'}};">{{item.course.name}}</text>
              <view class="course-info-divider"></view>
              <text class="course-teacher" wx:if="{{item.course.teacher}}" style="color: {{item.course.courseColorText || '#49566f'}};">{{item.course.teacher}}</text>
              <text class="course-location {{item.locationClass}}" wx:if="{{item.course.location}}">{{item.course.location}}</text>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 空状态 -->
  <view class="empty-schedule" wx:if="{{!isExpired && courses.length === 0}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon">📋</text>
    </view>
    <text class="empty-text">暂无课程</text>
    <text class="empty-desc">可手动添加、AI 识别，或从教务系统同步当前学期课表</text>
  </view>

  <!-- 图例说明 -->
  <view class="legend-section" wx:if="{{courses.length > 0}}">
    <view class="legend-title">时段图例</view>
    <view class="legend-grid">
      <block wx:for="{{legendColors}}" wx:for-item="legend" wx:key="label">
        <view class="legend-item">
          <view class="legend-color" style="background: {{legend.color}};"></view>
          <text class="legend-label">{{legend.label}}</text>
        </view>
      </block>
    </view>
    <view class="legend-tip">
      <text class="tip-icon">💡</text>
      <text class="tip-text">左右滑动查看完整课表，点击左侧菜单可同步教务系统课表</text>
    </view>
  </view>

  <!-- 抽屉遮罩 -->
  <view class="drawer-mask" wx:if="{{showDrawer}}" bindtap="closeDrawer"></view>
  <view class="drawer {{showDrawer ? 'show' : ''}}">
    <view class="drawer-title">课程设置</view>
    <view class="drawer-item sync-item" bindtap="goSyncSchedule">
      <view class="sync-icon-wrap">
        <image class="sync-icon" src="/assets/icons/refresh.png" mode="aspectFit"></image>
      </view>
      <view class="sync-text">
        <text class="sync-title">同步我的课表</text>
        <text class="sync-desc">输入教务账号并自动同步</text>
      </view>
      <text class="sync-arrow">></text>
    </view>
    <view class="drawer-item flex-between">
      <text>隐藏周末</text>
      <switch checked="{{hideWeekend}}" bindchange="onHideWeekend" color="#4A7AFF" />
    </view>
    <view class="drawer-item flex-between">
      <text>开启首页课程表提醒</text>
      <switch checked="{{reminder}}" bindchange="onReminder" color="#4A7AFF" />
    </view>
    <view class="drawer-item" bindtap="onBgColor">
      <text>更改课表背景颜色</text>
    </view>
    <view class="drawer-item" bindtap="goSetDate">
      <text>设置课程表开始日期</text>
    </view>
    <view class="drawer-item edit-item" bindtap="onEditSchedule">
      <view class="edit-icon-wrap">
        <text class="edit-icon-text">✏️</text>
      </view>
      <view class="edit-text">
        <text class="edit-title">清空/编辑课表</text>
        <text class="edit-desc">管理已添加的课程</text>
      </view>
      <text class="edit-arrow">></text>
    </view>
    <view class="drawer-item back" bindtap="closeDrawer">
      <text>返回</text>
    </view>
  </view>
</view>
