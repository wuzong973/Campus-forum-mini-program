.page {
  min-height: 100vh;
  background: #F5F7FA;
}

/* 警告提示条 */
.warning-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #FFFBE6;
  margin: 24rpx;
  border-radius: 12rpx;
}

.warning-icon-wrap {
  margin-right: 12rpx;
}

.warning-icon {
  font-size: 32rpx;
  color: #FA8C16;
}

.warning-text {
  font-size: 28rpx;
  color: #FA8C16;
}

/* 注销账号卡片 */
.delete-card {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}

.delete-header {
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

.delete-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.delete-body {
  padding: 32rpx;
}

.delete-desc {
  font-size: 28rpx;
  color: #F56C6C;
  line-height: 1.8;
}

.delete-btn-wrap {
  padding: 0 32rpx 32rpx;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #FF4D4F;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}

.delete-btn::after {
  border: none;
}
