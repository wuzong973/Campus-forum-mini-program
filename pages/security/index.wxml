<view class="page">
  <!-- 提示条 -->
  <view class="warning-bar">
    <view class="warning-icon-wrap">
      <text class="warning-icon">ⓘ</text>
    </view>
    <text class="warning-text">请妥善保管您的账号信息</text>
  </view>

  <!-- 注销账号卡片 -->
  <view class="delete-card">
    <view class="delete-header">
      <text class="delete-title">注销账号</text>
    </view>
    <view class="delete-body">
      <text class="delete-desc">提交注销申请后将进入 7 天冷静期。在冷静期内，您可随时撤销申请；期满后平台会按规则处理相关数据。</text>
    </view>
    <view class="delete-btn-wrap">
      <block wx:if="{{deletionRequest && deletionRequest.status === 'pending'}}">
        <text class="request-status">注销申请已提交，处理时间：{{deletionRequest.scheduledFor}}</text>
        <button class="delete-btn cancel-btn" loading="{{loading}}" bindtap="onCancelDeletion">撤销注销申请</button>
      </block>
      <button wx:else class="delete-btn" loading="{{loading}}" bindtap="onDeleteAccount">申请注销账号</button>
    </view>
  </view>
</view>
