.page {
  padding: 24rpx 20rpx 48rpx;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
}

.page-state {
  padding: 96rpx 24rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.page-state.retry {
  color: var(--primary);
}

.section {
  margin-bottom: 24rpx;
  padding: 30rpx 22rpx 26rpx;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 38rpx rgba(30, 64, 175, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
  margin-bottom: 18rpx;
  padding-left: 16rpx;
  position: relative;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 9rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #315CFF, #12B8A6);
}
