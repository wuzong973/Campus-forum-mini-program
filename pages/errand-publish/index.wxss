.page{min-height:100vh;background:#f5f6f8;padding:0 16rpx 150rpx;box-sizing:border-box;color:#263246}.topbar{position:fixed;z-index:10;top:0;left:0;right:0;background:#f5f6f8}.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}.back{font-size:64rpx;font-weight:300;line-height:1;color:#1f2b3a;width:72rpx}.nav-title{font-size:34rpx;font-weight:600}.more{font-size:42rpx;letter-spacing:4rpx;width:72rpx;text-align:center}.nav-space{width:100%}.card{background:#fff;border-radius:18rpx;padding:28rpx 26rpx;margin-bottom:20rpx;box-shadow:0 3rpx 16rpx rgba(32,48,76,.06)}.field-head{display:flex;justify-content:space-between;align-items:flex-start}.field-title{display:block;font-size:32rpx;font-weight:600;color:#27364a}.required{color:#ef5350}.counter{font-size:26rpx;color:#a5acb7}.sub-label,.private-tip,.hint{display:block;font-size:24rpx;color:#a6afbb;margin-top:6rpx}.private-tip{color:#f2b344}.soft-input,.desc-input{width:100%;background:#f7f8fa;border-radius:8rpx;margin-top:18rpx;padding:18rpx 20rpx;font-size:29rpx;color:#27364a}.soft-input{height:76rpx}.desc-input{height:250rpx;line-height:1.55}.private-input{height:170rpx}.add-image{width:170rpx;height:170rpx;border:2rpx dashed #d8dde5;border-radius:10rpx;margin-top:18rpx;display:flex;align-items:center;justify-content:center;color:#9ca6b4;font-size:72rpx}.image-list{display:flex;gap:14rpx;margin-top:16rpx}.image-item{width:150rpx;height:150rpx;position:relative}.image-item image{width:100%;height:100%;border-radius:10rpx}.remove{position:absolute;right:-10rpx;top:-10rpx;width:34rpx;height:34rpx;border-radius:50%;background:#444;color:#fff;text-align:center;line-height:32rpx}.compact-card{padding-top:24rpx;padding-bottom:24rpx}.amount-input{font-size:34rpx;color:#ef5d5d}.amount-error{display:block;color:#e64d4d;font-size:23rpx;margin-top:8rpx}.use-last{display:flex;align-items:center;flex-shrink:0;gap:8rpx;color:#27364a;font-size:26rpx;font-weight:600;transition:opacity .2s ease}.use-last:active{opacity:.6}.use-last switch{transform:scale(.9);margin-right:-8rpx}.contact-input{display:flex;align-items:center;height:78rpx;border:1rpx solid #edf0f4;border-radius:10rpx;padding:0 18rpx;margin-top:14rpx}.contact-input input{flex:1;font-size:28rpx;margin-left:12rpx}.contact-icon{color:#35bd77;font-size:25rpx}.contact-icon.phone{color:#5598ff;font-size:30rpx}.advanced-card{padding-top:24rpx}.gender-row,.type-grid{display:flex;gap:16rpx;margin-top:20rpx}.gender-btn,.type-btn{flex:1;text-align:center;padding:18rpx 10rpx;background:#f5f6f8;border:2rpx solid transparent;border-radius:12rpx;color:#69717e;font-size:27rpx}.gender-btn.active,.type-btn.active{background:#eef4ff;border-color:#4285f4;color:#4285f4}.pay-bar{position:fixed;z-index:9;left:16rpx;right:16rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-radius:20rpx;padding:20rpx 24rpx;box-shadow:0 8rpx 22rpx rgba(32,48,76,.12)}.agreement-row{display:flex;align-items:center;flex-wrap:wrap;gap:8rpx}.agree-check{width:32rpx;height:32rpx;border-radius:50%;border:2rpx solid #c4cbd6;background:#fff;box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex-shrink:0}.agree-check.checked{background:#347ff2;border-color:#347ff2}.agree-tick{color:#fff;font-size:22rpx;line-height:1}.agree-text{font-size:24rpx;color:#5a6472}.agree-link{font-size:24rpx;color:#347ff2}.pay-row{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}.pay-label{font-size:26rpx;color:#263246}.pay-amount{color:#e64340;font-size:34rpx;font-weight:700}.pay-btn{height:80rpx;line-height:80rpx;border-radius:40rpx;background:#347ff2;color:#fff;font-size:30rpx;font-weight:600;padding:0 48rpx;margin:0}.pay-btn::after{border:0}
/* 校区子选择行 */
.sub-grid{margin-top:16rpx}
/* 自动填充选项 */
.quick-tags{display:flex;gap:16rpx;margin-top:16rpx}
.quick-tag{padding:12rpx 28rpx;background:#f5f6f8;border:2rpx solid #e3e7ee;border-radius:999rpx;color:#69717e;font-size:26rpx;line-height:1}
.quick-tag:active{background:#eef4ff;border-color:#4285f4;color:#4285f4}
/* 发布流程提示条 */
/* 顶部自动轮播横幅 */
.publish-banner-swiper{height:72rpx;margin:16rpx 8rpx 20rpx}
.publish-banner{display:flex;align-items:center;gap:12rpx;height:72rpx;padding:0 24rpx;border-radius:36rpx;font-size:26rpx;box-sizing:border-box}
.publish-banner.style-red{background:#ffe2e2;color:#e34d4d}
.publish-banner.style-green{background:#e0f5e6;color:#3aa356}
.publish-banner.style-orange{background:#fff1de;color:#e8930c}
.publish-banner.style-blue{background:#e3edff;color:#3a6fe3}
.publish-banner.style-purple{background:#f0e5ff;color:#8a4de0}
.publish-banner-icon{flex-shrink:0;font-size:28rpx}
.publish-banner-text{flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.publish-banner-close{flex-shrink:0;padding:4rpx 8rpx;opacity:.55}
.flow-banner{display:flex;align-items:center;justify-content:center;gap:18rpx;background:#347ff2;border-radius:14rpx;padding:22rpx 12rpx;margin-bottom:20rpx}
.flow-step{display:flex;align-items:center;gap:10rpx}
.flow-num{width:36rpx;height:36rpx;border-radius:50%;background:#fff;color:#347ff2;font-size:24rpx;font-weight:700;text-align:center;line-height:36rpx;flex-shrink:0}
.flow-label{color:#fff;font-size:28rpx;font-weight:600;white-space:nowrap}
.flow-sep{color:rgba(255,255,255,.7);font-size:28rpx;font-weight:700}
