.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

.type-quick,
.form {
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.group-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
  letter-spacing: 0.3rpx;
}

/* 类型快捷选择 */
.type-list {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.type-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0;
  background: var(--bg);
  border-radius: var(--radius);
  border: 2rpx solid transparent;
  font-size: 26rpx;
  color: var(--text-secondary);
  transition: var(--transition-fast);
}

.type-chip.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

.type-emoji {
  font-size: 40rpx;
  line-height: 1;
}

/* 表单项 */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.form-item:last-child {
  border-bottom: none;
}

.form-item-row {
  display: flex;
  gap: 32rpx;
}

.row-cell {
  flex: 1;
}

.label {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input,
.textarea {
  font-size: 28rpx;
  width: 100%;
  color: var(--text-primary);
}

.input {
  height: 48rpx;
}

.textarea {
  height: 160rpx;
  line-height: 1.6;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-placeholder);
  margin-top: 8rpx;
}

.picker-val {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

/* 地址标签 */
.addr-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.addr-label-row .label {
  margin-bottom: 0;
}

.addr-tag {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.addr-tag-delivery {
  background: var(--success);
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-bg);
  color: var(--primary);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.step-btn.disabled {
  opacity: 0.35;
}

.step-val {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  min-width: 48rpx;
  text-align: center;
}

/* 分段选择 */
.seg-list {
  display: flex;
  gap: 16rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: var(--transition-fast);
}

.seg-item.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
}

/* 开关行 */
.form-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-label {
  flex: 1;
}

.switch-label .label {
  margin-bottom: 4rpx;
}

.switch-tip {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--text-placeholder);
  position: relative;
  transition: var(--transition-fast);
  flex-shrink: 0;
}

.switch.on {
  background: var(--primary);
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: var(--transition-fast);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.switch.on .switch-dot {
  left: 44rpx;
}

/* 提示 */
.tips {
  margin: 8rpx 8rpx 32rpx;
}

.tips-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
}
