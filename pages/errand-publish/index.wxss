.page {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.section {
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.required {
  color: var(--error);
  margin-left: 4rpx;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.form-item:last-child {
  border-bottom: none;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.row-cell {
  flex: 1;
}

.label {
  font-size: 28rpx;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input,
.textarea {
  font-size: 28rpx;
  width: 100%;
  color: var(--text-primary);
}

.input {
  height: 48rpx;
}

.textarea {
  height: 160rpx;
  line-height: 1.6;
}

.amount-input {
  font-size: 32rpx;
  font-weight: 500;
}

/* 下单类型网格 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.type-btn {
  padding: 16rpx 32rpx;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: var(--transition-fast);
}

.type-btn:active {
  transform: scale(0.96);
}

.type-btn.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 500;
}

/* 地图提示 */
.map-hint {
  margin: 16rpx 0;
  cursor: pointer;
}

.map-hint:active {
  opacity: 0.7;
}

.map-hint-title {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.map-hint-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 地址链接 */
.addr-links {
  display: flex;
  gap: 24rpx;
  margin: 12rpx 0;
}

.addr-link {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.addr-link:active {
  opacity: 0.7;
}

.addr-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
}

/* 取件时间按钮 */
.time-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.time-picker {
  flex: 1;
  min-width: 0;
}
.time-btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  background: var(--bg);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: var(--transition-fast);
}

.time-btn:active {
  transform: scale(0.96);
}

.time-btn.active {
  background: var(--primary-bg);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 500;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: var(--bg);
  border-radius: var(--radius);
  border: 2rpx dashed var(--border);
  margin: 16rpx 0;
}

.upload-icon {
  font-size: 48rpx;
  color: var(--primary);
  line-height: 1;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 500;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-sm);
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--error);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.image-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 12rpx;
}

/* 金额提示 */
.amount-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 基础金额独立输入框 */
.base-amount-box {
  margin: 20rpx 0;
  padding: 24rpx;
  background: var(--primary-bg);
  border-radius: var(--radius);
  border: 2rpx solid var(--primary);
}

.base-amount-header {
  margin-bottom: 12rpx;
}

.base-amount-label {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 600;
}

.base-amount-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary);
  background: #ffffff;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
}

/* 开关行 */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-info {
  flex: 1;
}

.switch-info .switch-label {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  display: block;
  margin-bottom: 4rpx;
}

.switch-info .switch-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--text-placeholder);
  position: relative;
  transition: var(--transition-fast);
  flex-shrink: 0;
}

.switch.on {
  background: var(--primary);
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: var(--transition-fast);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.switch.on .switch-dot {
  left: 44rpx;
}

/* 费用明细 */
.fee-detail {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--divider);
}

.fee-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.fee-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.fee-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.fee-row.fee-highlight {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--divider);
}

.fee-row.fee-highlight .fee-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.fee-row.fee-highlight .fee-value {
  color: var(--primary);
  font-weight: 700;
  font-size: 30rpx;
}

/* 规则列表 */
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rule-item {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
}
