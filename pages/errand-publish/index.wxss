.page{min-height:100vh;background:#f5f6f8;padding:0 16rpx 150rpx;box-sizing:border-box;color:#263246}.topbar{position:fixed;z-index:10;top:0;left:0;right:0;background:#f5f6f8}.topbar-inner{display:flex;align-items:center;justify-content:space-between;padding:0 12rpx}.back{font-size:64rpx;font-weight:300;line-height:1;color:#1f2b3a;width:72rpx}.nav-title{font-size:34rpx;font-weight:600}.more{font-size:42rpx;letter-spacing:4rpx;width:72rpx;text-align:center}.nav-space{width:100%}.card{background:#fff;border-radius:18rpx;padding:28rpx 26rpx;margin-bottom:20rpx;box-shadow:0 3rpx 16rpx rgba(32,48,76,.06)}.field-head{display:flex;justify-content:space-between;align-items:flex-start}.field-title{display:block;font-size:32rpx;font-weight:600;color:#27364a}.required{color:#ef5350}.counter{font-size:26rpx;color:#a5acb7}.sub-label,.private-tip,.hint{display:block;font-size:24rpx;color:#a6afbb;margin-top:6rpx}.private-tip{color:#f2b344}.soft-input,.desc-input{width:100%;background:#f7f8fa;border-radius:8rpx;margin-top:18rpx;padding:18rpx 20rpx;font-size:29rpx;color:#27364a}.soft-input{height:76rpx}.desc-input{height:250rpx;line-height:1.55}.private-input{height:170rpx}.add-image{width:170rpx;height:170rpx;border:2rpx dashed #d8dde5;border-radius:10rpx;margin-top:18rpx;display:flex;align-items:center;justify-content:center;color:#9ca6b4;font-size:72rpx}.image-list{display:flex;gap:14rpx;margin-top:16rpx}.image-item{width:150rpx;height:150rpx;position:relative}.image-item image{width:100%;height:100%;border-radius:10rpx}.remove{position:absolute;right:-10rpx;top:-10rpx;width:34rpx;height:34rpx;border-radius:50%;background:#444;color:#fff;text-align:center;line-height:32rpx}.compact-card{padding-top:24rpx;padding-bottom:24rpx}.amount-input{font-size:34rpx;color:#ef5d5d}.amount-error{display:block;color:#e64d4d;font-size:23rpx;margin-top:8rpx}.use-last{display:flex;align-items:center;gap:8rpx;color:#8f98a6;font-size:24rpx}.use-last switch{transform:scale(.75);margin-right:-12rpx}.contact-input{display:flex;align-items:center;height:78rpx;border:1rpx solid #edf0f4;border-radius:10rpx;padding:0 18rpx;margin-top:14rpx}.contact-input input{flex:1;font-size:28rpx;margin-left:12rpx}.contact-icon{color:#35bd77;font-size:25rpx}.contact-icon.phone{color:#5598ff;font-size:30rpx}.advanced-card{padding-top:24rpx}.gender-row,.type-grid{display:flex;gap:16rpx;margin-top:20rpx}.gender-btn,.type-btn{flex:1;text-align:center;padding:18rpx 10rpx;background:#f5f6f8;border:2rpx solid transparent;border-radius:12rpx;color:#69717e;font-size:27rpx}.gender-btn.active,.type-btn.active{background:#eef4ff;border-color:#4285f4;color:#4285f4}.line-input{height:74rpx;border-bottom:1rpx solid #eef0f3;font-size:28rpx}.two-input{display:flex;gap:18rpx}.two-input .line-input{flex:1}.submit-btn{position:fixed;z-index:9;left:16rpx;right:16rpx;bottom:calc(24rpx + env(safe-area-inset-bottom));height:88rpx;line-height:88rpx;border-radius:44rpx;background:#347ff2;color:#fff;font-size:32rpx;font-weight:600;box-shadow:0 8rpx 22rpx rgba(52,127,242,.28)}.submit-btn::after{border:0}
