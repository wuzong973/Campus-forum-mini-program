<view class="page">
  <!-- 顶部自动轮播横幅（管理后台「内容配置-发布横幅」可编辑） -->
  <swiper class="publish-banner-swiper" wx:if="{{publishBanners.length}}" autoplay circular interval="3000" duration="500">
    <swiper-item wx:for="{{publishBanners}}" wx:key="id">
      <view class="publish-banner style-{{item.style}}" style="{{item.bannerStyle}}" data-index="{{index}}" bindtap="onPublishBannerTap">
        <text class="publish-banner-icon" wx:if="{{item.icon}}">{{item.icon}}</text>
        <text class="publish-banner-text">{{item.text}}</text>
        <text class="publish-banner-close" data-index="{{index}}" catchtap="onClosePublishBanner">✕</text>
      </view>
    </swiper-item>
  </swiper>
  <!-- 顶部订阅入口：点击直接拉起「订单接单通知」等原生订阅授权弹窗（与原「支付发布」触发一致）；
       订阅生效后整行隐藏，在设置页关闭「代拿/跑腿通知」后重新出现 -->
  <view class="sub-notice-card" wx:if="{{showErrandPublishSubscribeEntry}}">
    <view class="sub-notice-main" bindtap="onErrandPublishSubscribeTap">
      <text class="sub-notice-title">订阅跑腿订单提醒</text>
      <text class="sub-notice-desc">有人接单、订单完成或取消时第一时间通知你</text>
    </view>
    <switch class="sub-notice-switch" checked="{{errandPublishSubscribeChecked}}" color="#00bc19" bindchange="onErrandPublishSubscribeTap"></switch>
  </view>
  <view class="flow-banner"><view class="flow-step"><text class="flow-num">1</text><text class="flow-label">发布需求</text></view><text class="flow-sep">»</text><view class="flow-step"><text class="flow-num">2</text><text class="flow-label">支付佣金</text></view><text class="flow-sep">»</text><view class="flow-step"><text class="flow-num">3</text><text class="flow-label">接单帮忙</text></view></view>
  <view class="card description-card"><view class="field-head"><view><text class="field-title">公开描述 <text class="required">*</text></text><text class="sub-label">◎ 所有人可见</text></view><text class="counter">{{remark.length || 0}}/500</text></view><textarea class="desc-input" maxlength="500" placeholder="请输入需求描述(请勿在此填写敏感信息如姓名、电话、取件码....等)
" data-field="remark" bindinput="onInput" value="{{remark}}" /><view class="quick-tags"><view class="quick-tag" data-field="remark" data-tag="送达地点：" bindtap="onQuickTagTap">送达地点</view></view><view class="add-image" bindtap="onChooseImage" wx:if="{{images.length < maxImages}}"><text>＋</text></view><view class="image-list"><view class="image-item" wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-index="{{index}}"/><text class="remove" bindtap="onRemoveImage" data-index="{{index}}">×</text></view></view></view>
  <view class="card"><view class="field-head"><view><text class="field-title">隐私信息</text><text class="private-tip">ⓘ 只有接单者可见，例如：取件码、门牌号等</text></view><text class="counter">{{privateInfo.length || 0}}/200</text></view><textarea class="desc-input private-input" maxlength="200" placeholder="输入隐私信息(可选)" data-field="privateInfo" bindinput="onInput" value="{{privateInfo}}" /><view class="quick-tags"><view class="quick-tag" data-field="privateInfo" data-tag="取件码：" bindtap="onQuickTagTap">取件码</view><view class="quick-tag" data-field="privateInfo" data-tag="手机尾号：" bindtap="onQuickTagTap">手机尾号</view></view><view class="add-image" bindtap="onChoosePrivateImage" wx:if="{{privateImages.length < maxPrivateImages}}"><text>＋</text></view><view class="image-list"><view class="image-item" wx:for="{{privateImages}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" bindtap="onPreviewPrivateImage" data-index="{{index}}"/><text class="remove" bindtap="onRemovePrivateImage" data-index="{{index}}">×</text></view></view></view>
  <view class="card compact-card"><text class="field-title">期望完成时间</text><text class="hint">例如：今天下午3点前，明天上午等；未填写将显示「越快越好」</text><input class="soft-input" maxlength="30" placeholder="选填，未填写默认越快越好" data-field="appointmentValue" bindinput="onInput" value="{{appointmentValue}}" /></view>
  <view class="card compact-card"><text class="field-title">截止接单时间</text><text class="hint">超过该时间仍无人接单，订单将自动取消并退款</text><view class="soft-input deadline-field" bindtap="onOpenDeadlineSheet"><text class="{{deadlineText ? 'deadline-value' : 'deadline-placeholder'}}">{{deadlineText || '不设置（点击选择时间）'}}</text><text class="deadline-clear" wx:if="{{deadlineText}}" catchtap="onClearDeadline">清除</text></view></view>
  <view class="card compact-card"><text class="field-title">悬赏金额 <text class="required">*</text></text><text class="hint">金额范围：2-500元</text><input class="soft-input amount-input" type="number" maxlength="3" placeholder="请输入悬赏金额" data-field="baseAmount" bindinput="onBaseAmountInput" value="{{baseAmount}}" /><text class="amount-error" wx:if="{{baseAmount && (baseAmount < 2 || baseAmount > 500)}}">请输入2-500元的金额</text></view>
  <view class="card compact-card"><view class="field-head"><text class="field-title">联系方式 <text class="required">*</text></text><view class="use-last"><text class="use-last-text">使用上次</text><switch checked="{{useLastContact}}" color="#4388ff" bindchange="onToggleLastContact"/></view></view><view class="contact-input"><text class="contact-icon">●</text><input placeholder="请输入微信号" data-field="wechatId" bindinput="onInput" value="{{wechatId}}" /></view><view class="contact-input"><text class="contact-icon phone">⌕</text><input type="number" placeholder="请输入手机号" data-field="receiverPhone" bindinput="onInput" value="{{receiverPhone}}" /></view></view>
  <view class="card advanced-card"><text class="field-title">性别限制 <text class="required">*</text></text><view class="gender-row"><view wx:for="{{genderRestrictions}}" wx:key="*this" class="gender-btn {{activeGenderRestriction === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onGenderRestrictionSelect">{{item}}</view></view></view>
  <view class="card advanced-card"><view class="field-head"><text class="field-title">校区选择 <text class="required">*</text></text></view><view class="type-grid"><view wx:for="{{campusGroups}}" wx:key="name" class="type-btn {{activeCampus === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onCampusSelect">{{item.name}}</view></view><view class="type-grid sub-grid" wx:if="{{subCampuses.length}}"><view wx:for="{{subCampuses}}" wx:key="*this" class="type-btn {{activeSubCampus === item ? 'active' : ''}}" data-value="{{item}}" bindtap="onSubCampusSelect">{{item}}</view></view></view>
  <view class="pay-bar">
    <view class="agreement-row">
      <view class="agree-check {{agreed ? 'checked' : ''}}" bindtap="toggleAgree"><text wx:if="{{agreed}}" class="agree-tick">✓</text></view>
      <text class="agree-text" bindtap="toggleAgree">我已阅读并同意</text>
      <text class="agree-link" bindtap="openAgreement">《广轻工论坛互助发单系统协议》</text>
    </view>
    <view class="pay-row">
      <text class="pay-label">确认支付 <text class="pay-amount">¥{{totalAmount || '0'}}</text></text>
      <button hover-class="press-spring" class="pay-btn spring-btn" bindtap="onSubmit" loading="{{submitting}}" hover-stay-time="120">支付发布</button>
    </view>
  </view>

  <!-- 截止接单时间选择弹窗（今天~大后天 + 时 + 分，可清空不限时） -->
  <view class="sheet-mask" wx:if="{{showDeadlineSheet}}" bindtap="onCloseDeadlineSheet"></view>
  <view class="deadline-sheet" wx:if="{{showDeadlineSheet}}">
    <view class="deadline-sheet-title">设置截止接单时间</view>
    <picker-view class="deadline-picker" value="{{deadlinePickerValue}}" bindchange="onDeadlinePickerChange" indicator-style="height: 88rpx;">
      <picker-view-column>
        <view wx:for="{{deadlineDays}}" wx:key="offset" class="deadline-picker-item">{{item.label}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{deadlineHours}}" wx:key="*this" class="deadline-picker-item">{{item}} 时</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{deadlineMinutes}}" wx:key="*this" class="deadline-picker-item">{{item}} 分</view>
      </picker-view-column>
    </picker-view>
    <view class="deadline-unlimited" bindtap="onDeadlineUnlimited">清空时间，不限时</view>
    <view class="deadline-sheet-actions">
      <view class="deadline-sheet-btn cancel" bindtap="onCloseDeadlineSheet">关闭</view>
      <view class="deadline-sheet-btn confirm" bindtap="onConfirmDeadline">确认</view>
    </view>
  </view>
</view>
