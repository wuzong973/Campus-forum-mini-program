<view class="page">
  <view class="card"><view class="field-head"><text class="field-title">标题 <text class="required">*</text></text><text class="counter">{{title.length || 0}}/50</text></view><input class="soft-input" maxlength="50" placeholder="请输入标题(50字以内)" data-field="title" bindinput="onInput" value="{{title}}" /></view>
  <view class="card description-card"><view class="field-head"><view><text class="field-title">公开描述 <text class="required">*</text></text><text class="sub-label">◎ 所有人可见</text></view><text class="counter">{{remark.length || 0}}/500</text></view><textarea class="desc-input" maxlength="500" placeholder="详细描述你的需求(最多500字)" data-field="remark" bindinput="onInput" value="{{remark}}" /><view class="add-image" bindtap="onChooseImage" wx:if="{{images.length < maxImages}}"><text>＋</text></view><view class="image-list"><view class="image-item" wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" bindtap="onPreviewImage" data-index="{{index}}"/><text class="remove" bindtap="onRemoveImage" data-index="{{index}}">×</text></view></view></view>
  <view class="card"><view class="field-head"><view><text class="field-title">隐私信息</text><text class="private-tip">ⓘ 只有接单者可见，例如：取件码、门牌号等</text></view><text class="counter">{{privateInfo.length || 0}}/200</text></view><textarea class="desc-input private-input" maxlength="200" placeholder="输入隐私信息(可选)" data-field="privateInfo" bindinput="onInput" value="{{privateInfo}}" /><view class="add-image" bindtap="onChooseImage" wx:if="{{images.length < maxImages}}"><text>＋</text></view></view>
  <view class="card compact-card"><text class="field-title">期望完成时间 <text class="required">*</text></text><text class="hint">例如：今天下午3点前，明天上午等</text><picker mode="multiSelector" range="{{appointmentPickerRange}}" value="{{[appointmentDateIndex, appointmentHourIndex, appointmentMinuteIndex]}}" bindcolumnchange="onAppointmentColumnChange" bindchange="onAppointmentChange"><view class="soft-input picker-value {{appointmentValue ? 'filled' : ''}}"><text>{{appointmentValue || '请选择期望完成时间（今天/明天）'}}</text><text class="picker-arrow">›</text></view></picker></view>
  <view class="card compact-card"><text class="field-title">悬赏金额 <text class="required">*</text></text><text class="hint">金额范围：2-500元</text><input class="soft-input amount-input" type="number" maxlength="3" placeholder="请输入悬赏金额" data-field="baseAmount" bindinput="onBaseAmountInput" value="{{baseAmount}}" /><text class="amount-error" wx:if="{{baseAmount && (baseAmount < 2 || baseAmount > 500)}}">请输入2-500元的金额</text></view>
  <view class="card compact-card"><view class="field-head"><text class="field-title">联系方式 <text class="required">*</text></text><view class="use-last"><text class="use-last-text">使用上次</text><switch checked="{{useLastContact}}" color="#4388ff" bindchange="onToggleLastContact"/></view></view><view class="contact-input"><text class="contact-icon">●</text><input placeholder="请输入微信号" data-field="wechatId" bindinput="onInput" value="{{wechatId}}" /></view><view class="contact-input"><text class="contact-icon phone">⌕</text><input type="number" placeholder="请输入手机号" data-field="receiverPhone" bindinput="onInput" value="{{receiverPhone}}" /></view></view>
  <view class="card advanced-card"><text class="field-title">性别限制 <text class="required">*</text></text><view class="gender-row"><view wx:for="{{genderRestrictions}}" wx:key="*this" class="gender-btn {{activeGenderRestriction === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onGenderRestrictionSelect">{{item}}</view></view></view>
  <view class="card advanced-card"><text class="field-title">取件与送达信息</text><view class="line-row"><view class="line-field"><text class="required-star">*</text><input class="line-input" placeholder="取件地址" data-field="pickupAddr" bindinput="onInput" value="{{pickupAddr}}" /></view><view class="use-last"><text class="use-last-text">使用上次</text><switch checked="{{useLastPickup}}" color="#4388ff" bindchange="onToggleLastPickup"/></view></view><view class="line-row"><view class="line-field"><text class="required-star">*</text><input class="line-input" placeholder="送达地址" data-field="deliveryAddr" bindinput="onInput" value="{{deliveryAddr}}" /></view><view class="use-last"><text class="use-last-text">使用上次</text><switch checked="{{useLastDelivery}}" color="#4388ff" bindchange="onToggleLastDelivery"/></view></view><view class="two-input"><view class="line-field"><text class="required-star">*</text><input class="line-input" placeholder="楼栋" data-field="deliveryBuilding" bindinput="onInput" value="{{deliveryBuilding}}"/></view><view class="line-field"><text class="required-star">*</text><input class="line-input" placeholder="宿舍号" data-field="deliveryRoom" bindinput="onInput" value="{{deliveryRoom}}"/></view></view><view class="type-grid"><view wx:for="{{campusGroups}}" wx:key="name" class="type-btn {{activeCampus === index ? 'active' : ''}}" data-index="{{index}}" bindtap="onCampusSelect">{{item.name}}</view></view><view class="type-grid sub-grid" wx:if="{{subCampuses.length}}"><view wx:for="{{subCampuses}}" wx:key="*this" class="type-btn {{activeSubCampus === item ? 'active' : ''}}" data-value="{{item}}" bindtap="onSubCampusSelect">{{item}}</view></view></view>
  <button class="submit-btn" bindtap="onSubmit" loading="{{submitting}}">发布</button>
</view>
