.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 8% 0%, rgba(125, 211, 192, 0.18), transparent 300rpx),
    linear-gradient(180deg, #e8f8f4 0%, #f5f7fb 430rpx, #f4f6fa 100%);
  position: relative;
  overflow: hidden;
}

.scroll-container {
  height: 100vh;
  padding-bottom: 24rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.nav-divider {
  margin: 0 12rpx;
  opacity: 0.7;
}

.banner-swiper {
  margin: 20rpx 20rpx 0;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 22rpx 50rpx rgba(37, 56, 110, 0.18);
}

.banner-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  height: 30rpx;
  margin: -40rpx 0 18rpx;
  position: relative;
  z-index: 2;
  pointer-events: none;
}

.indicator-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  transition: var(--transition);
}

.indicator-dot.active {
  width: 40rpx;
  background: #ffffff;
}

.banner-item {
  position: relative;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background:
    linear-gradient(90deg, rgba(18, 25, 54, 0.54) 0%, rgba(18, 25, 54, 0.18) 56%, rgba(18, 25, 54, 0.08) 100%),
    linear-gradient(180deg, rgba(18, 25, 54, 0.04), rgba(18, 25, 54, 0.2));
}

.banner-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  opacity: 0.96;
}

.banner-text {
  position: absolute;
  left: 38rpx;
  bottom: 38rpx;
  right: 290rpx;
  display: flex;
  flex-direction: column;
}

.banner-tag {
  align-self: flex-start;
  padding: 6rpx 14rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.banner-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  color: rgba(255,255,255,0.9);
  font-size: 25rpx;
  line-height: 1.45;
  margin-top: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

.banner-cta {
  align-self: flex-start;
  margin-top: 18rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(12rpx);
}

.banner-cta-text {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.notice-bar {
  margin: 18rpx 20rpx;
  background: rgba(255, 250, 232, 0.92);
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 224, 138, 0.55);
  box-shadow: 0 8rpx 22rpx rgba(250, 173, 20, 0.08);
}

.notice-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #646566;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-tail {
  margin-left: 16rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(250, 173, 20, 0.16);
  color: #d48806;
  font-size: 20rpx;
}

.service-retry {
  margin-bottom: 16rpx;
  color: var(--primary);
  font-size: 24rpx;
  text-align: center;
}

.service-page-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin: 0 0 2rpx;
}

.service-page-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d7dfeb;
}

.service-page-dot.active {
  width: 28rpx;
  border-radius: 8rpx;
  background: #4a7aff;
}

.section {
  margin: 0 20rpx 18rpx;
  padding: 28rpx 22rpx;
  border-radius: 26rpx;
}

.section-header {
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2a44;
}

.section-more {
  font-size: 24rpx;
  color: #8a94a6;
}

.schedule-card {
  margin: 0 24rpx 16rpx;
  padding: 32rpx 24rpx;
  min-height: 240rpx;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.schedule-week {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.schedule-remain {
  font-size: 26rpx;
  color: #4a7aff;
  background: #f0f4ff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.schedule-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.schedule-empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.schedule-empty-text {
  font-size: 28rpx;
  color: #c8c9cc;
}

/* 今日课程列表 */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.schedule-course-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.schedule-course-item:active {
  background: #f0f4ff;
}

.course-time-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.course-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.course-info-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.course-info-time {
  font-size: 24rpx;
  color: #969799;
  flex-shrink: 0;
}

.course-info-loc {
  font-size: 24rpx;
  color: #969799;
}

/* 搜索栏 */
.search-bar {
  margin: 0 20rpx 18rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  background: #f1f5fb;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 26rpx;
  color: #c8c9cc;
}

.search-action {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #315CFF, #6A8BFF);
  box-shadow: 0 10rpx 22rpx rgba(49, 92, 255, 0.28);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.search-action:active {
  transform: scale(0.9);
}

.search-action-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
  background: #ffffff;
  padding: 18rpx 0 10rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.category-list {
  display: inline-flex;
  gap: 46rpx;
  min-width: max-content;
  padding: 0 48rpx 0 24rpx;
  box-sizing: border-box;
}

.category-item {
  font-size: 27rpx;
  color: #7f8a98;
  padding: 8rpx 0 16rpx;
  position: relative;
  transition: all 0.3s ease-out;
  flex: 0 0 auto;
  white-space: nowrap;
}

.category-item.active {
  color: #1f3148;
  font-weight: 700;
}

.category-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 34rpx;
  height: 5rpx;
  background: #3478f6;
  border-radius: 3rpx;
}

.post-feed { margin: 0 12rpx; }

/* 浮动操作按钮 */
.float-actions {
  position: fixed;
  right: 24rpx;
  bottom: 400rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.3s ease;
  pointer-events: none;
  z-index: 90;
}

.float-actions.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.float-btn {
  width: 88rpx;
  height: 88rpx;
  background: #e5e5e5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.08);
}

.float-btn:active {
  transform: scale(0.92);
}

.float-btn-publish {
  background: #4a7aff;
}

.float-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

.float-btn-publish .float-btn-icon {
  filter: brightness(0) invert(1);
}

.float-btn-text {
  font-size: 18rpx;
  color: #646566;
}

.float-btn-publish .float-btn-text {
  color: #fff;
}

/* ============ 骨架屏 ============ */
.sk-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
}

.sk-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.sk-user {
  flex: 1;
}

.sk-line {
  border-radius: var(--radius-sm);
}

.sk-name {
  width: 180rpx;
  height: 28rpx;
  margin-bottom: 12rpx;
}

.sk-time {
  width: 120rpx;
  height: 22rpx;
}

.sk-content {
  width: 100%;
  height: 28rpx;
  margin-bottom: 16rpx;
}

.sk-content-2 {
  width: 60%;
  height: 28rpx;
}

/* Home comment half sheet */
.comment-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 210;
  background: rgba(12, 18, 32, 0.42);
  animation: fadeIn 0.2s ease-out;
}

.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 220;
  height: 72vh;
  max-height: 1060rpx;
  min-height: 720rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -18rpx 50rpx rgba(20, 30, 52, 0.18);
  animation: sheetUp 0.24s ease-out;
}

.comment-sheet-handle {
  width: 92rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d7dce6;
  margin: 0 auto 28rpx;
}

.comment-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.comment-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
}

.comment-sheet-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  color: #9aa3b2;
  font-size: 46rpx;
}

.comment-sheet-close:active {
  background: #f3f6fb;
}

.comment-sheet-list {
  flex: 1;
  min-height: 0;
}

.comment-sheet-loading,
.comment-sheet-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #9aa3b2;
  font-size: 26rpx;
}

.sheet-comment {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 0;
}

.sheet-comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef2f8;
  flex-shrink: 0;
}

.sheet-comment-main {
  flex: 1;
  min-width: 0;
}

.sheet-comment-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.sheet-comment-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #5e6675;
}

.sheet-comment-time {
  font-size: 23rpx;
  color: #a6adbb;
}

.sheet-comment-content {
  display: block;
  font-size: 31rpx;
  line-height: 1.58;
  color: #1f2329;
  word-break: break-word;
}

.sheet-comment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sheet-comment-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  background: #eef2f8;
}

.sheet-comment-like {
  min-width: 76rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  color: #9aa3b2;
  white-space: nowrap;
}

.sheet-like-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.76;
}

.sheet-like-count {
  font-size: 22rpx;
}

.sheet-preview-images {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
}

.sheet-preview-item {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.sheet-preview-img {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #eef2f8;
}

.sheet-preview-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(31, 42, 68, 0.76);
  color: #ffffff;
  font-size: 24rpx;
}

.sheet-input-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f2f6;
}

.sheet-comment-input {
  flex: 1;
  height: 72rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f6f7f9;
  font-size: 28rpx;
  color: #1f2329;
}

.sheet-send {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  color: #b3bac6;
  font-size: 27rpx;
  flex-shrink: 0;
}

.sheet-send.active {
  color: #315cff;
  font-weight: 800;
}

.sheet-tool {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #f2fbf8;
  color: #1f2329;
  font-size: 34rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}

.sheet-tool:active {
  transform: scale(0.92);
}

.sheet-emoji-panel {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10rpx 0;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f7f9fc;
}

.sheet-emoji-item {
  width: 66rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 34rpx;
  border-radius: 16rpx;
}

.sheet-emoji-item:active {
  background: #eef3ff;
  transform: scale(0.92);
}

.hot-rank {
  margin: 12rpx 14rpx 32rpx;
}

.hot-period-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hot-period {
  min-width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  background: #f3f5f8;
  color: #6b7280;
  font-size: 27rpx;
}

.hot-period.active {
  background: #edf2ff;
  color: #315cff;
  font-weight: 700;
}

.hot-rank-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 20rpx 18rpx 24rpx;
  background: #eaf4ff;
  border-radius: 12rpx 12rpx 0 0;
}

.hot-rank-kicker { display: inline-block; padding: 3rpx 8rpx; background: #cfe6ff; color: #376da8; font-size: 19rpx; font-style: italic; font-weight: 700; }
.hot-rank-title { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 700; color: #172c47; }
.hot-rank-note { max-width: 270rpx; color: #7e91a7; font-size: 22rpx; text-align: right; }
.hot-rank-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 14rpx; }
.hot-rank-card { padding: 22rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(31, 44, 75, .05); }
.hot-rank-card:active { background: #fbfcfe; }
.hot-rank-card-header { display: flex; align-items: center; }
.hot-rank-avatar { width: 58rpx; height: 58rpx; margin-right: 14rpx; border-radius: 50%; background: #edf1f6; }
.hot-rank-author { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3rpx; }
.hot-rank-nick { overflow: hidden; color: #24364c; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.hot-rank-time { color: #9ba6b2; font-size: 21rpx; }
.hot-rank-badge { display: flex; width: 46rpx; height: 50rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 6rpx; background: #e5e9ee; color: #7c8997; font-size: 17rpx; font-weight: 700; line-height: 1.05; }
.hot-rank-badge text:last-child { font-size: 24rpx; }
.hot-rank-badge.top { background: #fff0c8; color: #b47a14; }
.hot-rank-post-title { display: -webkit-box; margin-top: 18rpx; overflow: hidden; color: #1f3046; font-size: 29rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hot-rank-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.hot-rank-topic { display: flex; align-items: center; color: #9ba6b2; font-size: 21rpx; }
.hot-rank-topic text { display: inline-flex; width: 23rpx; height: 23rpx; margin-right: 5rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e9eef3; color: #98a4b0; font-size: 17rpx; }
.hot-rank-stats { display: flex; align-items: center; gap: 20rpx; color: #9aa5b2; font-size: 21rpx; }
.hot-rank-stats view { display: flex; align-items: center; gap: 4rpx; }
.hot-rank-stats image { width: 30rpx; height: 30rpx; opacity: .7; }
.hot-rank-empty { padding: 72rpx 0; text-align: center; color: #98a2b3; font-size: 27rpx; }

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
