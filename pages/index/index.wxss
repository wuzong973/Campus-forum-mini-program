.page {
  min-height: 100vh;
  background: var(--bg);
  position: relative;
  overflow: hidden;
}

.scroll-container {
  height: 100vh;
  padding-bottom: 24rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.nav-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.nav-divider {
  margin: 0 12rpx;
  opacity: 0.7;
}

.banner-swiper {
  margin: 16rpx 24rpx 0;
  height: 374rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(37, 56, 110, 0.1);
}

.banner-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  height: 30rpx;
  margin: -40rpx 0 18rpx;
  position: relative;
  z-index: 2;
  pointer-events: none;
}

.indicator-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.58);
  transition: var(--transition);
}

.indicator-dot.active {
  width: 34rpx;
  background: #ffffff;
}

.banner-item {
  position: relative;
  height: 100%;
  border-radius: var(--radius);
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(135deg, rgba(18, 25, 54, 0.08) 0%, rgba(18, 25, 54, 0.68) 100%);
}

.banner-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  opacity: 0.92;
}

.banner-text {
  position: absolute;
  left: 32rpx;
  bottom: 36rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
}

.banner-tag {
  align-self: flex-start;
  padding: 6rpx 14rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.banner-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.28;
  letter-spacing: 0;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  color: rgba(255,255,255,0.9);
  font-size: 25rpx;
  line-height: 1.45;
  margin-top: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

.banner-cta {
  align-self: flex-start;
  margin-top: 18rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
}

.banner-cta-text {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.notice-bar {
  margin: 16rpx 24rpx;
  background: #fffbe6;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.notice-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #646566;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-tail {
  margin-left: 16rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(250, 173, 20, 0.16);
  color: #d48806;
  font-size: 20rpx;
}

.section {
  margin: 0 24rpx 16rpx;
  padding: 24rpx 20rpx;
}

.section-header {
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.section-more {
  font-size: 24rpx;
  color: #969799;
}

.schedule-card {
  margin: 0 24rpx 16rpx;
  padding: 32rpx 24rpx;
  min-height: 240rpx;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.schedule-week {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.schedule-remain {
  font-size: 26rpx;
  color: #4a7aff;
  background: #f0f4ff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.schedule-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.schedule-empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.schedule-empty-text {
  font-size: 28rpx;
  color: #c8c9cc;
}

/* 今日课程列表 */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.schedule-course-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.schedule-course-item:active {
  background: #f0f4ff;
}

.course-time-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.course-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.course-info-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.course-info-time {
  font-size: 24rpx;
  color: #969799;
  flex-shrink: 0;
}

.course-info-loc {
  font-size: 24rpx;
  color: #969799;
}

/* 搜索栏 */
.search-bar {
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 26rpx;
  color: #c8c9cc;
}

.search-action {
  width: 64rpx;
  height: 64rpx;
  background: #4a7aff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.3s ease;
}

.search-action:active {
  transform: scale(0.9);
}

.search-action-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
  background: #fff;
  padding: 16rpx 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.category-list {
  display: inline-flex;
  gap: 32rpx;
  min-width: max-content;
  padding: 0 48rpx 0 24rpx;
  box-sizing: border-box;
}

.category-item {
  font-size: 28rpx;
  color: #969799;
  padding: 12rpx 0;
  position: relative;
  transition: all 0.3s ease-out;
  flex: 0 0 auto;
  white-space: nowrap;
}

.category-item.active {
  color: #4a7aff;
  font-weight: 600;
}

.category-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #4a7aff;
  border-radius: 2rpx;
}

/* 浮动操作按钮 */
.float-actions {
  position: fixed;
  right: 24rpx;
  bottom: 160rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.3s ease;
  pointer-events: none;
  z-index: 90;
}

.float-actions.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.float-btn {
  width: 96rpx;
  height: 96rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  gap: 4rpx;
}

.float-btn:active {
  transform: scale(0.92);
}

.float-btn-publish {
  background: #4a7aff;
}

.float-btn-icon {
  width: 36rpx;
  height: 36rpx;
}

.float-btn-publish .float-btn-icon {
  filter: brightness(0) invert(1);
}

.float-btn-text {
  font-size: 18rpx;
  color: #646566;
}

.float-btn-publish .float-btn-text {
  color: #fff;
}

/* ============ 骨架屏 ============ */
.sk-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
}

.sk-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.sk-user {
  flex: 1;
}

.sk-line {
  border-radius: var(--radius-sm);
}

.sk-name {
  width: 180rpx;
  height: 28rpx;
  margin-bottom: 12rpx;
}

.sk-time {
  width: 120rpx;
  height: 22rpx;
}

.sk-content {
  width: 100%;
  height: 28rpx;
  margin-bottom: 16rpx;
}

.sk-content-2 {
  width: 60%;
  height: 28rpx;
}
