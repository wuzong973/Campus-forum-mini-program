.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
  position: relative;
  overflow: hidden;
}

.page::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.32), rgba(255, 255, 255, 0));
  z-index: 0;
}

.scroll-container {
  position: relative;
  z-index: 1;
  height: 100vh;
  padding-bottom: 24rpx;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

/* 品牌胶囊：白色圆角底 + logo + 名称 */
.nav-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 24rpx 8rpx 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 22rpx rgba(69, 126, 177, 0.18), 0 2rpx 5rpx rgba(55, 93, 132, 0.08);
  transition: var(--transition);
}

.nav-brand-pressed {
  transform: translateY(-3rpx) scale(0.98);
  box-shadow: 0 12rpx 28rpx rgba(69, 126, 177, 0.24), 0 3rpx 8rpx rgba(55, 93, 132, 0.12);
}

.nav-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.nav-brand-text {
  color: #1d3048;
  font-size: 30rpx;
  font-weight: 700;
}

.banner-swiper {
  margin: 20rpx 20rpx 0;
  height: 258rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 22rpx 50rpx rgba(37, 56, 110, 0.18);
}

.banner-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  height: 30rpx;
  margin: -40rpx 0 18rpx;
  position: relative;
  z-index: 2;
  pointer-events: none;
}

.indicator-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  transition: var(--transition);
}

.indicator-dot.active {
  width: 40rpx;
  background: #ffffff;
}

.banner-item {
  position: relative;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background:
    linear-gradient(90deg, rgba(18, 25, 54, 0.54) 0%, rgba(18, 25, 54, 0.18) 56%, rgba(18, 25, 54, 0.08) 100%),
    linear-gradient(180deg, rgba(18, 25, 54, 0.04), rgba(18, 25, 54, 0.2));
}

.banner-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  opacity: 0.96;
}

.banner-text {
  position: absolute;
  left: 38rpx;
  bottom: 38rpx;
  right: 290rpx;
  display: flex;
  flex-direction: column;
}

.banner-tag {
  align-self: flex-start;
  padding: 6rpx 14rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

.banner-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  color: rgba(255,255,255,0.9);
  font-size: 25rpx;
  line-height: 1.45;
  margin-top: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

.banner-cta {
  align-self: flex-start;
  margin-top: 18rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  backdrop-filter: blur(12rpx);
}

.banner-cta-text {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.notice-bar {
  margin: 18rpx 20rpx;
  background: rgba(255, 250, 232, 0.92);
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 224, 138, 0.55);
  box-shadow: 0 8rpx 22rpx rgba(250, 173, 20, 0.08);
}

.notice-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.notice-text {
  font-size: 24rpx;
  color: var(--banner-fg, #646566);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-admin-wrap {
  flex-shrink: 0;
}

.notice-admin {
  color: var(--banner-fg, #0066cc);
  font-size: 24rpx;
  font-weight: 600;
  text-decoration: underline;
}

.notice-tail {
  margin-left: 16rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(250, 173, 20, 0.16);
  color: var(--banner-fg, #d48806);
  font-size: 20rpx;
}

.service-retry {
  margin-bottom: 16rpx;
  color: var(--primary);
  font-size: 24rpx;
  text-align: center;
}

.service-page-dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin: 0 0 2rpx;
}

.service-page-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #d7dfeb;
}

.service-page-dot.active {
  width: 28rpx;
  border-radius: 8rpx;
  background: #4a7aff;
}

.section {
  margin: 0 20rpx 18rpx;
  padding: 28rpx 22rpx;
  border-radius: 26rpx;
}

.service-section {
  padding: 20rpx 18rpx 12rpx;
}

.section-header {
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2a44;
}

.section-more {
  font-size: 24rpx;
  color: #8a94a6;
}

.schedule-card {
  margin: 0 24rpx 16rpx;
  padding: 32rpx 24rpx;
  min-height: 240rpx;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.schedule-week {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.schedule-remain {
  font-size: 26rpx;
  color: #4a7aff;
  background: #f0f4ff;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.schedule-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.schedule-empty-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.schedule-empty-text {
  font-size: 28rpx;
  color: #c8c9cc;
}

/* 今日课程列表 */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.schedule-course-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  transition: background 0.2s;
}

.schedule-course-item:active {
  background: #f0f4ff;
}

.course-time-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.course-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.course-info-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.course-info-time {
  font-size: 24rpx;
  color: #969799;
  flex-shrink: 0;
}

.course-info-loc {
  font-size: 24rpx;
  color: #969799;
}

/* 搜索栏 */
.search-bar {
  position: relative;
  margin: 0 20rpx 18rpx;
  padding: 12rpx 14rpx 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-refresh {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #315CFF, #6A8BFF);
  box-shadow: 0 10rpx 22rpx rgba(49, 92, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.search-refresh-icon {
  width: 38rpx;
  height: 38rpx;
}

.search-refresh.refreshing .search-refresh-icon {
  animation: fabSpin 0.8s linear infinite;
}

.fab-pressed {
  transform: scale(0.92);
  box-shadow: 0 4rpx 12rpx rgba(49, 92, 255, 0.28);
}

@keyframes fabSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.search-input {
  flex: 1;
  background: #f1f5fb;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
}

.search-icon-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-placeholder {
  font-size: 26rpx;
  color: #c8c9cc;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 12rpx;
  background: #ffffff;
  padding: 18rpx 0 10rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.category-list {
  display: inline-flex;
  gap: 46rpx;
  min-width: max-content;
  padding: 0 48rpx 0 24rpx;
  box-sizing: border-box;
}

.category-item {
  font-size: 27rpx;
  color: #7f8a98;
  padding: 8rpx 0 16rpx;
  position: relative;
  transition: all 0.3s ease-out;
  flex: 0 0 auto;
  white-space: nowrap;
}

.category-item.active {
  color: #1f3148;
  font-weight: 700;
}

.category-item.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 34rpx;
  height: 5rpx;
  background: #3478f6;
  border-radius: 3rpx;
}

.post-feed { margin: 0 12rpx; }

/* 浮动操作按钮：每日热榜 / 私信 / 回到顶部（固定右下角） */
.float-actions {
  position: fixed;
  right: 24rpx;
  /* 兜底值：env() 不生效时也能避开底部导航 */
  bottom: 210rpx;
  /* 展开态基线：置顶按钮底边距底部导航的参考线 */
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  z-index: 90;
  /* 初始整体下移一个图标高度（隐藏置顶按钮的位置），出现时被顶起复位 */
  transform: translateY(84rpx);
  transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* 「回到置顶」出现：整个图标组被顶起一个身位 */
.float-actions.rise {
  transform: translateY(0);
}

.float-btn {
  width: 84rpx;
  height: 84rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(31, 44, 75, 0.14);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.float-btn-pressed {
  transform: scale(0.92);
  box-shadow: 0 3rpx 10rpx rgba(31, 44, 75, 0.1);
}

/* 图标配色（iconfont 字体图标） */
.float-icon {
  font-size: 46rpx;
  line-height: 1;
}

.float-icon-hot {
  color: #ff6b35;
}

.float-icon-msg {
  color: #4a90f8;
}

/* 回到顶部：随容器顶起而淡入滑出。
   隐藏态占位保留（transform 不影响布局，前两个按钮位置由容器统一控制），不可交互 */
.float-btn-top {
  opacity: 0;
  pointer-events: none;
  transform: translateY(28rpx);
  transition:
    transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1),
    opacity 0.26s ease-out;
}

.float-btn-top.show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

/* 显示态下保留按压缩放反馈（.show 优先级高于 hover-class，需显式覆盖） */
.float-btn-top.show.float-btn-pressed {
  transform: translateY(0) scale(0.92);
}

/* 回到顶部图标颜色：深灰箭头 */
.float-btn-top .float-icon {
  color: #5e6675;
}

/* ============ 骨架屏 ============ */
.sk-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius);
}

.sk-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.sk-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.sk-user {
  flex: 1;
}

.sk-line {
  border-radius: var(--radius-sm);
}

.sk-name {
  width: 180rpx;
  height: 28rpx;
  margin-bottom: 12rpx;
}

.sk-time {
  width: 120rpx;
  height: 22rpx;
}

.sk-content {
  width: 100%;
  height: 28rpx;
  margin-bottom: 16rpx;
}

.sk-content-2 {
  width: 60%;
  height: 28rpx;
}

/* Home comment half sheet */
.comment-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 210;
  background: rgba(12, 18, 32, 0.42);
  animation: fadeIn 0.2s ease-out;
}

.comment-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 220;
  height: 72vh;
  max-height: 1060rpx;
  min-height: 720rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 34rpx 34rpx 0 0;
  box-shadow: 0 -18rpx 50rpx rgba(20, 30, 52, 0.18);
  animation: sheetUp 0.24s ease-out;
}

.comment-sheet-handle {
  width: 92rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d7dce6;
  margin: 0 auto 28rpx;
}

.comment-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.comment-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
}

.comment-sheet-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  color: #9aa3b2;
  font-size: 46rpx;
}

.comment-sheet-close:active {
  background: #f3f6fb;
}

.comment-sheet-list {
  flex: 1;
  min-height: 0;
}

.comment-sheet-loading,
.comment-sheet-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #9aa3b2;
  font-size: 26rpx;
}

.sheet-comment {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 0;
}

.sheet-comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eef2f8;
  flex-shrink: 0;
}

.sheet-comment-main {
  flex: 1;
  min-width: 0;
}

.sheet-comment-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.sheet-comment-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #5e6675;
}

.sheet-comment-time {
  font-size: 23rpx;
  color: #a6adbb;
}

.sheet-comment-content {
  display: block;
  font-size: 31rpx;
  line-height: 1.58;
  color: #1f2329;
  word-break: break-word;
}

.sheet-comment-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sheet-comment-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  background: #eef2f8;
}

.sheet-comment-like {
  min-width: 76rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  color: #9aa3b2;
  white-space: nowrap;
}

.sheet-like-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.76;
}

.sheet-like-count {
  font-size: 22rpx;
}

.sheet-preview-images {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
}

.sheet-preview-item {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.sheet-preview-img {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #eef2f8;
}

.sheet-preview-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(31, 42, 68, 0.76);
  color: #ffffff;
  font-size: 24rpx;
}

.sheet-input-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0f2f6;
}

.sheet-comment-input {
  flex: 1;
  height: 72rpx;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f6f7f9;
  font-size: 28rpx;
  color: #1f2329;
}

.sheet-send {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  color: #b3bac6;
  font-size: 27rpx;
  flex-shrink: 0;
}

.sheet-send.active {
  color: #315cff;
  font-weight: 800;
}

.sheet-tool {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #f2fbf8;
  color: #1f2329;
  font-size: 34rpx;
  flex-shrink: 0;
  transition: transform 0.18s ease;
}

.sheet-tool:active {
  transform: scale(0.92);
}

.sheet-emoji-panel {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10rpx 0;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #f7f9fc;
}

.sheet-emoji-item {
  width: 66rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  font-size: 34rpx;
  border-radius: 16rpx;
}

.sheet-emoji-item:active {
  background: #eef3ff;
  transform: scale(0.92);
}

.hot-rank {
  margin: 12rpx 14rpx 32rpx;
}

.hot-rank-heading {
  border-radius: 16rpx;
  overflow: hidden;
}

.hot-rank-banner { display: block; width: 100%; }
.hot-rank-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 14rpx; }
.hot-rank-card { padding: 22rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(31, 44, 75, .05); }
.hot-rank-card:active { background: #fbfcfe; }

/* 热榜媒体（图片/视频） */
.hot-rank-media {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.hot-media {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10rpx;
  background: #edf1f6;
}

.hot-media-video {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1f2b43;
}

.hot-video-play {
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1;
}
.hot-rank-card-header { display: flex; align-items: center; }
.hot-rank-avatar { width: 58rpx; height: 58rpx; margin-right: 14rpx; border-radius: 50%; background: #edf1f6; }
.hot-rank-author { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.hot-rank-nick-row { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.hot-rank-nick { overflow: hidden; color: #24364c; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
/* 与帖子卡片一致的「帖子/AN」标识 */
.hot-rank-post-label { display: inline-flex; align-items: stretch; overflow: hidden; height: 30rpx; flex: 0 0 auto; border-radius: 4rpx; background: #f34e72; color: #fff; font-size: 18rpx; font-weight: 700; line-height: 30rpx; }
.post-label-main { padding: 0 8rpx; }
.post-label-an { padding: 0 5rpx; background: #f6d84a; color: #4c5b22; font-size: 15rpx; line-height: 30rpx; }
/* 元信息行：话题分类 · 时间 · 浏览量 */
.hot-rank-meta { display: flex; align-items: center; gap: 9rpx; overflow: hidden; color: #9ea9b7; font-size: 21rpx; }
.hot-meta-category { flex: 0 1 auto; max-width: 168rpx; overflow: hidden; padding: 2rpx 10rpx; border-radius: 6rpx; background: #f0edff; color: #7268b8; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.hot-meta-dot { flex: 0 0 auto; color: #d3d9e0; }
.hot-rank-badge { display: flex; width: 46rpx; height: 50rpx; flex-direction: column; align-items: center; justify-content: center; border-radius: 6rpx; background: #e5e9ee; color: #7c8997; font-size: 17rpx; font-weight: 700; line-height: 1.05; }
.hot-rank-badge text:last-child { font-size: 24rpx; }
.hot-rank-badge.top { background: #fff0c8; color: #b47a14; }
.hot-rank-post-title { display: -webkit-box; margin-top: 18rpx; overflow: hidden; color: #1f3046; font-size: 29rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.hot-rank-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.hot-rank-campus { max-width: 138rpx; overflow: hidden; padding: 3rpx 8rpx; border-radius: 4rpx; background: #f0f5ff; color: #5e7fb6; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.hot-rank-stats { display: flex; align-items: center; gap: 20rpx; color: #9aa5b2; font-size: 21rpx; }
.hot-rank-stats view { display: flex; align-items: center; gap: 4rpx; }
.hot-rank-stats image { width: 30rpx; height: 30rpx; opacity: .7; }
.hot-rank-empty { padding: 72rpx 0; text-align: center; color: #98a2b3; font-size: 26rpx; }

/* 首页热榜预览 */
.today-hot-card {
  margin: 0 20rpx 12rpx;
  padding: 12rpx 18rpx 8rpx;
  border-radius: 22rpx;
  background: #fffdf1;
  box-sizing: border-box;
}
.today-hot-header { display: flex; align-items: center; min-height: 40rpx; }
.today-hot-title-wrap { display: flex; align-items: center; gap: 14rpx; flex: 1; min-width: 0; }
.today-hot-fire { color: #f04f36; font-size: 34rpx; line-height: 1; }
.today-hot-title { color: #272727; font-size: 30rpx; font-weight: 800; }
.today-hot-more { padding: 6rpx 12rpx; border-radius: 8rpx; background: #ff3d62; color: #fff; font-size: 20rpx; font-weight: 700; }
.today-hot-swiper { height: 76rpx; margin-top: 2rpx; }
.today-hot-row { display: flex; height: 38rpx; align-items: center; gap: 10rpx; overflow: hidden; }
.today-hot-rank { flex: 0 0 auto; min-width: 30rpx; color: #e4af11; font-size: 24rpx; font-weight: 800; text-align: right; white-space: nowrap; }
.today-hot-text { display: block; overflow: hidden; flex: 1; min-width: 0; color: #222; font-size: 25rpx; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.today-hot-card { transition: var(--transition); }
.today-hot-card:active { transform: translateY(-2rpx); box-shadow: 0 12rpx 26rpx rgba(237, 176, 42, 0.14); }
.today-hot-loading { padding: 24rpx 18rpx; color: #9aa5b1; font-size: 26rpx; text-align: center; }

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
