<!-- 自定义导航栏必须放在 .page 之外（与 .float-actions 同层）：
     祖先一旦带 transform，position:fixed 的包含块就会被劫持到该祖先，导航栏会随
     页面本体的滚动被顶出屏幕且无法复位。详见 app.wxss 中 .page-enter 的说明。 -->
<view class="custom-nav gradient-nav {{navVisible ? '' : 'nav-hidden'}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content" style="height: {{navBarHeight}}px;">
    <view class="nav-brand spring-btn" hover-class="nav-brand-pressed press-spring" hover-stay-time="120">
      <image class="nav-logo" src="/assets/icons/campus-logo.png" mode="aspectFill"></image>
      <text class="nav-brand-text">广轻校园圈</text>
    </view>
  </view>
</view>

<view class="page page-enter" style="--nav-h: {{statusBarHeight + navBarHeight}}px;">
  <!-- 导航栏占位：scroll-view 高度 = 100vh - 导航高度，保证页面本体不产生滚动 -->
  <view class="nav-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <scroll-view
    class="scroll-container"
    scroll-y
    scroll-with-animation
    bindscroll="onContentScroll"
    bindscrolltoupper="onContentScrollToUpper"
    bindtouchmove="onContentTouchMove"
    bindscrolltolower="onReachBottom"
    lower-threshold="120"
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
    refresher-enabled="{{!hotAreaTouching}}"
    refresher-triggered="{{scrollRefreshing}}"
    bindrefresherrefresh="onContentRefresh"
    enhanced
    show-scrollbar="{{false}}"
  >
    <!-- 轮播图 -->
    <!-- banner-stage 只为承载弥散背光：swiper 自带 overflow:hidden，背光放进去会被整层裁掉，
         所以它必须是 swiper 的兄弟节点并向下溢出 stage。滚动时挂 fx-paused 暂停常驻动画。
         fx-stage 提供共享层 token 默认值；fx-off 由「设置 → 显示 → 卡片动效」或低端机命中。 -->
    <view class="banner-stage fx-stage {{bannerFxPaused ? 'fx-paused' : ''}} {{fxOff ? 'fx-off' : ''}}">
      <!-- 一张 banner 一层背光，靠外层 opacity 交叉淡入：避免在 js 里同步「当前那张的 accent」。
           呼吸放在内层，是为了让淡入淡出走 transition、脉动走 animation，两者不互相覆盖。 -->
      <view class="fx-glow-layer">
        <view
          class="fx-glow {{bannerCurrent === index ? 'is-on' : ''}}"
          wx:for="{{banners}}"
          wx:key="id"
          style="--fx-accent: {{item.accent}};"
        ><view class="fx-glow-pulse"></view></view>
      </view>
      <swiper class="banner-swiper" autoplay circular interval="{{bannerInterval}}" duration="{{bannerDuration}}" bindchange="onBannerChange">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view
            class="banner-item fx-card fx-card--fill {{bannerPressedIndex === index ? 'banner-pressing' : ''}} {{bannerCurrent === index ? 'is-live' : ''}}"
            id="banner-{{index}}"
            style="{{bannerTiltStyle}}"
            data-index="{{index}}"
            data-link="{{item.link}}"
            bindtap="onBannerTap"
            bindtouchstart="onBannerTouchStart"
            bindtouchmove="onBannerTouchMove"
            bindtouchend="onBannerTouchEnd"
            bindtouchcancel="onBannerTouchEnd"
          >
            <!-- 描边环与卡面结构见 styles/card-fx.wxss：环自带 overflow:hidden 做圆形裁切，
                 卡面内缩 --fx-w 露出描边；主色逐张由后台配置的 accent 下发 -->
            <view class="fx-ring" style="--fx-accent: {{item.accent}};">
              <view class="fx-ring-spin"></view>
            </view>
            <view class="fx-body">
              <image class="banner-img" src="{{item.image}}" mode="aspectFill" lazy-load></image>
              <view class="banner-mask"></view>
              <!-- 光斑：压在图片与文字之间，按下时从略大收缩到触点位置（位置由 --spot-x/y 决定） -->
              <view class="banner-spot"></view>
              <!-- 流光：一条斜向高光带，横向位移由 --spot-x 换算，倾斜时像反光扫过卡面 -->
              <view class="banner-shine"></view>
              <view class="banner-accent" style="background: {{item.accent}};"></view>
              <view class="banner-text">
                <text class="banner-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
                <text class="banner-title">{{item.title}}</text>
                <text class="banner-subtitle">{{item.subtitle}}</text>
                <view class="banner-cta">
                  <text class="banner-cta-text">立即查看</text>
                </view>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>
    <view class="banner-indicator">
      <view
        class="indicator-dot {{bannerCurrent === index ? 'active' : ''}}"
        wx:for="{{banners}}"
        wx:key="id"
      ></view>
    </view>

    <!-- 公告 -->
    <view class="notice-bar" style="{{noticeStyle}}">
      <image class="notice-icon-img icon-sm" src="/assets/icons/notice.png" mode="aspectFit"></image>
      <text class="notice-text">{{notice}}</text>
      <contact-admin wx:if="{{!noticeLinkUrl}}" id="noticeAdmin" class="notice-admin-wrap" direct>
        <view slot="trigger" class="notice-admin">{{noticeLinkText}}</view>
      </contact-admin>
      <text wx:else class="notice-admin" catchtap="onNoticeLinkTap">{{noticeLinkText}}</text>
      <text class="notice-tail" wx:if="{{noticeTailText}}" bindtap="onNoticeTailTap">{{noticeTailText}}</text>
    </view>

    <!-- 今日热榜预览：两行竖向轮换，点击进入完整榜单（用户关闭偏好时整体隐藏） -->
    <!-- 触摸落在热榜内时临时禁用下拉刷新，避免误触发（touchstart 决定整个手势周期） -->
    <view
      class="today-hot-card card anim-slide-up"
      wx:if="{{dailyHotVisible && hotPosts.length}}"
      bindtap="onTodayHotTap"
      bindtouchstart="onHotAreaTouchStart"
      bindtouchend="onHotAreaTouchEnd"
      bindtouchcancel="onHotAreaTouchEnd"
    >
      <view class="today-hot-header">
        <view class="today-hot-title-wrap"><text class="today-hot-fire">🔥</text><text class="today-hot-title">每日热榜</text></view>
        <view class="today-hot-more">点击查看</view>
      </view>
      <swiper class="today-hot-swiper" vertical autoplay circular interval="5000" duration="420">
        <swiper-item wx:for="{{hotRankGroups}}" wx:key="index">
          <view class="today-hot-row" wx:for="{{item}}" wx:for-item="hotItem" wx:key="id">
            <text class="today-hot-rank">{{hotItem.rank}}.</text>
            <text class="today-hot-text">{{hotItem.hotText}}</text>
          </view>
        </swiper-item>
      </swiper>
    </view>
    <view
      class="today-hot-card card today-hot-loading"
      wx:elif="{{dailyHotVisible && hotLoading}}"
      bindtouchstart="onHotAreaTouchStart"
      bindtouchend="onHotAreaTouchEnd"
      bindtouchcancel="onHotAreaTouchEnd"
    >热榜更新中...</view>

    <!-- 校园服务 -->
    <view class="section service-section card anim-slide-up">
      <view class="service-retry" wx:if="{{serviceLoadFailed}}" bindtap="loadServices">校园服务加载失败，点击重试</view>
      <service-grid
        services="{{allServices}}"
        layout="scroll"
        bind:tap="onServiceTap"
        bind:scroll="onServiceScroll"
      />
      <view class="service-page-dots" wx:if="{{serviceIndicators.length > 1}}">
        <view class="service-page-dot {{serviceIndicatorCurrent === index ? 'active' : ''}}" wx:for="{{serviceIndicators}}" wx:key="*this"></view>
      </view>
    </view>

    <!-- 课程表卡片（仅在开启"首页课程表提醒"时显示） -->
    <view class="schedule-card card anim-slide-up" wx:if="{{reminderEnabled}}" bindtap="goSchedule">
      <view class="schedule-header">
        <text class="schedule-week">{{scheduleWeekText || '加载中...'}}</text>
        <text class="schedule-remain">{{scheduleRemainText}}</text>
      </view>

      <!-- 有课：列出今日课程 -->
      <view class="schedule-list" wx:if="{{!scheduleEmpty && todayCourses.length > 0}}">
        <view class="schedule-course-item" wx:for="{{todayCourses}}" wx:key="id">
          <view class="course-time-dot" style="background: {{item.color || '#4A7AFF'}};"></view>
          <view class="course-info">
            <view class="course-info-row">
              <text class="course-info-name">{{item.name}}</text>
              <text class="course-info-time">{{item.startTime}}-{{item.endTime}}</text>
            </view>
            <text class="course-info-loc" wx:if="{{item.location}}">{{item.location}}</text>
          </view>
        </view>
      </view>

      <!-- 无课：空状态 -->
      <view class="schedule-empty" wx:if="{{scheduleEmpty}}">
        <image class="schedule-empty-icon icon-xl" src="/assets/icons/tag-clock.png" mode="aspectFit"></image>
        <text class="schedule-empty-text">今天是没有课程打扰的宁静时光~</text>
      </view>
    </view>

    <!-- 搜索与刷新：按钮固定在搜索栏最右侧 -->
    <view class="search-bar card anim-slide-up">
      <view class="search-input pressable" bindtap="goSearch">
        <image class="search-icon-img icon-xs" src="/assets/icons/search.png" mode="aspectFit"></image>
        <text class="search-placeholder">搜索社区内容...</text>
      </view>
      <view class="search-refresh {{refreshing ? 'refreshing' : ''}} spring-btn" hover-stay-time="80" hover-class="fab-pressed press-spring" bindtap="onRefreshAction">
        <image class="search-refresh-icon" src="/assets/icons/refresh.png" mode="aspectFit"></image>
      </view>
    </view>

    <!-- 分类标签（指示条为液态拉伸样式，utils/liquid-tab.js 驱动；
         指示条随滚动内容移动，横滚由用户手动，不做自动滚入） -->
    <scroll-view class="category-scroll" scroll-x enable-flex>
      <view class="category-list liquid-tab-track">
        <view
          class="category-item pressable {{activeCategory === index ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onCategoryTap"
        >{{item}}</view>
        <view class="liquid-indicator {{liquidPhase}}" style="{{liquidStyle}}"></view>
      </view>
    </scroll-view>

    <!-- 分类说明：仅「二手闲置」分类显示 —— 该分类的帖子不进「最新」列表，避免用户以为帖子丢了 -->
    <view class="category-note" wx:if="{{categories[activeCategory] === '二手闲置'}}">二手闲置帖子不显示在「最新」页面</view>

    <!-- 最热榜单（用户关闭每日热榜偏好时显示关闭提示） -->
    <view id="hot-rank-detail" class="hot-rank" wx:if="{{isHotCategory && !dailyHotVisible}}">
      <view class="hot-rank-empty">每日热榜已在设置中关闭</view>
    </view>
    <view id="hot-rank-detail" class="hot-rank" wx:elif="{{isHotCategory}}">
      <view class="hot-rank-heading">
        <image class="hot-rank-banner" src="/assets/banners/hot-rank-banner.jpg" mode="widthFix"></image>
      </view>
      <view class="hot-rank-list" wx:if="{{hotPosts.length}}">
        <view class="hot-rank-card anim-stagger" style="--i: {{index < 6 ? index : 0}};" wx:for="{{hotPosts}}" wx:key="id" data-id="{{item.id}}" bindtap="onHotPostTap">
          <view class="hot-rank-card-header">
            <image class="hot-rank-avatar" src="{{item.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" lazy-load></image>
            <view class="hot-rank-author">
              <view class="hot-rank-nick-row">
                <text class="hot-rank-nick">{{item.nickName}}</text>
                <view class="hot-rank-post-label"><text class="post-label-main">作者</text><text class="post-label-an" wx:if="{{item.isAnonymous}}">AN</text></view>
              </view>
              <view class="hot-rank-meta">
                <text class="hot-meta-category">{{item.category || '日常话题'}}</text>
                <text class="hot-meta-dot">·</text>
                <text>{{item.rankTimeText}}</text>
                <text class="hot-meta-dot">·</text>
                <text>{{item.rankViewText}}</text>
              </view>
            </view>
            <view class="hot-rank-badge {{index < 3 ? 'top' : ''}}"><text>TOP</text><text>{{index + 1}}</text></view>
          </view>
          <text class="hot-rank-post-title" user-select>{{item.title || item.content}}</text>
          <view class="hot-rank-media" wx:if="{{item.hotImages.length || item.hasVideo}}">
            <image wx:for="{{item.hotImages}}" wx:for-item="img" wx:key="*this" class="hot-media" src="{{img}}" mode="aspectFill" lazy-load></image>
            <view wx:if="{{item.hasVideo}}" class="hot-media hot-media-video"><text class="hot-video-play">▶</text></view>
          </view>
          <view class="hot-rank-footer"><view class="hot-rank-campus">{{item.campus || '未设置校区'}}</view><view class="hot-rank-stats"><view><image src="/assets/icons/heart-outline.png" mode="aspectFit"></image><text>{{item.likeCount || '点赞'}}</text></view><view><image src="/assets/icons/comment.png" mode="aspectFit"></image><text>{{item.commentCount || 0}}</text></view></view></view>
        </view>
      </view>
      <view class="hot-rank-empty" wx:elif="{{!hotLoading}}">近两天暂无上榜帖子</view>
      <view class="hot-rank-empty" wx:else>榜单更新中...</view>
    </view>

    <!-- 帖子列表 - 骨架屏 -->
    <block wx:if="{{skeleton && !isHotCategory}}">
      <view class="sk-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-header">
          <view class="sk-avatar skeleton"></view>
          <view class="sk-user">
            <view class="sk-line sk-name skeleton"></view>
            <view class="sk-line sk-time skeleton"></view>
          </view>
        </view>
        <view class="sk-line sk-content skeleton"></view>
        <view class="sk-line sk-content-2 skeleton"></view>
      </view>
    </block>

    <!-- 帖子列表 -->
    <block wx:elif="{{!isHotCategory}}">
      <view wx:for="{{posts}}" wx:key="id" style="--i: {{index < 6 ? index : 0}};" class="post-feed anim-stagger">
        <post-card
          post="{{item}}"
          commentMode="sheet"
          avatarToDetail="{{true}}"
          bind:like="onPostLike"
          bind:favorite="onPostFavorite"
          bind:comment="onPostComment"
          bind:close="onPostClose"
          bind:remove="onPostRemove"
          bind:reviewnote="onPostReviewNote"
        />
      </view>
      <empty-state wx:if="{{posts.length === 0}}" text="暂无帖子" />
      <load-more loading="{{loading}}" hasMore="{{hasMore}}" />
    </block>
  </scroll-view>

  <view class="comment-sheet-mask" wx:if="{{commentSheetVisible}}" bindtap="closeCommentSheet"></view>
  <view class="comment-sheet" wx:if="{{commentSheetVisible}}" catchtap="noop" style="bottom: {{commentSheetKeyboardHeight}}px;">
    <view class="comment-sheet-handle"></view>
    <view class="comment-sheet-header">
      <text class="comment-sheet-title">评论 {{commentSheetTotal || (commentSheetPost.commentCount || 0)}}</text>
      <text class="comment-sheet-close" bindtap="closeCommentSheet">×</text>
    </view>

    <scroll-view class="comment-sheet-list" scroll-y enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMoreSheetComments">
      <view class="comment-sheet-loading" wx:if="{{commentSheetLoading}}">评论加载中...</view>
      <view class="comment-item" wx:for="{{commentSheetComments}}" wx:key="id">
        <image class="comment-avatar" src="{{item.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" lazy-load data-userid="{{item.userId}}" catchtap="onCommentAvatarTap"></image>
        <view class="comment-content-wrap">
          <view class="comment-head">
            <view class="comment-meta"><text class="comment-nick">{{item.nickName}}</text><view class="author-comment-label" wx:if="{{item.isAuthor}}">作者</view><text class="comment-time">{{item.timeText}}</text></view>
          </view>
          <view class="comment-body">
            <view class="comment-text-wrap"><text class="comment-reply-to" wx:if="{{item.replyToNick}}">回复 {{item.replyToNick}}：</text><text class="comment-text" user-select>{{item.content}}</text></view>
            <view class="comment-like spring-btn" hover-class="like-hover press-spring" hover-stay-time="80" catchtap="onSheetLikeComment" data-id="{{item.id}}"><view class="pa-icon pa-heart {{item.isLiked ? 'on' : ''}}"></view><text class="like-count" wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text></view>
          </view>
          <view class="comment-image-list" wx:if="{{item.images.length || item.videos.length}}">
            <image class="comment-image" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" lazy-load></image>
            <video wx:for="{{item.videos}}" wx:for-item="vid" wx:key="*this" class="comment-video" src="{{vid}}" object-fit="contain" controls></video>
          </view>
          <view class="reply-list" wx:if="{{item.replies.length}}">
            <view class="reply-item" wx:for="{{item.expanded ? item.replies : item.recentReplies}}" wx:for-item="reply" wx:key="id">
              <image class="reply-avatar" src="{{reply.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" lazy-load data-userid="{{reply.userId}}" catchtap="onCommentAvatarTap"></image>
              <view class="reply-content">
                <view class="comment-head">
                  <view class="comment-meta"><text class="comment-nick">{{reply.nickName}}</text><view class="author-comment-label" wx:if="{{reply.isAuthor}}">作者</view><text class="comment-time">{{reply.timeText}}</text></view>
                </view>
                <view class="comment-body">
                  <view class="comment-text-wrap"><text class="comment-reply-to" wx:if="{{reply.replyToNick}}">回复 {{reply.replyToNick}}：</text><text class="comment-text" user-select>{{reply.content}}</text></view>
                  <view class="comment-like spring-btn" hover-class="like-hover press-spring" hover-stay-time="80" catchtap="onSheetLikeComment" data-id="{{reply.id}}"><view class="pa-icon pa-heart {{reply.isLiked ? 'on' : ''}}"></view><text class="like-count" wx:if="{{reply.likeCount > 0}}">{{reply.likeCount}}</text></view>
                </view>
                <view class="comment-image-list" wx:if="{{reply.images.length || reply.videos.length}}">
                  <image class="comment-image" wx:for="{{reply.images}}" wx:for-item="image" wx:key="*this" src="{{image}}" mode="aspectFill" lazy-load></image>
                  <video wx:for="{{reply.videos}}" wx:for-item="vid" wx:key="*this" class="comment-video" src="{{vid}}" object-fit="contain" controls></video>
                </view>
              </view>
            </view>
            <view class="reply-toggle" wx:if="{{item.hasHiddenReplies}}" catchtap="toggleSheetCommentReplies" data-id="{{item.id}}"><text class="reply-toggle-line"></text><text>{{item.expanded ? '收起回复' : '展开 ' + item.hiddenReplyCount + ' 条回复'}}</text></view>
          </view>
        </view>
      </view>
      <view class="sheet-load-more" wx:if="{{!commentSheetLoading && commentSheetComments.length && commentSheetHasMore}}">
        <text>上滑加载更多</text>
      </view>
      <view class="comment-sheet-empty" wx:if="{{!commentSheetLoading && commentSheetComments.length === 0}}">
        <text>还没有评论，来坐第一排</text>
      </view>
    </scroll-view>

    <view class="sheet-preview-images" wx:if="{{commentSheetImages.length}}">
      <view class="sheet-preview-item" wx:for="{{commentSheetImages}}" wx:key="*this">
        <image class="sheet-preview-img" src="{{item}}" mode="aspectFill"></image>
        <view class="sheet-preview-remove" data-index="{{index}}" catchtap="onSheetRemoveImage">×</view>
      </view>
    </view>

    <view class="sheet-input-area">
      <input
        class="sheet-comment-input"
        value="{{commentSheetText}}"
        placeholder="发言要友善"
        focus="{{commentSheetFocus}}"
        cursor-spacing="24"
        adjust-position="{{false}}"
        bindinput="onSheetCommentInput"
        bindkeyboardheightchange="onSheetKeyboardChange"
      />
      <view class="sheet-send {{commentSheetText || commentSheetImages.length ? 'active' : ''}}" bindtap="onSheetSendComment">发送</view>
      <view class="sheet-tool" catchtap="toggleSheetEmojiPanel">😊</view>
      <view class="sheet-tool" catchtap="onSheetChooseImage">＋</view>
    </view>

    <view class="sheet-emoji-panel" wx:if="{{commentSheetEmojiVisible}}">
      <view class="sheet-emoji-item" wx:for="{{commentSheetEmojis}}" wx:key="*this" data-emoji="{{item}}" catchtap="onSheetEmojiTap">{{item}}</view>
    </view>
  </view>
</view>

<!-- 浮动操作按钮：放在 .page 外部，避免祖先 transform 导致 fixed 失效 -->
<view class="float-actions {{showTopBtn ? 'rise' : ''}}">
  <view class="float-btn spring-btn" wx:if="{{dailyHotVisible}}" hover-class="float-btn-pressed press-spring" hover-stay-time="120" aria-label="每日热榜" bindtap="onTodayHotTap">
    <text class="iconfont float-icon icon-remen float-icon-hot"></text>
  </view>
  <view class="float-btn spring-btn" hover-class="float-btn-pressed press-spring" hover-stay-time="120" aria-label="消息通知" bindtap="goMessages">
    <text class="iconfont float-icon icon-xiaoxi1 float-icon-msg"></text>
    <view class="float-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
  </view>
  <view class="float-btn float-btn-top {{showTopBtn ? 'show' : ''}} spring-btn" hover-class="float-btn-pressed press-spring" hover-stay-time="120" aria-label="回到顶部" bindtap="onScrollToTop">
    <text class="iconfont float-icon icon-zhiding"></text>
  </view>
</view>

<update-dialog
  visible="{{updateDialogVisible}}"
  latest-version="{{updateLatestVersion}}"
  local-version="{{updateLocalVersion}}"
  updating="{{updateDialogUpdating}}"
  bindconfirm="onVersionUpdateConfirm"
  bindcancel="onVersionUpdateCancel"
></update-dialog>
