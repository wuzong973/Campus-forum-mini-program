<view class="page">
  <!-- 收益卡片（与"我的"钱包数据互通，提现需前往钱包申请） -->
  <view class="earn-card gradient-nav" bindtap="goWallet">
    <text class="earn-label">可提现余额（请点击余额前往提现）</text>
    <text class="earn-value">¥{{wallet.balance}}</text>
    <text class="earn-meta">累计收益 ¥{{wallet.earned}}</text>
  </view>

  <!-- 订单数量 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{counts.pending}}</text>
      <text class="stat-label">待接单</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{counts.inProgress}}</text>
      <text class="stat-label">待完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{counts.done}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{counts.cancelled}}</text>
      <text class="stat-label">已取消</text>
    </view>
  </view>

  <!-- 顶部标签（指示条为液态拉伸样式，utils/liquid-tab.js 驱动） -->
  <view class="top-tabs liquid-tab-track">
    <view
      class="top-tab {{activeTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onTab"
    >{{item}}</view>
    <view class="liquid-indicator {{liquidPhase}}" style="{{liquidStyle}}"></view>
  </view>

  <!-- 状态筛选 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view class="filter-list">
      <view
        class="filter-chip {{activeStatus === index ? 'active' : ''}}"
        wx:for="{{statusFilters}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onStatusFilter"
      >{{item}} <text class="filter-count" wx:if="{{index === 0}}">{{counts.unpaid}}</text></view>
    </view>
  </scroll-view>

  <!-- 订单列表（与接单大厅一致的版式：头像+昵称+校区/性别标签+状态胶囊 / 公开描述+红色金额 / 期望完成时间） -->
  <view class="order-list">
    <block wx:for="{{orders}}" wx:key="id">
      <view class="order-card anim-stagger" style="--i: {{index < 6 ? index : 0}};" data-order="{{item}}" bindtap="onOpenDetail">
        <view class="card-head">
          <image class="card-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view class="card-user">
            <view class="card-name-row">
              <text class="card-name">{{item.authorName}}</text>
              <text class="card-tag tag-campus" wx:if="{{item.campus}}">{{item.campus}}</text>
              <text class="card-tag tag-gender-{{item.genderClass}}" wx:if="{{item.genderText}}">{{item.genderText}}</text>
            </view>
            <text class="card-time">{{item.publishTime}}</text>
          </view>
          <text class="status-pill {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="card-body">
          <view class="card-desc-row">
            <text class="card-title">{{item.descText}}</text>
            <text class="amount-price">¥{{item.price}}</text>
          </view>
          <text class="card-expect">期望时间：{{item.expectText}}</text>
          <text class="card-expect" wx:if="{{item.deadlineText}}">截止时间：{{item.deadlineText}}</text>
        </view>
        <view class="card-foot" wx:if="{{item.action}}">
          <view class="foot-actions">
            <view class="card-btn btn-pay" wx:if="{{item.action === 'pay'}}" catchtap="onPay" data-order="{{item}}">去支付</view>
            <view class="card-btn btn-finish" wx:elif="{{item.action === 'finish'}}" catchtap="onFinish" data-order="{{item}}">立即完成</view>
            <view class="card-btn btn-finish" wx:elif="{{item.action === 'confirm'}}" catchtap="onOpenDetail" data-order="{{item}}">去确认</view>
            <view class="card-btn btn-ghost" wx:elif="{{item.action === 'cancel'}}" catchtap="onCancel" data-order="{{item}}">取消订单</view>
            <view class="card-btn" wx:elif="{{item.action === 'contact'}}" catchtap="onContact" data-order="{{item}}">联系对方</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orders.length === 0}}">
    <text class="empty-title">{{emptyText}}</text>
    <text class="empty-desc" wx:if="{{!needLogin}}">你可以调整标签或状态筛选，也可以下拉刷新再看看。</text>
    <view class="empty-publish-btn" wx:if="{{needLogin}}" bindtap="goLogin">去登录</view>
  </view>

  <!-- 空状态发布入口 -->
  <view class="empty-publish" wx:if="{{orders.length === 0 && !needLogin}}">
    <text class="empty-publish-desc">你可以去发布新的需求，或切换其他标签查看历史订单。</text>
    <view class="empty-publish-btn" bindtap="goPublish">去发布需求</view>
  </view>

  <!-- 右侧浮动导航（发布/消息/首页，保持在右下角） -->
  <view class="float-nav">
    <view class="float-item spring-btn" hover-class="float-item-hover press-spring" hover-stay-time="80" bindtap="goPublish"><text class="float-icon">✚</text><text class="float-label">发布</text></view>
    <view class="float-item spring-btn" hover-class="float-item-hover press-spring" hover-stay-time="80" bindtap="goMessages"><text class="float-icon">✉</text><text class="float-label">消息</text></view>
    <view class="float-item spring-btn" hover-class="float-item-hover press-spring" hover-stay-time="80" bindtap="goHallHome"><text class="float-icon">⌂</text><text class="float-label">首页</text></view>
  </view>

</view>
