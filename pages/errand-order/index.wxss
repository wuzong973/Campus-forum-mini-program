.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-home-icon {
  width: 40rpx;
  height: 40rpx;
  transition: var(--transition-fast);
}

.nav-home-icon:active {
  transform: scale(0.88);
  opacity: 0.8;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.nav-right-placeholder {
  width: 40rpx;
}

.nav-placeholder {
  width: 100%;
}

/* 收益卡片（图二样式，数据与钱包互通，点击前往钱包提现） */
.earn-card {
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 16rpx;
  color: #fff;
  /* 覆盖全局 .gradient-nav 浅蓝背景：改为深蓝色，保证白色文字清晰可读 */
  background:
    radial-gradient(ellipse at 14% -6%, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 48%),
    linear-gradient(135deg, #16337f 0%, #1d4ed8 60%, #2563eb 100%);
  box-shadow: 0 8rpx 24rpx rgba(22, 51, 127, 0.32);
}

.earn-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.earn-value {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  margin: 12rpx 0 16rpx;
}

.earn-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 统计卡片 */
.stats-card {
  display: flex;
  margin: 20rpx 24rpx;
  padding: 24rpx 0;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 顶部标签 */
.top-tabs {
  display: flex;
  background: var(--card-bg);
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--divider);
}

.top-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-tertiary);
  position: relative;
  transition: var(--transition-fast);
}

.top-tab.active {
  color: var(--primary);
  font-weight: 600;
}

.top-tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--error);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

/* 状态筛选 */
.filter-scroll {
  white-space: nowrap;
  padding: 20rpx 24rpx;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
}

.filter-chip {
  padding: 12rpx 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.filter-chip.active {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 500;
}

.filter-count {
  font-size: 22rpx;
  color: var(--primary);
}

/* 订单列表 */
.order-list {
  padding: 8rpx 24rpx;
}

/* ===== 订单卡片（与接单大厅完全一致的版式） ===== */
.order-card {
  margin: 0 0 20rpx;
  padding: 26rpx 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
  transition: var(--transition-fast);
}

.order-card:active {
  transform: scale(0.99);
}

.card-head {
  display: flex;
  align-items: center;
}

.card-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eef2f7;
  flex-shrink: 0;
}

.card-user {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-left: 16rpx;
}

/* 昵称行：昵称 + 校区标签 + 性别限制标签 */
.card-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.card-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2b43;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tag {
  flex-shrink: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

/* 校区标签：蓝框白底 */
.tag-campus {
  border: 2rpx solid #4388ff;
  background: #ffffff;
  color: #4388ff;
}

/* 性别限制标签：浅色填充，按限制值区分颜色 */
.tag-gender-male { background: #e8f1ff; color: #3478f6; }
.tag-gender-female { background: #ffeef4; color: #f0479c; }
.tag-gender-any { background: #f1f3f6; color: #8a94a6; }

.card-time {
  font-size: 22rpx;
  color: #a5adbb;
}

/* 描述行：公开描述 + 右侧红色金额 */
.card-desc-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.card-desc-row .card-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2a3547;
  line-height: 1.55;
  word-break: break-all;
}

.card-desc-row .amount-price {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #e64340;
}

/* 右上角状态胶囊 */
.status-pill {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid currentColor;
  background: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pill.pending { color: #ff9f40; }
.status-pill.accepted { color: var(--primary); }
.status-pill.done { color: var(--success); }
.status-pill.unpaid { color: #e64340; }
.status-pill.cancelled { color: #9aa3b2; }
.status-pill.refunding { color: #faad14; }

/* 卡片内容：期望完成时间 */
.card-body {
  margin-top: 20rpx;
}

.card-expect {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #2a3547;
  line-height: 1.5;
}

/* 底部：操作按钮 */
.card-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 26rpx;
}

.foot-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-btn {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #e9f0ff;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.card-btn:active { opacity: 0.75; }

.card-btn.btn-pay {
  background: #ffece8;
  color: #e64340;
}

.card-btn.btn-finish {
  background: #e7f8ec;
  color: var(--success);
}

.card-btn.btn-ghost {
  background: #f5f6fa;
  color: #5a6472;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx 0;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2a3547;
  text-align: center;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #98a2b3;
  text-align: center;
  line-height: 1.6;
}

/* 空状态发布入口 */
.empty-publish {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 48rpx;
}

.empty-publish-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-publish-btn {
  padding: 20rpx 48rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

.empty-publish-btn:active {
  transform: scale(0.96);
}

/* ===== 右侧浮动导航（发布/消息/首页，保持在右下角） ===== */
.float-nav {
  position: fixed;
  right: 16rpx;
  bottom: 200rpx;
  z-index: 7;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  background: rgba(35, 48, 70, 0.88);
  border-radius: 40rpx;
  padding: 10rpx 8rpx;
}

.float-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  width: 88rpx;
  padding: 8rpx 0;
  color: #fff;
  border-radius: 28rpx;
  transition: opacity 0.2s ease;
}

.float-item-hover {
  opacity: 0.65;
}

.float-icon {
  font-size: 32rpx;
  line-height: 1.1;
}

.float-label {
  font-size: 20rpx;
  color: #cfd8e6;
}
