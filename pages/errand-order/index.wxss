.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-home-icon {
  width: 40rpx;
  height: 40rpx;
  transition: var(--transition-fast);
}

.nav-home-icon:active {
  transform: scale(0.88);
  opacity: 0.8;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.nav-right-placeholder {
  width: 40rpx;
}

.nav-placeholder {
  width: 100%;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  margin: 20rpx 24rpx;
  padding: 24rpx 0;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 顶部标签 */
.top-tabs {
  display: flex;
  background: var(--card-bg);
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--divider);
}

.top-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-tertiary);
  position: relative;
  transition: var(--transition-fast);
}

.top-tab.active {
  color: var(--primary);
  font-weight: 600;
}

.top-tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--error);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

/* 状态筛选 */
.filter-scroll {
  white-space: nowrap;
  padding: 20rpx 24rpx;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
}

.filter-chip {
  padding: 12rpx 28rpx;
  background: var(--card-bg);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.filter-chip.active {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 500;
}

.filter-count {
  font-size: 22rpx;
  color: var(--primary);
}

/* 订单列表 */
.order-list {
  padding: 8rpx 24rpx;
}

/* 空状态发布入口 */
.empty-publish {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 48rpx;
}

.empty-publish-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-publish-btn {
  padding: 20rpx 48rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 500;
}

.empty-publish-btn:active {
  transform: scale(0.96);
}
