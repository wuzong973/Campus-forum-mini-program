<view class="chat-container">
  <!-- 消息列表 -->
  <scroll-view
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    scroll-with-animation
    bindscrolltoupper="onLoadMore"
  >
    <view class="message-item {{item.isSelf ? 'self' : 'other'}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="message-content">
        <view class="message-bubble {{item.type === 'image' ? 'image-bubble' : ''}}">
          <text wx:if="{{item.type === 'text'}}" class="message-text">{{item.content}}</text>
          <image wx:elif="{{item.type === 'image'}}" class="message-image" src="{{item.content}}" mode="widthFix" data-src="{{item.content}}" catchtap="onPreviewImage"></image>
          <text wx:else class="message-emoji">{{item.content}}</text>
        </view>
        <text class="time">{{item.timeText}}</text>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="loading-more">加载中...</view>
  </scroll-view>

  <!-- 微信式输入区 -->
  <view class="input-area">
    <view class="emoji-panel" wx:if="{{activePanel === 'emoji'}}">
      <view class="emoji-grid">
        <text
          class="emoji-item"
          wx:for="{{emojiList}}"
          wx:key="*this"
          bindtap="onEmojiTap"
          data-emoji="{{item}}"
        >{{item}}</text>
      </view>
    </view>

    <view class="tool-panel" wx:if="{{activePanel === 'tools'}}">
      <view class="tool-panel-item" bindtap="onChooseImage">
        <text class="tool-panel-icon">▣</text>
        <text class="tool-panel-label">照片</text>
      </view>
    </view>

    <view class="input-toolbar">
      <view class="tool-btn voice-btn" bindtap="onToggleVoice"><text>{{voiceMode ? '⌨' : '◉'}}</text></view>
      <view class="input-wrapper" wx:if="{{!voiceMode}}">
        <input
          class="message-input"
          placeholder=""
          value="{{inputValue}}"
          bindinput="onInput"
          bindfocus="onInputFocus"
          bindconfirm="onSend"
          confirm-type="send"
          focus="{{inputFocus}}"
        />
      </view>
      <view class="voice-input" wx:else bindtouchstart="onVoiceHint">按住说话</view>
      <view class="tool-btn" bindtap="onToggleEmoji"><text>☺</text></view>
      <view class="tool-btn" wx:if="{{!inputValue}}" bindtap="onToggleTools"><text>＋</text></view>
      <view class="send-btn" wx:else bindtap="onSend">发送</view>
    </view>
  </view>
</view>
