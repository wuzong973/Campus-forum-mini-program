.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

/* 自定义导航栏 */
.custom-nav {
  background: #7dd3c0;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  /* 右侧预留胶囊按钮区域，避免标题组与其重叠 */
  padding: 0 200rpx 0 16rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 100%;
  flex-shrink: 0;
}

.nav-back-icon {
  color: #ffffff;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -6rpx;
}

.nav-back-hover {
  opacity: 0.6;
}

.nav-title-wrap {
  /* 相对整个导航栏绝对定位，保证「回到帖子」在屏幕水平正中（不受右侧胶囊预留区影响） */
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.back-post-btn {
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
  flex-shrink: 0;
  transition:
    background-color 0.2s ease,
    opacity 0.2s ease;
}

.back-post-hover {
  background: rgba(255, 255, 255, 0.4);
}

.back-post-btn.is-returning {
  opacity: 0.55;
}

/* 顶部安全提示栏（整体单行显示） */
.chat-notice {
  background: #f0f1f2;
  padding: 12rpx 16rpx;
}
.notice-line {
  /* flex 单行布局：contact-admin 组件内部是块级元素会强制换行，
     改为 flex 后各段作为子项排在一行 */
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.notice-text {
  color: #7f8792;
  font-size: 24rpx;
}
.notice-contact {
  display: inline;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  color: #3d7dff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.7;
  vertical-align: baseline;
  text-decoration: underline;
}
.notice-contact::after {
  border: none;
}
contact-admin.inline-contact {
  display: inline;
}
.notice-diamond {
  font-size: 20rpx;
  margin-right: 4rpx;
}
.notice-block {
  color: #3d7dff;
  font-size: 24rpx;
  text-decoration: underline;
}
.notice-block.is-blocked {
  color: #fa5151;
}
.notice-press {
  opacity: 0.55;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx 0 12rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
  /* 水平留白放在消息行上：scroll-view 的水平 padding 在部分端上不生效，
     会导致右侧头像贴边被裁剪 */
  padding: 0 24rpx;
  box-sizing: border-box;
}

.message-item.self {
  flex-direction: row-reverse;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.message-content {
  max-width: 72%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.message-item.self .message-content {
  align-items: flex-end;
}

.message-bubble {
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.message-item.self .message-bubble {
  background: #95ec69;
}

.message-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-word;
}

.message-item.self .message-text {
  color: #191919;
}

.message-image {
  width: 360rpx;
  max-height: 480rpx;
  border-radius: 6rpx;
  display: block;
}

.message-bubble.image-bubble {
  padding: 0;
  overflow: hidden;
}
.message-emoji {
  display: block;
  font-size: 56rpx;
  line-height: 1.2;
}

.time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 输入区域 */
.input-area {
  background: #f7f7f7;
  border-top: 1rpx solid #d7d7d7;
  padding-bottom: env(safe-area-inset-bottom);
}
.anonymous-chat-tip,
.send-limit-tip {
  padding: 12rpx 24rpx;
  color: #63748a;
  background: #eef5ff;
  font-size: 22rpx;
  line-height: 1.45;
}
.send-limit-tip {
  border-top: 1rpx solid #dce8f7;
  color: #3971c9;
  background: #f5f9ff;
}
.send-limit-tip.block-tip {
  color: #b25000;
  background: #fff7e8;
  border-top-color: #f3e3c8;
}

.input-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 22rpx;
}

.tool-btn {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 52rpx;
  line-height: 1;
  color: #191919;
}

.input-wrapper {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 8rpx;
}

.voice-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 8rpx;
  color: #191919;
  font-size: 28rpx;
}

.message-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 30rpx;
  color: #191919;
  box-sizing: border-box;
}

.send-btn {
  height: 62rpx;
  min-width: 100rpx;
  padding: 0 18rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 27rpx;
}

.tool-panel {
  display: flex;
  min-height: 250rpx;
  padding: 28rpx 38rpx;
  border-top: 1rpx solid #e5e5e5;
}

.tool-panel-item {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.tool-panel-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 52rpx;
}
.tool-panel-label {
  color: #555;
  font-size: 23rpx;
}

/* 表情面板 */
.emoji-panel {
  max-height: 390rpx;
  overflow: hidden;
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  padding: 20rpx;
  gap: 12rpx;
}

.emoji-item {
  font-size: 40rpx;
  text-align: center;
  padding: 8rpx;
}

.emoji-item:active {
  background: #f5f5f5;
  border-radius: 8rpx;
}
