.page {
  min-height: 100vh;
  background: #f0f2f5;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-back {
  font-size: 36rpx;
  color: #333;
}

.nav-center {
  flex: 1;
  text-align: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-right {
  width: 80rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx 24rpx 0;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  height: 1px;
}

.load-more-tip,
.empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 0;
}

.empty-tip {
  padding: 120rpx 0;
}

/* 消息项 */
.message-item {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}

.message-item.mine {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.msg-bubble-wrap {
  max-width: 480rpx;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.message-item.mine .msg-bubble-wrap {
  align-items: flex-end;
}

.msg-bubble {
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
  position: relative;
}

.bubble-other {
  background: #ffffff;
  color: #1a1a1a;
  border-top-left-radius: 4rpx;
}

.bubble-mine {
  background: #4A7AFF;
  color: #ffffff;
  border-top-right-radius: 4rpx;
}

.msg-text {
  font-size: 28rpx;
}

.msg-image {
  width: 360rpx;
  max-height: 360rpx;
  border-radius: 12rpx;
}

.bubble-image {
  padding: 8rpx;
  background: transparent !important;
}

.msg-time {
  font-size: 20rpx;
  color: #bbbbbb;
  margin-top: 8rpx;
}

.msg-status {
  margin-top: 4rpx;
}

.status-sending {
  font-size: 20rpx;
  color: #bbbbbb;
}

.status-sent {
  font-size: 20rpx;
  color: #bbbbbb;
}

.status-read {
  font-size: 20rpx;
  color: #4A7AFF;
}

.status-failed {
  font-size: 20rpx;
  color: #FF4D4F;
}

/* 底部输入栏 */
.input-bar {
  padding: 12rpx 20rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  z-index: 300;
  box-shadow: 0 -10rpx 28rpx rgba(30, 64, 175, 0.08);
}

.input-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 36rpx;
  padding: 0 8rpx 0 24rpx;
  height: 72rpx;
  gap: 8rpx;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
  color: #333333;
  min-width: 0;
}

.send-text {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #999999;
  font-weight: 500;
  flex-shrink: 0;
}

.send-text.active {
  color: #4A7AFF;
  font-weight: 600;
}

.emoji-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.emoji-icon {
  font-size: 32rpx;
}

.plus-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E0F2F1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plus-icon {
  font-size: 32rpx;
  color: #4A7AFF;
  font-weight: 600;
}

/* 表情面板 */
.emoji-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 299;
  box-shadow: 0 -10rpx 28rpx rgba(30, 64, 175, 0.08);
}

.emoji-panel.show {
  transform: translateY(0);
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.emoji-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f8f9fa;
}

.emoji-item text {
  font-size: 44rpx;
}

.emoji-item:active {
  background: #eef3ff;
}
