.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

/* 自定义导航栏 */
.custom-nav {
  /* 与首页顶部一致的渐变（180deg：#d7efff → #eaf6ff，叠加同款淡蓝径向高光） */
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 100%);
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  /* 右侧预留胶囊按钮区域，避免标题组与其重叠 */
  padding: 0 200rpx 0 16rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 100%;
  flex-shrink: 0;
}

.nav-back-icon {
  color: #1d3048;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -6rpx;
}

.nav-back-hover {
  opacity: 0.6;
}

.nav-title-wrap {
  /* 相对整个导航栏绝对定位，保证「回到帖子」在屏幕水平正中（不受右侧胶囊预留区影响） */
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.back-post-btn {
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(29, 48, 72, 0.35);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  color: #1d3048;
  font-size: 22rpx;
  line-height: 1.5;
  white-space: nowrap;
  flex-shrink: 0;
  transition:
    background-color 0.2s ease,
    opacity 0.2s ease;
}

.back-post-hover {
  background: rgba(255, 255, 255, 0.8);
}

.back-post-btn.is-returning {
  opacity: 0.55;
}

/* 顶部安全提示栏（整体单行显示） */
.chat-notice {
  background: #f0f1f2;
  padding: 12rpx 16rpx;
}
.notice-line {
  /* flex 单行布局：contact-admin 组件内部是块级元素会强制换行，
     改为 flex 后各段作为子项排在一行 */
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}
.notice-text {
  color: #7f8792;
  font-size: 24rpx;
}
.notice-contact {
  display: inline;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  color: #3d7dff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.7;
  vertical-align: baseline;
  text-decoration: underline;
}
.notice-contact::after {
  border: none;
}
contact-admin.inline-contact {
  display: inline;
}
.notice-diamond {
  font-size: 20rpx;
  margin-right: 4rpx;
}
.notice-block {
  color: #3d7dff;
  font-size: 24rpx;
  text-decoration: underline;
}
.notice-block.is-blocked {
  color: #fa5151;
}
.notice-press {
  opacity: 0.55;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx 0 12rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
  /* 水平留白放在消息行上：scroll-view 的水平 padding 在部分端上不生效，
     会导致右侧头像贴边被裁剪 */
  padding: 0 24rpx;
  box-sizing: border-box;
}

.message-item.self {
  flex-direction: row-reverse;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.message-content {
  max-width: 72%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.message-item.self .message-content {
  align-items: flex-end;
}

.message-bubble {
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.message-item.self .message-bubble {
  background: #95ec69;
}

.message-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-word;
}

.message-item.self .message-text {
  color: #191919;
}

.message-image {
  width: 360rpx;
  max-height: 480rpx;
  border-radius: 6rpx;
  display: block;
}

/* 图片/视频消息：气泡去内边距 */
.message-bubble.media-bubble {
  padding: 0;
  overflow: hidden;
}

.message-video {
  width: 380rpx;
  height: 300rpx;
  display: block;
  background: #000000;
  border-radius: 6rpx;
}
.message-emoji {
  display: block;
  font-size: 56rpx;
  line-height: 1.2;
}

.time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 输入区域（微信原生风格） */
.input-area {
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: env(safe-area-inset-bottom);
}
.anonymous-chat-tip,
.send-limit-tip {
  padding: 12rpx 24rpx;
  color: #63748a;
  background: #eef5ff;
  font-size: 22rpx;
  line-height: 1.45;
}
.send-limit-tip {
  border-top: 1rpx solid #dce8f7;
  color: #3971c9;
  background: #f5f9ff;
}
.send-limit-tip.block-tip {
  color: #b25000;
  background: #fff7e8;
  border-top-color: #f3e3c8;
}

.input-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx;
}

/* 工具按钮：细线图标（微信风格） */
.tool-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 10rpx;
  color: #1a1a1a;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.tool-btn-hover { opacity: 0.55; transform: scale(0.92); }

/* 麦克风图标 */
.icon-voice {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}
.icon-voice::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 3rpx;
  transform: translateX(-50%);
  width: 17rpx;
  height: 27rpx;
  border: 3.5rpx solid currentColor;
  border-radius: 9rpx;
  box-sizing: border-box;
}
.icon-voice::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 24rpx;
  transform: translateX(-50%);
  width: 32rpx;
  height: 24rpx;
  border: 3.5rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  box-sizing: border-box;
}
/* 语音模式切换为键盘图标 */
.icon-voice.is-keyboard::before {
  top: 10rpx;
  width: 42rpx;
  height: 32rpx;
  border-radius: 6rpx;
}
.icon-voice.is-keyboard::after {
  top: 26rpx;
  width: 16rpx;
  height: 4rpx;
  border: none;
  border-radius: 2rpx;
  background: currentColor;
}

/* 表情图标（笑脸） */
.icon-emoji {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border: 3.5rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.icon-emoji::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 13rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 16rpx 0 0 currentColor;
}
.icon-emoji::after {
  content: '';
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 11rpx;
  border: 3.5rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 16rpx 16rpx;
  box-sizing: border-box;
}

/* 加号图标 */
.icon-plus {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}
.icon-plus::before,
.icon-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.icon-plus::before { transform: translate(-50%, -50%); }
.icon-plus::after { transform: translate(-50%, -50%) rotate(90deg); }

.voice-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 8rpx;
  color: #191919;
  font-size: 28rpx;
  font-weight: 500;
}

.voice-hover { background: #ececec; }

.message-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 30rpx;
  color: #191919;
  background: #ffffff;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.send-btn {
  height: 64rpx;
  min-width: 104rpx;
  padding: 0 20rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 500;
  flex-shrink: 0;
  transition: transform 0.15s ease, background-color 0.15s ease;
}

.send-btn-hover { background: #06ad56; transform: scale(0.96); }

/* ＋ 功能面板（照片/视频） */
.tool-panel {
  display: flex;
  gap: 36rpx;
  min-height: 280rpx;
  padding: 32rpx 40rpx;
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  box-sizing: border-box;
}

.tool-panel-item {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.tool-item-hover { opacity: 0.6; transform: scale(0.95); }

.tool-tile {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-radius: 20rpx;
}

/* 照片图标 */
.tool-icon-photo {
  position: relative;
  width: 52rpx;
  height: 44rpx;
  border: 3.5rpx solid #595f6b;
  border-radius: 8rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.tool-icon-photo::before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 8rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #595f6b;
}
.tool-icon-photo::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 20rpx;
  height: 20rpx;
  background: #595f6b;
}

/* 视频图标 */
.tool-icon-video {
  position: relative;
  width: 54rpx;
  height: 44rpx;
  border: 3.5rpx solid #595f6b;
  border-radius: 10rpx;
  box-sizing: border-box;
}
.tool-icon-video::after {
  content: '';
  position: absolute;
  left: 53%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-left: 14rpx solid #595f6b;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
}

.tool-panel-label {
  color: #555555;
  font-size: 23rpx;
}

/* 表情面板 */
.emoji-panel {
  max-height: 390rpx;
  overflow: hidden;
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  padding: 20rpx;
  gap: 12rpx;
}

.emoji-item {
  font-size: 40rpx;
  text-align: center;
  padding: 8rpx;
}

.emoji-item:active {
  background: #f5f5f5;
  border-radius: 8rpx;
}
