.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx 24rpx 12rpx;
  overflow-y: auto;
}

.message-item {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message-item.self {
  flex-direction: row-reverse;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.message-content {
  max-width: 72%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.message-item.self .message-content {
  align-items: flex-end;
}

.message-bubble {
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #fff;
}

.message-item.self .message-bubble {
  background: #95ec69;
}

.message-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-word;
}

.message-item.self .message-text {
  color: #191919;
}

.message-image {
  width: 360rpx;
  max-height: 480rpx;
  border-radius: 6rpx;
  display: block;
}

.message-bubble.image-bubble { padding: 0; overflow: hidden; }
.message-emoji { display: block; font-size: 56rpx; line-height: 1.2; }

.time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.loading-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 输入区域 */
.input-area {
  background: #f7f7f7;
  border-top: 1rpx solid #d7d7d7;
  padding-bottom: env(safe-area-inset-bottom);
}

.input-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 22rpx;
}

.tool-btn {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 52rpx;
  line-height: 1;
  color: #191919;
}

.input-wrapper {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 8rpx;
}

.voice-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 8rpx;
  color: #191919;
  font-size: 28rpx;
}

.message-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 30rpx;
  color: #191919;
  box-sizing: border-box;
}

.send-btn {
  height: 62rpx;
  min-width: 100rpx;
  padding: 0 18rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 27rpx;
}

.tool-panel {
  display: flex;
  min-height: 250rpx;
  padding: 28rpx 38rpx;
  border-top: 1rpx solid #e5e5e5;
}

.tool-panel-item { width: 120rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.tool-panel-icon { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 12rpx; background: #ffffff; color: #4b5563; font-size: 52rpx; }
.tool-panel-label { color: #555; font-size: 23rpx; }

/* 表情面板 */
.emoji-panel {
  max-height: 390rpx;
  overflow: hidden;
  background: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  padding: 20rpx;
  gap: 12rpx;
}

.emoji-item { font-size: 40rpx; text-align: center; padding: 8rpx; }

.emoji-item:active {
  background: #f5f5f5;
  border-radius: 8rpx;
}
