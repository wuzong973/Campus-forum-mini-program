.webview-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  color: #969799;
  font-size: 28rpx;
}

/* 非可信域名兜底页：展示链接并引导复制到浏览器打开 */
.webview-blocked {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 0;
  text-align: center;
}

.blocked-icon {
  font-size: 72rpx;
  line-height: 1;
}

.blocked-title {
  margin-top: 24rpx;
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 600;
}

.blocked-desc {
  margin-top: 16rpx;
  color: #98a2b3;
  font-size: 26rpx;
  line-height: 1.6;
}

.blocked-url {
  width: 100%;
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f5f8ff;
  color: #3d7bfa;
  font-size: 26rpx;
  word-break: break-all;
  text-align: left;
}

.blocked-btn {
  margin-top: 40rpx;
  padding: 20rpx 80rpx;
  border-radius: 999rpx;
  background: #3d7bfa;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.blocked-btn:active { opacity: .8; }
