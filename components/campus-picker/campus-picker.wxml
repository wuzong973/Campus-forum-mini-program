<view wx:if="{{visible}}" class="cp-mask" bindtap="onClose">
  <view class="cp-panel" catchtap="noop">
    <view class="cp-head">
      <text class="cp-title">校区选择</text>
    </view>

    <!-- 仅主校区模式：广州校区 / 佛山校区两格直选（校园评价等必选主校区场景） -->
    <block wx:if="{{mainOnly}}">
      <view class="cp-grid">
        <view
          wx:for="{{groups}}"
          wx:key="name"
          class="cp-option {{value === item.name ? 'cp-option--active' : ''}}"
          data-value="{{item.name}}"
          bindtap="onPick"
        >{{item.name}}</view>
      </view>
      <view class="cp-tip">请选择你所在的主校区</view>
    </block>

    <!-- 二级结构模式：一级主校区点击展开下属分校区 -->
    <block wx:elif="{{twoLevel}}">
      <view class="cp-groups">
        <view
          wx:for="{{groups}}"
          wx:key="name"
          class="cp-group"
        >
          <view
            class="cp-group-row {{value === item.name ? 'cp-group-row--active' : ''}} spring-btn"
            data-name="{{item.name}}"
            bindtap="onGroupTap"
            hover-class="cp-group-row--hover press-spring"
            hover-stay-time="80"
          >
            <text class="cp-group-name">{{item.name}}</text>
            <text class="cp-group-arrow">{{expanded === item.name ? '▴' : '▾'}}</text>
          </view>
          <view wx:if="{{expanded === item.name}}" class="cp-sub-grid anim-fade">
            <view
              wx:for="{{item.subs}}"
              wx:for-item="sub"
              wx:key="*this"
              class="cp-option {{value === sub ? 'cp-option--active' : ''}}"
              data-value="{{sub}}"
              bindtap="onPick"
            >{{sub}}</view>
          </view>
        </view>
      </view>
      <view class="cp-tip">点击主校区展开分校区，选择你所在的校区</view>
    </block>

    <!-- 普通模式：仅保留主校区层级（全部校区 + 两个主校区） -->
    <block wx:else>
      <view class="cp-grid">
        <view class="cp-option {{value === '' ? 'cp-option--active' : ''}}" data-value="" bindtap="onPick">全部校区</view>
        <view
          wx:for="{{groups}}"
          wx:key="name"
          class="cp-option {{value === item.name ? 'cp-option--active' : ''}}"
          data-value="{{item.name}}"
          bindtap="onPick"
        >{{item.name}}</view>
      </view>

      <view class="cp-tip">选择活动/群聊归属的校区</view>
    </block>
  </view>
</view>
