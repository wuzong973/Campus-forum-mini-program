<view class="contact-admin">
  <view class="contact-admin-trigger" catchtap="openMenu">
    <slot name="trigger"></slot>
  </view>

  <!-- 弹窗通过 root-portal 挂到页面根节点渲染：
       组件位于四列网格 feature-item 内，父级的 :active transform（scale）和页面
       page-enter 动画残留的 transform 会把 position:fixed 的包含块劫持到网格单元，
       导致第二次打开时弹窗被压成一条细竖列（错乱）。root-portal 可彻底脱离这些祖先。 -->
  <root-portal wx:if="{{showMenu}}">
    <view class="contact-admin-mask" catchtap="closeMenu"></view>
    <view class="contact-admin-sheet" catchtap="stopPropagation">
      <view class="contact-admin-sheet-head">
        <view class="contact-admin-sheet-title">联系管理员</view>
        <view class="contact-admin-close" catchtap="closeMenu">×</view>
      </view>
      <view class="contact-admin-options">
        <button hover-class="press-spring" class="contact-admin-option online spring-btn" open-type="contact" bindcontact="onCustomerServiceContact" hover-stay-time="120">
          <text class="contact-admin-option-icon">◉</text>
          <view class="contact-admin-option-copy">
            <text class="contact-admin-option-title">在线联系</text>
            <text class="contact-admin-option-desc">进入微信客服会话</text>
          </view>
          <text class="contact-admin-option-arrow">›</text>
        </button>
        <view class="contact-admin-option wechat" catchtap="openQr">
          <text class="contact-admin-option-icon">⌁</text>
          <view class="contact-admin-option-copy">
            <text class="contact-admin-option-title">添加微信</text>
            <text class="contact-admin-option-desc">扫码添加管理员微信</text>
          </view>
          <text class="contact-admin-option-arrow">›</text>
        </view>
      </view>
      <view class="contact-admin-cancel" catchtap="closeMenu">取消</view>
    </view>
  </root-portal>

  <root-portal wx:if="{{showQr}}">
    <view class="contact-admin-mask {{qrExpanded ? 'is-zoom' : ''}}" catchtap="closeQr"></view>
    <view class="contact-admin-qr-dialog {{qrExpanded ? 'is-expanded' : ''}}" catchtap="stopPropagation">
      <!-- 放大态整条标题栏隐藏：放大后就是一张满屏的二维码大图（对齐微信图片查看器，零 UI）。
           退出方式随之改为「点弹层任意处」——stopPropagation() 在放大态收起，
           所以这里不再需要「点击可缩小」的提示文案。 -->
      <view class="contact-admin-qr-head" wx:if="{{!qrExpanded}}">
        <view>
          <text class="contact-admin-qr-title">{{qrTitle}}</text>
          <text class="contact-admin-qr-desc">长按图片可保存或识别，点击可放大</text>
        </view>
        <view class="contact-admin-close" catchtap="closeQr">×</view>
      </view>
      <!-- 长按 = 微信原生菜单（保存图片 / 发送给朋友 / 收藏 / 识别）。
           放大**必须留在页面内**：show-menu-by-longpress 只作用于页面里的 <image>，
           一旦改走 wx.previewImage（微信自带查看器），长按菜单就由微信决定、
           小程序注入不进去 —— 用户实测「放大后长按没菜单」就是这么来的。
           所以点击只做同一张图的尺寸切换，mode 在 widthFix/aspectFit 间换，不影响长按菜单。
           ⚠ 点击必须用 catchtap，不能改回 bindtap：放大态整层绑了 catchtap="stopPropagation"
           （点弹层任意处退出放大），bindtap 会冒泡上去，刚放大就被同一层立刻收起，
           端上表现成「点击后无法放大」。 -->
      <image
        class="contact-admin-qr {{qrExpanded ? 'is-full' : ''}}"
        src="{{qrImage}}"
        mode="{{qrExpanded ? 'aspectFit' : 'widthFix'}}"
        show-menu-by-longpress="{{true}}"
        catchtap="toggleQrZoom"
      ></image>
      <block wx:if="{{!qrExpanded}}">
        <button hover-class="press-spring" class="contact-admin-qr-btn spring-btn" bindtap="openQrPage" hover-stay-time="120">点击此处即可跳转</button>
        <view class="contact-admin-qr-tip">个人好友码在小程序内识别不出（微信限制）：请长按选「保存图片」，再用微信「扫一扫 → 相册」选这张图添加</view>
      </block>
    </view>
  </root-portal>
</view>
