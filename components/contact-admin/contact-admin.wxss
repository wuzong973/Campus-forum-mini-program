:host {
  display: block;
}

.contact-admin,
.contact-admin-trigger {
  display: block;
}

.contact-admin-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 25, 42, .52);
}

.contact-admin-sheet,
.contact-admin-qr-dialog {
  position: fixed;
  z-index: 2001;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 18rpx 60rpx rgba(16, 33, 58, .2);
}

.contact-admin-sheet {
  right: 0;
  bottom: 0;
  left: 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
}

.contact-admin-sheet-head,
.contact-admin-qr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-admin-sheet-title,
.contact-admin-qr-title {
  color: #18263d;
  font-size: 36rpx;
  font-weight: 700;
}

.contact-admin-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: #f3f5f8;
  color: #667386;
  text-align: center;
  font-size: 44rpx;
  font-weight: 300;
}

.contact-admin-options {
  margin-top: 28rpx;
}

.contact-admin-option {
  display: flex;
  align-items: center;
  /* 覆盖微信 button 默认样式（width: 184px / margin: auto），保证与 view 卡片同宽 */
  width: 100% !important;
  min-height: 124rpx;
  box-sizing: border-box;
  margin: 0 0 20rpx !important;
  padding: 22rpx 24rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 18rpx;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.35;
  text-align: left;
}

.contact-admin-option::after {
  border: none;
}

.contact-admin-option:active,
.contact-admin-cancel:active,
.contact-admin-close:active {
  opacity: .65;
}

.contact-admin-option.online {
  border-color: #d9e8ff;
  background: #f5f9ff;
}

.contact-admin-option.wechat {
  margin-bottom: 0;
  border-color: #d9f0e5;
  background: #f5fbf8;
}

.contact-admin-option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: #347ff2;
  color: #fff;
  font-size: 32rpx;
}

.wechat .contact-admin-option-icon {
  background: #25b978;
}

.contact-admin-option-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.contact-admin-option-title {
  color: #1c2d46;
  font-size: 30rpx;
  font-weight: 700;
}

.contact-admin-option-desc {
  margin-top: 6rpx;
  color: #8290a3;
  font-size: 24rpx;
}

.contact-admin-option-arrow {
  margin-left: 14rpx;
  color: #a4afbd;
  font-size: 40rpx;
  line-height: 1;
}

.contact-admin-cancel {
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 44rpx;
  background: #f3f5f8;
  color: #536176;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
}

.contact-admin-qr-dialog {
  top: 50%;
  left: 50%;
  width: calc(100vw - 72rpx);
  max-width: 680rpx;
  padding: 30rpx 30rpx 34rpx;
  transform: translate(-50%, -50%);
  border-radius: 28rpx;
}

.contact-admin-qr-head {
  align-items: flex-start;
}

.contact-admin-qr-title {
  display: block;
  font-size: 34rpx;
}

.contact-admin-qr-desc {
  display: block;
  margin-top: 8rpx;
  color: #8b97a8;
  font-size: 23rpx;
}

.contact-admin-qr {
  display: block;
  width: 100%;
  max-width: 560rpx;
  height: auto;
  margin: 24rpx auto 0;
}

.contact-admin-qr-btn {
  width: 100% !important;
  height: 88rpx;
  margin: 26rpx 0 0 !important;
  padding: 0;
  border-radius: 44rpx;
  background: #25b978;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.contact-admin-qr-btn::after {
  border: none;
}

.contact-admin-qr-btn:active {
  opacity: .85;
}

.contact-admin-qr-tip {
  margin-top: 18rpx;
  color: #8995a5;
  font-size: 23rpx;
  text-align: center;
}

/* 放大态：对齐微信原生图片查看器的观感 —— 深色满屏、只留二维码大图、零 UI。
   放大必须留在页面内（wx.previewImage 里长按菜单由微信决定，注入不进去）。

   ⚠ 底部必须多撑出 tabbar 的高度：position:fixed 的包含块是「页面视口」，
   它**不含自定义 tabbar**（tabbar 在页面流底部，高度 104rpx + 安全区，
   见 custom-tab-bar/index.wxss）——只写 height:100vh 会在底部漏出 tabbar
   和页面内容（用户实测到的就是这个现象）。这里用负 bottom 把面板多撑一段，
   再靠 z-index 2001 盖住 tabbar；tabbar 高度若变，-104rpx 要同步。
   ⚠ 内容区再用 padding 把多撑的那段抵消掉，保证图片是在「屏幕可视区」里居中，
   而不是在「含 tabbar 的整块」里居中（否则图片整体偏下）。 */
.contact-admin-qr-dialog.is-expanded {
  top: 0;
  left: 0;
  width: 100vw;
  max-width: none;
  /* 高度分两行写（标准 CSS 回退）：第一行按视口铺满兜底，第二行再往下多撑出
     自定义 tabbar 的高度（fixed 的包含块是「页面视口」，不含 tabbar）。
     ⚠ 三不要：① 不要只写 height:100vh（底部会漏出 tabbar 与页面内容）；
     ② 不要用 `width: auto` 靠 left/right 拉伸（实测会收缩成一条窄带）；
     ③ 不要用 `height: auto`（图片是 height:0 + flex:1，撑不起 auto 高度，会塌成只剩 padding）。 */
  height: 100vh;
  height: calc(100vh + 104rpx + env(safe-area-inset-bottom));
  padding: calc(24rpx + env(safe-area-inset-top)) 0 calc(104rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: #000;
  box-shadow: none;
  transform: none;
  display: flex;
  flex-direction: column;
}

/* 放大态的遮罩兜底也压成深色：面板已铺满，遮罩只在面板边缘漏光时可见 */
.contact-admin-mask.is-zoom {
  background: #000;
}

.contact-admin-qr.is-full {
  flex: 1 1 auto;
  width: 100%;
  /* ⚠ 必须显式覆盖基类的 max-width: 560rpx —— 否则放大态图片宽度被卡在 ~400px，
     看起来「没居中」（2026-10-08 实测：538px 屏宽下卡片只占 413px、偏左 63px） */
  max-width: none;
  /* height:0 + flex-grow 才能稳定吃满剩余空间；mode=aspectFit 在盒子里等比居中 */
  height: 0;
  min-height: 0;
  /* ⚠ 必须留 auto，不能写成 margin: 0：基类是 margin: 24rpx auto 0，
     那个 auto 就是水平居中，写成 0 会让图片靠左贴边 */
  margin: 0 auto;
}
