:host {
  display: block;
}

.contact-admin,
.contact-admin-trigger {
  display: block;
}

.contact-admin-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 25, 42, .52);
}

.contact-admin-sheet,
.contact-admin-qr-dialog {
  position: fixed;
  z-index: 2001;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 18rpx 60rpx rgba(16, 33, 58, .2);
}

.contact-admin-sheet {
  right: 0;
  bottom: 0;
  left: 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
}

.contact-admin-sheet-head,
.contact-admin-qr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact-admin-sheet-title,
.contact-admin-qr-title {
  color: #18263d;
  font-size: 36rpx;
  font-weight: 700;
}

.contact-admin-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: #f3f5f8;
  color: #667386;
  text-align: center;
  font-size: 44rpx;
  font-weight: 300;
}

.contact-admin-options {
  margin-top: 28rpx;
}

.contact-admin-option {
  display: flex;
  align-items: center;
  /* 覆盖微信 button 默认样式（width: 184px / margin: auto），保证与 view 卡片同宽 */
  width: 100% !important;
  min-height: 124rpx;
  box-sizing: border-box;
  margin: 0 0 20rpx !important;
  padding: 22rpx 24rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 18rpx;
  background: #fff;
  font-size: 28rpx;
  line-height: 1.35;
  text-align: left;
}

.contact-admin-option::after {
  border: none;
}

.contact-admin-option:active,
.contact-admin-cancel:active,
.contact-admin-close:active {
  opacity: .65;
}

.contact-admin-option.online {
  border-color: #d9e8ff;
  background: #f5f9ff;
}

.contact-admin-option.wechat {
  margin-bottom: 0;
  border-color: #d9f0e5;
  background: #f5fbf8;
}

.contact-admin-option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: #347ff2;
  color: #fff;
  font-size: 32rpx;
}

.wechat .contact-admin-option-icon {
  background: #25b978;
}

.contact-admin-option-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.contact-admin-option-title {
  color: #1c2d46;
  font-size: 30rpx;
  font-weight: 700;
}

.contact-admin-option-desc {
  margin-top: 6rpx;
  color: #8290a3;
  font-size: 24rpx;
}

.contact-admin-option-arrow {
  margin-left: 14rpx;
  color: #a4afbd;
  font-size: 40rpx;
  line-height: 1;
}

.contact-admin-cancel {
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 44rpx;
  background: #f3f5f8;
  color: #536176;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
}

.contact-admin-qr-dialog {
  top: 50%;
  left: 50%;
  width: calc(100vw - 72rpx);
  max-width: 680rpx;
  padding: 30rpx 30rpx 34rpx;
  transform: translate(-50%, -50%);
  border-radius: 28rpx;
}

.contact-admin-qr-head {
  align-items: flex-start;
}

.contact-admin-qr-title {
  display: block;
  font-size: 34rpx;
}

.contact-admin-qr-desc {
  display: block;
  margin-top: 8rpx;
  color: #8b97a8;
  font-size: 23rpx;
}

.contact-admin-qr {
  display: block;
  width: 100%;
  max-width: 560rpx;
  height: auto;
  margin: 24rpx auto 0;
}

.contact-admin-qr-btn {
  width: 100% !important;
  height: 88rpx;
  margin: 26rpx 0 0 !important;
  padding: 0;
  border-radius: 44rpx;
  background: #25b978;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.contact-admin-qr-btn::after {
  border: none;
}

.contact-admin-qr-btn:active {
  opacity: .85;
}

.contact-admin-qr-tip {
  margin-top: 18rpx;
  color: #8995a5;
  font-size: 23rpx;
  text-align: center;
}
