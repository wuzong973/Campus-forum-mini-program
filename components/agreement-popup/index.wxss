.agreement-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.popup-content {
  position: relative;
  width: 85%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  z-index: 1;
}

.popup-header {
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
}

.popup-body {
  padding: 0 32rpx 32rpx;
}

.popup-text {
  display: block;
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.agreement-links {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 24rpx 0;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.agreement-link {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 1rpx solid #e5e7eb;
}

.link-text {
  font-size: 28rpx;
  color: #4a7aff;
  font-weight: 500;
}

.popup-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 40rpx;
}

.popup-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-reject {
  background: #f3f4f6;
  color: #6b7280;
}

.btn-agree {
  background: #4a7aff;
  color: #fff;
}
