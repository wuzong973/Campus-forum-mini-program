.errand-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: var(--transition-fast);
}

.errand-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type-tag {
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-bg);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.status-pending {
  background: rgba(250, 173, 20, 0.12);
  color: var(--warning);
}

.status-accepted {
  background: var(--primary-bg);
  color: var(--primary);
}

.status-done {
  background: rgba(82, 196, 26, 0.12);
  color: var(--success);
}

.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.4;
}

.reward {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--price);
  flex-shrink: 0;
}

.desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.addr-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.addr-label {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.addr-label.delivery {
  background: var(--success);
}

.addr-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}

.tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-sm);
  font-size: 22rpx;
  color: var(--primary);
}

.tag-warn {
  background: rgba(250, 173, 20, 0.12);
  color: var(--warning);
}

.tag-emoji {
  font-size: 22rpx;
}

.card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-user {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.user-name {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.time-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.footer-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.action-btn {
  font-size: 24rpx !important;
  border-radius: var(--radius-pill) !important;
  padding: 0 28rpx !important;
  margin: 0 !important;
  line-height: 56rpx !important;
  transition: var(--transition-fast) !important;
}

.action-btn::after {
  border: none;
}

.accept-btn {
  background: var(--primary) !important;
  color: #fff !important;
}

.accept-btn:active {
  background: var(--primary-dark) !important;
  transform: scale(0.96);
}

.finish-btn {
  background: var(--success) !important;
  color: #fff !important;
}

.finish-btn:active {
  transform: scale(0.96);
}

.contact-btn {
  background: var(--bg) !important;
  color: var(--text-secondary) !important;
}

.contact-btn:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.done-tag {
  font-size: 24rpx;
  color: var(--success);
  font-weight: 500;
}
