<view class="post-card" bindtap="onTap">
  <view class="post-header">
    <image class="post-avatar" src="{{post.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" lazy-load catchtap="onAvatarTap"></image>
    <view class="post-user-info">
      <view class="post-nick-row">
        <text class="post-nick">{{authorName}}</text>
        <view class="post-anonymous-label"><text class="post-anonymous-main">作者</text><text class="post-anonymous-tag" wx:if="{{post.isAnonymous}}">AN</text></view>
        <text class="post-review-note" wx:if="{{post.reviewNote}}">备注：{{post.reviewNote}}</text>
        <text class="post-cert-label" wx:if="{{certLabel && !post.isAnonymous}}">{{certLabel}}</text>
      </view>
      <view class="post-meta">
        <text class="meta-category">{{post.category || '日常话题'}}</text>
        <text class="meta-dot">·</text>
        <text>{{timeText}}</text>
        <text class="meta-dot">·</text>
        <text>{{viewText}}</text>
      </view>
    </view>
    <text class="post-pin-tag" wx:if="{{post.pinned}}">置顶</text>
    <view class="more-btn" wx:if="{{!readonly}}" catchtap="onClose"><image class="more-btn-icon" src="/assets/icons/more.png" mode="aspectFit"></image></view>
  </view>

  <view class="post-deleted-stamp" wx:if="{{readonly}}">已删除</view>

  <text class="post-title" wx:if="{{post.title}}">{{post.title}}</text>
  <view class="post-content">
    <text>{{displayContent}}</text><text class="post-full" wx:if="{{isLongContent}}" catchtap="onViewFull">全文</text>
  </view>

  <view class="post-images images-{{imageLayout}}" wx:if="{{previewImages.length}}">
    <view class="post-img-wrap" wx:for="{{previewImages}}" wx:key="url">
      <video wx:if="{{item.isVideo}}" class="post-video" src="{{item.url}}" object-fit="contain" controls show-center-play-btn catchtap="noop"></video>
      <image wx:elif="{{!item.failed}}" src="{{item.url}}" mode="aspectFill" class="post-img" lazy-load data-url="{{item.url}}" data-urls="{{imageUrls}}" catchtap="onPreviewImage" bindlongpress="onImageQrScan" binderror="onImageError"></image>
      <view wx:else class="post-img-error" data-url="{{item.url}}" catchtap="onRetryImage">图片加载失败</view>
      <view class="image-count" wx:if="{{index === 2 && post.images.length > 3}}">+{{post.images.length - 3}}</view>
    </view>
  </view>

  <view class="post-footer" wx:if="{{showFooter}}">
    <view class="post-topic-meta">
      <view class="campus-tag">{{post.campus || '未设置校区'}}</view>
    </view>
    <view class="footer-actions">
      <view class="footer-action {{post.isLiked ? 'active-like' : ''}} {{likeAnim}} spring-btn" hover-class="action-pressed press-spring" hover-start-time="0" hover-stay-time="120" catchtap="onLike"><view class="footer-action-icon act-heart {{post.isLiked ? 'on' : ''}}"></view><text>{{post.likeCount > 0 ? post.likeCount : '点赞'}}</text><view class="heart-fly" wx:if="{{likeHeartFly}}"><view class="heart-fly-core"></view></view></view>
      <view class="footer-action" catchtap="onComment"><image class="footer-action-icon" src="/assets/icons/comment.png" mode="aspectFit"></image><text>{{post.commentCount > 0 ? post.commentCount : '评论'}}</text></view>
    </view>
  </view>

  <view class="note-editor-mask" wx:if="{{showNoteEditor}}" catchtap="closeNoteEditor"></view>
  <view class="note-editor" wx:if="{{showNoteEditor}}" catchtap="noop" style="bottom: {{noteKeyboardHeight ? noteKeyboardHeight : 16}}px;">
    <view class="note-editor-header">
      <view class="note-editor-title">添加备注</view>
      <text class="note-editor-count">{{noteLength}}/255</text>
    </view>
    <textarea class="note-editor-input" placeholder="请输入备注内容" maxlength="255" value="{{noteDraft}}" focus="{{noteInputFocus}}" cursor-spacing="20" adjust-position="{{false}}" bindinput="onNoteInput" bindkeyboardheightchange="onNoteKeyboardChange" />
    <view class="note-editor-actions">
      <button hover-class="press-spring" class="note-editor-btn cancel spring-btn" catchtap="closeNoteEditor" hover-stay-time="120">取消</button>
      <button hover-class="press-spring" class="note-editor-btn confirm {{savingNote || !noteDraft ? 'is-disabled' : ''}} spring-btn" loading="{{savingNote}}" disabled="{{savingNote || !noteDraft}}" catchtap="saveNote" hover-stay-time="120">保存备注</button>
    </view>
  </view>

  <share-popup
    visible="{{showSharePopup}}"
    postId="{{post.id || 0}}"
    postTitle="{{post.title || ''}}"
    postContent="{{post.content || ''}}"
    bind:close="onCloseSharePopup"
    bind:shareToFriend="onShareToFriend"
    bind:sharePoster="onSharePoster"
  />

  <view class="anon-sheet-mask" wx:if="{{anonPopup}}" catchtap="onCloseAnonPopup"></view>
  <view class="anon-sheet" wx:if="{{anonPopup}}" catchtap="noop">
    <view class="anon-sheet-close" catchtap="onCloseAnonPopup">×</view>
    <view class="anon-sheet-user">
      <image class="anon-sheet-avatar" src="{{anonPopup.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      <text class="anon-sheet-nick">{{anonPopup.nick}}</text>
      <view class="anon-sheet-owner" wx:if="{{anonPopup.isOwner}}">
        <text class="anon-sheet-owner-text">帖主</text>
        <text class="anon-sheet-owner-op">OP</text>
      </view>
    </view>
    <button hover-class="press-spring" class="anon-sheet-msg-btn spring-btn" catchtap="onAnonPopupMessage" hover-stay-time="120">私信</button>
    <text class="anon-sheet-tip">这是一位分身用户</text>
  </view>

  <view class="anon-sheet-mask" wx:if="{{authorPopup}}" catchtap="onCloseAuthorPopup"></view>
  <view class="anon-sheet" wx:if="{{authorPopup}}" catchtap="noop">
    <view class="anon-sheet-close" catchtap="onCloseAuthorPopup">×</view>
    <view class="anon-sheet-user">
      <image class="anon-sheet-avatar" src="{{authorPopup.avatar || '/assets/icons/avatar.png'}}" mode="aspectFill"></image>
      <text class="anon-sheet-nick">{{authorPopup.nick}}</text>
      <view class="author-sheet-badge" wx:if="{{authorPopup.certLabel}}"><text class="author-sheet-badge-text">{{authorPopup.certLabel}}</text></view>
    </view>
    <view class="author-sheet-actions">
      <button hover-class="press-spring" class="author-sheet-btn ghost spring-btn" catchtap="onAuthorPopupProfile" hover-stay-time="120">个人主页</button>
      <button hover-class="press-spring" class="author-sheet-btn primary spring-btn" catchtap="onAuthorPopupMessage" hover-stay-time="120">分身私信</button>
    </view>
    <text class="anon-sheet-tip">帖主允许分身私信，进入主页可以进行普通私信</text>
  </view>
</view>
