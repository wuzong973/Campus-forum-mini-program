<view class="post-card" bindtap="onTap">
  <view class="post-header">
    <image class="post-avatar" src="{{post.avatarUrl || '/assets/icons/avatar.png'}}" mode="aspectFill" lazy-load catchtap="onAvatarTap"></image>
    <view class="post-user-info">
      <view class="post-nick-row">
        <text class="post-nick">{{authorName}}</text>
        <text class="post-review-note" wx:if="{{post.reviewNote}}">备注：{{post.reviewNote}}</text>
        <text class="post-cert-label" wx:if="{{certLabel}}">{{certLabel}}</text>
      </view>
      <view class="post-meta">
        <text class="meta-category">{{post.category || '日常话题'}}</text>
        <text class="meta-dot">·</text>
        <text>{{timeText}}</text>
        <text class="meta-dot">·</text>
        <text>{{viewText}}</text>
      </view>
    </view>
    <view class="more-btn" catchtap="onClose"><image src="/assets/icons/more.png" mode="aspectFit"></image></view>
  </view>

  <text class="post-title" wx:if="{{post.title}}">{{post.title}}</text>
  <view class="post-content">
    <text>{{displayContent}}</text><text class="post-full" wx:if="{{isLongContent}}" catchtap="onViewFull">全文</text>
  </view>

  <view class="post-images images-{{imageLayout}}" wx:if="{{previewImages.length}}">
    <view class="post-img-wrap" wx:for="{{previewImages}}" wx:key="url">
      <image wx:if="{{!item.failed}}" src="{{item.url}}" mode="aspectFill" class="post-img" lazy-load data-url="{{item.url}}" catchtap="onPreviewImage" binderror="onImageError"></image>
      <view wx:else class="post-img-error" data-url="{{item.url}}" catchtap="onRetryImage">图片加载失败</view>
      <view class="image-count" wx:if="{{index === 2 && post.images.length > 3}}">+{{post.images.length - 3}}</view>
    </view>
  </view>

  <view class="post-footer" wx:if="{{showFooter}}">
    <view class="post-topic-meta">
      <view class="campus-tag">{{post.campus || '未设置校区'}}</view>
    </view>
    <view class="footer-actions">
      <view class="footer-action {{post.isLiked ? 'active-like' : ''}}" catchtap="onLike"><image src="/assets/icons/heart-outline.png" mode="aspectFit"></image><text>点赞{{post.likeCount ? ' ' + post.likeCount : ''}}</text></view>
      <view class="footer-action" catchtap="onComment"><image src="/assets/icons/comment.png" mode="aspectFit"></image><text>评论{{post.commentCount ? ' ' + post.commentCount : ''}}</text></view>
    </view>
  </view>

  <view class="note-editor-mask" wx:if="{{showNoteEditor}}" catchtap="closeNoteEditor"></view>
  <view class="note-editor" wx:if="{{showNoteEditor}}" catchtap="noop" style="bottom: {{noteKeyboardHeight ? noteKeyboardHeight : 16}}px;">
    <view class="note-editor-header">
      <view class="note-editor-title">添加备注</view>
      <text class="note-editor-count">{{noteLength}}/255</text>
    </view>
    <textarea class="note-editor-input" placeholder="请输入备注内容" maxlength="255" value="{{noteDraft}}" focus="{{noteInputFocus}}" cursor-spacing="20" adjust-position="{{false}}" bindinput="onNoteInput" bindkeyboardheightchange="onNoteKeyboardChange" />
    <view class="note-editor-actions">
      <button class="note-editor-btn cancel" catchtap="closeNoteEditor">取消</button>
      <button class="note-editor-btn confirm {{savingNote || !noteDraft ? 'is-disabled' : ''}}" loading="{{savingNote}}" disabled="{{savingNote || !noteDraft}}" catchtap="saveNote">保存备注</button>
    </view>
  </view>

  <share-popup
    visible="{{showSharePopup}}"
    postId="{{post.id}}"
    postTitle="{{post.title}}"
    postContent="{{post.content}}"
    bind:close="onCloseSharePopup"
    bind:shareToFriend="onShareToFriend"
    bind:sharePoster="onSharePoster"
  />
</view>
