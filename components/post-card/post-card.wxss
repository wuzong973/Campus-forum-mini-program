.post-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx 24rpx 20rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.98), rgba(252,253,255,0.96));
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(30, 64, 175, 0.08);
  border: 1rpx solid rgba(226, 234, 250, 0.9);
  transition: all 0.2s ease-out;
  position: relative;
}

.post-card:active {
  transform: scale(0.995);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #eef2f8;
  flex-shrink: 0;
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(49, 92, 255, 0.16);
}

.post-user-info {
  flex: 1;
  min-width: 0;
}

.post-user-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.post-nick {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 240rpx;
}

.verified-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(74, 122, 255, 0.12);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
}

.post-sub-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.post-category {
  max-width: 160rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(114, 46, 209, 0.08);
  color: #722ed1;
  font-size: 20rpx;
  white-space: nowrap;
}

.post-dot,
.post-time,
.post-meta {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.post-meta {
  display: block;
}

.post-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 32rpx;
  color: #c8c9cc;
  font-weight: 300;
}

.hot-badge {
  position: absolute;
  top: 28rpx;
  right: 96rpx;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff8e53);
  border-radius: 999rpx;
}

.hot-badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.pin-badge {
  position: absolute;
  top: 28rpx;
  right: 96rpx;
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, #315cff, #12b8a6);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(49, 92, 255, 0.18);
}

.pin-badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.post-title {
  margin-bottom: 10rpx;
}

.post-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
  display: block;
}

.post-content {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
}

.post-content-text {
  font-size: 27rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
  flex: 1;
}

.post-full-text {
  font-size: 26rpx;
  color: #4A7AFF;
  font-weight: 600;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.post-images {
  display: grid;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.images-single {
  grid-template-columns: 1fr;
  max-width: 520rpx;
}

.images-double {
  grid-template-columns: repeat(2, 1fr);
}

.images-grid {
  grid-template-columns: repeat(3, 1fr);
}

.post-img-wrap {
  position: relative;
  width: 100%;
  height: 184rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #edf1f6;
}

.images-single .post-img-wrap {
  height: 360rpx;
}

.images-double .post-img-wrap {
  height: 248rpx;
}

.post-img {
  width: 100%;
  height: 100%;
}

.image-count {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  min-width: 56rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.52);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 8rpx 0;
  border-top: 1rpx solid rgba(235, 237, 240, 0.78);
}

.footer-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 104rpx;
  justify-content: center;
  padding: 10rpx 12rpx;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.footer-action:active {
  background: #f5f7fb;
  transform: scale(0.94);
}

.footer-action.liked .footer-count {
  color: #FF4D4F;
}

.footer-action.favorited .footer-count {
  color: #FAAD14;
}

.action-comment .footer-count {
  color: #315CFF;
}

.action-share .footer-count {
  color: #12B8A6;
}

.footer-icon {
  width: 48rpx;
  height: 48rpx;
}

.footer-count {
  font-size: 23rpx;
  color: #8a94a6;
  font-weight: 700;
  line-height: 1.1;
}

/* 热门评论条 */
.top-comment-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #fff8f0 0%, #fff5f5 100%);
  border: 1rpx solid #ffe4e0;
  border-radius: 16rpx;
}

.top-comment-bar .top-comment-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.top-comment-bar .top-comment-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.top-comment-bar .top-comment-nick {
  font-size: 22rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.top-comment-bar .top-comment-content {
  font-size: 22rpx;
  color: #666666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-comment-bar .top-comment-likes {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.top-comment-bar .top-comment-heart {
  font-size: 24rpx;
  color: #ff6b6b;
}

.top-comment-bar .top-comment-count {
  font-size: 21rpx;
  color: #ff6b6b;
  font-weight: 700;
}
