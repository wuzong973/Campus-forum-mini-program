.update-mask{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(12,20,36,.45);padding:48rpx}.update-dialog{width:100%;max-width:560rpx;padding:36rpx 32rpx 28rpx;border-radius:16rpx;background:#fff;box-shadow:0 24rpx 64rpx rgba(10,25,54,.22)}.update-title{display:block;font-size:34rpx;font-weight:700;color:#1f2a44;text-align:center}.update-body{margin-top:24rpx}.update-message{display:block;font-size:29rpx;line-height:1.6;color:#3c4a63;text-align:center}.update-version{display:block;margin-top:10rpx;font-size:23rpx;color:#8794a8;text-align:center}.update-actions{display:flex;gap:18rpx;margin-top:34rpx}.update-btn{flex:1;height:80rpx;line-height:80rpx;margin:0;padding:0;border-radius:10rpx;font-size:29rpx;font-weight:600}.update-btn::after{border:none}.update-btn.ghost{background:#f3f6fb;color:#4a5870}.update-btn.primary{background:#315cff;color:#fff}.update-btn.is-disabled{opacity:.68}
