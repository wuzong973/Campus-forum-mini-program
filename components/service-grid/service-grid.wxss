.service-grid {
  display: grid;
  gap: 26rpx 0;
  padding: 16rpx 0;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 6rpx 0;
  transition: var(--transition-fast);
}

.service-item:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.icon-wrap {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(238,243,255,0.92) 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(49, 92, 255, 0.08);
  box-shadow: 0 8rpx 18rpx rgba(49, 92, 255, 0.08);
}

.icon {
  font-size: 44rpx;
  line-height: 1;
}

.service-icon-img {
  width: 46rpx;
  height: 46rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: var(--radius-sm);
  color: #fff;
  white-space: nowrap;
  line-height: 1.4;
}

.badge-recommend {
  background: var(--accent);
}

.badge-new {
  background: var(--warning);
}

.name {
  font-size: 24rpx;
  color: var(--text-primary);
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.35;
  min-height: 64rpx;
  max-width: 116rpx;
  overflow: hidden;
}
