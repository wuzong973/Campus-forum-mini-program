/* 功能图标共享层必须组件内自带一份：小程序的样式隔离让 app.wxss 里的类选择器
   进不了自定义组件（只有标签名 / id 选择器能穿透），所以宫格里的 .ui-icon--market
   拿不到 background-image，「校园市场」那一格就是纯空白。
   @import 必须写在其它规则之前。 */
@import "../../styles/ui-icons.wxss";

.service-grid {
  display: grid;
  gap: 30rpx 0;
  padding: 18rpx 0 10rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 6rpx 0;
  transition: var(--transition-fast);
}

.service-item:active {
  transform: translateY(2rpx) scale(0.94);
  opacity: 0.88;
}

.icon-wrap {
  position: relative;
  width: 94rpx;
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 28% 18%, rgba(255,255,255,1) 0, rgba(255,255,255,0.35) 34rpx, rgba(255,255,255,0) 62rpx),
    linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(239,244,255,0.96) 100%);
  border-radius: 26rpx;
  border: 1rpx solid rgba(214, 226, 255, 0.95);
  box-shadow:
    0 12rpx 24rpx rgba(49, 92, 255, 0.12),
    inset 0 1rpx 0 rgba(255,255,255,0.86);
}

.icon {
  font-size: 44rpx;
  line-height: 1;
}

.service-icon-img {
  width: 58rpx;
  height: 58rpx;
}

/* 内置统一图标（styles/ui-icons.wxss）：固定到与 PNG 图标同尺寸，避免各页写法不一 */
.icon-wrap .ui-icon {
  width: 58rpx;
  height: 58rpx;
}

.badge {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #fff;
  white-space: nowrap;
  line-height: 1.4;
}

.badge-recommend {
  background: linear-gradient(135deg, #12B8A6, #27D6C2);
  box-shadow: 0 4rpx 10rpx rgba(18, 184, 166, 0.24);
}

.badge-new {
  background: linear-gradient(135deg, #FFB020, #FF8A3D);
  box-shadow: 0 4rpx 10rpx rgba(255, 138, 61, 0.24);
}

.name {
  font-size: 24rpx;
  color: #49566f;
  margin-top: 14rpx;
  text-align: center;
  line-height: 1.35;
  min-height: 64rpx;
  max-width: 116rpx;
  overflow: hidden;
  font-weight: 600;
}

.service-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 0 2rpx;
  box-sizing: border-box;
}

.service-strip {
  display: grid;
  grid-template-rows: repeat(2, 112rpx);
  grid-auto-flow: column;
  grid-auto-columns: 126rpx;
  column-gap: 16rpx;
  row-gap: 14rpx;
  width: max-content;
  padding: 10rpx 4rpx 14rpx;
  box-sizing: border-box;
}

.service-strip-item {
  width: 126rpx;
  height: 112rpx;
  padding: 0;
  justify-content: flex-start;
}

.service-strip .icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border: none;
  border-radius: 18rpx;
  background: transparent;
  box-shadow: none;
}

.service-strip .service-icon-img {
  width: 68rpx;
  height: 68rpx;
  filter: drop-shadow(0 6rpx 8rpx rgba(49, 92, 255, 0.16));
}

.service-strip .icon-wrap .ui-icon {
  width: 68rpx;
  height: 68rpx;
  filter: drop-shadow(0 6rpx 8rpx rgba(49, 92, 255, 0.16));
}

.service-strip .icon {
  font-size: 54rpx;
}

.service-strip .badge {
  top: -2rpx;
  left: 72%;
  font-size: 16rpx;
  padding: 1rpx 8rpx;
}

.service-strip .name {
  max-width: 126rpx;
  min-height: 38rpx;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #3d465a;
  line-height: 1.25;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 悬浮交互状态：轻微上浮 + 阴影加深 ===== */
.service-item {
  transition: transform 0.18s ease, opacity 0.18s ease;
  will-change: transform;
}

.service-item--hover {
  transform: translateY(-6rpx) scale(1.03);
}

.service-item--hover .icon-wrap {
  box-shadow:
    0 18rpx 32rpx rgba(49, 92, 255, 0.24),
    0 4rpx 10rpx rgba(49, 92, 255, 0.12);
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.service-strip .service-item--hover .icon-wrap {
  box-shadow: none;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.service-item--hover .service-icon-img,
.service-item--hover .icon-wrap .ui-icon,
.service-strip .service-item--hover .service-icon-img,
.service-strip .service-item--hover .icon-wrap .ui-icon {
  filter: drop-shadow(0 10rpx 14rpx rgba(49, 92, 255, 0.28));
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

/* 内置统一图标：悬停时本体轻微放大（PNG 图标走上面的 filter 阴影路径，
   内联 SVG 图标额外给一次放大，让"这一格被拾起来"读得更明确）。
   用 animation 而不是 transform，是为了不被上面的 press-spring scale(0.96) 覆盖。 */
.service-item--hover .icon-wrap .ui-icon {
  animation: ui-icon-pop 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

@keyframes ui-icon-pop {
  0% { transform: scale(1) rotate(0deg); }
  45% { transform: scale(1.16) rotate(-5deg); }
  100% { transform: scale(1.06) rotate(0deg); }
}

@media (prefers-reduced-motion: reduce) {
  .service-item--hover .icon-wrap .ui-icon {
    animation: none;
  }
}
