.share-popup-mask {
  position: fixed;
  z-index: 999;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
}

.share-popup-mask.show {
  background: rgba(0, 0, 0, 0.5);
}

.share-popup {
  position: fixed;
  z-index: 1000;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.share-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.share-list-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
  background: transparent;
  border: none;
  width: 100%;
  margin: 0;
  line-height: normal;
  font-size: 32rpx;
}

.share-list-item::after {
  border: none;
}

.share-wechat-btn {
  color: #1a1a1a;
}

.share-wechat-icon {
  width: 44rpx;
  height: 44rpx;
}

.share-list-label {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.share-list-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 32rpx;
}

.share-cancel-wrap {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.share-cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #F5F6F8;
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}
