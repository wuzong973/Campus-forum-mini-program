.cp-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .45); }
.cp-panel { width: 100%; padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); background: #ffffff; border-radius: 20rpx 20rpx 0 0; box-sizing: border-box; }
.cp-title { margin-bottom: 22rpx; color: #1f2329; font-size: 30rpx; font-weight: 600; }

.cp-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 14rpx; margin-bottom: 24rpx; }
.cp-cell { height: 64rpx; border: 1rpx solid rgba(0, 0, 0, .08); border-radius: 10rpx; }
.cp-cell.on { border: 4rpx solid #3d7bfa; }

.cp-hex-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 22rpx; }
.cp-hex-label { flex-shrink: 0; color: #667085; font-size: 25rpx; }
.cp-hex-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 20rpx; border: 1rpx solid #e4e9f2; border-radius: 12rpx; background: #f8fafc; color: #1f2329; font-size: 26rpx; box-sizing: border-box; }
.cp-hex-apply { flex-shrink: 0; padding: 16rpx 28rpx; border-radius: 12rpx; background: #eef4ff; color: #3d7bfa; font-size: 25rpx; font-weight: 500; }
.cp-hex-apply:active { opacity: .75; }

.cp-preview-bar { display: flex; min-height: 84rpx; align-items: center; justify-content: center; margin-bottom: 22rpx; border-radius: 14rpx; font-size: 27rpx; font-weight: 500; }
.cp-preview-empty { margin-bottom: 22rpx; padding: 24rpx 0; border: 1rpx dashed #d7dee9; border-radius: 14rpx; color: #98a2b3; font-size: 24rpx; text-align: center; }

.cp-actions { display: flex; gap: 20rpx; }
.cp-btn { flex: 1; padding: 20rpx 0; border-radius: 14rpx; font-size: 28rpx; font-weight: 600; text-align: center; }
.cp-btn:active { opacity: .8; }
.cp-btn-ghost { border: 1rpx solid #d7dee9; background: #ffffff; color: #5b6472; }
.cp-btn-primary { background: linear-gradient(90deg, #3d7bfa 0%, #5b8cff 100%); color: #ffffff; }
