.page{min-height:100vh;padding:24rpx 24rpx 150rpx;background:radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);box-sizing:border-box}.hero{display:flex;align-items:center;padding:28rpx 30rpx;background:linear-gradient(110deg,#315cff,#12b8a6);border-radius:8rpx;color:#fff}.hero-icon{width:104rpx;height:104rpx;margin-right:24rpx;border-radius:8rpx;background:#fff}.hero-copy{display:flex;flex-direction:column;gap:10rpx}.hero-title{font-size:38rpx;font-weight:700}.hero-sub{font-size:24rpx;opacity:.9}.tabs{height:88rpx;display:flex;background:#fff;margin:24rpx 0;border-bottom:1rpx solid #eef0f5}.tab{flex:1;text-align:center;line-height:88rpx;font-size:28rpx;color:#87909e;position:relative}.tab.active{color:#315cff;font-weight:700}.tab.active:after{content:"";position:absolute;bottom:0;left:35%;width:30%;height:5rpx;background:#315cff;border-radius:3rpx}.section{padding:30rpx;margin-bottom:24rpx;border-radius:8rpx}.section-title{display:block;font-size:32rpx;font-weight:700;color:#1f2329;margin-bottom:28rpx}.label{display:block;font-size:26rpx;color:#5d6675;margin-bottom:16rpx}.label-gap{margin-top:26rpx}.technician-list{display:flex;flex-direction:column;gap:16rpx}.technician{display:flex;align-items:center;min-height:100rpx;padding:16rpx;background:#f7f9fc;border:2rpx solid transparent;border-radius:8rpx;box-sizing:border-box}.technician.active{border-color:#315cff;background:#f0f4ff}.technician-avatar{width:66rpx;height:66rpx;border-radius:50%;background:#fff}.technician-info{display:flex;flex:1;min-width:0;margin-left:18rpx;flex-direction:column;gap:4rpx}.technician-name{font-size:28rpx;font-weight:600;color:#1f2329}.technician-phone{font-size:23rpx;color:#7c8798}.technician-copy,.order-chat{padding:12rpx;color:#315cff;font-size:25rpx}.selected-mark{font-size:23rpx;color:#12a06f}.textarea{width:100%;height:170rpx;padding:22rpx;margin-top