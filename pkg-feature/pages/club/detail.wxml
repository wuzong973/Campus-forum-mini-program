<view class="page page-enter">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="back-pill spring-btn" hover-class="back-pill-hover press-spring" hover-stay-time="80" bindtap="goBack"><text class="back-pill-icon">‹</text><text>返回</text></view>
  </view>

  <view class="content">
    <view class="page-title">{{category.name || '社团分类'}}</view>
    <view class="page-sub">查看该分类下的代表社团</view>

    <view class="campus-bar spring-btn" hover-class="campus-bar--hover press-spring" hover-stay-time="80" bindtap="onToggleCampus">
      <text class="campus-bar-label">校区</text>
      <text class="campus-bar-value">{{campus || '全部校区'}}</text>
      <text class="campus-bar-arrow">{{showCampusPanel ? '▴' : '▾'}}</text>
    </view>

    <view class="empty" wx:if="{{loaded && loadError}}" bindtap="retryLoad">
      <view class="empty-icon"><text class="empty-q">!</text></view>
      <text class="empty-text">社团加载失败，点击重试</text>
    </view>

    <view class="empty" wx:elif="{{loaded && !clubs.length}}">
      <view class="empty-icon"><text class="empty-q">?</text></view>
      <text class="empty-text">该分类下暂无社团</text>
    </view>

    <!-- 代表社团：单张白卡 + 行分隔线，点击整行进入社团详情 -->
    <view class="club-panel" wx:if="{{clubs.length}}">
      <view
        class="club-row anim-stagger spring-btn"
        style="--i: {{index < 6 ? index : 0}};"
        wx:for="{{clubs}}"
        wx:key="name"
        hover-class="club-row--hover press-spring"
        hover-stay-time="80"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onClubTap"
      >
        <view class="row-avatar-box">
          <!-- 文字徽标兜底：无头像/加载中/加载失败时始终可见，头像加载成功后淡入覆盖 -->
          <view class="row-badge" style="background:{{theme.soft}};color:{{theme.deep}};">{{item.firstChar}}</view>
          <!-- 申请人上传的社团头像：原图渲染（aspectFill 圆形裁切），不压缩、不降质 -->
          <image
            wx:if="{{item.avatarUrl && item.avatarState !== 'failed'}}"
            class="row-avatar-img {{item.avatarState === 'loaded' ? 'row-avatar-img--on' : ''}}"
            src="{{item.avatarSrc}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            data-index="{{index}}"
            bindload="onAvatarLoad"
            binderror="onAvatarError"
          />
          <!-- 弱网加载态：头像位置显示轻量旋转指示 -->
          <view wx:if="{{item.avatarUrl && item.avatarState === 'loading'}}" class="row-avatar-loading">
            <view class="row-avatar-spinner"></view>
          </view>
          <!-- 同步失败：明确标识 + 点击手动重试（更新时间戳绕过失败缓存） -->
          <view
            wx:if="{{item.avatarUrl && item.avatarState === 'failed'}}"
            class="row-avatar-retry"
            data-index="{{index}}"
            catchtap="onAvatarRetry"
          >
            <text class="row-avatar-retry-icon">↻</text>
          </view>
        </view>
        <view class="row-main">
          <text class="row-name">{{item.name}}</text>
          <text class="row-tags" wx:if="{{item.tags}}">{{item.tags}}</text>
        </view>
        <text class="row-arrow" wx:if="{{item.id}}">›</text>
      </view>
    </view>
  </view>
</view>

<!-- 校区选择弹层（fixed 元素放在带动画容器外） -->
<campus-picker visible="{{showCampusPanel}}" value="{{campus}}" bind:change="onCampusChange" bind:close="onCloseCampus" />
