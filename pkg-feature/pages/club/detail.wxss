.page {
  min-height: 100vh;
  background: #f2f3f5;
}

.topbar {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.content {
  padding: 24rpx 32rpx 60rpx;
}

.page-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.3;
}

.page-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7a8494;
}

/* ===== 校区选择器（与群聊列表页同款：白色胶囊，选中蓝色高亮） ===== */
.campus-bar {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(31, 42, 68, 0.05);
}

.campus-bar--hover {
  background: #f7f9fc;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.campus-bar-label {
  font-size: 24rpx;
  color: #9aa3b2;
}

.campus-bar-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2a44;
}

.campus-bar-arrow {
  font-size: 22rpx;
  color: #9aa3b2;
}

/* ===== 代表社团面板（单张白卡 + 行分隔线，与群聊列表同款） ===== */
.club-panel {
  margin-top: 30rpx;
  background: #ffffff;
  border: 1rpx solid #f0f1f4;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 42, 68, 0.05);
  overflow: hidden;
}

.club-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 26rpx;
  border-bottom: 1rpx solid #f2f3f6;
  transition: background 0.15s ease, transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.club-row:last-child {
  border-bottom: none;
}

.club-row--hover {
  background: #f7f9fc;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.row-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  flex-shrink: 0;
}

/* ===== 头像同步（申请人上传的社团头像）：徽标兜底 + 加载指示 + 失败重试 ===== */
.row-avatar-box {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
}

/* 头像原图渲染，aspectFill 圆形裁切保证比例正确；加载完成后 0.2s 淡入 */
.row-avatar-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.row-avatar-img--on {
  opacity: 1;
}

/* 弱网加载态：半透明遮罩 + 旋转指示 */
.row-avatar-loading {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-avatar-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid rgba(46, 107, 255, 0.18);
  border-top-color: #2e6bff;
  border-radius: 50%;
  animation: avatar-spin 0.8s linear infinite;
}

@keyframes avatar-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 同步失败态：深色遮罩 + 白色刷新符号，点击手动重试 */
.row-avatar-retry {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(31, 42, 68, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease;
}

.row-avatar-retry:active {
  background: rgba(31, 42, 68, 0.6);
}

.row-avatar-retry-icon {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a44;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-tags {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9aa3b2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  flex-shrink: 0;
  font-size: 34rpx;
  color: #c0c7d2;
  line-height: 1;
  margin-top: -4rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 7rpx solid #d7dade;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-q {
  font-size: 60rpx;
  font-weight: 700;
  color: #c6cad1;
  line-height: 1;
  margin-top: -6rpx;
}

.empty-text {
  margin-top: 22rpx;
  font-size: 28rpx;
  color: #9aa3b2;
}
