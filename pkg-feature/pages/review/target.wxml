<view class="page page-enter">
  <view class="content" wx:if="{{target}}">
    <!-- 头部对象卡 -->
    <view class="head-card">
      <image wx:if="{{target.avatar}}" class="head-avatar" src="{{target.avatar}}" mode="aspectFill" />
      <view wx:else class="head-avatar head-avatar--char" style="background:{{target.avatarBg}};color:{{target.avatarColor}};">
        <text>{{target.char}}</text>
      </view>
      <view class="head-main">
        <view class="head-name">{{target.name}}</view>
        <view wx:if="{{subtitle}}" class="head-sub">{{subtitle}}</view>
      </view>
      <view wx:if="{{target.rateable !== false}}" class="head-score">
        <view class="head-score-num">{{scoreText}}<text wx:if="{{scoreText !== '暂无'}}" class="head-score-unit">分</text></view>
        <view class="head-score-count">{{ratingCountText}}</view>
      </view>
    </view>

      <!-- 我的评分（根级食堂/商圈为容器，本身不可评分，不显示星级卡） -->
      <view wx:if="{{target.rateable !== false}}" class="rate-card">
        <view class="rate-head">
          <text class="rate-title">我的评分</text>
          <text class="rate-tip">{{dimsSupported ? '四项都选好后提交，综合分按权重计算' : '再次点击可以重新评分'}}</text>
        </view>

        <!-- 多维度（食堂 / 商圈）：每维一行，权重标在右侧 -->
        <block wx:if="{{dimsSupported}}">
          <view class="dim-row" wx:for="{{dimRows}}" wx:for-item="dim" wx:for-index="di" wx:key="key">
            <text class="dim-label">{{dim.label}}</text>
            <view class="dim-stars">
              <view
                wx:for="{{stars}}"
                wx:for-item="s"
                wx:for-index="si"
                wx:key="*this"
                class="star {{dim.my >= s ? 'star--on' : ''}}"
                data-dim="{{dim.key}}"
                data-score="{{s}}"
                bindtap="onDimStarTap"
              >★</view>
            </view>
            <text class="dim-weight">{{dim.weight}}%</text>
          </view>
          <view class="dim-submit {{dimsReady && !dimSubmitting ? 'dim-submit--on' : ''}}" bindtap="onSubmitDims">
            {{dimSubmitting ? '提交中…' : '提交评分'}}
          </view>
          <!-- 各维度均分（暂无带维度明细的评分时整块隐藏） -->
          <view class="dim-avg" wx:if="{{dimAverages}}">
            <text class="dim-avg-title">各维度均分</text>
            <view class="dim-avg-grid">
              <view class="dim-avg-item" wx:for="{{dimRows}}" wx:for-item="dim" wx:for-index="di" wx:key="key">
                <text class="dim-avg-label">{{dim.label}}</text>
                <text class="dim-avg-value">{{dim.avg === null ? '—' : dim.avg}}</text>
              </view>
            </view>
          </view>
        </block>

        <!-- 单一星级（课程评分）：保持原交互不变 -->
        <block wx:else>
          <view class="star-row">
            <view
              wx:for="{{stars}}"
              wx:key="*this"
              class="star {{myRating >= item ? 'star--on' : ''}}"
              data-score="{{item}}"
              bindtap="onStarTap"
            >★</view>
          </view>
          <view class="star-labels">
            <text>{{starLabels[0]}}</text>
            <text>{{starLabels[2]}}</text>
            <text>{{starLabels[4]}}</text>
          </view>
        </block>
      </view>

    <!-- 评价列表 -->
    <view class="comments-header">
      <view class="comment-tag">
        <text class="comment-tag-text">评论区</text>
        <text class="comment-tag-count" wx:if="{{commentCount > 0}}">{{commentCount}}</text>
      </view>
      <view class="comment-sort">
        <view
          wx:for="{{commentSorts}}"
          wx:key="key"
          class="comment-sort-chip {{commentSort === item.key ? 'comment-sort-chip--active' : ''}}"
          data-sort="{{item.key}}"
          bindtap="onCommentSortTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="comment-list">
      <view
        wx:for="{{comments}}"
        wx:key="id"
        class="comment-item anim-stagger {{index < 6 ? '' : ''}}"
        style="--i: {{index < 6 ? index : 0}};"
      >
        <image
          class="comment-avatar"
          src="{{item.avatarUrl || '/assets/icons/avatar.png'}}"
          mode="aspectFill"
          lazy-load
          data-path="comments[{{index}}]"
          binderror="onAvatarError"
          data-userid="{{item.userId}}"
          data-anonymous="{{item.isAnonymous}}"
          data-nick="{{item.nickName}}"
          data-avatar="{{item.avatarUrl}}"
          data-isowner="{{item.isAuthor}}"
          data-allowpm="{{item.allowAnonymousPm}}"
          catchtap="onCommentAvatarTap"
        />
        <view class="comment-content-wrap comment-reply-trigger" catchtap="onReplyComment" data-id="{{item.id}}" data-nick="{{item.nickName}}">
          <view class="comment-head">
            <view class="comment-meta">
              <text class="comment-nick">{{item.nickName || '校园用户'}}</text>
              <!-- 匿名（分身）不再显示「分身」徽标：分身身份已由昵称 + 头像体现，徽标属冗余。
                   注意：原条件分支的第二个分支依赖前一个条件，去掉前一个后必须提升为独立条件。 -->
              <text wx:if="{{item.certLabel}}" class="comment-cert">{{item.certLabel}}</text>
              <text class="comment-time">{{item.timeText}}</text>
            </view>
            <view class="comment-more" catchtap="onCommentMore" data-id="{{item.id}}" data-userid="{{item.userId}}" data-nick="{{item.nickName}}">
              <image class="comment-more-icon" src="/assets/icons/more.png" mode="aspectFit"></image>
            </view>
          </view>
          <view class="comment-body">
            <view class="comment-text-wrap">
              <text class="comment-text" user-select>{{item.content}}</text>
            </view>
            <view class="comment-like {{item.liked ? 'active-like' : ''}} spring-btn" hover-class="like-hover press-spring" hover-stay-time="80" catchtap="onCommentLikeTap" data-id="{{item.id}}">
              <view class="pa-icon pa-heart {{item.liked ? 'on' : ''}}"></view>
              <text class="like-count" wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text>
            </view>
          </view>
          <view class="comment-image-list" wx:if="{{item.images.length}}">
            <image
              wx:for="{{item.images}}"
              wx:for-item="img"
              wx:key="*this"
              class="comment-image"
              src="{{img}}"
              mode="aspectFill"
              lazy-load
              data-url="{{img}}"
              data-urls="{{item.images}}"
              catchtap="onPreviewCommentImage"
              bindlongpress="onImageQrScan"
            />
          </view>
          <!-- 自己的评价：编辑 / 删除（与帖子详情页同款，不藏进「…」菜单） -->
          <view class="comment-actions" wx:if="{{item.userId === currentUserId}}">
            <text catchtap="onEditComment" data-id="{{item.id}}" data-content="{{item.content}}">编辑</text>
            <text class="delete" catchtap="onDeleteComment" data-id="{{item.id}}">删除</text>
          </view>

          <!-- 回复列表（两级：回复的回复挂到顶层评价下，超出 2 条折叠） -->
          <view class="reply-list" wx:if="{{item.replies.length}}">
            <view
              class="reply-item"
              wx:for="{{item.expandedReplies ? item.replies : item.visibleReplies}}"
              wx:for-item="reply"
              wx:for-index="replyIndex"
              wx:key="id"
              catchtap="onReplyComment"
              data-id="{{reply.id}}"
              data-nick="{{reply.nickName}}"
            >
              <image
                class="reply-avatar"
                src="{{reply.avatarUrl || '/assets/icons/avatar.png'}}"
                mode="aspectFill"
                lazy-load
                data-path="comments[{{index}}].replies[{{replyIndex}}]"
                binderror="onAvatarError"
                data-userid="{{reply.userId}}"
                data-anonymous="{{reply.isAnonymous}}"
                data-nick="{{reply.nickName}}"
                data-avatar="{{reply.avatarUrl}}"
                data-isowner="{{reply.isAuthor}}"
                data-allowpm="{{reply.allowAnonymousPm}}"
                catchtap="onCommentAvatarTap"
              />
              <view class="reply-content">
                <view class="comment-head">
                  <view class="comment-meta">
                    <text class="comment-nick">{{reply.nickName || '校园用户'}}</text>
                    <!-- 同上：回复也不再显示「分身」徽标 -->
                    <text wx:if="{{reply.certLabel}}" class="comment-cert">{{reply.certLabel}}</text>
                    <text class="comment-time">{{reply.timeText}}</text>
                  </view>
                  <view class="comment-more" catchtap="onCommentMore" data-id="{{reply.id}}" data-userid="{{reply.userId}}" data-nick="{{reply.nickName}}">
                    <image class="comment-more-icon" src="/assets/icons/more.png" mode="aspectFit"></image>
                  </view>
                </view>
                <view class="comment-body">
                  <view class="comment-text-wrap">
                    <text class="comment-reply-to" wx:if="{{reply.replyToNick}}">回复 {{reply.replyToNick}}：</text>
                    <text class="comment-text" user-select>{{reply.content}}</text>
                  </view>
                  <view class="comment-like {{reply.liked ? 'active-like' : ''}} spring-btn" hover-class="like-hover press-spring" hover-stay-time="80" catchtap="onCommentLikeTap" data-id="{{reply.id}}">
                    <view class="pa-icon pa-heart {{reply.liked ? 'on' : ''}}"></view>
                    <text class="like-count" wx:if="{{reply.likeCount > 0}}">{{reply.likeCount}}</text>
                  </view>
                </view>
                <view class="comment-image-list" wx:if="{{reply.images.length}}">
                  <image
                    wx:for="{{reply.images}}"
                    wx:for-item="img"
                    wx:key="*this"
                    class="comment-image"
                    src="{{img}}"
                    mode="aspectFill"
                    lazy-load
                    data-url="{{img}}"
                    data-urls="{{reply.images}}"
                    catchtap="onPreviewCommentImage"
                    bindlongpress="onImageQrScan"
                  />
                </view>
                <!-- 自己的回复：编辑 / 删除（与帖子详情页同款） -->
                <view class="comment-actions" wx:if="{{reply.userId === currentUserId}}">
                  <text catchtap="onEditComment" data-id="{{reply.id}}" data-content="{{reply.content}}">编辑</text>
                  <text class="delete" catchtap="onDeleteComment" data-id="{{reply.id}}">删除</text>
                </view>
              </view>
            </view>
            <view
              wx:if="{{item.replies.length > 3}}"
              class="reply-toggle"
              data-index="{{index}}"
              catchtap="onToggleReplies"
            ><text class="reply-toggle-line"></text><text>{{item.expandedReplies ? '收起回复' : '展开 ' + (item.replies.length - 3) + ' 条回复'}}</text></view>
          </view>
        </view>
      </view>

      <view wx:if="{{!comments.length && !commentLoading}}" class="empty-tip">还没有评价，来写第一条吧</view>
      <view wx:if="{{commentLoading}}" class="loading-tip">加载中...</view>
    </view>
  </view>

  <!-- 待发送图片预览（随底栏一起固定） -->
  <view class="pending-images" wx:if="{{commentImages.length}}">
    <view class="pending-image-item" wx:for="{{commentImages}}" wx:key="*this">
      <image class="pending-image" src="{{item}}" mode="aspectFill"></image>
      <view class="pending-image-remove" data-index="{{index}}" bindtap="onRemoveCommentImage">×</view>
    </view>
  </view>

  <!-- 加载失败 / 不存在 -->
  <view wx:if="{{loadFailed}}" class="fail-tip">
    <text>{{notFound ? '该评分对象不存在或已下架' : '加载失败，请稍后重试'}}</text>
  </view>
</view>

<!-- 底部输入栏（fixed 放在带动画容器外） -->
<view class="bottom-bar">
  <view class="bar-action bar-anon {{commentAnonymous ? 'bar-anon--on' : ''}}" bindtap="onToggleAnonymous"><view class="anon-dot"></view>分身</view>
  <view class="input-wrap">
    <view class="reply-hint" wx:if="{{replyTo}}">
      <text class="reply-hint-text">回复 {{replyToNick}}</text>
      <text class="reply-hint-cancel" catchtap="onCancelReply">✕</text>
    </view>
    <input
      class="bottom-input"
      placeholder="{{replyTo ? '回复 ' + replyToNick + '...' : '说点什么...'}}"
      placeholder-class="bottom-placeholder"
      value="{{inputText}}"
      focus="{{inputFocus}}"
      cursor-spacing="18"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
    />
    <view class="send-btn {{(inputText || commentImages.length) ? 'send-btn--on' : ''}}" bindtap="onSend">发送</view>
  </view>
  <view class="bar-action" bindtap="onPickCommentImage"><text>＋</text></view>
  <view class="bar-action" catchtap="toggleEmojiPanel"><text>☺</text></view>
  <!-- 表情面板（与帖子详情页同款表情组） -->
  <view class="emoji-panel" wx:if="{{showEmojiPanel}}">
    <view class="emoji-item" wx:for="{{emojis}}" wx:key="*this" data-emoji="{{item}}" catchtap="onEmojiTap">{{item}}</view>
  </view>
</view>

<!-- 编辑评价弹窗（与帖子详情页同款） -->
<view class="modal-mask" wx:if="{{showEditModal}}" bindtap="onCloseEditModal"></view>
<view class="edit-modal" wx:if="{{showEditModal}}"><view class="modal-header"><text class="modal-title">编辑评价</text><text class="modal-close" bindtap="onCloseEditModal">×</text></view><textarea class="modal-textarea" value="{{editContent}}" bindinput="onEditContentInput" maxlength="200"></textarea><view class="modal-actions"><button hover-class="press-spring" class="modal-btn cancel spring-btn" bindtap="onCloseEditModal" hover-stay-time="120">取消</button><button hover-class="press-spring" class="modal-btn confirm spring-btn" bindtap="onConfirmEdit" hover-stay-time="120">确定</button></view></view>

<!-- 点击头像弹出的功能菜单：与帖子详情页共用同一组件（components/avatar-sheet）。
     打开方式：this.selectComponent('#avatarSheet').open({...})（见 target.js 的 onCommentAvatarTap） -->
<avatar-sheet id="avatarSheet" />
