.page { min-height: 100vh; padding: 92rpx 48rpx 60rpx; background: #f5f7fb; text-align: center; }.brand-mark { display: flex; width: 128rpx; height: 128rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 30rpx; background: #e8f0ff; }.brand-mark image { width: 86rpx; height: 86rpx; }.brand-name, .brand-subtitle, .about-title, .about-text, .version { display: block; }.brand-name { margin-top: 24rpx; color: #16213a; font-size: 40rpx; font-weight: 700; }.brand-subtitle { margin-top: 8rpx; color: #8190a5; font-size: 25rpx; }.about-card { margin-top: 60rpx; padding: 30rpx; border-radius: 18rpx; background: #ffffff; text-align: left; box-shadow: 0 8rpx 22rpx rgba(31, 52, 92, .06); }.about-title { color: #202a3c; font-size: 30rpx; font-weight: 700; }.about-text { margin-top: 16rpx; color: #6d7a8f; font-size: 25rpx; line-height: 1.7; }.version { margin-top: 38rpx; color: #abb3c0; font-size: 22rpx; }

/* ===== 开发人员（页面底部） =====
   布局全部基于 flex + flex-wrap + min-width:0，没有固定宽度和固定列数，
   因此在窄屏手机 / iPad / PC 微信（rpx 按窗口宽度等比缩放）下都不会溢出或错位。 */
.dev-card { margin-top: 32rpx; padding: 30rpx; border-radius: 18rpx; background: #ffffff; text-align: left; box-shadow: 0 8rpx 22rpx rgba(31, 52, 92, .06); }
.dev-title { display: block; color: #202a3c; font-size: 30rpx; font-weight: 700; }
.dev-head { display: flex; align-items: center; margin-top: 24rpx; }
.dev-avatar { display: flex; flex: 0 0 auto; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: #e8f0ff; color: #315cff; font-size: 38rpx; font-weight: 700; line-height: 1; }
.dev-head-main { flex: 1; min-width: 0; margin-left: 22rpx; }
.dev-name { display: block; color: #202a3c; font-size: 30rpx; font-weight: 700; word-break: break-all; }
.dev-role { display: block; margin-top: 6rpx; color: #8190a5; font-size: 23rpx; line-height: 1.5; }
.dev-section { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #eef1f6; }
.dev-label { display: block; color: #202a3c; font-size: 26rpx; font-weight: 600; }
.dev-tags { display: flex; flex-wrap: wrap; margin-top: 16rpx; gap: 12rpx; }
.dev-tag { padding: 8rpx 18rpx; border-radius: 999rpx; background: #eef3ff; color: #315cff; font-size: 22rpx; line-height: 1.5; }
.dev-text { display: block; margin-top: 14rpx; color: #6d7a8f; font-size: 25rpx; line-height: 1.7; }
.dev-contact { display: flex; align-items: center; margin-top: 14rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #f7f9fc; }
.dev-contact-key { flex: 0 0 auto; color: #8190a5; font-size: 24rpx; }
.dev-contact-val { flex: 1; min-width: 0; margin-left: 16rpx; color: #315cff; font-size: 24rpx; text-align: right; word-break: break-all; }
.dev-contact-action { flex: 0 0 auto; margin-left: 14rpx; padding: 4rpx 14rpx; border: 1rpx solid #d8e2f7; border-radius: 999rpx; color: #8190a5; font-size: 21rpx; line-height: 1.5; }
