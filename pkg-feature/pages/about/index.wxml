<view class="page">
  <view class="brand-mark">
    <image src="/assets/icons/campus-logo.png" mode="aspectFit"></image>
  </view>
  <text class="brand-name">校园论坛</text>
  <text class="brand-subtitle">面向校园生活的交流与互助社区</text>

  <view class="about-card">
    <text class="about-title">关于我们</text>
    <text class="about-text">在这里可以交流校园生活、发布和查看帖子、使用跑腿服务，并与同校同学保持连接。</text>
    <text class="about-text">请文明交流，尊重他人隐私，共同维护友好的校园社区。</text>
  </view>

  <!-- 开发人员 -->
  <view class="dev-card">
    <text class="dev-title">开发人员</text>

    <view class="dev-head">
      <view class="dev-avatar">{{developer.initial}}</view>
      <view class="dev-head-main">
        <text class="dev-name">{{developer.name}}</text>
        <text class="dev-role">{{developer.role}}</text>
      </view>
    </view>

    <view class="dev-section">
      <text class="dev-label">技术栈与专业技能</text>
      <view class="dev-tags">
        <text class="dev-tag" wx:for="{{developer.skills}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="dev-section">
      <text class="dev-label">项目经验</text>
      <text class="dev-text" wx:for="{{developer.experience}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="dev-section">
      <text class="dev-label">联系方式</text>
      <view
        class="dev-contact"
        wx:for="{{developer.contacts}}"
        wx:key="key"
        data-value="{{item.copy}}"
        bindtap="onCopyContact"
      >
        <text class="dev-contact-key">{{item.key}}</text>
        <text class="dev-contact-val">{{item.value}}</text>
        <text class="dev-contact-action">复制</text>
      </view>
    </view>
  </view>

  <text class="version">当前版本 v1.1.28</text>
</view>
