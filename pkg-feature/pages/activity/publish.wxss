.page {
  min-height: 100vh;
  background: #f2f3f5;
}

.topbar {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.content {
  padding: 24rpx 32rpx 80rpx;
}

.page-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2a44;
  line-height: 1.3;
}

.page-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #7a8494;
}

.sec-title {
  margin-top: 36rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2a44;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row--column {
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
}

.form-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #3a4356;
  font-weight: 600;
}

.form-row--column .form-label {
  width: auto;
}

.req {
  color: #f04438;
}

.form-input {
  flex: 1;
  font-size: 27rpx;
  color: #1f2a44;
}

.time-pair {
  flex: 1;
  display: flex;
  gap: 14rpx;
}

.time-picker {
  flex: 1;
  height: 64rpx;
  border-radius: 10rpx;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #2a3247;
}

.form-textarea {
  width: 100%;
  height: 220rpx;
  font-size: 27rpx;
  color: #1f2a44;
  line-height: 1.6;
}

.form-textarea--short {
  height: 130rpx;
}

.form-label-block {
  padding: 24rpx 0 14rpx;
  font-size: 26rpx;
  color: #3a4356;
  font-weight: 600;
}

/* ===== 上传行 ===== */
.upload-row {
  position: relative;
  display: flex;
  align-items: center;
  padding: 4rpx 0 24rpx;
}

.upload-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #eef1f5;
}

.upload-add {
  width: 200rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #f5f6f8;
  border: 2rpx dashed #d5dae2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #9aa3b2;
  text-align: center;
  line-height: 1.5;
}

.upload-add--grid {
  width: 100%;
  height: 200rpx;
  font-size: 44rpx;
}

.upload-clear {
  position: absolute;
  top: -6rpx;
  left: 172rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding-bottom: 24rpx;
}

.img-item {
  position: relative;
}

.img-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 14rpx;
  background: #eef1f5;
}

.img-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  margin-top: 40rpx;
  height: 92rpx;
  border-radius: 18rpx;
  background: #1a1c20;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.16s ease, transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.submit-btn--hover {
  opacity: 0.86;
  transform: scale(0.96);
 box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

/* ===== 校区选择器（与群聊/活动列表页 campus-bar 同款） ===== */
.campus-bar {
  margin-top: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f4;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(31, 42, 68, 0.05);
}

.campus-bar--hover {
  background: #f7f9fc;
 transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.campus-bar-label {
  font-size: 24rpx;
  color: #9aa3b2;
}

.campus-bar-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2a44;
}

.campus-bar-arrow {
  font-size: 22rpx;
  color: #9aa3b2;
}

.campus-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}

.campus-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 30rpx 26rpx;
}

.campus-panel-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2a44;
}

.campus-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.campus-option {
  height: 88rpx;
  border-radius: 14rpx;
  background: #f2f3f5;
  border: 3rpx solid transparent;
  color: #4a5468;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.campus-option--active {
  background: #eef4ff;
  border-color: #2e6bff;
  color: #2e6bff;
}

.campus-panel-tip {
  margin-top: 22rpx;
  font-size: 23rpx;
  color: #9aa3b2;
  text-align: center;
}

/* ===== 订阅消息提醒弹窗（活动发布成功后） ===== */
.sub-mask { position: fixed; z-index: 100; inset: 0; background: rgba(0, 0, 0, .58); }
.sub-dialog { position: fixed; z-index: 101; top: 50%; left: 50%; width: 600rpx; transform: translate(-50%, -50%); padding: 40rpx 32rpx 32rpx; border-radius: 28rpx; background: #ffffff; box-sizing: border-box; }
.sub-title { display: block; color: #15233a; font-size: 36rpx; font-weight: 700; text-align: center; }
.sub-desc { display: block; margin: 14rpx 0 6rpx; color: #8a94a6; font-size: 25rpx; text-align: center; }
.sub-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; border-bottom: 1rpx solid #f0f2f5; }
.sub-row-label { display: block; color: #10213a; font-size: 30rpx; }
.sub-row-hint { display: block; margin-top: 4rpx; color: #8a94a6; font-size: 22rpx; }
.sub-actions { display: flex; margin-top: 32rpx; }
.sub-btn-skip, .sub-btn-confirm { display: flex; align-items: center; justify-content: center; height: 88rpx; border-radius: 44rpx; font-size: 30rpx; }
.sub-btn-skip { flex: 1; margin-right: 20rpx; background: #f6f7f9; color: #5a6572; }
.sub-btn-confirm { flex: 1.6; background: #3478f6; color: #ffffff; font-weight: 600; }
