.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

button::after { border: none; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

/* ===== 顶部横幅 ===== */
.result-banner {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  padding: 34rpx 28rpx 30rpx;
  text-align: center;
  color: #ffffff;
  background:
    radial-gradient(280rpx 220rpx at 86% 8%, rgba(255, 255, 255, 0.22), transparent 68%),
    linear-gradient(135deg, #ff8ba5 0%, #ff4d72 46%, #8c4dff 100%);
  box-shadow: 0 18rpx 38rpx rgba(255, 77, 114, 0.24);
}
.result-kicker { display: block; position: relative; z-index: 2; font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; color: rgba(255, 255, 255, 0.78); }
.result-title { display: block; position: relative; z-index: 2; margin: 12rpx 0 8rpx; font-size: 42rpx; font-weight: 900; letter-spacing: -1rpx; }
.result-sub { display: block; position: relative; z-index: 2; font-size: 22rpx; color: rgba(255, 255, 255, 0.84); }
.result-banner::after {
  content: '';
  position: absolute;
  top: -40%;
  bottom: -40%;
  left: -60%;
  width: 46%;
  background: linear-gradient(100deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0));
  opacity: 0;
  pointer-events: none;
}

/* ===== 双人卡 ===== */
.pair-card {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  padding: 30rpx 26rpx 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(31, 43, 67, 0.12);
}
.pair-row { display: flex; align-items: center; justify-content: center; }
.pair-person { flex: 1; min-width: 0; text-align: center; }
.pair-avatar-wrap { position: relative; width: 140rpx; height: 140rpx; margin: 0 auto 14rpx; }
.pair-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 5rpx solid #ffffff;
  background: #eef2f8;
  box-shadow: 0 12rpx 24rpx rgba(31, 43, 67, 0.12);
}
.pair-badge {
  position: absolute;
  right: 0;
  bottom: 4rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  border: 4rpx solid #ffffff;
  background: linear-gradient(135deg, #ff8ba5, #ff4d72);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}
.pair-name { display: block; font-size: 28rpx; font-weight: 800; color: #1f2b43; }
.pair-meta { display: block; margin-top: 4rpx; font-size: 21rpx; color: #969799; }
.pair-link { width: 96rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.pair-line { width: 64rpx; height: 2rpx; background: linear-gradient(90deg, transparent, #ffb3c2, transparent); }
.pair-heart {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24rpx;
  background: linear-gradient(135deg, #ff8ba5, #ff4d72);
  box-shadow: 0 8rpx 18rpx rgba(255, 77, 114, 0.24);
}
.pair-heart-icon { display: block; line-height: 1; transform-origin: center; }

.score-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #eef1f6;
}
.score-ring {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 8rpx solid #ff8aa5;
  background: #fff5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.score-ring::after {
  content: '';
  position: absolute;
  top: -18rpx;
  right: -18rpx;
  bottom: -18rpx;
  left: -18rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 77, 114, 0.4);
  opacity: 0;
  pointer-events: none;
}
.score-num { font-size: 32rpx; font-weight: 900; color: #e5486a; }
.score-text { display: flex; flex-direction: column; gap: 5rpx; }
.score-label { font-size: 27rpx; font-weight: 800; color: #1f2b43; }
.score-sub { font-size: 21rpx; color: #969799; }

.common-title { display: block; margin: 24rpx 4rpx 14rpx; font-size: 21rpx; font-weight: 700; color: #969799; }
.common-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.common-tag {
  padding: 10rpx 20rpx;
  border: 1rpx solid #ffdce3;
  border-radius: 999rpx;
  background: #fff0f3;
  color: #e5486a;
  font-size: 22rpx;
  font-weight: 600;
}

/* ===== 匹配成功动效：一次性入场，只动 transform/opacity ===== */
.anim-banner { animation: banner-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.02s backwards; }
.anim-banner::after { animation: banner-sheen 0.9s ease-out 0.3s; }
.anim-pair { animation: pair-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.12s backwards; }
.anim-from-left { animation: pair-from-left 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.24s backwards; }
.anim-from-right { animation: pair-from-right 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.3s backwards; }
.anim-heart-pop { animation: heart-pop 0.52s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s backwards; }
.anim-heart-pop .pair-heart-icon { animation: heart-beat 1.5s ease-in-out 1.05s 2; }
.anim-score-pop { animation: score-pop 0.55s cubic-bezier(0.34, 1.4, 0.64, 1) 0.46s backwards; }
.anim-score-pop::after { animation: score-halo 1s ease-out 0.6s; }
.anim-score-text { animation: score-text-in 0.35s ease-out 0.36s backwards; }
.anim-tag { animation: tag-in 0.38s cubic-bezier(0.22, 1, 0.36, 1) backwards; }
.anim-footer { animation: footer-in 0.42s cubic-bezier(0.22, 1, 0.36, 1) 0.5s backwards; }

@keyframes banner-in {
  from { opacity: 0; transform: translateY(18rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes banner-sheen {
  0% { opacity: 0; transform: translateX(0) skewX(-18deg); }
  18% { opacity: 0.85; }
  100% { opacity: 0; transform: translateX(760rpx) skewX(-18deg); }
}
@keyframes pair-in {
  from { opacity: 0; transform: translateY(26rpx) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes pair-from-left {
  from { opacity: 0; transform: translateX(-36rpx) scale(0.94); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}
@keyframes pair-from-right {
  from { opacity: 0; transform: translateX(36rpx) scale(0.94); }
  to { opacity: 1; transform: translateX(0) scale(1); }
}
@keyframes heart-pop {
  0% { opacity: 0; transform: scale(0.3); }
  60% { opacity: 1; transform: scale(1.14); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes heart-beat {
  0%, 100% { transform: scale(1); }
  18% { transform: scale(1.18); }
  36% { transform: scale(0.96); }
  54% { transform: scale(1.08); }
}
@keyframes score-pop {
  0% { opacity: 0; transform: scale(0.6); }
  65% { opacity: 1; transform: scale(1.06); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes score-halo {
  0% { opacity: 0.7; transform: scale(0.86); }
  100% { opacity: 0; transform: scale(1.28); }
}
@keyframes score-text-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes tag-in {
  from { opacity: 0; transform: translateY(10rpx) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes footer-in {
  from { opacity: 0; transform: translateY(110%); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 次数与操作 ===== */
.limit-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
}
.limit-main { flex: 1; min-width: 0; }
.limit-title { display: block; font-size: 24rpx; font-weight: 800; color: #1f2b43; }
.limit-strong { color: #e5486a; font-size: 28rpx; }
.limit-sub { display: block; margin-top: 5rpx; font-size: 19rpx; color: #969799; }
.limit-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.link-btn { font-size: 21rpx; color: #e5486a; font-weight: 700; transition: opacity 0.12s ease; }
.link-press { opacity: 0.55; }
.btn-ghost {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  border: 1rpx solid #ffc6d2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #e5486a;
  font-size: 21rpx;
  font-weight: 700;
}
.btn-ghost[disabled] { opacity: 0.45; color: #969799; border-color: #e5e9f1; }

/* ===== 提示 / 安全 ===== */
.prompt-card { margin-top: 22rpx; padding: 24rpx 26rpx 18rpx; }
.prompt-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 800; color: #1f2b43; }
.prompt-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff4e8;
  color: #e58a2b;
  font-size: 19rpx;
}
.prompt-item { display: flex; gap: 12rpx; padding: 8rpx 0; font-size: 23rpx; line-height: 1.6; color: #646566; }
.prompt-no { color: #c2c9d4; font-weight: 800; }
.safety-note {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 20rpx;
  background: #f7f9fc;
  font-size: 21rpx;
  line-height: 1.65;
  color: #7a8699;
}
.safety-bold { color: #5b677a; font-weight: 700; }
.bottom-space { height: 190rpx; }

.result-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f7f7f7 74%, rgba(247, 247, 247, 0.86));
}
.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #ff7a9a 0%, #ff4d72 58%, #f03d63 100%);
  box-shadow: 0 12rpx 24rpx rgba(255, 77, 114, 0.28);
}
.btn-secondary {
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  color: #e5486a;
  background: #ffffff;
  border: 1rpx solid #ffc6d2;
  font-size: 27rpx;
  font-weight: 700;
}
.btn-primary,
.btn-secondary,
.btn-ghost { transition: transform 0.12s ease, opacity 0.12s ease; transform-origin: center; }
.btn-press { transform: scale(0.96); opacity: 0.9; }
.footer-note { display: block; margin-top: 8rpx; text-align: center; font-size: 19rpx; color: #98a2b3; }

/* ===== 空 / 加载 ===== */
.empty-state { margin-top: 80rpx; padding: 60rpx 36rpx; text-align: center; }
.empty-orb {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: linear-gradient(135deg, #ff8ba5, #7a5cff);
}
.empty-title { display: block; font-size: 30rpx; font-weight: 800; color: #1f2b43; }
.empty-sub { display: block; margin: 12rpx auto 26rpx; font-size: 22rpx; line-height: 1.65; color: #969799; }
.empty-state button { display: inline-block; width: 300rpx; }
.loading-page {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 23rpx;
  color: #969799;
}
.loading-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #ff4d72; animation: pulse 1s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { transform: scale(0.8); opacity: 0.45; } 50% { transform: scale(1.15); opacity: 1; } }

/* ===== 重新匹配弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.48);
}
.modal-sheet {
  width: 100%;
  padding: 30rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}
.modal-mask.is-entering { animation: mask-in 0.2s ease-out both; }
.modal-sheet.is-entering { animation: sheet-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) both; }
.modal-mask.is-leaving { animation: mask-out 0.18s ease-in both; pointer-events: none; }
.modal-sheet.is-leaving { animation: sheet-out 0.18s ease-in both; }

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes mask-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes sheet-in {
  from { opacity: 0; transform: translateY(100%); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes sheet-out {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(100%); }
}
.modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.modal-title { font-size: 34rpx; font-weight: 900; color: #1f2b43; }
.modal-close { font-size: 22rpx; color: #969799; }
.modal-intro { display: block; margin-bottom: 16rpx; font-size: 24rpx; line-height: 1.7; color: #646566; }
.modal-strong { color: #e5486a; font-weight: 800; }
.modal-rule { padding: 7rpx 0; font-size: 22rpx; line-height: 1.6; color: #969799; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.modal-actions button { flex: 1; }
.modal-actions .btn-primary { height: 82rpx; line-height: 82rpx; font-size: 27rpx; }

/* ===== 减弱动效兜底 ===== */
@media (prefers-reduced-motion: reduce) {
  .anim-banner,
  .anim-banner::after,
  .anim-pair,
  .anim-from-left,
  .anim-from-right,
  .anim-heart-pop,
  .anim-heart-pop .pair-heart-icon,
  .anim-score-pop,
  .anim-score-pop::after,
  .anim-score-text,
  .anim-tag,
  .anim-footer,
  .modal-mask.is-entering,
  .modal-sheet.is-entering,
  .modal-mask.is-leaving,
  .modal-sheet.is-leaving {
    animation: none;
  }
  .btn-primary,
  .btn-secondary,
  .btn-ghost,
  .link-btn { transition: none; }
}
