.poster-page {
  min-height: 100vh;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  box-sizing: border-box;
}

.poster-container {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.poster-image {
  width: 100%;
  display: block;
}

.poster-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.poster-actions {
  margin-top: 48rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-share-tip {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.save-btn {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border-radius: 44rpx;
  border: none;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.save-btn::after {
  border: none;
}

.save-icon {
  font-size: 32rpx;
}

/* 微信好友图标是位图，按文字图标的视觉重量裁成小圆角方块 */
.save-icon-img {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
}

.poster-actions .save-btn + .save-btn {
  margin-top: 20rpx;
}

/* P12：错误态下的「重新生成」按钮，沿用底部操作区样式，只调整间距与宽度 */
.poster-retry-btn {
  margin-top: 24rpx;
  width: 60%;
}
