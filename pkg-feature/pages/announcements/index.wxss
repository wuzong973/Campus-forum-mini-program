.page { min-height: 100vh; padding: 30rpx 24rpx 60rpx; background: #f5f7fb; }.page-head { padding: 14rpx 8rpx 30rpx; }.head-title, .head-desc, .notice-title, .notice-content { display: block; }.head-title { color: #172039; font-size: 40rpx; font-weight: 700; }.head-desc { margin-top: 8rpx; color: #8995a8; font-size: 25rpx; }.notice-card { margin-bottom: 18rpx; padding: 28rpx; border-radius: 18rpx; background: #ffffff; box-shadow: 0 8rpx 22rpx rgba(31, 52, 92, .06); }.notice-version { display: inline-block; padding: 3rpx 12rpx; border-radius: 10rpx; background: #eaf1ff; color: #4b78d4; font-size: 20rpx; }.notice-title { margin-top: 15rpx; color: #1c263a; font-size: 31rpx; font-weight: 700; }.notice-content { margin-top: 10rpx; color: #69778c; font-size: 25rpx; line-height: 1.65; }
