.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 14% -6%, rgba(137, 202, 255, 0.28) 0%, rgba(137, 202, 255, 0) 48%),
    linear-gradient(180deg, #d7efff 0%, #eaf6ff 18%, #f5f9fd 46%, #f7f8fb 72%, #f4f6fa 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

.type-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  color: #5b6b85;
  font-size: 27rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.type-tab.active {
  background: #3a6fe3;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(58, 111, 227, 0.32);
}

.unblock-btn.restore {
  border-color: #3a6fe3;
  color: #3a6fe3;
}

.black-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 10rpx 26rpx;
  box-shadow: 0 3rpx 16rpx rgba(32, 48, 76, 0.06);
}

.black-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.black-row + .black-row { border-top: 1rpx solid #f0f2f5; }

.black-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #edf1f6;
  flex-shrink: 0;
}

.black-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.black-nick {
  color: #27364a;
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.black-date { color: #a6afbb; font-size: 23rpx; }

.nick-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.cert-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #e8f1ff;
  color: #3a6fe3;
  font-size: 20rpx;
  font-weight: 500;
}

.cert-tag.restored-tag {
  background: #e8f8ef;
  color: #1fa864;
}

.unblock-btn.restore.viewing {
  border-color: #1fa864;
  color: #1fa864;
}

.post-detail-text {
  color: #42506b;
  font-size: 25rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.post-row .black-info { gap: 8rpx; }

.unblock-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e64340;
  color: #e64340;
  font-size: 24rpx;
  font-weight: 500;
  transition: opacity 0.2s ease, transform 0.35s cubic-bezier(0.34, 1.42, 0.6, 1), box-shadow 0.35s cubic-bezier(0.34, 1.42, 0.6, 1);
}

.btn-hover { opacity: 0.7;  transform: scale(0.96); box-shadow: inset 0 2rpx 6rpx rgba(16, 32, 64, 0.16), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.08); }

.black-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 90rpx 40rpx;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.5;
}

.empty-text {
  margin-top: 20rpx;
  color: #42506b;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 10rpx;
  color: #a6afbb;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.black-loading {
  padding: 60rpx 0;
  color: #a6afbb;
  font-size: 26rpx;
  text-align: center;
}
