REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=GQG_campus_jwt_secret_2026
JWT_EXPIRES=7d

# 微信小程序配置（手机号登录需配置真实的 AppID 与 AppSecret）
WX_APPID=wx826b32d30330546e
WX_APPSECRET=your_appsecret
