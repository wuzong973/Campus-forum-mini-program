# 维修接单订阅消息
WX_REPAIR_TEMPLATE_ID=
WX_REPAIR_TEMPLATE_PAGE=pages/repair/index

# 同类消息合并窗口（毫秒）。语义：窗口内同一用户同一模板只发一条，后续转待发表、过窗后补发。
# 0 或不设 = 不合并（当前默认）：每收到一条消息立即独立触发一次微信提醒。
# 需恢复合并时设为 300000（5 分钟）；仅 commentNew / commentReply / message 三个高频模板参与合并。
# ⚠️ 微信一次性订阅是「授权一次 = 一条额度」的硬上限，关闭合并后突发消息会更快耗尽额度。
SUBSCRIBE_MERGE_WINDOW_MS=0

JW_CAPTCHA_ATTEMPTS=3
JW_OCR_AUTO_FILL_CONFIDENCE=65
# 教务爬虫容错参数（学校侧 SLB 源站超时会间歇返回 504/502，故开启重试并放宽超时）
JW_USE_OCR=1
JW_TIMEOUT_MS=12000
JW_MAX_RETRIES=2
JW_RETRY_BACKOFF_MS=800
JW_FAST_SEMESTER_CONCURRENCY=6
JW_SYNC_COOLDOWN_MS=60000
# 课表截图 OCR（微信通用印刷体识别）本地每日调用保护上限
# 微信侧免费额度以实际为准，超限后接口返回「今日课表识别次数已用完」
SCHEDULE_OCR_DAILY_LIMIT=200

# ===== 上传与内容安全 =====
# 视频上传每日配额（按用户计，走 Redis 计数）。
# 微信内容安全只覆盖文本/图片/音频，**没有视频检测接口**，
# 视频靠「真实文件类型校验 + 每日配额 + 举报与后台下架」收敛风险。
VIDEO_UPLOAD_DAILY_LIMIT=30

# 微信公众平台「开发 → 开发设置 → 消息推送」里配置的 Token。
# 用途：媒体异步检测（wxa/media_check_async）的结果回调验签，见 services/mediaCheckService.js。
#   推送 URL 填 https://<你的域名>/api/v1/wechat/message
#   数据格式选 JSON，消息加密方式选「明文模式」
# 留空 = 不启用异步检测：正常尺寸图片仍走同步 img_sec_check（行为与改造前一致）；
# 超大图片在服务器缺 sharp 时仍会被拒绝并提示换小图 —— 宁可拒绝上传，也不放行未经检测的媒体。
WX_MESSAGE_TOKEN=
