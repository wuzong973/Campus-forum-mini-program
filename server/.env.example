PORT=3000
NODE_ENV=production
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=least_privilege_user
DB_PASSWORD=replace-with-secret-manager
DB_NAME=gqg_campus
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-secret-manager
JWT_SECRET=replace-with-32-byte-random-secret
JWT_EXPIRES=7d
WX_APPID=wxxxxxxxxxxxxxxxxx
WX_APPSECRET=replace-with-secret-manager
WX_MCH_ID=merchant-id
WX_SERIAL_NO=certificate-serial
WX_APIV3_KEY=32-byte-api-v3-key
WX_PLATFORM_PUBLIC_KEY=replace-with-wechat-platform-public-key
WX_PRIVATE_KEY=replace-with-merchant-private-key
WX_PAY_NOTIFY_URL=https://your-domain.example/api/v1/payment/notify
WX_TRANSFER_NOTIFY_URL=https://your-domain.example/api/v1/wallet/transfer/notify
UPLOAD_PUBLIC_BASE_URL=https://your-domain.example
# 小程序最新发布版本号；发布新版时同步更新，供前端版本更新提醒比较
APP_VERSION=
UPLOAD_STORAGE_DRIVER=object
CORS_ORIGIN=https://servicewechat.com

# 腾讯云 COS 对象存储（生产环境图片上传必需）
COS_BUCKET=payun-1445580415
COS_REGION=ap-guangzhou
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key

# 订阅消息模板 ID（微信公众平台 → 功能 → 订阅消息 → 公共模板库选用后填入）
# 留空则对应类型的订阅推送自动跳过，只保留站内信，不影响业务主流程。
# ⚠️ 必须与前端 utils/subscribe.js 的 TEMPLATE_IDS 保持一致：前端用这些 ID 拉起授权弹窗、
#    服务端用同一条 ID 发送；两边不一致会导致「用户授权了却收不到」（微信返回 43101）。
#    改动模板时两处必须同改，护栏见 tests/subscribe-binding-audit.test.js 的 A 组断言。
# 旧的 WX_TPL_ACTIVITY / WX_TPL_ERRAND / WX_TPL_INTERACT 三槽位体系已废弃，勿再使用。
WX_TPL_COMMENT_NEW=kDU3pivvs0kb4EtB-rJk7OuMGhOhLkGfsrvz6ob2xj4
WX_TPL_COMMENT_REPLY=YcAwFpCDmjHoNpH8jwqyCBpgu4JUD0o61Uj4Wnqd6Y0
